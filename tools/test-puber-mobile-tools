    def test_v2_v3_closed_checkpoint_and_no_preacquisition_serial(self):
        with Fixture() as f:
            paths = ("app/src/main/generated/baselineProfiles/baseline-prof.txt",
                     "app/src/main/generated/baselineProfiles/startup-prof.txt")
            value = {"schema": "puber_release_profile_checkpoint_v3", "task_id": TASK,
                     "task_short_id": "PUB-99", "operation_id": "a" * 64,
                     "release_branch": "release/99.0.0", "release_base_oid": "a" * 40,
                     "candidate_oid": "b" * 40, "release_head_oid": "",
                     "state": "acquiring", "resource_serial": "", "resource_lease": f.binding,
                     "profile_report": "", "profile_report_digest": "",
                     "release_preparation_report": "", "release_preparation_report_digest": "",
                     "output_hashes": {p: "c" * 64 for p in paths}}
            helper.validate_profile_checkpoint(value)
            with self.assertRaises(helper.ContractError):
                helper.validate_profile_checkpoint(dict(value, token="SECRET"))
            with self.assertRaises(helper.ContractError):
                helper.validate_profile_checkpoint(dict(value, resource_serial="emulator-5554"))
            changed = copy.deepcopy(value)
            changed["resource_lease"]["config_sha256"] = "e" * 64
            with self.assertRaises(helper.ContractError):
                helper.validate_profile_checkpoint(changed, expected=value)
            legacy = {k: v for k, v in value.items() if k != "resource_lease"}
            legacy.update(schema="puber_release_profile_checkpoint_v2", candidate_serials=["emulator-5554"])
            before = mobile.canonical(legacy)
            helper.validate_profile_checkpoint(legacy)
            self.assertEqual(mobile.canonical(legacy), before)
            with self.assertRaises(helper.ContractError):
                helper.validate_profile_checkpoint(dict(legacy, candidate_serials=[]))
            # The protected store preserves v2 bytes and never implicitly
            # upgrades/downgrades an existing ownership record.
            (f.root / ".kent").mkdir(mode=0o700)
            helper.write_profile_checkpoint(f.root, "PUB-99", legacy)
            checkpoint_path = f.root / ".kent/runtime/PUB-99/release-profile-checkpoint.json"
            old_bytes = checkpoint_path.read_bytes()
            with self.assertRaises(helper.ContractError):
                helper.write_profile_checkpoint(f.root, "PUB-99", value)
            self.assertEqual(checkpoint_path.read_bytes(), old_bytes)
            # Separate Task storage exercises genuine v3 write/read custody.
            value2 = dict(value, task_short_id="PUB-100")
            helper.write_profile_checkpoint(f.root, "PUB-100", value2)
            retained = helper.read_profile_checkpoint(f.root, "PUB-100")
            self.assertEqual(retained, value2)
            changed2 = copy.deepcopy(value2)
            changed2["resource_lease"]["config_sha256"] = "e" * 64
            with self.assertRaises(helper.ContractError):
                helper.write_profile_checkpoint(f.root, "PUB-100", changed2)
            self.assertEqual(helper.read_profile_checkpoint(f.root, "PUB-100"), value2)


