    def test_cleanup_proof_not_exit_and_survives_record_pruning(self):
        with Fixture() as f:
            f.run()
            f.finish()
            run, resource, proof = mobile.inspect_command(f.binding, f.context, terminal=True)
            self.assertEqual(proof["command_stop"], "confirmed")
            self.assertEqual(proof["resource"], resource)
            self.assertNotIn("NEVER-PUBLISH", mobile.canonical(proof))
            for field, invalid in (("command_stop", "unconfirmed"), ("phase", "failed")):
                old = f.status[field]
                f.status[field] = invalid
                f.save()
                with self.assertRaises(mobile.Error):
                    mobile.inspect_command(f.binding, f.context, terminal=True)
                f.status[field] = old
            f.save()
            for field in ("cleanup_pending", "quarantined"):
                f.lease[field] = True
                f.save()
                with self.assertRaises(mobile.Error):
                    mobile.inspect_command(f.binding, f.context, terminal=True)
                f.lease[field] = False
            f.save()
            mobile.write(Path(run) / "command-stop-uncertain.json", {"schema": 1})
            with self.assertRaises(mobile.Error):
                mobile.inspect_command(f.binding, f.context, terminal=True)
            retained = dict(f.binding, run_directory=run, resource=resource, cleanup_proof=proof)
            # Validation of retained proof is independent of live client files.
            # A completed report can therefore survive later client pruning.
            helper.validate_resource_lease_checkpoint(retained, "completed", "emulator-5570")
            for key in ("command_stop", "cleanup_pending", "quarantined"):
                altered = copy.deepcopy(retained)
                altered["cleanup_proof"][key] = "invalid"
                with self.assertRaises(helper.ContractError):
                    helper.validate_resource_lease_checkpoint(altered, "completed", "emulator-5570")

