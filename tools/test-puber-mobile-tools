                        patch.object(mobile, "fresh_release_context", self.native._fresh_native_context),
                        patch.object(mobile, "verify_smoke_identity")]
        for p in self.patches:
            p.start()
        self.binding = mobile.release_attempt(self.context)
        return self

    def run(self):
        self.run_dir = self.runs / "attempt"
        self.run_dir.mkdir(mode=0o700)
        mobile.write(self.run_dir / "binding.json", {
            "schema": 1, "config": self.client, "profile": "release.clean",
            "capability": self.client["profiles"]["release.clean"],
            "owner": self.binding["owner"], "binding": None})
        self.lease = {"id": "lease-id", "generation": 1, "slot": "release-slot",
                      "owner": self.binding["owner"], "capability": "puber-tv-release-clean",
                      "state": "active", "quarantined": False, "cleanup_pending": False,
                      "service_available": True, "expires_in": 25,
                      "endpoint": {"adb_serial": "emulator-5570"}}
        self.status = {"phase": "active", "updated_at": time.monotonic(),
                       "run_directory": str(self.run_dir), "lease": self.lease,
                       "command_stop": "unconfirmed"}
        self.save()
        mobile.write(self.run_dir / "receipt.json", {"secret": "NEVER-PUBLISH"})
        self.lock = os.open(self.run_dir / "helper.lock", os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        return self.run_dir

    def save(self):
        mobile.write(self.run_dir / "status.json", self.status)

    def finish(self):
        fcntl.flock(self.lock, fcntl.LOCK_UN)
        self.status.update(phase="finished", command_stop="confirmed")
        self.lease.update(state="completed")
        self.save()

    def __exit__(self, *_args):
        if hasattr(self, "lock"):
            os.close(self.lock)
        for p in reversed(self.patches):
            p.stop()
        self.temp.cleanup()


class MobileTests(unittest.TestCase):
    def test_smoke_record_lock_serializes_all_actions_and_keeps_inode(self):
        for first in ("start", "check", "finish"):
            with self.subTest(first=first), Fixture() as f:
                run, identity, record, recovery = self.smoke_finish_setup(f, "active")
                lock = record.with_name(record.name + ".lock")
                calls, inodes = [], []
                def delegate(command, **_kwargs):
                    calls.append(command[1])
                    inode = lock.stat().st_ino
                    inodes.append(inode)
                    for contender in ("start", "check", "finish"):
                        with self.assertRaisesRegex(mobile.Error, "busy"):
                            mobile.smoke(contender, record, identity)
                        self.assertEqual(lock.stat().st_ino, inode)
                    # Another record has an independent serialization domain.
                    other = f.root / "different-smoke.json"
                    with self.assertRaisesRegex(mobile.Error, "checkpoint missing"):
                        mobile.smoke("check", other, identity)
                    if command[1] == "finish":
                        f.status.update(phase="finished", error=None)
                        f.lease.update(state="completed")
                        f.save()
                    return f.status
                with patch.object(mobile, "capture", side_effect=delegate):
                    mobile.smoke(first, record, identity)
                    mobile.smoke("finish", record, identity)
                self.assertTrue(lock.exists())
                self.assertEqual(set(inodes), {lock.stat().st_ino})
                self.assertEqual(calls.count("start"), int(first == "start"))
                self.assertFalse(mobile.read(recovery)["pending"])

    def test_smoke_record_lock_rejects_unsafe_or_replaced_paths(self):
        for kind in ("symlink", "hardlink", "mode", "owner", "inode"):
            with self.subTest(kind=kind), Fixture() as f:
                run, identity, record, _recovery = self.smoke_finish_setup(f, "stopped")
                lock = record.with_name(record.name + ".lock")
                target = f.root / "lock-target"
                target.write_bytes(b"")
                target.chmod(0o600)
                if kind == "symlink":
                    lock.symlink_to(target)
                elif kind == "hardlink":
                    os.link(target, lock)
                else:
                    lock.write_bytes(b"")
                    lock.chmod(0o644 if kind == "mode" else 0o600)
                original_fstat, original_lstat = os.fstat, Path.lstat
                def fstat(fd):
                    info = original_fstat(fd)
                    return SimpleNamespace(st_mode=info.st_mode, st_uid=info.st_uid + 1,
                                           st_nlink=info.st_nlink, st_dev=info.st_dev, st_ino=info.st_ino)
                def lstat(path, **kwargs):
                    info = original_lstat(path, **kwargs)
                    if path == lock:
                        return SimpleNamespace(st_mode=info.st_mode, st_dev=info.st_dev, st_ino=info.st_ino + 1)
                    return info
                from contextlib import ExitStack
                with ExitStack() as stack, patch.object(mobile, "capture") as dispatch:
                    if kind == "owner":
                        stack.enter_context(patch.object(mobile.os, "fstat", side_effect=fstat))
                    elif kind == "inode":
                        stack.enter_context(patch.object(Path, "lstat", lstat))
                    with self.assertRaises((OSError, mobile.Error)):
                        mobile.smoke("finish", record, identity)
                    dispatch.assert_not_called()
                # No recovery or delegate effect; unsafe lock is never removed.
                self.assertTrue(lock.exists() or lock.is_symlink())

    def test_smoke_record_lock_process_death_releases_without_losing_pending(self):
        with Fixture() as f:
            run, identity, record, recovery = self.smoke_finish_setup(f, "active")
            code = """
import importlib.machinery, importlib.util, json, sys, time
from pathlib import Path
source, root, config, record, identity = sys.argv[1:]
spec=importlib.util.spec_from_loader('owned_smoke_child', importlib.machinery.SourceFileLoader('owned_smoke_child',source))
mobile=importlib.util.module_from_spec(spec); spec.loader.exec_module(mobile)
mobile.ROOT=Path(root); mobile.CONFIG=Path(config)
mobile.verify_smoke_identity=lambda identity: None
def capture(command, **kwargs):
    if command[1]=='check':
        return mobile.read(Path(json.loads(Path(record).read_text())['run_directory'])/'status.json')
    assert command[1]=='finish'
    assert mobile.read(Path(record+'.cleanup.json'))['pending']
    print('OWNED_CHILD_PENDING',flush=True)
    time.sleep(120)
mobile.capture=capture
mobile.smoke('finish',Path(record),json.loads(identity))
"""
            child = subprocess.Popen(
                [sys.executable, "-B", "-c", code, str(ROOT / ".kent/adapters/mobile/puber-resource-lease"),
                 str(f.root), str(f.config), str(record), json.dumps(identity)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            try:
                import select
                ready, _, _ = select.select([child.stdout], [], [], 15)
                self.assertTrue(ready, "owned child did not reach durable pending")
                self.assertEqual(child.stdout.readline().strip(), "OWNED_CHILD_PENDING")
                lock = record.with_name(record.name + ".lock")
                inode = lock.stat().st_ino
                with patch.object(mobile, "capture") as dispatch:
                    for action in ("start", "check", "finish"):
                        with self.assertRaisesRegex(mobile.Error, "busy"):
                            mobile.smoke(action, record, identity)
                    dispatch.assert_not_called()
                self.assertTrue(mobile.read(recovery)["pending"])
                child.terminate()  # Only the exact Popen child created above.
                child.communicate(timeout=15)
                self.assertEqual(lock.stat().st_ino, inode)
                terminal = {"phase": "finished", "run_directory": str(run),
                            "lease": {"state": "completed", "cleanup_pending": False, "quarantined": False}}
                with patch.object(mobile, "capture", side_effect=lambda command, **kwargs:
                                  f.status if command[1] == "check" else terminal):
                    result = mobile.smoke("finish", record, identity)
                self.assertTrue(result["cleanup_confirmed"])
                self.assertTrue(result["smoke_blocked"])
                self.assertIn("cleanup-unconfirmed", result["recovery_reasons"])
                self.assertFalse(mobile.read(recovery)["pending"])
                self.assertEqual(lock.stat().st_ino, inode)
            finally:
                if child.poll() is None:
                    child.terminate()
                    child.communicate(timeout=15)

    def smoke_finish_setup(self, fixture, phase):
        run = fixture.run()
        identity = mobile.smoke_binding(PROJECT, TASK, SESSION)
        metadata = mobile.read(run / "binding.json")
        metadata.update(profile="smoke.persistent", binding=identity,
                        owner=f"smoke:{TASK}:{SESSION}")
        mobile.write(run / "binding.json", metadata)
        fixture.status["phase"] = phase
        fixture.save()
        record = fixture.root / "smoke.json"
        mobile.write(record, {"protocol": mobile.PROTOCOL, "profile": "smoke.persistent",
                              "config_sha256": mobile.configuration()[2], "binding": identity,
                              "run_directory": str(run)})
        return run, identity, record, record.with_name(record.name + ".cleanup.json")

    def test_smoke_finish_stopped_active_and_late_loss_reconciliation(self):
        for phase, state, expected in (
            ("stopped", "completed", {"helper-stopped"}),
            ("finished", "completed", {"status-unknown"}),
            ("active", "completed", set()),
            ("active", "expired", {"lease-expired"}),
            ("active", "cancelled", {"lease-cancelled"}),
        ):
            with self.subTest(phase=phase, state=state), Fixture() as f:
                run, identity, record, recovery = self.smoke_finish_setup(f, phase)
                calls = []
                def delegate(command, **_kwargs):
                    self.assertEqual(command[2:], ["--run-dir", str(run)])
                    calls.append(command[1])
                    if command[1] == "check":
                        if f.status["phase"] != "active":
                            raise mobile.Error("helper is not observably active")
                        return f.status
                    self.assertEqual(command[1], "finish")
                    self.assertTrue(recovery.is_file())
                    if phase == "stopped":
                        self.assertIn("helper-stopped", mobile.read(recovery)["reasons"])
                    f.status.update(phase="finished", error=None)
                    f.lease.update(state=state)
                    f.save()
                    return f.status
                with patch.object(mobile, "capture", side_effect=delegate):
                    result = mobile.smoke("finish", record, identity)
                    self.assertTrue(result["cleanup_confirmed"])
                    self.assertEqual(set(result["recovery_reasons"]), expected)
                    self.assertEqual(result["smoke_blocked"], bool(expected))
                    # Later completed status cannot erase expired/cancelled loss.
                    f.lease["state"] = "completed"
                    result = mobile.smoke("finish", record, identity)
                    self.assertEqual(set(result["recovery_reasons"]), expected)
                    with self.assertRaises(mobile.Error):
                        mobile.smoke("check", record, identity)
                self.assertNotIn("start", calls)
                self.assertEqual(calls.count("finish"), 2)

    def test_smoke_finish_lost_ack_and_uncertain_stop_remain_blocked(self):
        for failure in ("lost-ack", "check-failed", "stop-uncertain", "renewal-stopped", "unknown"):
            with self.subTest(failure=failure), Fixture() as f:
                run, identity, record, recovery = self.smoke_finish_setup(f, "active")
                if failure in {"stop-uncertain", "renewal-stopped"}:
                    marker = "command-stop-uncertain.json" if failure == "stop-uncertain" else "stop-renewal.json"
                    mobile.write(run / marker, {"schema": 1})
                if failure == "unknown":
                    (run / "status.json").unlink()
                calls = []
                def delegate(command, **_kwargs):
                    calls.append(command[1])
                    if command[1] == "check":
                        if failure == "check-failed":
                            raise mobile.Error("lease lost")
                        return f.status
                    self.assertEqual(command[1], "finish")
                    self.assertTrue(recovery.is_file())
                    f.status.update(phase="finished", error=None)
                    f.lease.update(state="completed")
                    f.save()
                    if failure == "lost-ack" and calls.count("finish") == 1:
                        raise mobile.Error("response lost after cleanup")
                    return f.status
                with patch.object(mobile, "capture", side_effect=delegate):
                    if failure == "lost-ack":
                        with self.assertRaises(mobile.Error):
                            mobile.smoke("finish", record, identity)
                    else:
                        self.assertTrue(mobile.smoke("finish", record, identity)["smoke_blocked"])
                    result = mobile.smoke("finish", record, identity)
                reason = {"lost-ack": "cleanup-unconfirmed", "unknown": "status-unknown"}.get(failure, failure)
                self.assertTrue(result["cleanup_confirmed"])
                self.assertTrue(result["smoke_blocked"])
                self.assertIn(reason, result["recovery_reasons"])
                self.assertNotIn("start", calls)

    def test_smoke_finish_rejects_foreign_missing_unsafe_binding_before_dispatch(self):
        for drift in ("missing", "unsafe", "binding", "config", "owner", "run", "native",
                      "recovery", "unsafe-recovery", "pending-type", "legacy-recovery"):
            with self.subTest(drift=drift), Fixture() as f:
                run, identity, record, recovery = self.smoke_finish_setup(f, "stopped")
                binding_path = run / "binding.json"
                if drift == "missing":
                    binding_path.unlink()
                elif drift == "unsafe":
                    binding_path.chmod(0o644)
                elif drift in {"binding", "config", "owner"}:
                    metadata = mobile.read(binding_path)
                    metadata[drift] = "foreign"
                    mobile.write(binding_path, metadata)
                elif drift == "run":
                    value = mobile.read(record)
                    value["run_directory"] = str(f.root)
                    mobile.write(record, value)
                elif drift == "native":
                    pass
                elif drift in {"unsafe-recovery", "pending-type", "legacy-recovery"}:
                    value = mobile.read(record)
                    note = {"schema": 1, "run_directory": str(run),
                            "config_sha256": value["config_sha256"], "binding": identity,
                            "pending": False, "reasons": []}
                    if drift == "pending-type":
                        note["pending"] = "false"
                    elif drift == "legacy-recovery":
                        note.pop("pending")
                    mobile.write(recovery, note)
                    if drift == "unsafe-recovery":
                        recovery.chmod(0o644)
                else:
                    mobile.write(recovery, {"schema": 1, "binding": "foreign"})
                with patch.object(mobile, "capture") as dispatch:
                    if drift == "native":
                        with patch.object(mobile, "verify_smoke_identity", side_effect=mobile.Error("native drift")):
                            with self.assertRaises(mobile.Error):
                                mobile.smoke("finish", record, identity)
                    else:
                        with self.assertRaises(mobile.Error):
                            mobile.smoke("finish", record, identity)
                    dispatch.assert_not_called()

