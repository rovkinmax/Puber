    def test_smoke_finish_crash_write_windows_keep_pending_or_history(self):
        # Exercise the real atomic writer, including a NEW visible file after
        # replace but before directory fsync, not merely a mocked write refusal.
        for fail_at in (1, 2):
            for window in ("before-replace", "directory-fsync"):
                with self.subTest(fail_at=fail_at, window=window), Fixture() as f:
                    run, identity, record, recovery = self.smoke_finish_setup(f, "active")
                    calls, replacements = [], []
                    real_replace, real_fsync = os.replace, os.fsync
                    latest = [None]
                    def replace(source, destination):
                        latest[0] = destination
                        if destination == recovery:
                            replacements.append(destination)
                            if len(replacements) == fail_at and window == "before-replace":
                                raise OSError("crash before recovery replace")
                        real_replace(source, destination)
                    def fsync(fd):
                        if (latest[0] == recovery and len(replacements) == fail_at
                                and window == "directory-fsync" and stat.S_ISDIR(os.fstat(fd).st_mode)):
                            raise OSError("crash after replace before directory fsync")
                        real_fsync(fd)
                    def delegate(command, **_kwargs):
                        calls.append(command[1])
                        if command[1] == "check":
                            return f.status
                        self.assertTrue(mobile.read(recovery)["pending"])
                        f.status.update(phase="finished", error=None)
                        f.lease.update(state="expired")
                        f.save()
                        return f.status
                    with patch.object(mobile, "capture", side_effect=delegate), patch.object(
                        mobile.os, "replace", side_effect=replace
                    ), patch.object(mobile.os, "fsync", side_effect=fsync):
                        with self.assertRaises(OSError):
                            mobile.smoke("finish", record, identity)
                    if fail_at == 1:
                        self.assertNotIn("finish", calls)
                    if recovery.exists():
                        saved = mobile.read(recovery)
                        self.assertTrue(saved["pending"] or "lease-expired" in saved["reasons"])
                    with patch.object(mobile, "capture", side_effect=delegate):
                        result = mobile.smoke("finish", record, identity)
                    self.assertTrue(result["cleanup_confirmed"])
                    self.assertTrue(result["smoke_blocked"])
                    self.assertIn("lease-expired", result["recovery_reasons"])
                    self.assertFalse(mobile.read(recovery)["pending"])
                    self.assertNotIn("start", calls)

    def test_smoke_finish_lost_ack_error_write_failure_and_interrupt_retry(self):
        for failure in ("old-visible", "new-visible", "interrupted"):
            with self.subTest(failure=failure), Fixture() as f:
                run, identity, record, recovery = self.smoke_finish_setup(f, "active")
                calls, writes = [], []
                original = mobile.write
                class Interrupted(BaseException):
                    pass
                def delegate(command, **_kwargs):
                    calls.append(command[1])
                    if command[1] == "check":
                        return f.status
                    self.assertTrue(mobile.read(recovery)["pending"])
                    if failure == "interrupted" and calls.count("finish") == 1:
                        raise Interrupted()
                    f.status.update(phase="finished", error=None)
                    f.lease.update(state="completed")
                    f.save()
                    if calls.count("finish") == 1:
                        raise mobile.Error("lost delegate acknowledgement")
                    return f.status
                def write(path, value):
                    if path == recovery:
                        writes.append(path)
                        if len(writes) == 2:
                            if failure == "new-visible":
                                original(path, value)
                            raise OSError("error disposition write failed")
                    original(path, value)
                with patch.object(mobile, "capture", side_effect=delegate), patch.object(
                    mobile, "write", side_effect=write
                ):
                    with self.assertRaises(Interrupted if failure == "interrupted" else OSError):
                        mobile.smoke("finish", record, identity)
                self.assertTrue(mobile.read(recovery)["pending"])
                with patch.object(mobile, "capture", side_effect=delegate):
                    result = mobile.smoke("finish", record, identity)
                    again = mobile.smoke("finish", record, identity)
                self.assertTrue(result["cleanup_confirmed"])
                self.assertIn("cleanup-unconfirmed", result["recovery_reasons"])
                self.assertEqual(result, again)
                self.assertTrue(again["smoke_blocked"])
                self.assertNotIn("start", calls)

    def test_active_source_cutover_and_legacy_admission_retirement(self):
        import tomllib
        profile = tomllib.loads((ROOT / ".kent/workflow-profile.toml").read_text())
        self.assertTrue({"puber_resource_lease", "android_tools"} <= set(profile["required_adapters"]))
        self.assertFalse({"mobile_resource_lock", "mobile_script_resource_lock"} & set(profile["adapters"]))
        self.assertNotIn("mobile_resource_lock", profile["kit_managed_adapters"])
        self.assertIn("smoke-test-resource-lease.md", (ROOT / ".kent/commands/smoke-test.md").read_text())
        legacy = ROOT / ".kent/adapters/mobile/emulator-resource-lock.sh"
        with tempfile.TemporaryDirectory(prefix="puber-retirement-") as temporary:
            directory = Path(temporary).resolve()
            storage = directory / "must-not-exist"
            env = dict(os.environ, KENT_RESOURCE_LOCK_DIR=str(storage),
                       KENT_RESOURCE_ALLOW_LEGACY="1", ANDROID_SERIAL="emulator-5570")
            for action in ("acquire", "acquire-any", "resume", "resume-owned", "acquire-script",
                           "acquire-script-any", "adb-emulators", "adb-physical-devices"):
                result = subprocess.run([str(legacy), action, "emulator-5570"], env=env, capture_output=True)
                self.assertEqual(result.returncode, 64, action)
                self.assertIn(b"retired", result.stderr)
                self.assertFalse(storage.exists())
            for action in ("try-acquire", "resume", "resume-owned", "script-acquire"):
                result = subprocess.run([str(legacy), "__locked", action, "emulator-5570"],
                                        env=env, capture_output=True)
                self.assertEqual(result.returncode, 64, action)
                self.assertFalse(storage.exists())
            status = subprocess.run([str(legacy), "status"], env=env, capture_output=True)
