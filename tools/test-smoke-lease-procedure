    def test_release_readback_controls_checkpoint_state(self) -> None:
        held = checkpoint_for(resource=RESOURCE, token=TOKEN, owner=TASK_SHORT_ID)
        prelude = "LEASE_HELD=true"
        locked = default_config()
        locked["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        unresolved = run_scenario(
            self.blocks, cases=["release"], checkpoint=held, config=locked,
            prelude=prelude, epilogue="if cleanup_lease; then exit 0; else exit 41; fi",
        )
        self.assertEqual(unresolved.returncode, 41)
        self.assertEqual(unresolved.checkpoint["stage_data"]["lease_state"], "held")
        assert_order(self, unresolved, ("adapter", "release"), ("adapter", "status"))

        failed_status = default_config()
        failed_status["statuses"][RESOURCE] = {"stdout": "", "code": 70}
        no_readback = run_scenario(
            self.blocks, cases=["release"], checkpoint=held, config=failed_status,
            prelude=prelude, epilogue="if cleanup_lease; then exit 0; else exit 41; fi",
        )
        self.assertEqual(no_readback.returncode, 41)
        self.assertEqual(no_readback.checkpoint["stage_data"]["lease_state"], "held")

        unlocked = default_config()
        unlocked["statuses"][RESOURCE] = "unlocked\n"
        released = run_scenario(
            self.blocks, cases=["release"], checkpoint=held, config=unlocked,
            prelude=prelude, epilogue="if cleanup_lease; then exit 0; else exit 41; fi",
        )
        self.assertEqual(released.returncode, 0, released.stderr)
        self.assertEqual(released.checkpoint["stage_data"]["lease_state"], "released")
        assert_order(self, released, ("adapter", "release"), ("adapter", "status"), ("checkpoint", "write"))

        release_failed_but_unlocked = default_config()
        release_failed_but_unlocked["outputs"]["release"] = {"stdout": "", "code": 75}
        release_failed_but_unlocked["statuses"][RESOURCE] = "unlocked\n"
        verified = run_scenario(
            self.blocks, cases=["release"], checkpoint=held, config=release_failed_but_unlocked,
            prelude=prelude, epilogue="if cleanup_lease; then exit 0; else exit 41; fi",
        )
        self.assertEqual(verified.returncode, 0, verified.stderr)
        self.assertEqual(verified.checkpoint["stage_data"]["lease_state"], "released")

    def test_explicit_release_uses_same_handler_and_clears_trap(self) -> None:
