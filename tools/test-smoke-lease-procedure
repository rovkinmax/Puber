                self.assertTrue(any(line.startswith("created_at=") for line in lines))
                owner_path.write_text(
                    "\n".join(
                        f"created_at={created_at}" if line.startswith("created_at=") else line
                        for line in lines
                    ) + "\n",
                    encoding="ascii",
                )
                (lock_dir / "created_at").write_text(f"{created_at}\n", encoding="ascii")

            fixed_date = sandbox / "bin/date"
            fixed_date.write_text(
                "#!/bin/sh\n"
                "[ \"${1:-}\" = \"+%s\" ] || exit 97\n"
                "printf '1000\\n'\n",
                encoding="ascii",
            )
            fixed_date.chmod(0o755)

            equality_resource = "emulator-5560"
            equality_owner = run_adapter(["acquire", equality_resource, "0", "7200"])
            self.assertEqual(equality_owner.returncode, 0, equality_owner.stderr)
            equality_token = equality_owner.stdout.strip()
            set_created_at(equality_resource, 995)
            at_ttl = run_adapter(["acquire", equality_resource, "0", "5"])
            self.assertEqual(at_ttl.returncode, 75)
            self.assertNotIn(equality_token, at_ttl.stdout + at_ttl.stderr)

            resumed_first = run_adapter(["resume", equality_resource, equality_token])
            self.assertEqual(resumed_first.returncode, 0, resumed_first.stderr)
            self.assertEqual(resumed_first.stdout.strip(), equality_token)
            replacement_after_resume = run_adapter(
                ["acquire", equality_resource, "0", "5"],
            )
            self.assertEqual(replacement_after_resume.returncode, 75)
            equality_status = run_adapter(["status", equality_resource])
            self.assertIn(f"task_id={TASK_SHORT_ID}", equality_status.stdout)
            self.assertIn("token=<redacted>", equality_status.stdout)
            self.assertNotIn(equality_token, equality_status.stdout)
            self.assertEqual(run_adapter(["release", equality_resource, equality_token]).returncode, 0)

            replacement_resource = "emulator-5561"
            replaced_owner = run_adapter(["acquire", replacement_resource, "0", "7200"])
            self.assertEqual(replaced_owner.returncode, 0, replaced_owner.stderr)
            replaced_token = replaced_owner.stdout.strip()
            set_created_at(replacement_resource, 994)
            after_ttl = run_adapter(["acquire", replacement_resource, "0", "5"])
            self.assertEqual(after_ttl.returncode, 0, after_ttl.stderr)
            replacement_token = after_ttl.stdout.strip()
            self.assertNotEqual(replacement_token, replaced_token)
            old_owner_resume = run_adapter(
                ["resume", replacement_resource, replaced_token],
            )
            self.assertEqual(old_owner_resume.returncode, 75)
            replacement_status = run_adapter(["status", replacement_resource])
            self.assertIn(f"task_id={TASK_SHORT_ID}", replacement_status.stdout)
            self.assertIn("token=<redacted>", replacement_status.stdout)
            self.assertNotIn(replacement_token, replacement_status.stdout)
            self.assertEqual(
                run_adapter(["release", replacement_resource, replacement_token]).returncode,
                0,
            )

            unknown_resource = "emulator-5562"
            unknown_dir = (
                Path(env["KENT_RESOURCE_LOCK_DIR"]) / f"mobile-{unknown_resource}.lock"
            )
            unknown_dir.mkdir(mode=0o700)
            unknown_owner = unknown_dir / "owner"
            unknown_stamp = unknown_dir / "created_at"
            unknown_owner.write_text("unrecognized=synthetic\n", encoding="ascii")
            unknown_stamp.write_text("1\n", encoding="ascii")
            unknown_owner.chmod(0o600)
            unknown_stamp.chmod(0o600)
            unknown_before = (unknown_owner.read_bytes(), unknown_stamp.read_bytes())
            unknown_status = run_adapter(["status", unknown_resource])
            self.assertEqual(unknown_status.returncode, 0, unknown_status.stderr)
            self.assertIn("owner_kind=UnknownOwner", unknown_status.stdout)
            unknown_acquire = run_adapter(["acquire", unknown_resource, "0", "5"])
            self.assertEqual(unknown_acquire.returncode, 75)
            self.assertEqual(
                (unknown_owner.read_bytes(), unknown_stamp.read_bytes()), unknown_before,
            )
            self.assertNotIn("token=", unknown_acquire.stdout + unknown_acquire.stderr)

            script_resource = "emulator-5563"
            script_task = NATIVE_ID
            script_context = hashlib.sha256(b"synthetic script owner").hexdigest()
            script_pid = os.getpid()
            acquire_request = (
                "schema=mobile-script-lease-request-v1\n"
                f"task_id={script_task}\n"
                f"context_sha256={script_context}\n"
                f"pid={script_pid}\n"
            )
            script_acquire = run_adapter(
                ["acquire-script", script_resource, "0"], input_data=acquire_request,
            )
            self.assertEqual(script_acquire.returncode, 0, script_acquire.stderr)
            script_fields = dict(
                line.split("=", 1) for line in script_acquire.stdout.splitlines()
            )
            self.assertEqual(script_fields["schema"], "mobile-script-lease-result-v1")
            self.assertEqual(script_fields["resource"], script_resource)
            script_token = script_fields["token"]
            owner_hash = script_fields["owner_sha256"]
            script_owner_path = (
                Path(env["KENT_RESOURCE_LOCK_DIR"])
                / f"mobile-{script_resource}.lock/owner"
            )
            script_owner_before = script_owner_path.read_bytes()
            session_acquire = run_adapter(["acquire", script_resource, "0", "5"])
            self.assertEqual(session_acquire.returncode, 75)
            self.assertEqual(script_owner_path.read_bytes(), script_owner_before)
            script_status = run_adapter(["status", script_resource])
            self.assertIn("owner_kind=script", script_status.stdout)
            self.assertIn("token=<redacted>", script_status.stdout)
            self.assertNotIn(script_token, script_status.stdout + session_acquire.stderr)

            release_request = (
                "schema=mobile-script-lease-request-v1\n"
                f"task_id={script_task}\n"
                f"context_sha256={script_context}\n"
                f"pid={script_pid}\n"
                f"token={script_token}\n"
                f"owner_sha256={owner_hash}\n"
            )
            script_release = run_adapter(
                ["release-script", script_resource], input_data=release_request,
            )
            self.assertEqual(script_release.returncode, 0, script_release.stderr)
            self.assertEqual(run_adapter(["status", script_resource]).stdout, "unlocked\n")


