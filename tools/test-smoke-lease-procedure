    def test_retained_resume_refuses_foreign_malformed_wrong_and_stale_evidence(self) -> None:
        cases: list[tuple[str, dict[str, Any], dict[str, Any]]] = []
        foreign = default_config()
        foreign["statuses"][RESOURCE] = locked_status("KEN-99", RESOURCE)
        cases.append(("foreign owner", foreign, {}))
        malformed = default_config()
        malformed["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE).replace("token=<redacted>", "token=secret")
        cases.append(("unredacted token", malformed, {}))
        duplicate = default_config()
        duplicate["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE).replace(
            f"  resource={RESOURCE}\n", f"  resource={RESOURCE}\n  resource={RESOURCE}\n"
        )
        cases.append(("duplicate resource", duplicate, {}))
        wrong = default_config()
        wrong["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        wrong["outputs"]["resume"] = "token-synthetic-wrong\n"
        cases.append(("wrong returned token", wrong, {}))
        stale = default_config()
        stale["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        stale["outputs"]["resume"] = {"stdout": "", "code": 75}
        cases.append(("stale token", stale, {}))
        for label, config, _unused in cases:
            with self.subTest(reason=label):
                result = run_scenario(
                    self.blocks, cases=["resume"],
                    checkpoint=checkpoint_for(resource=RESOURCE, token=TOKEN, owner=TASK_SHORT_ID),
                    config=config,
                )
                self.assertNotEqual(result.returncode, 0)
                self.assertNotIn("write", ops(result, "checkpoint"))

    def test_later_session_inventory_recovers_exactly_one_candidate(self) -> None:
        later_session = "00000000-0000-4000-8000-000000009999"
        config = default_config(session_id=later_session)
