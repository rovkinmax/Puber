@dataclass
class Outcome:
    returncode: int
    stdout: str
    stderr: str
    calls: list[dict[str, Any]]
    checkpoint: dict[str, Any]



def tagged_blocks(text: str) -> dict[str, str]:
    blocks: dict[str, str] = {}
    for match in re.finditer(r"```bash(?:[ \t]+[^\n]+)?\n(.*?)```", text, re.S):
        body = match.group(1)
        tag = re.search(r"(?m)^[ \t]*# smoke-lease-case: ([a-z0-9-]+)\s*$", body)
        if tag:
            name = tag.group(1)
            if name in blocks:
                raise AssertionError(f"Duplicate source example tag: {name}")
            blocks[name] = body
    return blocks


def protected_build_install_auth(text: str) -> bytes:
    start = text.index(LEASE_STOP)
    suffix = text[start:]
    release = re.search(r"(?m)^9\.", suffix)
    if not release:
        raise AssertionError("Could not locate the Smoke release section boundary")
    return suffix[: release.start()].encode()


def locked_status(owner: str, resource: str) -> str:
    return (
        "locked\n"
        f"  task_id={owner}\n"
        f"  resource={resource}\n"
        "  token=<redacted>\n"
    )


def checkpoint_for(
    *, resource: str = "", token: str = "", owner: str = "", native_id: str = NATIVE_ID,
    short_id: str = TASK_SHORT_ID,
) -> dict[str, Any]:
    stage: dict[str, str] = {}
    if native_id:
        stage["task_native_id"] = native_id
    if short_id:
        stage["task_short_id"] = short_id
    if owner:
        stage["lease_owner_id"] = owner
    if resource:
        stage["lock_resource"] = resource
    if token:
        stage["lock_token"] = token
    return {
        "schema_version": 1,
        "task_short_id": short_id,
        "stage": "smoke",
        "workspace_path": "/synthetic/smoke-lease-workspace",
        "completed": ["identity verified"],
        "remaining": ["Smoke target"],
        "mutation_ledger": [{"action": "none", "scope": "synthetic"}],
        "next_action": "Reconcile the synthetic lease",
        "updated_at": "2026-10-13T00:00:00+00:00",
        "stage_data": stage,
    }


def default_config(
    *, eligible: list[str] | None = None, selected: str = RESOURCE,
    session_id: str = SESSION_ID, native_task: dict[str, Any] | None = None,
) -> dict[str, Any]:
    return {
        "eligible_resources": list(eligible or RESOURCES),
        "selected_resource": selected,
        "token": TOKEN,
        "session_id": session_id,
        "native_task": native_task or json.loads((FIXTURES / "native-task.json").read_text()),
        "device_properties": {
            RESOURCE: {
                "ro.build.characteristics": "tv",
                "ro.product.model": "Android TV",
                "ro.product.name": "google_tv",
            },
            RESOURCES[1]: {
                "ro.build.characteristics": "tv",
                "ro.product.model": "Android TV",
                "ro.product.name": "google_tv",
            },
        },
        "statuses": {},
        "outputs": {},
        "checkpoint_write_fail": False,
    }


def install_stubs(
    sandbox: Path, config: dict[str, Any], checkpoint: dict[str, Any],
    *, production_components: bool = False,
) -> tuple[Path, Path, Path]:
    bin_dir = sandbox / "bin"
    adapter = sandbox / ".kent/adapters/mobile/emulator-resource-lock.sh"
    checkpoint_tool = sandbox / ".kent/scripts/workflow-checkpoint"
    bin_dir.mkdir(parents=True)
    adapter.parent.mkdir(parents=True)
    checkpoint_tool.parent.mkdir(parents=True)
    (sandbox / "home").mkdir()
    if production_components:
        (sandbox / ".gitignore").write_text("/.kent/runtime/\n", encoding="utf-8")
        subprocess.run(
            ["git", "init", "--quiet", str(sandbox)],
            check=True, capture_output=True, text=True,
        )
        shutil.copy2(ADAPTER_SOURCE, adapter)
        shutil.copy2(CHECKPOINT_SOURCE, checkpoint_tool)
        adapter.chmod(0o755)
        checkpoint_tool.chmod(0o755)
    trace = sandbox / "trace.jsonl"
    config_path = sandbox / "config.json"
    checkpoint_path = (
        sandbox / ".kent/runtime" / checkpoint["task_short_id"] / "smoke-checkpoint.json"
        if production_components else sandbox / "checkpoint.json"
    )
    config_path.write_text(json.dumps(config), encoding="utf-8")
    if production_components:
        initial_write = subprocess.run(
            [
                str(checkpoint_tool), "write", "--stage", "smoke",
                "--task", checkpoint["task_short_id"], "--workspace", str(sandbox),
            ],
            input=json.dumps(checkpoint), cwd=sandbox, capture_output=True, text=True,
        )
        if initial_write.returncode != 0:
            raise AssertionError(f"production checkpoint initialization failed: {initial_write.stderr}")
        if TOKEN in initial_write.stdout + initial_write.stderr:
            raise AssertionError("production checkpoint initialization exposed a lease token")
    else:
        adapter.write_text(ADAPTER_STUB, encoding="utf-8")
        adapter.chmod(0o755)
        checkpoint_tool.write_text(CHECKPOINT_STUB, encoding="utf-8")
        checkpoint_tool.chmod(0o755)
        checkpoint_path.write_text(json.dumps(checkpoint), encoding="utf-8")
    (bin_dir / "kent").write_text(KENT_STUB, encoding="utf-8")
    (bin_dir / "kent").chmod(0o755)
    adb = bin_dir / "adb"
    adb.write_text(ADB_STUB if production_components else (
        "#!/bin/sh\n"
        "printf '{\"kind\":\"adb\"}\\n' >>\"$SMOKE_LEASE_TRACE\"\n"
        "echo 'unexpected adb command in synthetic procedure test' >&2\n"
        "exit 96\n"
    ), encoding="utf-8")
    adb.chmod(0o755)
    jq = shutil.which("jq")
    if not jq:
        raise RuntimeError("jq is required for the source examples")
    (bin_dir / "jq").symlink_to(jq)
    return trace, config_path, checkpoint_path


def scenario_environment(
    sandbox: Path, trace: Path, config_path: Path, checkpoint_path: Path,
    *, short_id: str,
) -> dict[str, str]:
    env = os.environ.copy()
    env.update({
        "PATH": f"{sandbox / 'bin'}:{os.environ.get('PATH', '')}",
        "HOME": str(sandbox / "home"),
        "KENT_RESOURCE_LOCK_DIR": str(sandbox / "resource-locks"),
        "SMOKE_TASK_SHORT_ID": short_id,
        "SMOKE_LEASE_TRACE": str(trace),
        "SMOKE_LEASE_CONFIG": str(config_path),
        "SMOKE_LEASE_CHECKPOINT": str(checkpoint_path),
        "KENT_TASK_ID": "untrusted-env-value",
        "KENT_SESSION_ID": "untrusted-env-value",
        "ANDROID_SERIAL": "",
    })
    return env


def execute_scenario(
    sandbox: Path, trace: Path, config_path: Path, checkpoint_path: Path,
    blocks: dict[str, str], *, cases: list[str], short_id: str = TASK_SHORT_ID,
    prelude: str = "", epilogue: str = "",
    disable_exit_trap: bool = True,
) -> Outcome:
    if any(name not in blocks for name in cases):
        raise AssertionError("A requested source-bound lease example is missing")
    trace.write_text("", encoding="utf-8")
    body_parts = [
        blocks["identity"], blocks["release"], prelude,
        *(blocks[name] for name in cases if name not in {"identity", "release"}),
    ]
    if disable_exit_trap:
        body_parts.append("trap - EXIT")
    body_parts.append(epilogue)
    body = "\n".join(body_parts)
    env = scenario_environment(sandbox, trace, config_path, checkpoint_path, short_id=short_id)
    result = subprocess.run(
        ["bash", "-euo", "pipefail", "-c", body],
        cwd=sandbox, env=env, capture_output=True, text=True, timeout=15,
    )
    calls = [json.loads(line) for line in trace.read_text().splitlines()] if trace.exists() else []
    saved = json.loads(checkpoint_path.read_text())
    return Outcome(result.returncode, result.stdout, result.stderr, calls, saved)


def run_scenario(
    blocks: dict[str, str], *, cases: list[str],
    checkpoint: dict[str, Any] | None = None,
    config: dict[str, Any] | None = None,
    prelude: str = "", epilogue: str = "",
    short_id: str = TASK_SHORT_ID,
    disable_exit_trap: bool = True,
) -> Outcome:
    with tempfile.TemporaryDirectory(prefix="puber-smoke-lease-") as temp:
        sandbox = Path(temp)
        scenario_config = config or default_config()
        initial_checkpoint = checkpoint or checkpoint_for(resource=RESOURCE, token=TOKEN, owner=TASK_SHORT_ID)
        trace, config_path, checkpoint_path = install_stubs(sandbox, scenario_config, initial_checkpoint)
        return execute_scenario(
            sandbox, trace, config_path, checkpoint_path, blocks, cases=cases,
            short_id=short_id, prelude=prelude, epilogue=epilogue,
            disable_exit_trap=disable_exit_trap,
        )


def ops(outcome: Outcome, kind: str | None = None) -> list[str]:
    return [
        str(call["op"])
        for call in outcome.calls
        if kind is None or call.get("kind") == kind
    ]


def assert_order(test: unittest.TestCase, outcome: Outcome, *wanted: tuple[str, str]) -> None:
    positions = []
    for kind, operation in wanted:
        position = next(
            (index for index, call in enumerate(outcome.calls)
             if call.get("kind") == kind and call.get("op") == operation),
            None,
        )
        test.assertIsNotNone(position, f"missing {kind}/{operation} operation")
        positions.append(int(position))
    test.assertEqual(positions, sorted(positions), "lease procedure operation order changed")


def assert_persisted(test: unittest.TestCase, outcome: Outcome, *, owner: str, resource: str, token: str, state: str = "held") -> None:
    stage = outcome.checkpoint.get("stage_data", {})
    test.assertEqual(outcome.checkpoint.get("task_short_id"), TASK_SHORT_ID)
    test.assertEqual(stage.get("task_native_id"), NATIVE_ID)
    test.assertEqual(stage.get("task_short_id"), TASK_SHORT_ID)
    test.assertEqual(stage.get("lease_owner_id"), owner)
    test.assertEqual(stage.get("lock_resource"), resource)
    test.assertEqual(stage.get("lock_token"), token)
    if state:
        test.assertEqual(stage.get("lease_state"), state)


class SmokeLeaseProcedureTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls) -> None:
        cls.text = SOURCE.read_text(encoding="utf-8")
        cls.baseline = json.loads((FIXTURES / "baseline.json").read_text(encoding="utf-8"))
        cls.fixture = json.loads((FIXTURES / "eligible-resources.json").read_text(encoding="utf-8"))
        cls.blocks = tagged_blocks(cls.text)
        cls.required = {"identity", "resume", "recovery", "acquire", "release", "explicit-release"}

    def test_source_contract_and_protected_package_policy(self) -> None:
        normalized_text = " ".join(self.text.lower().split())
        missing = self.required - self.blocks.keys()
        self.assertFalse(missing, f"missing source-bound examples: {sorted(missing)}")
        self.assertIn("kent task show", self.text)
        self.assertIn("kent session-id", self.text)
        self.assertIn("summary.id", self.text)
        self.assertIn("summary.short_id", self.text)
        self.assertIn("resume-owned", self.text)
        self.assertIn("lease_owner_id", self.text)
        self.assertIn("task_native_id", self.text)
        self.assertIn("strictly greater", normalized_text)
        self.assertIn("equality", normalized_text)
        self.assertIn("resume-first refreshes; replacement-first", normalized_text)
        self.assertIn("separately approved", normalized_text)
        self.assertIn("source-qualified together", normalized_text)
        self.assertIn("historical source-level prohibition", normalized_text)
        self.assertIn("does not prove that a live tv is available", normalized_text)
        self.assertNotIn("smoke lease/device execution is blocked until", normalized_text)
        self.assertNotIn("stop before lease status/acquisition", normalized_text)
        self.assertNotIn("adoption gate in evidence safety applies", normalized_text)
        self.assertIn("persist_lease_or_exit", self.blocks["identity"])
        for case in ("resume", "acquire"):
            self.assertLess(
                self.blocks[case].index("trap on_smoke_exit EXIT"),
                self.blocks[case].index("persist_lease_or_exit"),
                f"{case} must arm cleanup before checkpoint persistence",
            )
        self.assertEqual(
            self.blocks["recovery"].count("trap on_smoke_exit EXIT"),
            self.blocks["recovery"].count("persist_lease_or_exit"),
            "each recovery route must arm cleanup before its persistence attempt",
        )
        self.assertEqual(
            hashlib.sha256(protected_build_install_auth(self.text)).hexdigest(),
            self.baseline["protected_build_install_auth_sha256"],
            "build/install/auth policy changed outside the approved lease sections",
        )

    def test_native_identity_is_read_back_and_environment_values_replaced(self) -> None:
        result = run_scenario(self.blocks, cases=["identity"])
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(ops(result, "adapter"), [])
        self.assertEqual(ops(result, "kent"), ["task", "session-id"])
        self.assertFalse(any(call.get("kind") == "adb" for call in result.calls))

        mismatched = default_config(native_task={"summary": {"id": NATIVE_ID, "short_id": "PUB-84"}})
        rejected = run_scenario(self.blocks, cases=["identity"], config=mismatched)
        self.assertNotEqual(rejected.returncode, 0)
        self.assertEqual(ops(rejected, "adapter"), [])

    def test_retained_pair_resumes_exact_owner_resource_token_and_session(self) -> None:
        config = default_config()
        config["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        result = run_scenario(
            self.blocks, cases=["resume"],
            checkpoint=checkpoint_for(resource=RESOURCE, token=TOKEN, owner=TASK_SHORT_ID),
            config=config,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(ops(result, "adapter"), ["status", "resume"])
        resume = next(call for call in result.calls if call.get("op") == "resume")
        self.assertEqual(resume["args"], [RESOURCE, TOKEN])
        self.assertEqual(resume["task"], TASK_SHORT_ID)
        self.assertEqual(resume["session"], SESSION_ID)
        assert_persisted(self, result, owner=TASK_SHORT_ID, resource=RESOURCE, token=TOKEN)
        assert_order(self, result, ("adapter", "status"), ("adapter", "resume"), ("checkpoint", "write"))
        self.assertNotIn(TOKEN, result.stdout + result.stderr)

    def test_native_id_alias_is_verified_and_retained(self) -> None:
        config = default_config(session_id="00000000-0000-4000-8000-000000009999")
        config["statuses"][RESOURCE] = locked_status(NATIVE_ID, RESOURCE)
        result = run_scenario(
            self.blocks, cases=["recovery"],
            checkpoint=checkpoint_for(resource=RESOURCE, owner=NATIVE_ID), config=config,
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(ops(result, "adapter"), ["status", "resume-owned"])
        recovery = next(call for call in result.calls if call.get("op") == "resume-owned")
        self.assertEqual(recovery["task"], NATIVE_ID)
        self.assertEqual(recovery["session"], config["session_id"])
        assert_persisted(self, result, owner=NATIVE_ID, resource=RESOURCE, token=TOKEN)

    def test_partial_checkpoint_lost_stdout_recovers_only_proven_owner(self) -> None:
        config = default_config()
        config["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        success = run_scenario(
            self.blocks, cases=["recovery"],
            checkpoint=checkpoint_for(resource=RESOURCE), config=config,
        )
        self.assertEqual(success.returncode, 0, success.stderr)
        self.assertEqual(ops(success, "adapter"), ["status", "resume-owned"])
        assert_persisted(self, success, owner=TASK_SHORT_ID, resource=RESOURCE, token=TOKEN)
        assert_order(self, success, ("adapter", "resume-owned"), ("checkpoint", "write"))

        for label, status in (
            ("foreign", locked_status("KEN-99", RESOURCE)),
            ("duplicate-owner", locked_status(TASK_SHORT_ID, RESOURCE).replace(
                f"  task_id={TASK_SHORT_ID}\n", f"  task_id={TASK_SHORT_ID}\n  task_id={TASK_SHORT_ID}\n")),
            ("missing-token", f"locked\n  task_id={TASK_SHORT_ID}\n  resource={RESOURCE}\n"),
            ("wrong-resource", locked_status(TASK_SHORT_ID, "emulator-9999")),
            ("unlocked", "unlocked\n"),
        ):
            with self.subTest(status=label):
                blocked_config = default_config()
                blocked_config["statuses"][RESOURCE] = status
                blocked = run_scenario(
                    self.blocks, cases=["recovery"],
                    checkpoint=checkpoint_for(resource=RESOURCE), config=blocked_config,
                )
                self.assertNotEqual(blocked.returncode, 0)
                self.assertNotIn("resume-owned", ops(blocked, "adapter"))

    def test_pub70_returned_token_cannot_prove_unknown_owner(self) -> None:
        config = default_config()
        config["statuses"][RESOURCE] = locked_status("KEN-99", RESOURCE)
        result = run_scenario(
            self.blocks, cases=["recovery"],
            checkpoint=checkpoint_for(resource=RESOURCE), config=config,
        )
        self.assertNotEqual(result.returncode, 0)
        self.assertNotIn("resume-owned", ops(result, "adapter"))
        self.assertEqual(result.checkpoint["stage_data"].get("lock_token", ""), "")
        self.assertNotIn(TOKEN, result.stdout + result.stderr)

    def test_lost_acquire_stdout_is_recovered_by_exact_same_task_inventory(self) -> None:
        config = default_config()
        config["outputs"]["acquire-any"] = {"stdout": "", "code": 0}
        config["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        prelude = (
            "declare -A SEEN_EMULATORS=()\n"
            f'EMULATORS=("{RESOURCE}")\n'
            f'SEEN_EMULATORS["{RESOURCE}"]=1'
        )
        lost = run_scenario(
            self.blocks,
            cases=["acquire"],
            checkpoint=checkpoint_for(),
            config=config,
            prelude=prelude,
        )
        self.assertNotEqual(lost.returncode, 0)
        self.assertEqual(ops(lost, "adapter"), ["acquire-any"])
        self.assertNotIn("write", ops(lost, "checkpoint"))
        self.assertNotIn(TOKEN, lost.stdout + lost.stderr)

        recovered = run_scenario(
            self.blocks,
            cases=["recovery"],
            checkpoint=lost.checkpoint,
            config=config,
        )
        self.assertEqual(recovered.returncode, 0, recovered.stderr)
        self.assertEqual(ops(recovered, "adapter"), [
            "adb-emulators", "status", "status", "resume-owned",
