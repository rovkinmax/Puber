    def test_exit_trap_preserves_smoke_status_only_after_verified_release(self) -> None:
        checkpoint = checkpoint_for(resource=RESOURCE, token=TOKEN, owner=TASK_SHORT_ID)
        unlocked_on_release = default_config()
        unlocked_on_release["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        unlocked_on_release["release_unlocks"] = True
        success = run_scenario(
            self.blocks, cases=["release", "resume"], checkpoint=checkpoint,
            config=unlocked_on_release, epilogue="exit 23", disable_exit_trap=False,
        )
        self.assertEqual(success.returncode, 23)
        self.assertEqual(success.checkpoint["stage_data"]["lease_state"], "released")
        self.assertEqual(ops(success, "adapter"), ["status", "resume", "release", "status"])

        unresolved_config = default_config()
        unresolved_config["statuses"][RESOURCE] = locked_status(TASK_SHORT_ID, RESOURCE)
        unresolved = run_scenario(
            self.blocks, cases=["release", "resume"], checkpoint=checkpoint,
            config=unresolved_config, epilogue="exit 23", disable_exit_trap=False,
        )
        self.assertEqual(unresolved.returncode, 1)
        self.assertEqual(unresolved.checkpoint["stage_data"]["lease_state"], "held")
        self.assertEqual(ops(unresolved, "adapter"), ["status", "resume", "release", "status"])


