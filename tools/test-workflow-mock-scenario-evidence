class RecordingResult(unittest.TextTestResult):
    def __init__(self, *args: object, **kwargs: object) -> None:
        super().__init__(*args, **kwargs)
        self.started: list[unittest.case.TestCase] = []

    def startTest(self, test: unittest.case.TestCase) -> None:
        self.started.append(test)
        super().startTest(test)


def _test_result_map(result: RecordingResult) -> dict[str, str]:
    failed = {test.id() for test, _ in result.failures}
    failed.update(test.id() for test, _ in result.errors)
    skipped = {test.id() for test, _ in result.skipped}
    output: dict[str, str] = {}
    for test in result.started:
        identifier = test.id()
        output[identifier] = (
            "failed" if identifier in failed else "skipped" if identifier in skipped else "passed"
        )
    return output


