    def _install_compile_fixture(self) -> None:
        helper = self.repo.root / ".kent/scripts/workflow-mock-scenario-evidence"
        helper.parent.mkdir(parents=True)
        helper.write_bytes(HELPER_PATH.read_bytes())
        helper.chmod(0o700)
        command = self.repo.root / "gradlew"
        command.write_text(
            "#!/bin/sh\n"
            'test "$#" = 1 && test "$1" = ":app:compileDevDebugKotlin" || exit 7\n'
            "mkdir -p build/kent-workflow\n"
            ": > build/kent-workflow/compile-ran\n"
            "exit 0\n",
            encoding="utf-8",
        )
        command.chmod(0o700)

    def _helper_cli(self, *arguments: str, input_bytes: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
        return subprocess.run(
            [sys.executable, str(HELPER_PATH), *arguments],
            input=input_bytes,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
            check=False,
        )

    def _compile_cli(self, envelope: object) -> dict[str, object]:
        with tempfile.TemporaryDirectory(prefix="pub-84-compile-") as directory:
            tmp = Path(directory).resolve()
            tmp.chmod(0o700)
            result = subprocess.run(
                [str(ROOT / ".kent/scripts/workflow-compile-verify")],
                cwd=self.repo.root,
