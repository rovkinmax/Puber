    run_dir = f"build/kent-workflow/{TASK_SHORT_ID}/focused-{time.time_ns()}"
    return (
        f"{run_dir}/packet.json",
        f"{run_dir}/capture.json",
        f"{run_dir}/junit",
        f"{run_dir}/runner.log",
        f"{run_dir}/execution.json",
    )


def _iter_cases(suite: unittest.TestSuite) -> list[unittest.case.TestCase]:
    output: list[unittest.case.TestCase] = []
    for item in suite:
        if isinstance(item, unittest.TestSuite):
            output.extend(_iter_cases(item))
        else:
            output.append(item)
    return output


def _junit_test_id(identifier: str) -> str:
    classname, method = identifier.rsplit(".", 1)
    return f"{classname}#{method}"


def _prepare_local_sample(suite: unittest.TestSuite) -> dict[str, object]:
    source_digest, entries = evidence.source_delta(ROOT, FIXED_POINT)
    paths = [str(item["path"]) for item in entries if item["state"] == "present"]
    if not paths:
        raise RuntimeError("local source delta unexpectedly empty")
    test_ids = [_junit_test_id(test.id()) for test in _iter_cases(suite)]
    if not test_ids:
        raise RuntimeError("focused suite produced no selected tests")
    packet_path, capture_path, results_dir, log_path, receipt_path = _sample_paths()
    packet = {
        "schema": evidence.PACKET_SCHEMA,
        "task_short_id": TASK_SHORT_ID,
        "work_kind": "feature",
        "baseline": FIXED_POINT,
        "source_delta_sha256": source_digest,
        "behaviors": [
            {
                "id": "mock-scenario-policy-enforcement",
                "source_paths": paths,
                "applicability": "not_applicable",
                "rationale": (
                    "The tooling change has no app behavior; its synthetic "
                    "policy scenarios are the suitable alternative checks."
                ),
                "mock_seam": None,
                "selected_test_ids": test_ids,
                "assertion_paths": ["tools/test-workflow-mock-scenario-evidence"],
                "assertions": [
                    "Malformed, stale, unsafe, failed, skipped, and fresh evidence transitions are distinguished."
                ],
                "harness_ref": "python3 tools/test-workflow-mock-scenario-evidence",
                "result": "pending",
                "alternative_checks": test_ids,
            }
        ],
    }
    packet_file = ROOT / packet_path
    packet_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    packet_file.write_text(
        json.dumps(packet, ensure_ascii=False, sort_keys=True, indent=2) + "\n",
        encoding="utf-8",
    )
    evidence.capture(
        ROOT,
        task=TASK_SHORT_ID,
        work_kind="feature",
        baseline=FIXED_POINT,
        packet_path=packet_path,
        results_dir=results_dir,
        log_path=log_path,
        output_path=capture_path,
    )
    return {
        "source_delta_sha256": source_digest,
        "packet_path": packet_path,
        "capture_path": capture_path,
        "results_dir": results_dir,
        "log_path": log_path,
        "receipt_path": receipt_path,
        "test_ids": test_ids,
        "packet_file": packet_file,
    }


def _write_local_sample(
    result: RecordingResult,
    summary: str,
    prepared: dict[str, object],
) -> dict[str, object]:
    source_digest = prepared["source_delta_sha256"]
    packet_path = str(prepared["packet_path"])
    capture_path = str(prepared["capture_path"])
    results_dir = str(prepared["results_dir"])
    log_path = str(prepared["log_path"])
    receipt_path = str(prepared["receipt_path"])
    packet_file = prepared["packet_file"]
    test_ids = list(prepared["test_ids"])
    result_map = _test_result_map(result)
    observed_ids = [_junit_test_id(identifier) for identifier in result_map]
    if observed_ids != test_ids:
        raise RuntimeError("test selection changed after pre-run source capture")
    results = ROOT / results_dir
    results.mkdir(mode=0o700, parents=True, exist_ok=True)
    suite = ET.Element(
        "testsuite",
        tests=str(len(result_map)),
        failures=str(sum(value == "failed" for value in result_map.values())),
        errors="0",
        skipped=str(sum(value == "skipped" for value in result_map.values())),
    )
    for identifier, outcome in result_map.items():
        module_and_class, method = identifier.rsplit(".", 1)
        case = ET.SubElement(
            suite, "testcase", classname=module_and_class, name=method
        )
        if outcome == "failed":
            ET.SubElement(case, "failure", message="focused test failed")
        elif outcome == "skipped":
            ET.SubElement(case, "skipped", message="focused test skipped")
    (results / "focused-suite.xml").write_bytes(
        ET.tostring(suite, encoding="utf-8", xml_declaration=True)
    )
    log_file = ROOT / log_path
    log_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    log_file.write_text(summary[:16 * 1024] or "focused suite completed\n", encoding="utf-8")
    receipt = evidence.issue_receipt(
        ROOT,
        capture_path=capture_path,
        packet_path=packet_path,
        results_dir=results_dir,
        log_path=log_path,
        output_path=receipt_path,
        exit_code=0 if result.wasSuccessful() else 1,
    )
    output: dict[str, object] = {
        "transition": receipt["completion"],
        "packet": packet_path,
        "execution": receipt_path,
        "source_delta_sha256": source_digest,
        "selected_test_count": len(test_ids),
    }
    if receipt["completion"] == "passed":
        envelope = evidence.serialize_review_context(
            ROOT,
            task=TASK_SHORT_ID,
            work_kind="feature",
            baseline=FIXED_POINT,
            packet_path=packet_path,
            execution_path=receipt_path,
            narrative="Focused synthetic policy/helper scenarios passed.",
        )
        envelope_path = packet_file.parent / "review-context.json"
        envelope_path.write_text(
            json.dumps(envelope, ensure_ascii=False, sort_keys=True, indent=2) + "\n",
            encoding="utf-8",
        )
        output["review_context"] = envelope_path.relative_to(ROOT).as_posix()
    return output


def run_suite() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--historical-audit",
        action="store_true",
        help="also verify preserved local pre-edit RED artifacts (requires ignored audit files)",
    )
    arguments = parser.parse_args()
    stream = io.StringIO()
    suite = unittest.defaultTestLoader.loadTestsFromTestCase(MockScenarioEvidenceTest)
    if arguments.historical_audit:
        suite.addTests(unittest.defaultTestLoader.loadTestsFromTestCase(HistoricalAuditTest))
    runner = unittest.TextTestRunner(
        stream=stream,
        verbosity=2,
        resultclass=RecordingResult,
    )
    prepared = _prepare_local_sample(suite)
    result = runner.run(suite)
    summary = stream.getvalue()
    artifacts = _write_local_sample(result, summary, prepared)
    log_path = ROOT / "build/kent-workflow/PUB-84/focused-suite.log"
    log_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    bounded_summary = (
        "command=python3 tools/test-workflow-mock-scenario-evidence"
        f"{' --historical-audit' if arguments.historical_audit else ''}\n"
        f"result={'passed' if result.wasSuccessful() else 'failed'}\n"
        f"tests_run={result.testsRun}\n"
        f"failure_count={len(result.failures) + len(result.errors)}\n"
        f"sample_transition={artifacts['transition']}\n"
        f"sample_packet={artifacts['packet']}\n"
        f"sample_execution={artifacts['execution']}\n"
    ).encode("utf-8")
    if len(bounded_summary) > 16 * 1024:
        raise RuntimeError("focused suite result log exceeded its bound")
    log_path.write_bytes(bounded_summary)
    print(bounded_summary.decode("utf-8"), end="")
    return 0 if result.wasSuccessful() and artifacts["transition"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(run_suite())
