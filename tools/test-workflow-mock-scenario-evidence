                expected_baseline=self.repo.baseline,
                allow_pending=True,
            )
        packet = self.repo.packet([self.repo.case_id, self.repo.case_id])
        with self.assertRaisesRegex(evidence.EvidenceError, "duplicate"):
            evidence._validate_packet_object(
                self.repo.root,
                packet,
                expected_baseline=self.repo.baseline,
                allow_pending=True,
            )
        with self.assertRaisesRegex(evidence.EvidenceError, "contained relative"):
            evidence._relative_path("../outside.json", "packet")

