def run_git(root: Path, *arguments: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(root), *arguments],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=10,
    )
    return result.stdout.strip()


def digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def manifest_binding_errors(manifest: dict, root: Path) -> list[str]:
    """Task-owned required-pin inventory; the generic builder checks supplied pins."""
    errors = []
    for relative in MANIFEST_BOUND_SOURCES:
        bindings = [
            item for item in manifest["external_roots"]
            if item["kind"] == "source-sha256"
            and item["key"].split("=", 1)[0] == relative
        ]
        if len(bindings) != 1:
            errors.append(f"missing or duplicate task source binding: {relative}")
        elif (
            bindings[0]["key"] != f"{relative}={digest((root / relative).read_bytes())}"
            or bindings[0]["runtime_digest_required"] is not True
        ):
            errors.append(f"task source binding mismatch: {relative}")
    return errors


def junit_xml(test_id: str, outcome: str = "passed") -> bytes:
    classname, name = test_id.split("#", 1)
    suite = ET.Element("testsuite", tests="1", failures="0", errors="0", skipped="0")
    case = ET.SubElement(suite, "testcase", classname=classname, name=name)
    if outcome == "failed":
        ET.SubElement(case, "failure", message="expected assertion failure")
        suite.set("failures", "1")
    elif outcome == "skipped":
        ET.SubElement(case, "skipped", message="disabled test")
        suite.set("skipped", "1")
    return ET.tostring(suite, encoding="utf-8", xml_declaration=True)


class SyntheticRepository:
    def __init__(self) -> None:
        self.temporary = tempfile.TemporaryDirectory(prefix="pub-84-evidence-")
        self.root = Path(self.temporary.name).resolve()
        subprocess.run(
            ["git", "init", "--quiet", str(self.root)],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
        )
        run_git(self.root, "config", "user.name", "PUB-84 synthetic test")
        run_git(self.root, "config", "user.email", "pub-84@example.invalid")
        (self.root / "src").mkdir()
        (self.root / "tests").mkdir()
        (self.root / "src/behavior.py").write_text(
            "def behavior(): return 'before'\n", encoding="utf-8"
        )
        (self.root / "tests/test_behavior.py").write_text(
            "def test_behavior(): assert True\n", encoding="utf-8"
        )
        run_git(self.root, "add", "src/behavior.py", "tests/test_behavior.py")
        run_git(self.root, "commit", "--quiet", "-m", "synthetic baseline")
        self.baseline = run_git(self.root, "rev-parse", "HEAD")
        (self.root / "src/behavior.py").write_text(
            "def behavior(): return 'after'\n", encoding="utf-8"
        )
        (self.root / "tests/test_behavior.py").write_text(
            "def test_behavior(): assert behavior() == 'after'\n",
            encoding="utf-8",
        )
        self.task = "TEST-1"
        self.work_kind = "feature"
        self.case_id = "SyntheticPolicyTest#test_selected_behavior"
        self.relative_dir = "build/kent-workflow/TEST-1"
        self.packet_path = f"{self.relative_dir}/packet.json"
        self.capture_path = f"{self.relative_dir}/capture.json"
        self.results_dir = f"{self.relative_dir}/junit"
        self.log_path = f"{self.relative_dir}/runner.log"
        self.receipt_path = f"{self.relative_dir}/execution.json"

    def close(self) -> None:
        self.temporary.cleanup()

    def packet(self, test_ids: list[str] | None = None) -> dict[str, object]:
        source_digest, delta_entries = evidence.source_delta(self.root, self.baseline)
        changed_paths = [
            item["path"] for item in delta_entries if item["state"] == "present"
        ]
        return {
            "schema": evidence.PACKET_SCHEMA,
            "task_short_id": self.task,
            "work_kind": self.work_kind,
            "baseline": self.baseline,
            "source_delta_sha256": source_digest,
            "behaviors": [
                {
                    "id": "behavior-change",
                    "source_paths": changed_paths,
                    "applicability": "applicable",
                    "rationale": "A user-visible behavior change has a mock-backed seam.",
                    "mock_seam": "synthetic repository fixture",
                    "selected_test_ids": test_ids or [self.case_id],
                    "assertion_paths": ["tests/test_behavior.py"],
                    "assertions": ["The selected scenario observes the changed value."],
                    "harness_ref": "python -m unittest SyntheticPolicyTest",
                    "result": "pending",
                    "alternative_checks": [],
                }
            ],
        }

    def write_packet(self, packet: dict[str, object] | None = None) -> None:
        value = packet or self.packet()
        path = self.root / self.packet_path
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(value, ensure_ascii=False, sort_keys=True, indent=2) + "\n",
            encoding="utf-8",
        )

    def capture(
        self, packet: dict[str, object] | None = None
    ) -> dict[str, object]:
        self.write_packet(packet)
        return evidence.capture(
            self.root,
            task=self.task,
            work_kind=self.work_kind,
            baseline=self.baseline,
            packet_path=self.packet_path,
            results_dir=self.results_dir,
            log_path=self.log_path,
            output_path=self.capture_path,
        )

    def write_run(self, test_id: str | None = None, outcome: str = "passed") -> None:
        result_dir = self.root / self.results_dir
        result_dir.mkdir(parents=True, exist_ok=True)
        (result_dir / "TEST-results.xml").write_bytes(
            junit_xml(test_id or self.case_id, outcome)
        )
        log = self.root / self.log_path
        log.parent.mkdir(parents=True, exist_ok=True)
        log.write_text(f"selected harness completed: {outcome}\n", encoding="utf-8")

    def receipt(self, exit_code: int = 0) -> dict[str, object]:
        return evidence.issue_receipt(
            self.root,
            capture_path=self.capture_path,
            packet_path=self.packet_path,
            results_dir=self.results_dir,
            log_path=self.log_path,
            output_path=self.receipt_path,
            exit_code=exit_code,
        )

    def envelope(self) -> dict[str, object]:
        return evidence.serialize_review_context(
            self.root,
            task=self.task,
            work_kind=self.work_kind,
            baseline=self.baseline,
            packet_path=self.packet_path,
            execution_path=self.receipt_path,
            narrative="Synthetic selected scenarios completed with fresh source-bound output.",
        )


class HistoricalAuditTest(unittest.TestCase):
    """Local audit of preserved RED artifacts, not a clean-checkout requirement."""

    def test_locked_baseline_wrongful_pass_is_preserved(self) -> None:
        report = json.loads(PRE_EDIT_REPORT.read_text(encoding="utf-8"))
        log = PRE_EDIT_LOG.read_bytes()
        self.assertEqual(report["schema"], "mock-scenario-pre-edit-red-v1")
        self.assertEqual(report["task_short_id"], TASK_SHORT_ID)
        self.assertEqual(report["fixed_point"], FIXED_POINT)
        self.assertEqual(report["expected_transition"], "blocked")
        self.assertEqual(report["observed_transition"], "passed")
        self.assertEqual(report["verdict"], "RED")
        self.assertTrue(report["fixed_compile"]["stub"])
        self.assertEqual(report["log_sha256"], digest(log))


class MockScenarioEvidenceTest(unittest.TestCase):
    def setUp(self) -> None:
        self.repo = SyntheticRepository()

    def tearDown(self) -> None:
        self.repo.close()

    def test_duplicate_json_keys_and_unknown_packet_keys_reject(self) -> None:
        with self.assertRaises(evidence.EvidenceError):
            evidence._load_json_bytes(b'{"schema":"x","schema":"y"}', "duplicate")
        with self.assertRaisesRegex(evidence.EvidenceError, "exceeds"):
            evidence._load_json_bytes(
                b" " * (evidence.MAX_JSON_BYTES + 1),
                "oversized packet",
            )
        packet = self.repo.packet()
        packet["unexpected"] = "closed schema rejects this"
        with self.assertRaisesRegex(evidence.EvidenceError, "keys mismatch"):
            evidence._validate_packet_object(
                self.repo.root,
                packet,
                expected_task=self.repo.task,
                expected_work_kind=self.repo.work_kind,
                expected_baseline=self.repo.baseline,
                allow_pending=True,
            )
        packet = self.repo.packet()
        packet["schema"] = "mock-scenario-evidence-v0"
        with self.assertRaisesRegex(evidence.EvidenceError, "unsupported"):
            evidence._validate_packet_object(
                self.repo.root,
                packet,
                expected_baseline=self.repo.baseline,
                allow_pending=True,
            )

    def test_unsupported_kind_duplicate_ids_and_escape_reject(self) -> None:
        packet = self.repo.packet()
        packet["work_kind"] = "unsupported"
        with self.assertRaisesRegex(evidence.EvidenceError, "unsupported work_kind"):
            evidence._validate_packet_object(
                self.repo.root,
                packet,
                expected_baseline=self.repo.baseline,
                allow_pending=True,
            )
        packet = self.repo.packet()
        packet["behaviors"][0]["applicability"] = "unknown"
        with self.assertRaisesRegex(evidence.EvidenceError, "invalid applicability"):
            evidence._validate_packet_object(
                self.repo.root,
                packet,
                expected_baseline=self.repo.baseline,
                allow_pending=True,
            )
        packet = self.repo.packet()
        packet["behaviors"][0]["result"] = "not_run"
        with self.assertRaisesRegex(evidence.EvidenceError, "must be pending"):
            evidence._validate_packet_object(
                self.repo.root,
