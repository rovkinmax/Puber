    def test_cli_commands_round_trip_source_bound_evidence(self) -> None:
        self.repo.write_packet()
        common = [
            "--workspace",
            str(self.repo.root),
            "--task",
            self.repo.task,
            "--work-kind",
            self.repo.work_kind,
            "--baseline",
            self.repo.baseline,
            "--packet",
            self.repo.packet_path,
        ]

        def invoke(*arguments: str, input_bytes: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
            return subprocess.run(
                ["python3", str(HELPER_PATH), *arguments],
                input=input_bytes,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=10,
                check=False,
            )

        validated = invoke("validate-packet", *common)
        self.assertEqual(validated.returncode, 0, validated.stderr.decode())
        self.assertEqual(json.loads(validated.stdout)["transition"], "passed")

        capture = invoke(
            "capture",
            *common,
            "--results-dir",
            self.repo.results_dir,
            "--log",
            self.repo.log_path,
            "--output",
            self.repo.capture_path,
        )
        self.assertEqual(capture.returncode, 0, capture.stderr.decode())
        self.assertEqual(json.loads(capture.stdout)["transition"], "passed")
        self.repo.write_run()

        receipt = invoke(
            "receipt",
            "--workspace",
            str(self.repo.root),
            "--capture",
            self.repo.capture_path,
            "--packet",
            self.repo.packet_path,
            "--results-dir",
            self.repo.results_dir,
            "--log",
            self.repo.log_path,
            "--exit-code",
            "0",
            "--output",
            self.repo.receipt_path,
        )
        self.assertEqual(receipt.returncode, 0, receipt.stderr.decode())
        self.assertEqual(json.loads(receipt.stdout)["transition"], "passed")

        envelope = invoke(
            "serialize-envelope",
            *common,
            "--execution",
            self.repo.receipt_path,
            "--narrative",
            "CLI-generated evidence is fresh, source-bound, and passing.",
        )
        self.assertEqual(envelope.returncode, 0, envelope.stderr.decode())
        envelope_bytes = envelope.stdout
        checked = invoke(
            "validate-envelope",
            "--workspace",
            str(self.repo.root),
            "--task",
            self.repo.task,
            "--work-kind",
            self.repo.work_kind,
            input_bytes=envelope_bytes,
        )
        self.assertEqual(checked.returncode, 0, checked.stderr.decode())
        self.assertEqual(json.loads(checked.stdout), json.loads(envelope_bytes))

