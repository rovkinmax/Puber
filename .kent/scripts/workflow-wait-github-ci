#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import importlib.util
import importlib.machinery
from functools import partial
import json
import os
from pathlib import Path
import sys
import stat
import time
import tomllib
from typing import Any

sys.dont_write_bytecode = True


class _TechnicalFailure(RuntimeError):
    """A post-observation effect or capture failure that must not be retried."""


class _LocalProviderRetryBlocked(RuntimeError):
    """A locally captured provider constraint blocks another process."""

    code = "query_failed"

    def __init__(self, state: str) -> None:
        self.state = state if state in {"not_before", "unknown"} else "unknown"
        super().__init__("github_provider_retry_blocked")


def _sibling(name: str) -> Any:
    path = Path(__file__).with_name(name)
    if path.is_symlink() or not path.is_file():
        raise RuntimeError("{} support module is unsafe".format(name))
    spec = importlib.util.spec_from_file_location(
        "kent_{}".format(name.replace(".", "_")),
        path,
        loader=importlib.machinery.SourceFileLoader("kent_{}".format(name.replace(".", "_")), str(path)),
    )
    if spec is None or spec.loader is None:
        raise RuntimeError("{} support module is unavailable".format(name))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def runtime_contracts() -> Any:
    return _sibling("workflow_runtime_contracts.py")


def github_observation() -> Any:
    return _sibling("workflow_github_observation.py")


def _text(payload: dict[str, object], key: str) -> str:
    value = payload.get(key)
    if not isinstance(value, str) or not value.strip():
        raise ValueError("{} must be a non-empty string".format(key))
    return value.strip()


def _delivery_protocol_profile_enabled(workspace: Path) -> bool:
    directory_flags = (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    descriptors: list[int] = []
    try:
        root_fd = os.open(workspace, directory_flags)
        descriptors.append(root_fd)
        kent_fd = os.open(".kent", directory_flags, dir_fd=root_fd)
        descriptors.append(kent_fd)
        profile_fd = os.open(
            "workflow-profile.toml",
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0),
            dir_fd=kent_fd,
        )
        with os.fdopen(profile_fd, "rb") as stream:
            before = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_nlink != 1
                or before.st_uid != os.getuid()
                or before.st_mode & 0o7022
                or before.st_size > 64 * 1024
            ):
                raise ValueError("unsafe current delivery profile")
            raw = stream.read(64 * 1024 + 1)
            after = os.fstat(stream.fileno())
            if (
                len(raw) > 64 * 1024
                or len(raw) != before.st_size
                or (before.st_dev, before.st_ino, before.st_size,
                    before.st_mtime_ns, before.st_ctime_ns)
                != (after.st_dev, after.st_ino, after.st_size,
                    after.st_mtime_ns, after.st_ctime_ns)
            ):
                raise ValueError("current delivery profile changed during read")
    except FileNotFoundError:
        return False
    except OSError as error:
        raise ValueError("current delivery profile is unavailable") from error
    finally:
        for descriptor in reversed(descriptors):
            os.close(descriptor)
    try:
        profile = tomllib.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise ValueError("current delivery profile is invalid") from error
    policies = profile.get("policies", {})
    versions = profile.get("command_versions", {})
    return bool(
        isinstance(policies, dict)
        and policies.get("delivery_reliability") == "v1"
    ) or bool(
        isinstance(versions, dict)
        and (
            versions.get("runtime_contracts") in {"2.1.0", "2.2.0"}
            or versions.get("prepare_ci") in {"3.0.0", "3.1.0"}
        )
    )


def _current_delivery_protocol(
    workspace: Path,
    payload: dict[str, object],
) -> dict[str, object] | None:
    if not _delivery_protocol_profile_enabled(workspace):
        return None
    checkpoint = _sibling("workflow-checkpoint")
    task = payload.get("task_short_id")
    if task is not None and not isinstance(task, str):
        raise ValueError("task_short_id is invalid")
    result = checkpoint.current_script_delivery_protocol(
        workspace,
        task=task,
        native_context=payload.get("_kent"),
    )
    if result is None:
        return None
    if result["node_key"] != "ci_watch":
        raise ValueError("native Script is not the current CI watcher")
    if result["target_required"]:
        target = payload.get("pr_base_branch")
        if not isinstance(target, str) or not target or target != target.strip():
            raise ValueError("pr_base_branch is required by the current graph")
    return result


def _canonical(runtime: Any, value: object) -> str:
    return runtime.canonical_bytes(value).decode("utf-8")


def _retry_delay_seconds(
    error: Exception,
    *,
    interval: int,
    failure_count: int,
) -> int:
    delay = getattr(error, "retry_delay_seconds", None)
    if not callable(delay):
        return interval
    return max(
        interval,
        int(delay(interval=interval, failure_count=failure_count)),
    )


def _contract(runtime: Any, payload: dict[str, object]) -> tuple[dict[str, Any], str]:
    raw = payload.get("ci_contract")
    if not isinstance(raw, str) or not raw:
        raise ValueError("ci_contract is required")
    value = runtime.parse_canonical_json(
        raw,
        label="ci_contract",
        max_bytes=runtime.MAX_CI_REPORT_BYTES,
    )
    contract = runtime.validate_ci_contract(value)
    return contract, _canonical(runtime, contract)


def _report(
    runtime: Any,
    payload: dict[str, object],
    contract: dict[str, Any],
) -> dict[str, Any] | None:
    raw = payload.get("ci_report")
    if raw in (None, ""):
        return None
    if not isinstance(raw, str):
        raise ValueError("ci_report must be canonical JSON")
    report = runtime.validate_dynamic_ci_report(
        runtime.parse_canonical_json(
            raw,
            label="ci_report",
            max_bytes=runtime.MAX_DYNAMIC_CI_REPORT_BYTES,
        )
    )
    if report["contract"] != contract:
        raise ValueError("ci_report contract does not match ci_contract")
    return report


def _cursor(runtime: Any, payload: dict[str, object]) -> tuple[object, str | None]:
    if "pr_feedback_cursor" not in payload:
        return "uninitialized", None
    raw = payload["pr_feedback_cursor"]
    if raw != "uninitialized" and not isinstance(raw, (str, dict)):
        raise ValueError("pr_feedback_cursor is invalid")
    value = runtime.validate_dynamic_pr_feedback_cursor(raw)
    return (
        value,
        value if value == "uninitialized" else _canonical(runtime, value),
    )


def _error(runtime: Any, error: Exception) -> dict[str, str]:
    allowed = {
        "invalid_observation",
        "source_changed",
        "query_failed",
        "query_timeout",
        "incomplete_observation",
        "observation_limit",
    }
    code = str(getattr(error, "code", "") or "")
    if code not in allowed:
        code = "invalid_observation"
    empty = hashlib.sha256(b"").hexdigest()
    return {
        "code": code,
        "message": str(getattr(error, "code", None) or code),
        "stdout_sha256": str(getattr(error, "stdout_sha256", empty)),
        "stderr_sha256": str(getattr(error, "stderr_sha256", empty)),
    }


def _append(
    runtime: Any,
    contract: dict[str, Any],
    previous: dict[str, Any] | None,
    *,
    head_oid: str,
    base_oid: str,
    classification: dict[str, Any] | None = None,
    error: Exception | None = None,
    watcher_exit_code: int | None = None,
) -> dict[str, Any]:
    sequence = (
        previous["attempts"][-1]["sequence"] + 1
        if previous is not None
        else 1
    )
    if error is not None:
        reason = _error(runtime, error)["code"]
        checks: list[dict[str, Any]] = []
        check_count = 0
        checks_sha256 = runtime.canonical_sha256([])
        diagnostic = _error(runtime, error)
    else:
        assert classification is not None
        checks = list(classification["checks"])
        check_count = int(classification["check_count"])
        checks_sha256 = classification["checks_sha256"]
        reason = str(classification["state"])
        diagnostic = None
        if reason == "invalid_observation":
            diagnostic = {
                "code": "invalid_observation",
                "message": str(
                    (classification.get("diagnostic") or {}).get(
                        "message",
                        "the effective check observation is invalid",
                    )
                ),
                "stdout_sha256": hashlib.sha256(b"").hexdigest(),
                "stderr_sha256": hashlib.sha256(b"").hexdigest(),
            }
    attempt = {
        "sequence": sequence,
        "head_oid": head_oid,
        "base_oid": base_oid,
        "retry": None,
        "checks": checks,
        "check_count": check_count,
        "checks_sha256": checks_sha256,
        "reason": reason,
        "watcher_exit_code": watcher_exit_code,
        "error": diagnostic,
    }
    if previous is None:
        return runtime.build_dynamic_ci_report(
            contract=contract,
            attempts=[attempt],
        )
    return runtime.append_dynamic_ci_report(previous, attempt)


def _archive(
    observation: Any,
    values: dict[str, object],
    report: dict[str, Any],
    *,
    typed_script_archive: bool = False,
    native_context: object = None,
) -> None:
    task = values.get("task_short_id")
    if not isinstance(task, str) or not task:
        return
    try:
        tool = os.environ.get("KENT_PREPARE_GITHUB_CI_BIN")
        if not tool:
            tool = str(Path.home() / ".kent/bin/kent-prepare-github-ci")
        request = {
            **values,
            "operation": (
                "archive_script_ci_report"
                if typed_script_archive
                else "archive_ci_report"
            ),
            "ci_report": _canonical(runtime_contracts(), report),
        }
        if isinstance(native_context, dict):
            request["_kent"] = native_context
        result = observation.read_json(
            tool,
            Path(str(values["workspace_path"])),
            [],
            timeout=60,
            input_bytes=json.dumps(
                request,
                ensure_ascii=False,
                sort_keys=True,
            ).encode("utf-8"),
        )
        if (
            not isinstance(result, dict)
            or (
                set(result) != {"ci_report_artifact"}
                if typed_script_archive
                else "ci_report_artifact" not in result
            )
            or not isinstance(result.get("ci_report_artifact"), str)
        ):
            raise _TechnicalFailure("ci_report_archive_failed")
        task = values.get("task_short_id")
        if typed_script_archive and (
            not isinstance(task, str)
            or result["ci_report_artifact"]
            != (
                f".kent/runtime/{task}/ci-report-"
                f"{runtime_contracts().canonical_sha256(report)}.json"
            )
        ):
            raise _TechnicalFailure("ci_report_archive_failed")
    except _TechnicalFailure:
        raise
    except Exception as error:
        raise _TechnicalFailure("ci_report_archive_failed") from error


def _merge_report(pr: dict[str, Any]) -> str:
    return json.dumps(
        {
            "state": pr.get("state"),
            "mergedAt": pr.get("mergedAt"),
            "mergeCommit": pr.get("mergeCommit"),
            "headRefName": pr.get("headRefName"),
            "headRefOid": pr.get("headRefOid"),
            "baseRefName": pr.get("baseRefName"),
            "baseRefOid": pr.get("baseRefOid"),
            "url": pr.get("url"),
        },
        ensure_ascii=False,
        sort_keys=True,
    )


def _emit(
    transition: str,
    values: dict[str, object],
    *,
    report: dict[str, Any] | None = None,
    cursor: str | None = None,
    producer_payload: dict[str, object] | None = None,
    github_retry_constraint: str | None = None,
) -> None:
    result = dict(values)
    if report is not None:
        result["ci_report"] = _canonical(runtime_contracts(), report)
    if cursor is not None:
        result["pr_feedback_cursor"] = cursor
    encoded = (json.dumps(
        {"transition": transition, **result},
        ensure_ascii=False,
        sort_keys=True,
    ) + "\n").encode("utf-8")
    root = Path.cwd().resolve()
    profile_path = root / ".kent/workflow-profile.toml"
    profile = tomllib.loads(profile_path.read_text()) if profile_path.is_file() else {}
    if profile.get("policies", {}).get("delivery_reliability") is not None:
        checkpoint = _sibling("workflow-checkpoint")
        if github_retry_constraint is None:
            encoded = checkpoint.emit_producer_result(
                root, producer_payload, encoded, "wait-ci")
        else:
            encoded = checkpoint.emit_producer_result(
                root,
                producer_payload,
                encoded,
                "wait-ci",
                github_retry_constraint=github_retry_constraint,
            )
    sys.stdout.buffer.write(encoded)


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        raise ValueError("stdin is not valid JSON: {}".format(error))
    if not isinstance(payload, dict):
        raise ValueError("stdin must be one JSON object")
    pending_constraint: str | None = None
    producer_emit = partial(_emit, producer_payload=payload)

    def emit(*args: Any, **kwargs: Any) -> None:
        try:
            if pending_constraint is not None:
                kwargs.setdefault(
                    "github_retry_constraint",
                    pending_constraint,
                )
            producer_emit(*args, **kwargs)
        except Exception as error:
            raise _TechnicalFailure("producer_capture_failed") from error

    workspace = Path(_text(payload, "workspace_path")).expanduser().resolve()
    pr_url = _text(payload, "pr_url")
    branch_name = _text(payload, "branch_name")
    merge_strategy = _text(payload, "merge_strategy")
    expected_base_branch = payload.get("pr_base_branch")
    if expected_base_branch is not None and (
        not isinstance(expected_base_branch, str)
        or not expected_base_branch
        or expected_base_branch != expected_base_branch.strip()
        or expected_base_branch.startswith("-")
    ):
        raise ValueError("pr_base_branch is invalid")
    if not workspace.is_dir():
        raise ValueError("workspace does not exist: {}".format(workspace))
    if merge_strategy not in {"merge", "squash", "rebase"}:
        raise ValueError("unsupported merge_strategy: {!r}".format(merge_strategy))

    runtime = runtime_contracts()
    observation = github_observation()
    contract, contract_text = _contract(runtime, payload)
    previous = _report(runtime, payload, contract)
    acknowledged, acknowledged_text = _cursor(runtime, payload)
    repository, pull_number = observation.parse_pr_url(pr_url)
    if (
        repository != contract["repository"]
        or pull_number != contract["pull_number"]
    ):
        raise ValueError("ci_contract does not identify pr_url")
    values: dict[str, object] = {
        "workspace_path": str(workspace),
        "pr_url": pr_url,
        "branch_name": branch_name,
        "merge_strategy": merge_strategy,
        "ci_contract": contract_text,
    }
    if expected_base_branch is not None:
        values["pr_base_branch"] = expected_base_branch
    if previous is not None:
        values["ci_report"] = _canonical(runtime, previous)
    if "task_short_id" in payload:
        values["task_short_id"] = _text(payload, "task_short_id")
    delivery_protocol = _current_delivery_protocol(workspace, payload)
    typed_script_archive = bool(
        delivery_protocol is not None
        and delivery_protocol.get("protocol") == "typed-v1"
    )
    native_context = payload.get("_kent")
    checkpoint = None
    provider_guard = None
    provider_identity = None
    if delivery_protocol is not None:
        checkpoint = _sibling("workflow-checkpoint")
        provider_identity = delivery_protocol.get("identity")
        if not isinstance(provider_identity, dict):
            raise ValueError("native delivery identity is unavailable")

        def provider_guard() -> None:
            checkpoint.require_github_provider_read(
                workspace,
                payload,
                provider_identity,
            )
            if pending_constraint is not None:
                constraint = runtime.parse_canonical_json(
                    pending_constraint,
                    label="GitHub provider retry constraint",
                    max_bytes=1024,
                )
                state = runtime.evaluate_github_retry_constraint(
                    constraint,
                    now_unix_ms=time.time_ns() // 1_000_000,
                )
                if state != "clear":
                    raise _LocalProviderRetryBlocked(state)

    def archive_report(report: dict[str, Any]) -> None:
        _archive(
            observation,
            values,
            report,
            typed_script_archive=typed_script_archive,
            native_context=native_context,
        )

    test_mode = os.environ.get("KENT_CI_WATCH_TEST_MODE") == "1"
    interval = max(
        0 if test_mode else 30,
        int(os.environ.get("KENT_CI_WATCH_INTERVAL_SECONDS", "30")),
    )
    max_polls = max(0, int(os.environ.get("KENT_CI_WATCH_MAX_POLLS", "120")))
    max_errors = max(1, int(os.environ.get("KENT_CI_WATCH_MAX_ERRORS", "5")))
    timeout = max(
        1,
        int(os.environ.get("KENT_CI_WATCH_QUERY_TIMEOUT_SECONDS", "60")),
    )
    gh_bin = os.environ.get("KENT_GH_BIN")
    errors = 0
    polls = 0
    while True:
        polls += 1
        try:
            watcher = observation.GitHubObserver(
                workspace,
                gh_bin=gh_bin,
                timeout=timeout,
                provider_guard=provider_guard,
            )
            observed = watcher.observe_pr(pr_url)
            pr = observed["pr"]
            head_oid = str(pr["headRefOid"])
            base_oid = str(pr["baseRefOid"])
            if (
                expected_base_branch is not None
                and pr.get("baseRefName") != expected_base_branch
            ):
                emit(
                    "ci_watch_state_changed",
                    {
                        **values,
                        "pr_report": json.dumps(
                            {
                                "reason": "pr_base_branch_changed",
                                "expected_pr_base_branch": expected_base_branch,
                                "observed_base_ref_name": pr.get("baseRefName"),
                                "state": pr.get("state"),
                                "headRefOid": head_oid,
                                "baseRefOid": base_oid,
                            },
                            ensure_ascii=False,
                            sort_keys=True,
                        ),
                        "pr_head_oid": head_oid,
                        "pr_base_oid": base_oid,
                    },
                    cursor=acknowledged_text,
                )
                return 0
            if pr.get("headRefName") != branch_name:
                raise observation.ObservationError("invalid_observation")
            if pr["state"] == "MERGED":
                emit(
                    "ci_watch_pr_merged",
                    {
                        "workspace_path": values["workspace_path"],
                        "pr_url": values["pr_url"],
                        "branch_name": values["branch_name"],
                        **(
                            {"pr_base_branch": expected_base_branch}
                            if expected_base_branch is not None
                            else {}
                        ),
                        "merge_report": _merge_report(pr),
                    },
                )
                return 0
            if pr["state"] == "CLOSED":
                if (
                    head_oid != contract["head_oid"]
                    or base_oid != contract["base_oid"]
                ):
                    raise _TechnicalFailure(
                        "closed_pull_request_identity_changed"
                    )
                report = _append(
                    runtime,
                    contract,
                    previous,
                    head_oid=head_oid,
                    base_oid=base_oid,
                    classification=runtime.classify_github_checks(
                        [],
                        require_ci=contract["require_ci"],
                    ),
                )
                emit(
                    "ci_watch_state_changed",
                    {
                        **values,
                        "pr_report": json.dumps(
                            {
                                "reason": "pull_request_closed_without_merge",
                                "state": pr.get("state"),
                                "headRefOid": head_oid,
                                "baseRefOid": base_oid,
                            },
                            ensure_ascii=False,
                            sort_keys=True,
                        ),
                        "pr_head_oid": head_oid,
                        "pr_base_oid": base_oid,
                    },
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if (
                head_oid != contract["head_oid"]
                or base_oid != contract["base_oid"]
            ):
                emit(
                    "ci_watch_source_changed",
                    values,
                    cursor=acknowledged_text,
                )
                return 0

            classification = runtime.classify_github_checks(
                observed["checks"],
                require_ci=contract["require_ci"],
            )
            if classification["state"] in {
                "invalid_observation",
                "observation_limit",
            }:
                report = _append(
                    runtime,
                    contract,
                    previous,
                    head_oid=head_oid,
                    base_oid=base_oid,
                    classification=classification,
                )
                archive_report(report)
                emit(
                    "ci_watch_failed",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            current = runtime.make_dynamic_pr_feedback_cursor(
                repository=repository,
                pull_number=pull_number,
                items=observed["feedback_items"],
                review_decision=str(pr.get("reviewDecision") or ""),
                checks=classification["checks"],
            )
            delta = runtime.diff_dynamic_pr_feedback_cursor(
                acknowledged,
                current,
            )
            report = _append(
                runtime,
                contract,
                previous,
                head_oid=head_oid,
                base_oid=base_oid,
                classification=classification,
            )
            previous = report
            conflict = (
                str(pr.get("mergeStateStatus") or "").upper()
                in {"DIRTY", "CONFLICTING"}
                or str(pr.get("mergeable") or "").upper() == "CONFLICTING"
            )
            feedback_changed = (
                delta["transition"] == "state_changed"
                and not (
                    acknowledged == "uninitialized"
                    and not observed["feedback_items"]
                    and current.get("review_decision") in {"", "APPROVED"}
                )
            )
            if conflict or feedback_changed:
                observed_text = (
                    _canonical(runtime, current)
                    if feedback_changed
                    else None
                )
                reason = (
                    "merge_conflict"
                    if conflict
                    else (
                        "pull_request_feedback_refresh_required"
                        if delta.get("needs_refresh")
                        else "pull_request_feedback_changed"
                    )
                )
                archive_report(report)
                report_values = {
                    **values,
                    "pr_report": json.dumps(
                        {
                            "reason": reason,
                            "state": pr.get("state"),
                            "headRefOid": head_oid,
                            "baseRefOid": base_oid,
                            "mergeStateStatus": pr.get("mergeStateStatus"),
                            "checks": classification.get("checks", []),
                            **(
                                {"observed_feedback_cursor": observed_text}
                                if observed_text is not None
                                else {}
                            ),
                        },
                        ensure_ascii=False,
                        sort_keys=True,
                    ),
                    "pr_head_oid": head_oid,
                    "pr_base_oid": base_oid,
                }
                emit(
                    "ci_watch_state_changed",
                    report_values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if classification["state"] == "failed":
                archive_report(report)
                emit(
                    "ci_watch_failed",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if classification["state"] in {"green", "not_required"}:
                archive_report(report)
                emit(
                    "ci_watch_passed",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if test_mode and max_polls and polls >= max_polls:
                emit(
                    "ci_watch_still_waiting",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            errors = 0
            time.sleep(interval)
        except _TechnicalFailure:
            raise
        except Exception as error:
            if isinstance(error, _LocalProviderRetryBlocked) or (
                checkpoint is not None
                and checkpoint.is_github_provider_read_blocked(error)
            ):
                # A guard refusal happens before a provider process starts.
                # Preserve the exact incoming report; do not fabricate an
                # observation attempt or archive a report for a query that
                # never happened.
                emit(
                    "ci_watch_failed",
                    values,
                    cursor=acknowledged_text,
                )
                return 0
            errors += 1
            if str(getattr(error, "code", "") or "") == "source_changed":
                emit(
                    "ci_watch_source_changed",
                    values,
                    cursor=acknowledged_text,
                )
                return 0
            captured_constraint = observation.provider_retry_constraint(
                error,
                interval=interval,
                failure_count=errors,
            )
            if captured_constraint is not None:
                current_constraints = []
                if pending_constraint is not None:
                    current_constraints.append(
                        runtime.parse_canonical_json(
                            pending_constraint,
                            label="GitHub provider retry constraint",
                            max_bytes=1024,
                        )
                    )
                current_constraints.append(
                    runtime.parse_canonical_json(
                        captured_constraint,
                        label="GitHub provider retry constraint",
                        max_bytes=1024,
                    )
                )
                merged = runtime.merge_github_retry_constraints(
                    current_constraints,
                )
                pending_constraint = _canonical(runtime, merged)
            if (
                errors < max_errors
                and not getattr(error, "provider_retry_unknown", False)
            ):
                time.sleep(
                    _retry_delay_seconds(
                        error,
                        interval=interval,
                        failure_count=errors,
                    )
                )
                continue
            report = _append(
                runtime,
                contract,
                previous,
                head_oid=contract["head_oid"],
                base_oid=contract["base_oid"],
                error=error,
                watcher_exit_code=getattr(error, "exit_code", None),
            )
            archive_report(report)
            emit(
                "ci_watch_failed",
                values,
                report=report,
                cursor=acknowledged_text,
            )
            return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print("workflow-wait-github-ci: {}".format(error), file=sys.stderr)
        raise SystemExit(1)
