#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import importlib.util
import json
import os
from pathlib import Path
import sys
import time
from typing import Any

sys.dont_write_bytecode = True


def _sibling(name: str) -> Any:
    path = Path(__file__).with_name(name)
    if path.is_symlink() or not path.is_file():
        raise RuntimeError("{} support module is unsafe".format(name))
    spec = importlib.util.spec_from_file_location(
        "kent_{}".format(name.replace(".", "_")),
        path,
    )
    if spec is None or spec.loader is None:
        raise RuntimeError("{} support module is unavailable".format(name))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def runtime_contracts() -> Any:
    return _sibling("workflow_runtime_contracts.py")


def github_observation() -> Any:
    return _sibling("workflow_github_observation.py")


def _text(payload: dict[str, object], key: str) -> str:
    value = payload.get(key)
    if not isinstance(value, str) or not value.strip():
        raise ValueError("{} must be a non-empty string".format(key))
    return value.strip()


def _canonical(runtime: Any, value: object) -> str:
    return runtime.canonical_bytes(value).decode("utf-8")


def _contract(runtime: Any, payload: dict[str, object]) -> tuple[dict[str, Any], str]:
    raw = payload.get("ci_contract")
    if not isinstance(raw, str) or not raw:
        raise ValueError("ci_contract is required")
    value = runtime.parse_canonical_json(
        raw,
        label="ci_contract",
        max_bytes=runtime.MAX_CI_REPORT_BYTES,
    )
    contract = runtime.validate_ci_contract(value)
    return contract, _canonical(runtime, contract)


def _report(
    runtime: Any,
    payload: dict[str, object],
    contract: dict[str, Any],
) -> dict[str, Any] | None:
    raw = payload.get("ci_report")
    if raw in (None, ""):
        return None
    if not isinstance(raw, str):
        raise ValueError("ci_report must be canonical JSON")
    report = runtime.validate_dynamic_ci_report(
        runtime.parse_canonical_json(
            raw,
            label="ci_report",
            max_bytes=runtime.MAX_DYNAMIC_CI_REPORT_BYTES,
        )
    )
    if report["contract"] != contract:
        raise ValueError("ci_report contract does not match ci_contract")
    return report


def _cursor(runtime: Any, payload: dict[str, object]) -> tuple[object, str | None]:
    if "pr_feedback_cursor" not in payload:
        return "uninitialized", None
    raw = payload["pr_feedback_cursor"]
    if raw != "uninitialized" and not isinstance(raw, (str, dict)):
        raise ValueError("pr_feedback_cursor is invalid")
    value = runtime.validate_dynamic_pr_feedback_cursor(raw)
    return (
        value,
        value if value == "uninitialized" else _canonical(runtime, value),
    )


def _error(runtime: Any, error: Exception) -> dict[str, str]:
    allowed = {
        "invalid_observation",
        "source_changed",
        "query_failed",
        "query_timeout",
        "incomplete_observation",
        "observation_limit",
    }
    code = str(getattr(error, "code", "") or "")
    if code not in allowed:
        code = "invalid_observation"
    empty = hashlib.sha256(b"").hexdigest()
    return {
        "code": code,
        "message": str(getattr(error, "code", None) or code),
        "stdout_sha256": str(getattr(error, "stdout_sha256", empty)),
        "stderr_sha256": str(getattr(error, "stderr_sha256", empty)),
    }


def _append(
    runtime: Any,
    contract: dict[str, Any],
    previous: dict[str, Any] | None,
    *,
    head_oid: str,
    base_oid: str,
    classification: dict[str, Any] | None = None,
    error: Exception | None = None,
    watcher_exit_code: int | None = None,
) -> dict[str, Any]:
    sequence = (
        previous["attempts"][-1]["sequence"] + 1
        if previous is not None
        else 1
    )
    if error is not None:
        reason = _error(runtime, error)["code"]
        checks: list[dict[str, Any]] = []
        check_count = 0
        checks_sha256 = runtime.canonical_sha256([])
        diagnostic = _error(runtime, error)
    else:
        assert classification is not None
        checks = list(classification["checks"])
        check_count = int(classification["check_count"])
        checks_sha256 = classification["checks_sha256"]
        reason = str(classification["state"])
        diagnostic = None
        if reason == "invalid_observation":
            diagnostic = {
                "code": "invalid_observation",
                "message": str(
                    (classification.get("diagnostic") or {}).get(
                        "message",
                        "the effective check observation is invalid",
                    )
                ),
                "stdout_sha256": hashlib.sha256(b"").hexdigest(),
                "stderr_sha256": hashlib.sha256(b"").hexdigest(),
            }
    attempt = {
        "sequence": sequence,
        "head_oid": head_oid,
        "base_oid": base_oid,
        "retry": None,
        "checks": checks,
        "check_count": check_count,
        "checks_sha256": checks_sha256,
        "reason": reason,
        "watcher_exit_code": watcher_exit_code,
        "error": diagnostic,
    }
    if previous is None:
        return runtime.build_dynamic_ci_report(
            contract=contract,
            attempts=[attempt],
        )
    return runtime.append_dynamic_ci_report(previous, attempt)


def _archive(
    observation: Any,
    values: dict[str, object],
    report: dict[str, Any],
) -> None:
    task = values.get("task_short_id")
    if not isinstance(task, str) or not task:
        return
    tool = os.environ.get("KENT_PREPARE_GITHUB_CI_BIN")
    if not tool:
        tool = str(Path.home() / ".kent/bin/kent-prepare-github-ci")
    request = {
        **values,
        "operation": "archive_ci_report",
        "ci_report": _canonical(runtime_contracts(), report),
    }
    result = observation.read_json(
        tool,
        Path(str(values["workspace_path"])),
        [],
        timeout=60,
        input_bytes=json.dumps(
            request,
            ensure_ascii=False,
            sort_keys=True,
        ).encode("utf-8"),
    )
    if not isinstance(result, dict) or not isinstance(
        result.get("ci_report_artifact"),
        str,
    ):
        raise RuntimeError("ci_report_archive_failed")


def _merge_report(pr: dict[str, Any]) -> str:
    return json.dumps(
        {
            "state": pr.get("state"),
            "mergedAt": pr.get("mergedAt"),
            "mergeCommit": pr.get("mergeCommit"),
            "headRefName": pr.get("headRefName"),
            "headRefOid": pr.get("headRefOid"),
            "baseRefName": pr.get("baseRefName"),
            "baseRefOid": pr.get("baseRefOid"),
            "url": pr.get("url"),
        },
        ensure_ascii=False,
        sort_keys=True,
    )


def _emit(
    transition: str,
    values: dict[str, object],
    *,
    report: dict[str, Any] | None = None,
    cursor: str | None = None,
) -> None:
    result = dict(values)
    if report is not None:
        result["ci_report"] = _canonical(runtime_contracts(), report)
    if cursor is not None:
        result["pr_feedback_cursor"] = cursor
    print(json.dumps(
        {"transition": transition, **result},
        ensure_ascii=False,
        sort_keys=True,
    ))


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        raise ValueError("stdin is not valid JSON: {}".format(error))
    if not isinstance(payload, dict):
        raise ValueError("stdin must be one JSON object")

    workspace = Path(_text(payload, "workspace_path")).expanduser().resolve()
    pr_url = _text(payload, "pr_url")
    branch_name = _text(payload, "branch_name")
    merge_strategy = _text(payload, "merge_strategy")
    if not workspace.is_dir():
        raise ValueError("workspace does not exist: {}".format(workspace))
    if merge_strategy not in {"merge", "squash", "rebase"}:
        raise ValueError("unsupported merge_strategy: {!r}".format(merge_strategy))

    runtime = runtime_contracts()
    observation = github_observation()
    contract, contract_text = _contract(runtime, payload)
    previous = _report(runtime, payload, contract)
    acknowledged, acknowledged_text = _cursor(runtime, payload)
    repository, pull_number = observation.parse_pr_url(pr_url)
    if (
        repository != contract["repository"]
        or pull_number != contract["pull_number"]
    ):
        raise ValueError("ci_contract does not identify pr_url")
    values: dict[str, object] = {
        "workspace_path": str(workspace),
        "pr_url": pr_url,
        "branch_name": branch_name,
        "merge_strategy": merge_strategy,
        "ci_contract": contract_text,
    }
    if previous is not None:
        values["ci_report"] = _canonical(runtime, previous)
    if "task_short_id" in payload:
        values["task_short_id"] = _text(payload, "task_short_id")

    test_mode = os.environ.get("KENT_CI_WATCH_TEST_MODE") == "1"
    interval = max(
        0 if test_mode else 30,
        int(os.environ.get("KENT_CI_WATCH_INTERVAL_SECONDS", "30")),
    )
    max_polls = max(0, int(os.environ.get("KENT_CI_WATCH_MAX_POLLS", "120")))
    max_errors = max(1, int(os.environ.get("KENT_CI_WATCH_MAX_ERRORS", "5")))
    timeout = max(
        1,
        int(os.environ.get("KENT_CI_WATCH_QUERY_TIMEOUT_SECONDS", "60")),
    )
    gh_bin = os.environ.get("KENT_GH_BIN")
    errors = 0
    polls = 0
    while True:
        polls += 1
        try:
            watcher = observation.GitHubObserver(
                workspace,
                gh_bin=gh_bin,
                timeout=timeout,
            )
            observed = watcher.observe_pr(pr_url)
            errors = 0
            pr = observed["pr"]
            head_oid = str(pr["headRefOid"])
            base_oid = str(pr["baseRefOid"])
            if pr["state"] == "MERGED":
                _emit(
                    "ci_watch_pr_merged",
                    {**values, "merge_report": _merge_report(pr)},
                )
                return 0
            if pr["state"] == "CLOSED":
                report = _append(
                    runtime,
                    contract,
                    previous,
                    head_oid=head_oid,
                    base_oid=base_oid,
                    classification=runtime.classify_github_checks(
                        [],
                        require_ci=contract["require_ci"],
                    ),
                )
                _emit(
                    "ci_watch_state_changed",
                    {
                        **values,
                        "pr_report": json.dumps(
                            {
                                "reason": "pull_request_closed_without_merge",
                                "state": pr.get("state"),
                                "headRefOid": head_oid,
                                "baseRefOid": base_oid,
                            },
                            ensure_ascii=False,
                            sort_keys=True,
                        ),
                        "pr_head_oid": head_oid,
                        "pr_base_oid": base_oid,
                    },
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if (
                head_oid != contract["head_oid"]
                or base_oid != contract["base_oid"]
            ):
                _emit(
                    "ci_watch_source_changed",
                    values,
                    cursor=acknowledged_text,
                )
                return 0

            current = runtime.make_dynamic_pr_feedback_cursor(
                repository=repository,
                pull_number=pull_number,
                items=observed["feedback_items"],
                review_decision=str(pr.get("reviewDecision") or ""),
                checks=observed["checks"],
            )
            delta = runtime.diff_dynamic_pr_feedback_cursor(
                acknowledged,
                current,
            )
            classification = runtime.classify_github_checks(
                observed["checks"],
                require_ci=contract["require_ci"],
            )
            report = _append(
                runtime,
                contract,
                previous,
                head_oid=head_oid,
                base_oid=base_oid,
                classification=classification,
            )
            previous = report
            conflict = (
                str(pr.get("mergeStateStatus") or "").upper()
                in {"DIRTY", "CONFLICTING"}
                or str(pr.get("mergeable") or "").upper() == "CONFLICTING"
            )
            feedback_changed = (
                delta["transition"] == "state_changed"
                and not (
                    acknowledged == "uninitialized"
                    and not observed["feedback_items"]
                    and current.get("review_decision") in {"", "APPROVED"}
                )
            )
            if conflict or feedback_changed:
                observed_text = (
                    _canonical(runtime, current)
                    if feedback_changed
                    else None
                )
                reason = (
                    "merge_conflict"
                    if conflict
                    else (
                        "pull_request_feedback_refresh_required"
                        if delta.get("needs_refresh")
                        else "pull_request_feedback_changed"
                    )
                )
                _archive(observation, values, report)
                report_values = {
                    **values,
                    "pr_report": json.dumps(
                        {
                            "reason": reason,
                            "state": pr.get("state"),
                            "headRefOid": head_oid,
                            "baseRefOid": base_oid,
                            "mergeStateStatus": pr.get("mergeStateStatus"),
                            "checks": classification.get("checks", []),
                            **(
                                {"observed_feedback_cursor": observed_text}
                                if observed_text is not None
                                else {}
                            ),
                        },
                        ensure_ascii=False,
                        sort_keys=True,
                    ),
                    "pr_head_oid": head_oid,
                    "pr_base_oid": base_oid,
                }
                if observed_text is not None:
                    report_values["observed_feedback_cursor"] = observed_text
                _emit(
                    "ci_watch_state_changed",
                    report_values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if classification["state"] == "failed":
                _archive(observation, values, report)
                _emit(
                    "ci_watch_failed",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if classification["state"] in {
                "invalid_observation",
                "observation_limit",
            }:
                _archive(observation, values, report)
                _emit(
                    "ci_watch_failed",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if classification["state"] in {"green", "not_required"}:
                _archive(observation, values, report)
                _emit(
                    "ci_watch_passed",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            if test_mode and max_polls and polls >= max_polls:
                _emit(
                    "ci_watch_still_waiting",
                    values,
                    report=report,
                    cursor=acknowledged_text,
                )
                return 0
            time.sleep(interval)
        except Exception as error:
            errors += 1
            if str(getattr(error, "code", "") or "") == "source_changed":
                _emit(
                    "ci_watch_source_changed",
                    values,
                    cursor=acknowledged_text,
                )
                return 0
            if errors < max_errors:
                time.sleep(interval)
                continue
            report = _append(
                runtime,
                contract,
                previous,
                head_oid=contract["head_oid"],
                base_oid=contract["base_oid"],
                error=error,
                watcher_exit_code=getattr(error, "exit_code", None),
            )
            _archive(observation, values, report)
            _emit(
                "ci_watch_failed",
                values,
                report=report,
                cursor=acknowledged_text,
            )
            return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print("workflow-wait-github-ci: {}".format(error), file=sys.stderr)
        raise SystemExit(1)
