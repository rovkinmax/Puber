class ContractError(ValueError):
    pass


class GitHubProviderReadBlocked(ContractError):
    """A qualified provider guard denied a GitHub read."""

    def __init__(self, state: str) -> None:
        if state not in {"not_before", "unknown"}:
            raise ContractError("GitHub provider retry state is invalid")
        self.state = state
        super().__init__(f"GitHub provider retry is blocked: {state}")


class GitHubProviderRequestError(ContractError):
    """Provider command failed without trusted retry timing metadata."""

    github_retry_constraint = (
        '{"kind":"unknown","provider_host":"github.com",'
        '"schema":"github-provider-retry-v1"}'
    )


_ACTIVE_GITHUB_PROVIDER_CONTEXT: dict[str, Any] | None = None
_QUALIFIED_KIT_RUNTIME: Any | None = None
_QUALIFIED_PROJECT_ROOT: Path | None = None
_QUALIFIED_CHECKPOINT_MODULE: Any | None = None
_KIT_MODULES_CACHE: dict[str, Any] | None = None


def _reset_runtime_invocation() -> None:
    """Forget runtime authority only when a new native invocation begins."""
    global _ACTIVE_GITHUB_PROVIDER_CONTEXT
    global _QUALIFIED_KIT_RUNTIME, _QUALIFIED_PROJECT_ROOT
    global _QUALIFIED_CHECKPOINT_MODULE, _KIT_MODULES_CACHE
    _ACTIVE_GITHUB_PROVIDER_CONTEXT = None
    _QUALIFIED_KIT_RUNTIME = None
    _QUALIFIED_PROJECT_ROOT = None
    _QUALIFIED_CHECKPOINT_MODULE = None
    _KIT_MODULES_CACHE = None


def _json_one(raw: bytes) -> dict[str, Any]:
    if not raw or len(raw) > 8 * 1024 * 1024:
        raise ContractError("stdin must contain exactly one bounded JSON object")
    try:
        def pairs(items):
            result = {}
            for key, item in items:
                if key in result:
                    raise ContractError("duplicate JSON field")
                result[key] = item
            return result
        def constant(_):
            raise ContractError("non-finite JSON value")
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=pairs, parse_constant=constant)
        def depth(item, level=0):
            if isinstance(item, float) and not math.isfinite(item):
                raise ContractError("non-finite JSON value")
            if level > 32:
                raise ContractError("JSON nesting exceeds bound")
            if isinstance(item, dict):
                for child in item.values(): depth(child, level + 1)
            elif isinstance(item, list):
                for child in item: depth(child, level + 1)
        depth(value)
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise ContractError(f"invalid JSON input: {error}") from error
    if not isinstance(value, dict):
        raise ContractError("stdin must contain one JSON object")
    return value

def read_zero_argument() -> dict[str, Any]:
    return _json_one(sys.stdin.buffer.read())

def require_string(value: Any, label: str, *, empty: bool = False) -> str:
    if not isinstance(value, str) or (not empty and not value.strip()):
        raise ContractError(f"{label} must be a non-empty string")
    return value if empty else value.strip()

def sha256_bytes(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()

def canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False).encode("utf-8")

def canonical_json(value: Any) -> str:
    return canonical_bytes(value).decode("utf-8")

def digest_json(value: Any) -> str:
    return sha256_bytes(canonical_bytes(value))

def parse_closed_json(raw: Any, schema: str, keys: set[str]) -> dict[str, Any]:
    if not isinstance(raw, str) or len(raw.encode("utf-8")) > 2 * 1024 * 1024:
        raise ContractError(f"{schema} must be a bounded JSON string")
    value = _json_one(raw.encode("utf-8"))
    if set(value) != keys or value.get("schema") != schema:
        raise ContractError(f"{schema} has an incomplete, extra, or stale field set")
    return value

def _safe_task_short_id(value: Any) -> str:
    value = require_string(value, "task_short_id")
    if not TASK_SHORT_ID.fullmatch(value):
        raise ContractError("task_short_id is not safe")
    return value

def safe_version_tag(version: Any, tag: Any) -> tuple[str, str]:
    version = require_string(version, "release_version")
    tag = require_string(tag, "release_tag")
    if not SEMVER.fullmatch(version) or not TAG.fullmatch(tag) or tag != f"v{version}":
        raise ContractError("release version/tag is not exact")
    return version, tag

def safe_release_branch(value: Any, version: str) -> str:
    branch = require_string(value, "branch_name")
    if not RELEASE_BRANCH.fullmatch(branch) or branch != f"release/{version}":
        raise ContractError("release branch is not exact")
    return branch

def child_env() -> dict[str, str]:
    env = dict(os.environ)
    for key in ("KENT_SESSION_ID", "KENT_RUN_ID", "KENT_STEP_ID"):
        env.pop(key, None)
    return env

def run(command: list[str], *, cwd: Path, env: Mapping[str, str] | None = None, check: bool = True, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, cwd=cwd, env=dict(env) if env is not None else None, input=input_text, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if check and result.returncode != 0:
        raise ContractError(result.stderr.strip() or result.stdout.strip() or f"command failed: {' '.join(command)}")
    return result

def run_bytes(command: list[str], *, cwd: Path, env: Mapping[str, str] | None = None, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    result = subprocess.run(command, cwd=cwd, env=dict(env) if env is not None else None, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if check and result.returncode != 0:
        message = result.stderr.decode("utf-8", "replace").strip() or result.stdout.decode("utf-8", "replace").strip()
        raise ContractError(message or f"command failed: {' '.join(command)}")
    return result

def git(root: Path, *args: str, check: bool = True) -> str:
    return run(["git", *args], cwd=root, check=check).stdout.strip()

def _node_id(root: Path, node_key: str) -> str:
    graph = json.loads((root / GRAPH_PATH).read_text(encoding="utf-8"))
    for node in graph.get("nodes", []):
        if node.get("key") == node_key:
            return require_string(node.get("id"), "graph node id")
    raise ContractError(f"graph node missing: {node_key}")

def graph_edge(root: Path, branch: str, node_key: str) -> dict[str, Any]:
    graph = json.loads((root / GRAPH_PATH).read_text(encoding="utf-8"))
    node_id = _node_id(root, node_key)
    matches = [edge for edge in graph.get("edges", []) if edge.get("key") == branch and edge.get("target_node_id") == node_id]
    if len(matches) != 1 or matches[0].get("workflow_id") != WORKFLOW_ID:
        raise ContractError(f"incoming transition is not an exact graph edge: {branch}")
    return matches[0]

def _kent_bin(root: Path) -> str:
    candidate = os.environ.get("PUBER_KENT_BIN", "") or shutil.which("kent") or str(Path.home() / ".kent/bin/kent")
    if not Path(candidate).is_file() or not os.access(candidate, os.X_OK):
        raise ContractError("stock Kent executable is unavailable")
    return candidate


def _provider_native_read(
    root: Path,
    arguments: list[str],
    *,
    structured: bool = True,
) -> Any:
    if root != ROOT:
        raise ContractError("provider identity workspace mismatch")
    try:
        result = subprocess.run(
            [_kent_bin(root), *arguments],
            cwd=root,
            env=child_env(),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ContractError("provider identity read failed") from error
    if result.returncode != 0 or len(result.stdout) > 8 * 1024 * 1024:
        raise ContractError("provider identity read failed")
    if not structured:
        try:
            return result.stdout.decode("utf-8").strip()
        except UnicodeDecodeError as error:
            raise ContractError("provider identity read is not UTF-8") from error
    return _json_one(result.stdout)


def _qualified_delivery_module(
    root: Path,
    *,
    required: tuple[str, ...] = (
        "producer_locator",
        "observe_script_identity",
        "require_github_provider_read",
        "GitHubProviderRetryBlocked",
    ),
) -> Any:
    """Resolve delivery through the invocation's one qualified Kit facade."""
    checkpoint = _qualified_checkpoint_module(
        root,
        required=("qualified_kit_runtime", "kit_module", "delivery_module"),
    )
    qualified = _require_qualified_runtime(root)
    try:
        delivery = checkpoint.delivery_module(
            project_root=root,
            qualified=qualified,
        )
        if any(not hasattr(delivery, name) for name in required):
            raise ContractError("qualified workflow delivery API is unavailable")
        if "GitHubProviderRetryBlocked" in required and (
            not isinstance(delivery.GitHubProviderRetryBlocked, type)
            or not issubclass(
                delivery.GitHubProviderRetryBlocked,
                BaseException,
            )
        ):
            raise ContractError("qualified GitHub provider block type is invalid")
        return delivery
    except ContractError:
        raise
    except Exception as error:
        raise ContractError("qualified GitHub provider API cannot load") from error


def _qualified_checkpoint_module(
    root: Path,
    *,
    required: tuple[str, ...] = (),
) -> Any:
    """Load the installed checkpoint adapter through its fixed project path."""
    global _QUALIFIED_CHECKPOINT_MODULE, _QUALIFIED_PROJECT_ROOT
    if _QUALIFIED_CHECKPOINT_MODULE is not None:
        if _QUALIFIED_PROJECT_ROOT != root:
            raise ContractError("qualified checkpoint belongs to another project")
        if any(
            not hasattr(_QUALIFIED_CHECKPOINT_MODULE, name)
            for name in required
        ):
            raise ContractError("qualified native Agent identity API is unavailable")
        return _QUALIFIED_CHECKPOINT_MODULE
    path = root / ".kent/scripts/workflow-checkpoint"
    try:
        metadata = path.lstat()
    except OSError as error:
        raise ContractError("qualified workflow checkpoint adapter is unavailable") from error
    if (
        not stat.S_ISREG(metadata.st_mode)
        or path.is_symlink()
        or metadata.st_uid != os.getuid()
        or metadata.st_mode & 0o022
    ):
        raise ContractError("qualified workflow checkpoint adapter is unsafe")
    try:
        loader = importlib.machinery.SourceFileLoader(
            "puber_workflow_checkpoint_native",
            str(path),
        )
        spec = importlib.util.spec_from_loader(loader.name, loader)
        if spec is None:
            raise ContractError("qualified workflow checkpoint adapter cannot load")
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        if any(not hasattr(module, name) for name in required):
            raise ContractError("qualified native Agent identity API is unavailable")
        _QUALIFIED_CHECKPOINT_MODULE = module
        _QUALIFIED_PROJECT_ROOT = root
        return module
    except ContractError:
        raise
    except (
        AttributeError,
        ImportError,
        OSError,
        RuntimeError,
        SyntaxError,
        TypeError,
        ValueError,
    ) as error:
        raise ContractError("qualified native Agent identity API cannot load") from error


def _require_qualified_runtime(root: Path) -> Any:
    qualified = _QUALIFIED_KIT_RUNTIME
    if (
        qualified is None
        or _QUALIFIED_PROJECT_ROOT != root
        or getattr(qualified, "native_authorized", False) is not True
        or getattr(qualified, "project_root", None) != root
    ):
        raise ContractError("native qualified Kit runtime is unavailable")
    return qualified


def _bind_qualified_runtime(
    root: Path,
    source_binding: Mapping[str, Any] | None,
) -> Any:
    """Qualify this native Script/Agent before any selected Kit import."""
    global _QUALIFIED_KIT_RUNTIME, _QUALIFIED_PROJECT_ROOT, _KIT_MODULES_CACHE
    if source_binding is not None and (
        not isinstance(source_binding, Mapping)
        or set(source_binding) != KENT_KEYS
        or any(
            not isinstance(value, str) or not value.strip()
            for value in source_binding.values()
        )
    ):
        raise ContractError("native Kit binding context is invalid")
    checkpoint = _qualified_checkpoint_module(
        root,
        required=("qualified_kit_runtime", "kit_module", "delivery_module"),
    )
    loader = getattr(checkpoint, "qualified_kit_runtime", None)
    if not callable(loader):
        raise ContractError("native Kit runtime qualification facade is unavailable")
    try:
        qualified = loader(
            project_root=root,
            source_binding=(
                dict(source_binding) if source_binding is not None else None
            ),
        )
    except Exception as error:
        raise ContractError("native Kit runtime qualification failed") from error
    if (
        qualified is None
        or getattr(qualified, "native_authorized", False) is not True
        or getattr(qualified, "project_root", None) != root
    ):
        raise ContractError("native Kit runtime qualification returned no authority")
    _QUALIFIED_KIT_RUNTIME = qualified
    _QUALIFIED_PROJECT_ROOT = root
    _KIT_MODULES_CACHE = None
    return qualified


def producer_refs_from_commentary(
    root: Path,
    commentary: object,
) -> list[str]:
    """Parse only the exact qualified producer footer; malformed is not legacy."""
    if commentary is None:
        return []
    if not isinstance(commentary, str):
        raise ContractError("native producer commentary is invalid")
    if "KENT_PACKET_SOURCE_V1" not in commentary:
        return []
    delivery = _qualified_delivery_module(
        root,
        required=("producer_locator",),
    )
    try:
        locator = delivery.producer_locator(commentary)
    except (TypeError, ValueError, UnicodeError):
        raise ContractError("native producer commentary is malformed") from None
    if not isinstance(locator, str) or not locator:
        raise ContractError("native producer footer has no source locator")
    return [locator]


def capture_script_output(
    root: Path,
    payload: Mapping[str, Any],
    result: Mapping[str, Any],
    *,
    producer_kind: str,
    producer_refs: list[str],
    github_retry_constraint: str | None = None,
) -> bytes | None:
    """Capture a string-only native Script result through the selected Kit API."""
    if not producer_refs and github_retry_constraint is None:
        return None
    if (
        not isinstance(payload, Mapping)
        or any(not isinstance(value, str) for value in result.values())
    ):
        return None
    metadata = payload.get("_kent")
    if not isinstance(metadata, dict):
        raise ContractError("producer capture requires the actual native Script context")
    delivery = _qualified_delivery_module(
        root,
        required=("capture_script_producer", "packet_json"),
    )
    try:
        binding = {
            "producer_refs": delivery.packet_json(
                {"refs": producer_refs}
            ).decode("utf-8")
        }
        _locator, emitted = delivery.capture_script_producer(
            root,
            task=None,
            native_context=dict(metadata),
            producer_kind=producer_kind,
            inputs={
                key: value
                for key, value in payload.items()
                if isinstance(key, str) and isinstance(value, str)
            },
            result=dict(result),
            native_read=_provider_native_read,
            binding=binding,
            github_retry_constraint=github_retry_constraint,
        )
    except Exception as error:
        raise ContractError("qualified Script producer capture failed") from error
    if not isinstance(emitted, bytes) or not emitted:
        raise ContractError("qualified Script producer capture returned no bytes")
    return emitted


def emit_script_transition(
    root: Path,
    payload: Mapping[str, Any],
    transition: str,
    target: str,
    fields: Mapping[str, Any],
    *,
    producer_kind: str,
    commentary: str | None = None,
    provider_error: BaseException | None = None,
) -> None:
    """Emit a route while retaining authenticated provider ancestry when possible."""
    refs = producer_refs_from_commentary(root, payload.get("commentary"))
    constraint = (
        provider_retry_constraint_from_error(root, provider_error)
        if provider_error is not None
        else None
    )
    output = render_exact(
        root,
        transition,
        target,
        fields,
        commentary=commentary,
    )
    emitted = capture_script_output(
        root,
        payload,
        output,
        producer_kind=producer_kind,
        producer_refs=refs,
        github_retry_constraint=constraint,
    )
    if emitted is not None:
        sys.stdout.buffer.write(emitted)
        return
    if constraint is not None:
        raise ContractError(
            "provider retry failure cannot be represented by the exact native route"
        )
    if refs:
        raise ContractError(
            "qualified Script producer ancestry cannot be represented by the exact native route"
        )
    print(json.dumps(output, ensure_ascii=False, sort_keys=True))


def _admit_first_script_ingress(
    root: Path,
    native_context: Mapping[str, Any],
) -> None:
    """Require the qualified native source receipt on the initial release Script."""
    try:
        delivery = _qualified_delivery_module(
            root,
            required=("admit_script_source_ingress",),
        )
        admission = delivery.admit_script_source_ingress(
            root,
            dict(native_context),
            kent_path=_kent_bin(root),
        )
    except Exception:
        raise ContractError("native Script source admission failed") from None

    if (
        getattr(admission, "project_id", None) != PROJECT_ID
        or getattr(admission, "workflow_id", None) != WORKFLOW_ID
        or not isinstance(
            getattr(admission, "source_admission_sha256", None),
            str,
        )
        or not HEX64.fullmatch(admission.source_admission_sha256)
        or not isinstance(getattr(admission, "receipt_sha256", None), str)
        or not HEX64.fullmatch(admission.receipt_sha256)
    ):
        raise ContractError("native Script source admission result is invalid")


def _activate_github_provider_context(
    root: Path,
    payload: Mapping[str, Any],
    state: Mapping[str, Any],
) -> None:
    global _ACTIVE_GITHUB_PROVIDER_CONTEXT
    metadata = payload.get("_kent")
    task_short_id = state.get("task_short_id")
    if (
        not isinstance(metadata, dict)
        or set(metadata) != KENT_KEYS
        or any(not isinstance(value, str) or not value for value in metadata.values())
        or not isinstance(task_short_id, str)
        or not task_short_id
    ):
        _ACTIVE_GITHUB_PROVIDER_CONTEXT = None
        return
    commentary = payload.get("commentary", "")
    if not isinstance(commentary, str):
        _ACTIVE_GITHUB_PROVIDER_CONTEXT = None
        return
    _ACTIVE_GITHUB_PROVIDER_CONTEXT = {
        "root": root,
        "task_short_id": task_short_id,
        "native_context": dict(metadata),
        "commentary": commentary,
    }


def github_provider_read_guard(root: Path) -> Callable[[], None]:
    """Build a callback that rechecks native identity and producer ancestry per API call."""
    context = _ACTIVE_GITHUB_PROVIDER_CONTEXT
    if context is None or context.get("root") != root:
        raise ContractError("GitHub provider guard has no exact Script ingress context")

    def require_clear() -> None:
        delivery = _qualified_delivery_module(root)
        try:
            locator = delivery.producer_locator(context["commentary"])
        except (TypeError, ValueError, UnicodeError):
            raise ContractError(
                "GitHub provider source reference is invalid"
            ) from None
        refs = [locator] if locator is not None else []
        identity = delivery.observe_script_identity(
            root,
            context["task_short_id"],
            dict(context["native_context"]),
            native_read=_provider_native_read,
        )
        blocked = delivery.GitHubProviderRetryBlocked
        try:
            delivery.require_github_provider_read(root, refs, identity)
        except blocked as error:
            state = getattr(error, "state", None)
            if state not in {"not_before", "unknown"}:
                raise ContractError(
                    "GitHub provider guard returned an invalid block state"
                ) from None
            raise GitHubProviderReadBlocked(state) from None

    return require_clear


def _kent_worktree_bin() -> str:
    candidate = os.environ.get("PUBER_KENT_WORKTREE_BIN", "") or str(Path.home() / ".kent/bin/kent-worktree")
    if not Path(candidate).is_file() or not os.access(candidate, os.X_OK):
        raise ContractError("stock Kent worktree wrapper is unavailable")
    return candidate

def session_worktree_status(root: Path, session_id: str) -> dict[str, Any]:
    session_id = require_string(session_id, "cleanup_session_id")
    if any(character.isspace() for character in session_id) or "/" in session_id or "\\" in session_id:
        raise ContractError("cleanup_session_id is not safe")
    try:
        result = run([_kent_worktree_bin(), "status", "--session", session_id, "--json"], cwd=root, env=child_env(), check=False)
    except (OSError, TypeError, ValueError) as error:
        raise ContractError("Kent worktree status failed") from error
    if result.returncode != 0:
        raise ContractError(result.stderr.strip() or result.stdout.strip() or "Kent worktree status failed")
    return _json_one(result.stdout.encode("utf-8"))

def git_common_root(root: Path) -> Path:
    common = Path(git(root, "rev-parse", "--git-common-dir"))
    if not common.is_absolute():
        common = root / common
    try:
        common = common.expanduser().resolve()
    except (OSError, RuntimeError, TypeError, ValueError) as error:
        raise ContractError("Git common directory is not a safe path") from error
    if common.name != ".git":
        raise ContractError("Git common directory is not a .git directory")
    primary = common.parent
    try:
        top_level = git(primary, "rev-parse", "--show-toplevel")
    except ContractError:
        raise
    if top_level != str(primary):
        raise ContractError("primary checkout is not the exact Git root")
    return primary

def current_branch_ref(root: Path) -> str:
    branch = require_string(git(root, "symbolic-ref", "--quiet", "--short", "HEAD"), "current branch")
    return f"refs/heads/{branch}"

def _resolved_status_path(value: Any, label: str) -> Path:
    if not isinstance(value, str) or not value.strip():
        raise ContractError(f"{label} must be a non-empty path string")
    try:
        path = Path(value).expanduser()
        if not path.is_absolute():
            raise ContractError(f"{label} must be absolute")
        return path.resolve()
    except ContractError:
        raise
    except (OSError, RuntimeError, TypeError, ValueError) as error:
        raise ContractError(f"{label} is not a safe path") from error

def _status_string(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip() or value != value.strip():
        raise ContractError(f"{label} must be a non-empty string")
    return value

def _validate_session_status(root: Path, payload: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any], Path]:
    if (
        not isinstance(payload, dict)
        or set(payload) != {"target", "worktree", "problems"}
        or payload.get("problems") is not None
    ):
        raise ContractError("Kent 2.8 worktree status is not the exact clean dialect")
    native_target = payload.get("target")
    native_worktree = payload.get("worktree")
    target_keys = {
        "workspaceId", "workspaceName", "workspaceRoot",
        "workspaceAvailability", "worktree", "cwdRelpath",
        "effectiveWorkdir",
    }
    active_worktree_keys = {
        "recordedRoot", "observedRoot", "displayName", "recordedBranchRef",
    }
    inactive_worktree_keys = {"recordedRoot", "observedRoot"}
    if not isinstance(native_target, dict) or set(native_target) != target_keys:
        raise ContractError("Kent 2.8 worktree target is not the exact camel-case shape")
    if (
        not isinstance(native_worktree, dict)
        or set(native_worktree) not in {frozenset(active_worktree_keys), frozenset(inactive_worktree_keys)}
    ):
        raise ContractError("Kent 2.8 worktree roots are not the exact camel-case shape")
    native_task_worktree = native_target.get("worktree")
    if native_task_worktree is None:
        task_worktree = None
    else:
        task_worktree_keys = {"id", "name", "root", "availability"}
        if (
            not isinstance(native_task_worktree, dict)
            or set(native_task_worktree) != task_worktree_keys
        ):
            raise ContractError("Kent 2.8 active Worktree is not the exact camel-case shape")
        task_worktree = {
            "ID": native_task_worktree["id"],
            "Name": native_task_worktree["name"],
            "Root": native_task_worktree["root"],
            "Availability": native_task_worktree["availability"],
        }
    target = {
        "WorkspaceID": native_target["workspaceId"],
        "WorkspaceName": native_target["workspaceName"],
        "WorkspaceRoot": native_target["workspaceRoot"],
        "WorkspaceAvailability": native_target["workspaceAvailability"],
        "Worktree": task_worktree,
        "CwdRelpath": native_target["cwdRelpath"],
        "EffectiveWorkdir": native_target["effectiveWorkdir"],
    }
    worktree = {
        "recorded_root": native_worktree["recordedRoot"],
        "observed_root": native_worktree["observedRoot"],
    }
    if set(native_worktree) == active_worktree_keys:
        worktree["display_name"] = native_worktree["displayName"]
        worktree["recorded_branch_ref"] = native_worktree["recordedBranchRef"]
    primary = git_common_root(root)
    workspace_id = _status_string(target.get("WorkspaceID"), "WorkspaceID")
    workspace_name = _status_string(target.get("WorkspaceName"), "WorkspaceName")
    workspace_root = _resolved_status_path(target.get("WorkspaceRoot"), "WorkspaceRoot")
    effective_workdir = _resolved_status_path(target.get("EffectiveWorkdir"), "EffectiveWorkdir")
    if not isinstance(target["WorkspaceAvailability"], str) or not isinstance(target["CwdRelpath"], str) or target["WorkspaceAvailability"] != "available" or target["CwdRelpath"] != "." or workspace_root != primary:
        raise ContractError("Kent worktree status workspace identity drifted")
    target["WorkspaceID"], target["WorkspaceName"] = workspace_id, workspace_name
    target["WorkspaceRoot"], target["EffectiveWorkdir"] = str(workspace_root), str(effective_workdir)
    for key in ("recorded_root", "observed_root"):
        worktree[key] = str(_resolved_status_path(worktree.get(key), f"worktree.{key}"))
    task_worktree = target.get("Worktree")
    if task_worktree is not None:
        if not isinstance(task_worktree, dict) or set(task_worktree) != {"ID", "Name", "Root", "Availability"}:
            raise ContractError("Kent active Session Worktree is not the stock closed shape")
        task_worktree["ID"] = _status_string(task_worktree.get("ID"), "Worktree.ID")
        task_worktree["Name"] = _status_string(task_worktree.get("Name"), "Worktree.Name")
        task_worktree["Root"] = str(_resolved_status_path(task_worktree.get("Root"), "Worktree.Root"))
        if not isinstance(task_worktree["Availability"], str) or task_worktree["Availability"] != "available":
            raise ContractError("Worktree.Availability is not available")
    if set(worktree) == {"recorded_root", "observed_root", "display_name", "recorded_branch_ref"}:
        worktree["display_name"] = _status_string(worktree.get("display_name"), "worktree.display_name")
        worktree["recorded_branch_ref"] = _status_string(worktree.get("recorded_branch_ref"), "worktree.recorded_branch_ref")
        if not re.fullmatch(r"refs/heads/[A-Za-z0-9._/-]+", worktree["recorded_branch_ref"]) or not isinstance(task_worktree, dict) or worktree["display_name"] != task_worktree["Name"] or worktree["recorded_branch_ref"] != current_branch_ref(root):
            raise ContractError("Kent worktree status display or branch identity drifted")
    return target, worktree, primary

def classify_session_status(root: Path, payload: dict[str, Any]) -> tuple[str, dict[str, str]]:
    target, roots, primary = _validate_session_status(root, payload)
    selected_root = _resolved_status_path(str(root), "selected worktree")
    if target["Worktree"] is None:
        if set(roots) != {"recorded_root", "observed_root"}:
            raise ContractError("Kent post-leave Session roots are not exact")
        if target["EffectiveWorkdir"] == str(primary) and all(roots[key] == str(primary) for key in ("recorded_root", "observed_root")):
            return "primary", {
                "workspace_id": target["WorkspaceID"],
                "workspace_name": target["WorkspaceName"],
                "workspace_root": str(primary),
                "worktree_id": "",
                "worktree_name": "",
                "worktree_root": str(primary),
                "recorded_branch_ref": "",
            }
        return "foreign", {}
    task_worktree = target.get("Worktree")
    if set(roots) != {"recorded_root", "observed_root", "display_name", "recorded_branch_ref"}:
        raise ContractError("Kent active Session roots are not exact")
    identity = {
        "workspace_id": target["WorkspaceID"],
        "workspace_name": target["WorkspaceName"],
        "workspace_root": str(primary),
        "worktree_id": task_worktree["ID"],
        "worktree_name": task_worktree["Name"],
        "worktree_root": task_worktree["Root"],
        "recorded_branch_ref": roots["recorded_branch_ref"],
    }
    if target["EffectiveWorkdir"] == str(selected_root) and task_worktree["Root"] == str(selected_root) and all(roots[key] == str(selected_root) for key in ("recorded_root", "observed_root")):
        return "active", identity
    return "foreign", identity

def session_identity(root: Path, session_id: str, *, moved: bool = False) -> dict[str, str]:
    payload = session_worktree_status(root, session_id)
    classification, identity = classify_session_status(root, payload)
    expected = "primary" if moved else "active"
    if classification != expected:
        raise ContractError(f"Kent Session is not the exact {expected} state")
    return identity

def session_targets_worktree(root: Path, session_id: str) -> bool:
    payload = session_worktree_status(root, session_id)
    classification, _ = classify_session_status(root, payload)
    if classification == "active":
        return True
    if classification == "primary":
        return False
    raise ContractError("Kent Session is foreign to the selected worktree")

def session_preserves_worktree_identity(root: Path, session_id: str) -> bool:
    payload = session_worktree_status(root, session_id)
    classification, _ = classify_session_status(root, payload)
    if classification == "primary":
        return True
    if classification == "active":
        return False
    raise ContractError("Kent Session is foreign to the selected Workspace")

def task_show(root: Path, task_id: str) -> dict[str, Any]:
    result = run([_kent_bin(root), "task", "show", task_id, "--project", PROJECT_ID, "--json"], cwd=root, env=child_env(), check=False)
    if result.returncode != 0:
        raise ContractError("Kent task show failed")
    return _json_one(result.stdout.encode("utf-8"))

def _task_identity(root: Path, task_id: str, node_key: str, task: dict[str, Any] | None = None) -> tuple[dict, str]:
    if not TASK_ID.fullmatch(task_id):
        raise ContractError("_kent.task_id is invalid")
    task = task if task is not None else task_show(root, task_id)
    if set(task) != TASK_ROOT_KEYS:
        raise ContractError("Kent task root fields are not the exact stock shape")
    summary, workflow, status, execution = (task.get(key) for key in ("summary","workflow","status","execution_target"))
    if not all(isinstance(value, dict) for value in (summary, workflow, status, execution)):
        raise ContractError("Kent task state is incomplete")
    node_id = _node_id(root, node_key)
    if summary.get("id") != task_id or summary.get("project_id") != PROJECT_ID or summary.get("workflow_id") != WORKFLOW_ID:
        raise ContractError("Kent task/project/workflow identity drifted")
    if workflow.get("workflow_id") != WORKFLOW_ID or workflow.get("version") != WORKFLOW_REVISION or workflow.get("name", WORKFLOW_NAME) != WORKFLOW_NAME:
        raise ContractError("Kent workflow identity or revision drifted")
    if status.get("node_ids") != [node_id]:
        raise ContractError("Kent current node is not the selected node")
    nodes = task.get("current_nodes")
    if not isinstance(nodes, list) or len(nodes) != 1 or not isinstance(nodes[0], dict) or nodes[0].get("node_id") != node_id:
        raise ContractError("Kent current node state is ambiguous")
    return task, node_id

def _task_checkout(root: Path, task_id: str, node_key: str, task: dict, node_id: str, *,
                   allowed_notes_path=None, allowed_checkout_head=None,
                   profile_recovery_admission=None, cleanup_recovery_admission=None) -> dict:
    summary, execution = task["summary"], task["execution_target"]
    worktree = require_string(task.get("worktree_path"), "worktree_path")
    if Path(worktree).expanduser().resolve() != root:
        raise ContractError("Kent task worktree is not the selected repository root")
    commit = require_string(execution.get("commit_oid"), "execution_target.commit_oid")
    current_head = git(root, "rev-parse", "HEAD")
    if not SHA1.fullmatch(commit):
        raise ContractError("selected checkout is not the exact Task execution commit")
    # K is the immutable native lock. H is the currently executing controller
    # source, admitted below by preparation evidence, not a rewritten Task.
    validated = {"task": task, "task_id": task_id, "task_short_id": _safe_task_short_id(summary.get("short_id")), "node_id": node_id, "commit": commit, "controller_commit": current_head}
    if current_head != commit and current_head != allowed_checkout_head:
        if node_key not in {"ci_prepare", "ci_watch", "merge_watch", "publish", "monitor", "cleanup"}:
            raise ContractError("selected checkout is not the exact Task execution commit")
        if node_key == "cleanup":
            if cleanup_recovery_admission is None:
                raise ContractError("Cleanup inventory classifier is unavailable")
            # Classify the existing terminal inventory/history before reading
            # the release checkpoint or admitting a prepared controller.
            cleanup_recovery_admission(validated)
        checkpoint = read_profile_checkpoint(root, validated["task_short_id"], expected={
            "task_id": task_id, "task_short_id": validated["task_short_id"],
            "release_base_oid": commit, "release_head_oid": current_head,
        }, missing_ok=node_key == "cleanup")
        if checkpoint is None:
            if node_key != "cleanup" or cleanup_recovery_admission is None:
                raise ContractError("prepared controller checkpoint is missing")
        else:
            values = declarations(task.get("body"))
            version = values.get("release_version")
            version, tag = safe_version_tag(version, values.get("release_tag") or f"v{version}")
            validate_preparation_proof(root, {
                "operation_id": checkpoint["operation_id"],
                "branch_name": checkpoint["release_branch"],
                "release_base_oid": commit, "candidate_oid": checkpoint["candidate_oid"],
            }, validated, version, tag, current_head)
    status = git(root, "status", "--porcelain=v1", "--untracked-files=all")
    if status:
        allowed = validate_notes_path(root, allowed_notes_path, task_short_id=_safe_task_short_id(summary.get("short_id")), require_exists=False) if allowed_notes_path else None
        lines = [line for line in status.splitlines() if line]
        if not allowed or any(line not in {f"?? {allowed}", f"?? {allowed}/"} for line in lines):
            if node_key != "profile_generation" or profile_recovery_admission is None:
                raise ContractError("selected checkout is not clean")
            # Only the profile consumer can admit its checkpoint-bound recovery.
            # This is not a caller-supplied dirty-path allowlist.
            profile_recovery_admission(validated)
    return validated

def validate_task(root: Path, task_id: str, node_key: str, task: dict[str, Any] | None = None, *,
                  allowed_notes_path=None, allowed_checkout_head=None,
                  profile_recovery_admission=None, cleanup_recovery_admission=None) -> dict:
    task, node_id = _task_identity(root, task_id, node_key, task)
    scripts = task.get("current_scripts")
    if (node_key not in SCRIPT_PATHS or not isinstance(scripts, list) or len(scripts) != 1
            or not isinstance(scripts[0], dict) or scripts[0].get("path") != str(root / SCRIPT_PATHS[node_key])
            or scripts[0].get("current_node", {}).get("node_id") != node_id):
        raise ContractError("Kent current Script path or node drifted")
    return _task_checkout(root, task_id, node_key, task, node_id,
        allowed_notes_path=allowed_notes_path, allowed_checkout_head=allowed_checkout_head,
        profile_recovery_admission=profile_recovery_admission, cleanup_recovery_admission=cleanup_recovery_admission)


def validate_cleanup_agent(root: Path, task_id: str, caller: str, *, allowed_notes_path=None,
                           cleanup_recovery_admission=None) -> dict:
    caller = _status_string(caller, "Cleanup Agent caller")
    if caller in {".", ".."} or any(c.isspace() or c in "/\\" for c in caller):
        raise ContractError("Cleanup Agent caller is not path-safe")
    task, node_id = _task_identity(root, task_id, "cleanup")
    node = task["current_nodes"][0]
    if task.get("current_scripts") != [] or node.get("session_id") != caller:
        raise ContractError("caller is not the actual current Cleanup Agent")
    graph = json.loads((root / GRAPH_PATH).read_text(encoding="utf-8"))
    configured = next(n for n in graph["nodes"] if n["id"] == node_id)
    if configured.get("kind") != "agent" or configured.get("subagent_role") != "delivery-operator":
        raise ContractError("Cleanup is not the configured Agent")
    identity = session_identity(root, caller)
    state = _task_checkout(root, task_id, "cleanup", task, node_id,
        allowed_notes_path=allowed_notes_path, cleanup_recovery_admission=cleanup_recovery_admission)
    state.update(caller_session_id=caller, caller_identity=identity)
    return state

def normalize_transport_nulls(
    fields: Mapping[str, Any],
    edge_key: str,
) -> dict[str, Any]:
    """Normalize native JSON-null strings only on explicitly nullable routes."""
    normalized = dict(fields)
    nullable_fields = ROUTE_NULLABLE_FIELDS_BY_EDGE.get(edge_key, frozenset())
    for key in NULLABLE_TRANSPORT_FIELDS & set(normalized):
        value = normalized[key]
        if value is None:
            if key not in nullable_fields:
                raise ContractError(
                    f"{key} absence is not authorized on route {edge_key}"
                )
            normalized[key] = None
        elif (
            not isinstance(value, str)
            or not value.strip()
            or value.strip() == "null"
        ):
            raise ContractError(
                f"{key} must be a non-empty string or route-authorized JSON null"
            )
    return normalized


def validate_envelope(
    payload: Mapping[str, Any],
    root: Path,
    node_key: str,
    *,
    task: dict[str, Any] | None = None,
    allowed_checkout_head: str | None = None,
    profile_recovery_admission: Callable[[dict[str, Any]], None] | None = None,
    cleanup_recovery_admission: Callable[[dict[str, Any]], None] | None = None,
) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
    _reset_runtime_invocation()
    if not isinstance(payload, Mapping):
        raise ContractError("Script input must be one object")
    metadata = payload.get("_kent")
    if not isinstance(metadata, dict) or set(metadata) != KENT_KEYS:
        raise ContractError("_kent must contain exactly task_id and node_id")
    try:
        _bind_qualified_runtime(root, metadata)
    except ContractError:
        raise
    except Exception as error:
        raise ContractError("native Kit runtime qualification failed") from error
    if node_key == "release_intent_gate" and ENTRY_TRANSITION not in payload:
        _admit_first_script_ingress(root, metadata)
    task_id = require_string(metadata.get("task_id"), "_kent.task_id")
    if metadata.get("node_id") != _node_id(root, node_key):
        raise ContractError("_kent.node_id does not match the current Script")
    has_route = ENTRY_TRANSITION in payload
    ci_preparation_retry = node_key == "ci_prepare" and not has_route
    if node_key in INITIAL_SCRIPT_ENTRY and not has_route:
        # Start -> release_intent_gate is the one explicit initial variant.
        branch = INITIAL_SCRIPT_ENTRY[node_key]
        edge = graph_edge(root, branch, node_key)
        graph = json.loads((root / GRAPH_PATH).read_text(encoding="utf-8"))
        group = next(
            (
                item for item in graph.get("transition_groups", [])
                if item.get("id") == edge.get("transition_group_id")
            ),
            {},
        )
        source = next(
            (
                item for item in graph.get("nodes", [])
                if item.get("id") == group.get("source_node_id")
            ),
            {},
        )
        if source.get("kind") != "start" or edge.get("parameters") != []:
            raise ContractError("initial release-intent route is not the exact Start variant")
    elif ci_preparation_retry:
        branch = CI_PREPARATION_RETRY_ROUTE
        edge = graph_edge(root, branch, node_key)
        parameter_keys = [
            item.get("key") for item in edge.get("parameters", [])
        ]
        if tuple(parameter_keys) != CI_PREPARATION_RETRY_FIELDS:
            raise ContractError(
                "CI preparation retry route differs from its exact S4 carrier"
            )
    else:
        branch = require_string(payload.get(ENTRY_TRANSITION), ENTRY_TRANSITION)
        edge = graph_edge(root, branch, node_key)
        parameter_keys = [
            item.get("key") for item in edge.get("parameters", [])
        ]
        if (
            edge.get("key") != branch
            or parameter_keys.count(ENTRY_TRANSITION) != 1
            or not parameter_keys
            or parameter_keys[-1] != ENTRY_TRANSITION
        ):
            raise ContractError("business route is not the exact routed graph edge")
    expected = {
        item.get("key")
        for item in edge.get("parameters", [])
        if item.get("key") != ENTRY_TRANSITION
    }
    if None in expected or expected & {"_kent", "commentary"}:
        raise ContractError(f"graph edge {branch} contains invalid business parameters")
    expected_payload = set(expected) | {"_kent"}
    if has_route:
        expected_payload.add(ENTRY_TRANSITION)
    if ci_preparation_retry:
        expected_payload.add("commentary")
    if "commentary" in payload:
        commentary = payload["commentary"]
        if not isinstance(commentary, str):
            raise ContractError("commentary must be a bounded UTF-8 string")
        try:
            if len(commentary.encode("utf-8")) > 8 * 1024 * 1024:
                raise ContractError("commentary must be a bounded UTF-8 string")
        except UnicodeEncodeError as error:
            raise ContractError("commentary must be a bounded UTF-8 string") from error
        expected_payload.add("commentary")
    if set(payload) != expected_payload:
        raise ContractError("Script envelope contains unknown or missing fields")
    business = {
        key: value
        for key, value in payload.items()
        if key not in {"_kent", "commentary", ENTRY_TRANSITION}
    }
    if set(business) != expected:
        raise ContractError(f"input fields do not exactly match graph edge {branch}")
    business = normalize_transport_nulls(business, edge["key"])
    if ci_preparation_retry:
        for key in CI_PREPARATION_RETRY_FIELDS:
            value = business.get(key)
            if (
                not isinstance(value, str)
                or not value
                or value.strip() != value
            ):
                raise ContractError(
                    f"native CI preparation retry field {key} is invalid"
                )
    allowed_notes = business.get("release_notes_path") if isinstance(business.get("release_notes_path"), str) else None
    state = validate_task(
        root,
        task_id,
        node_key,
        task,
        allowed_notes_path=allowed_notes,
        allowed_checkout_head=allowed_checkout_head,
        profile_recovery_admission=profile_recovery_admission,
        cleanup_recovery_admission=cleanup_recovery_admission,
    )
    _activate_github_provider_context(root, payload, state)
    return (
        business,
        state,
        edge,
    )

def validate_notes_path(root: Path, value: Any, *, task_short_id: str | None = None, require_exists: bool = True) -> str:
    path = require_string(value, "release_notes_path")
    if Path(path).is_absolute() or "\\" in path or Path(path).as_posix() != path:
        raise ContractError("release notes path must be relative and canonical")
    expected_prefix = f".todo/{_safe_task_short_id(task_short_id)}/" if task_short_id else ".todo/"
    if not path.startswith(expected_prefix) or Path(path).name != "release-notes-ru.md" or len(Path(path).parts) != len(Path(expected_prefix).parts) + 1:
        raise ContractError("release notes path is outside the expected task-local root")
    candidate = root / path
    if candidate.is_symlink() or (require_exists and (not candidate.is_file() or not stat.S_ISREG(candidate.stat().st_mode))):
        raise ContractError("release notes path is not a regular file")
    return path

def output_edge(root: Path, transition: str, target_node: str) -> dict[str, Any]:
    graph = json.loads((root / GRAPH_PATH).read_text(encoding="utf-8"))
    target_id = _node_id(root, target_node)
    matches = [edge for edge in graph.get("edges", []) if edge.get("key") == transition and edge.get("target_node_id") == target_id]
    if len(matches) != 1:
        raise ContractError(f"output transition is not an exact graph edge: {transition}")
    return matches[0]

def render_exact(
    root: Path,
    transition: str,
    target_node: str,
    fields: Mapping[str, Any],
    *,
    commentary: str | None = None,
) -> dict[str, Any]:
    edge = output_edge(root, transition, target_node)
    graph = json.loads((root / GRAPH_PATH).read_text(encoding="utf-8"))
    groups = [
        item for item in graph.get("transition_groups", [])
        if item.get("id") == edge.get("transition_group_id")
    ]
    if (
        len(groups) != 1
        or not isinstance(groups[0].get("transition_id"), str)
        or not groups[0]["transition_id"]
    ):
        raise ContractError(
            f"output edge has no exact native transition group: {transition}"
        )
    target = next(
        (item for item in graph.get("nodes", []) if item.get("key") == target_node),
        {},
    )
    parameter_keys = [item.get("key") for item in edge.get("parameters", [])]
    routed_script = target.get("kind") == "script" and target_node != "task_janitor"
    if routed_script:
        if (
            parameter_keys.count(ENTRY_TRANSITION) != 1
            or not parameter_keys
            or parameter_keys[-1] != ENTRY_TRANSITION
            or ENTRY_TRANSITION in fields
        ):
            raise ContractError(
                f"Script output edge lacks the exact route carrier: {transition}"
            )
        expected = set(parameter_keys) - {ENTRY_TRANSITION}
    else:
        if ENTRY_TRANSITION in parameter_keys:
            raise ContractError(f"route carrier is forbidden for this target: {transition}")
        expected = set(parameter_keys)
    if set(fields) != expected:
        raise ContractError(f"output fields do not exactly match graph edge {transition}")
    nullable_fields = ROUTE_NULLABLE_FIELDS_BY_EDGE.get(transition, frozenset())
    empty_optional_fields = CLEANUP_EMPTY_OPTIONAL_FIELDS_BY_EDGE.get(
        transition,
        frozenset(),
    )
    for key, value in fields.items():
        if value is None:
            if key not in NULLABLE_TRANSPORT_FIELDS or key not in nullable_fields:
                raise ContractError(
                    f"{key} absence is not authorized on route {transition}"
                )
            continue
        if (
            key in NULLABLE_TRANSPORT_FIELDS
            and not (
                key in empty_optional_fields
                and value == ""
            )
            and (
            not isinstance(value, str)
            or not value.strip()
            or value.strip() == "null"
            )
        ):
            raise ContractError(
                f"{key} must be a non-empty packet string or route-authorized JSON null"
            )
    output = {"transition": groups[0]["transition_id"], **dict(fields)}
    if routed_script:
        output[ENTRY_TRANSITION] = transition
    if commentary is not None:
        if not isinstance(commentary, str) or len(commentary.encode("utf-8")) > 8192:
            raise ContractError("native approval commentary is invalid")
        output["commentary"] = commentary
    return output


def emit_exact(
    root: Path,
    transition: str,
    target_node: str,
    fields: Mapping[str, Any],
    *,
    commentary: str | None = None,
) -> None:
    output = render_exact(
        root,
        transition,
        target_node,
        fields,
        commentary=commentary,
    )
    print(json.dumps(output, ensure_ascii=False, sort_keys=True))

def _kit_modules(root: Path | None = None) -> dict[str, Any]:
    """Load every Kit module through the one native-qualified invocation handle."""
    global _KIT_MODULES_CACHE
    selected_root = ROOT if root is None else root
    qualified = _require_qualified_runtime(selected_root)
    if _KIT_MODULES_CACHE is not None:
        return _KIT_MODULES_CACHE
    checkpoint = _qualified_checkpoint_module(
        selected_root,
        required=("kit_module",),
    )

    def kit_module(name: str) -> Any:
        try:
            module = checkpoint.kit_module(
                name,
                project_root=selected_root,
                qualified=qualified,
            )
        except Exception as error:
            raise ContractError(
                f"qualified Kit module cannot load: {name}"
            ) from error
        module_path = getattr(module, "__file__", None)
        source_root = getattr(qualified, "source_root", None)
        if (
            not isinstance(module_path, str)
            or not isinstance(source_root, (Path, str))
            or Path(source_root) not in Path(module_path).resolve().parents
        ):
            raise ContractError(
                f"qualified Kit module escaped its selected cohort: {name}"
            )
        return module

    workflowkit = kit_module("workflowkit")
    runtime = kit_module("runtime")
    revision = kit_module("revision")
    ci = kit_module("ci_contract")
    merge_strategy = kit_module("merge_strategy")
    delivery = kit_module("delivery")
    for module, names in ((workflowkit, ("capture_runtime_authority_binding_verified",)),
                          (revision, ("verify_runtime_source_captures", "source_read_budget"))):
        if any(not callable(getattr(module, name, None)) for name in names):
            raise ContractError("qualified Kit lacks complete verified source capture capability")
    result = {name: getattr(workflowkit, name) for name in ("ProjectProfile","ReleaseSpec","NormalizedGitHubWorkflowSourceV1","preflight_project_revision","capture_runtime_execution_context","capture_runtime_authority_binding_verified","validate_operation_jobs","canonicalize_publication_operation")}
    result.update({name: getattr(runtime, name) for name in ("validate_terminal_seal_request","validate_terminal_marker","parse_terminal_marker_line","terminal_marker_line","validate_cleanup_report","validate_terminal_chain","canonical_sha256")})
    result.update({name: getattr(runtime, name) for name in (
        "validate_ci_report",
        "validate_ci_archive",
        "parse_canonical_json",
        "MAX_CI_REPORT_BYTES",
        "MAX_DYNAMIC_CI_REPORT_BYTES",
        "merge_github_retry_constraints",
    )})
    result.update({name: getattr(revision, name) for name in ("read_blob_bytes", "tree_mode", "verify_runtime_source_captures", "source_read_budget", "run_git")})
    result.update({name: getattr(ci, name) for name in ("normalize_github_workflow", "read_pull_request")})
    preparation_diagnostic_validator = getattr(
        ci,
        "validate_ci_preparation_diagnostic",
        None,
    )
    if callable(preparation_diagnostic_validator):
        result["validate_ci_preparation_diagnostic"] = (
            preparation_diagnostic_validator
        )
    typed_preparation_failure = getattr(
        ci,
        "typed_preparation_failure",
        None,
    )
    if callable(typed_preparation_failure):
        result["typed_preparation_failure"] = typed_preparation_failure
    delivery_runtime = getattr(runtime, "validate_delivery_context", None)
    if callable(delivery_runtime):
        result["validate_delivery_context"] = delivery_runtime
    runtime_canonical_bytes = getattr(runtime, "canonical_bytes", None)
    if callable(runtime_canonical_bytes):
        result["kit_canonical_bytes"] = runtime_canonical_bytes
    for name in (
        "unwrap_delivery_context_payload",
        "_validated_resume_context",
    ):
        function = getattr(ci, name, None)
        if callable(function):
            result[name] = function
    for name in (
        "capture_script_producer",
        "observe_script_identity",
        "producer_locator",
        "reconstruct_producer",
        "producer_reference_closure",
        "packet_decode",
        "packet_json",
        "pack_delivery",
        "transition_contract_reference",
    ):
        function = getattr(delivery, name, None)
        if callable(function):
            result[name] = function
    producer_retry_constraints = getattr(
        delivery,
        "_producer_github_retry_constraints",
        None,
    )
    if callable(producer_retry_constraints):
        result["producer_github_retry_constraints"] = producer_retry_constraints
    result["resolve_github_merge_strategy"] = merge_strategy.resolve_github_merge_strategy
    result.update({name: getattr(runtime, name) for name in ("validate_expected_ci_checks", "expected_ci_checks_sha256", "validate_ci_policy_snapshot", "ci_policy_projection_sha256")})
    _KIT_MODULES_CACHE = result
    return result

def _runtime_contracts_module(root: Path) -> Any:
    """Load the project-local pure runtime, separate from release authority."""
    path = root / ".kent/scripts/workflow_runtime_contracts.py"
    if path.is_symlink() or not path.is_file():
        raise ContractError("runtime contract support module is unsafe")
    try:
        spec = importlib.util.spec_from_file_location(
            "puber_runtime_contracts",
            path,
        )
        if spec is None or spec.loader is None:
            raise ContractError("runtime contract support module is unavailable")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except ContractError:
        raise
    except (
        AttributeError,
        ImportError,
        OSError,
        RuntimeError,
        SyntaxError,
        TypeError,
        ValueError,
    ) as error:
        raise ContractError("runtime contract support module cannot load") from error

def _github_observer(
    root: Path,
    *,
    provider_guard: Callable[[], None] | None = None,
) -> Any:
    """Load the project-materialized shared read-only GitHub observer."""
    path = root / ".kent/scripts/workflow_github_observation.py"
    if path.is_symlink() or not path.is_file():
        raise ContractError("shared GitHub observation module is missing or unsafe")
    try:
        spec = importlib.util.spec_from_file_location(
            "puber_github_observation",
            path,
        )
        if spec is None or spec.loader is None:
            raise ContractError("shared GitHub observation module cannot load")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        observer = getattr(module, "GitHubObserver")
        return observer(
            root,
            gh_bin=os.environ.get("PUBER_GH_BIN")
            or os.environ.get("KENT_GH_BIN"),
            provider_guard=(
                github_provider_read_guard(root)
                if provider_guard is None
                else provider_guard
            ),
        )
    except ContractError:
        raise
    except (
        AttributeError,
        ImportError,
        OSError,
        RuntimeError,
        SyntaxError,
        TypeError,
        ValueError,
    ) as error:
        raise ContractError("shared GitHub observation module cannot load") from error

def provider_retry_constraint_from_error(
    root: Path,
    error: BaseException,
    *,
    interval: int = 0,
    failure_count: int = 1,
) -> str | None:
    """Expose only the shared observer's closed DTO, never response details."""
    if isinstance(error, GitHubProviderReadBlocked):
        return None
    retained = getattr(error, "github_retry_constraint", None)
    if isinstance(retained, str):
        return retained
    path = root / ".kent/scripts/workflow_github_observation.py"
    if path.is_symlink() or not path.is_file():
        raise ContractError("shared GitHub retry adapter is missing or unsafe")
    try:
        spec = importlib.util.spec_from_file_location(
            "puber_github_retry_observation",
            path,
        )
        if spec is None or spec.loader is None:
            raise ContractError("shared GitHub retry adapter cannot load")
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        extract = getattr(module, "provider_retry_constraint", None)
        if not callable(extract):
            raise ContractError("shared GitHub retry adapter API is unavailable")
        return extract(
            error,
            interval=interval,
            failure_count=failure_count,
        )
    except ContractError:
        raise
    except (
        AttributeError,
        ImportError,
        OSError,
        RuntimeError,
        SyntaxError,
        TypeError,
        ValueError,
    ) as load_error:
        raise ContractError(
            "shared GitHub retry adapter cannot evaluate failure"
        ) from load_error


def _external_captures(root: Path, profile: Any, selected: Any, *, budget: Any) -> Any:
    # The complete opaque proof cannot be reconstructed from a list of hashes.
    return _kit_modules()["verify_runtime_source_captures"](root, selected, budget=budget)

def _revision_blob(root: Path, kit: dict[str, Any], revision: str, path: str) -> bytes:
    if kit["tree_mode"](root, revision, path) not in {"100644", "100755"}:
        raise ContractError(f"selected source is not a regular Git blob: {path}")
    return kit["read_blob_bytes"](root, revision, path, label="release source")

def _normalized_workflow(root: Path, path: str, *, revision: str | None = None) -> dict[str, Any]:
    kit = _kit_modules()
    # Source-only builder checks inspect their explicitly supplied source root;
    # runtime callers always pass the immutable H or T revision below.
    raw = _revision_blob(root, kit, revision, path) if revision is not None else (root / path).read_bytes()
    observed = kit["normalize_github_workflow"](raw, path)
    # The shared normalizer exposes one convenience alias outside the source DTO.
    return {key: value for key, value in observed.items() if key != "workflow_name"}

def _normalized_sources(root: Path, kit: dict[str, Any], spec: Any, *, revision: str | None = None) -> list[Any]:
    paths = sorted({row["workflow_path"] for table in (spec.required_jobs_v1, spec.qualification_jobs_v1, spec.effect_jobs_v1) for row in table.jobs})
    return [kit["NormalizedGitHubWorkflowSourceV1"].from_dict(_normalized_workflow(root, path, revision=revision)) for path in paths]

def _load_release_spec(root: Path, kit: dict[str, Any], profile: Any, *, revision: str | None = None) -> Any:
    revision = revision or git(root, "rev-parse", "HEAD")
    raw = tomllib.loads(_revision_blob(root, kit, revision, profile.release.spec_path).decode("utf-8"))
    empty_container = {"image": "", "environment": {}, "ports": [], "options": ""}
    for table_name in ("required_jobs_v1", "qualification_jobs_v1", "effect_jobs_v1"):
        table = raw.get(table_name)
        for row in table.get("jobs", []) if isinstance(table, dict) else []:
            if row.get("container") == empty_container:
                row["container"] = None
    return kit["ReleaseSpec"].from_dict(raw, profile=profile)

def attest(root: Path, state: dict[str, Any], node_key: str, branch: str, **kwargs: Any) -> dict[str, Any]:
    try:
        with _kit_modules()["source_read_budget"]() as budget:
            return _attest(root, state, node_key, branch, budget=budget, **kwargs)
    except (ValueError, OSError, RuntimeError) as error:
        raise ContractError(f"release runtime admission failed: {error}") from error

def _attest(root: Path, state: dict[str, Any], node_key: str, branch: str, *, budget: Any, kind: str | None = None, run_tuple: Mapping[str, Any] | None = None, project_fields: Mapping[str, Any] | None = None) -> dict[str, Any]:
    kit = _kit_modules()
    controller = state.get("controller_commit", state["commit"])
    selected_commit = run_tuple["head_sha"] if run_tuple is not None else controller
    revision = kit["preflight_project_revision"](root, selected_commit, budget=budget)
    selected = revision.selected_runtime_source_inputs
    if selected is None or selected.project_commit != selected_commit:
        raise ContractError("selected sealed RuntimeSourceInputs are missing or stale")
    profile = kit["ProjectProfile"].from_toml(root, _revision_blob(root, kit, selected_commit, ".kent/workflow-profile.toml").decode("utf-8"), source=".kent/workflow-profile.toml", check_files=False)
    # T supplies observations, never a weaker policy for observing itself.
    policy_profile = kit["ProjectProfile"].from_toml(root, _revision_blob(root, kit, controller, ".kent/workflow-profile.toml").decode("utf-8"), check_files=False)
    spec = _load_release_spec(root, kit, policy_profile, revision=controller)
    captures = _external_captures(root, profile, selected, budget=budget)
    if run_tuple is None:
        execution = {"kind":"kent_transition","task_id":state["task_id"],"task_short_id":state["task_short_id"],"workflow_id":WORKFLOW_ID,"workflow_revision":WORKFLOW_REVISION,"project_id":PROJECT_ID,"project_commit":controller,"authority_transition":branch}
        authority = {"kind":"kent_transition","task_short_id":state["task_short_id"],"workflow_id":WORKFLOW_ID,"workflow_revision":WORKFLOW_REVISION,"project_id":PROJECT_ID,"approval_authority":"publish-release","authority_transition":branch}
    else:
        execution = {"kind":"github_run", **dict(run_tuple)}
        authority = {"kind":"github_run", **{key: value for key, value in run_tuple.items() if key != "repository"}}
    context = kit["capture_runtime_execution_context"](selected, execution)
    binding = kit["capture_runtime_authority_binding_verified"](selected, captures, context, authority, envelope_version=2)
    canonicalized = None
    if kind:
        variant_key = {"publish": "publish_after_merge", "observe": "observe_release", "observe_release": "observe_release"}.get(kind)
        if variant_key is None:
            raise ContractError(f"unsupported operation kind: {kind}")
        variant = next((item for item in spec.operation_variants if item.key == variant_key), None)
        if variant is None:
            raise ContractError(f"missing ReleaseSpec operation variant: {variant_key}")
        jobs = kit["validate_operation_jobs"](variant, _normalized_sources(root, kit, spec, revision=selected_commit), required=spec.required_jobs_v1, qualification=spec.qualification_jobs_v1, effect=spec.effect_jobs_v1)
        operation = {"schema_version":1,"variant_key":variant_key,"operation_kind":variant.operation_kind,"repository":"rovkinmax/Puber","runtime_source_envelope_digest":binding.runtime_source_envelope_digest,"operation_jobs_manifest_digest":jobs.operation_jobs_manifest_digest,"authority":authority,"project_fields":dict(project_fields or {})}
        canonicalized = kit["canonicalize_publication_operation"](operation, variant, jobs, spec=spec, runtime_execution_context=context, runtime_authority_binding=binding)
    return {"kit":kit,"profile":profile,"spec":spec,"selected":selected,"context":context,"binding":binding,"operation":canonicalized}

def resolve_merge_strategy(root: Path, state: dict, payload: dict) -> str:
    kit = _kit_modules()
    profile_blob = _revision_blob(
        root,
        kit,
        state.get("controller_commit", state["commit"]),
        ".kent/workflow-profile.toml",
    )
    try:
        profile_data = tomllib.loads(profile_blob.decode("utf-8"))
    except (TOMLDecodeError, UnicodeDecodeError) as error:
        raise ContractError("selected profile TOML is invalid") from error
    policies = profile_data.get("policies", {})
    if not isinstance(policies, dict):
        raise ContractError("selected profile policies must be a TOML table")
    configured_policy = policies.get("pr_merge_strategy", "auto")
    if not isinstance(configured_policy, str):
        raise ContractError("policies.pr_merge_strategy must be a string")
    merge_policy = configured_policy.strip()
    if merge_policy not in {"auto", "merge", "squash", "rebase"}:
        raise ContractError("policies.pr_merge_strategy is unsupported")
    repository = gh_api(root, f"repos/{REPOSITORY}")
    rules_response = gh(root, ["api", f"repos/{REPOSITORY}/rules/branches/master"])
    if rules_response.returncode:
        raise ContractError("active branch rules are unavailable")
    rules = _json_one(b'{"rules":' + rules_response.stdout.encode("utf-8") + b'}')["rules"]
    protection = gh_api(root, f"repos/{REPOSITORY}/branches/master/protection", allow_404=True)
    if (not isinstance(repository, dict) or repository.get("full_name") != REPOSITORY
            or repository.get("default_branch") != "master" or not isinstance(rules, list)
            or any(not isinstance(rule, dict) for rule in rules)
            or protection is not None and not isinstance(protection, dict)):
        raise ContractError("merge rules readback is incomplete")
    resolution = kit["resolve_github_merge_strategy"](merge_policy, {
        "repository": repository, "branch_protection": protection,
        "rulesets": [{"enforcement": "active", "rules": rules}],
    })
    if resolution.outcome != "resolved" or resolution.strategy != payload["merge_strategy"]:
        raise ContractError("merge strategy does not match the current unique rules resolution")
    return resolution.strategy


def qualify_merged_target(root: Path, state: dict[str, Any], target: str, preparation: Mapping[str, Any]) -> None:
    """Recompute immutable T qualification under H policy; never acquire objects."""
    try:
        kit = _kit_modules()
        with kit["source_read_budget"]() as budget:
            head = state.get("controller_commit", state["commit"])
            if not SHA1.fullmatch(target) or git(root, "rev-parse", "HEAD") != head:
                raise ContractError("publication controller differs from the admitted current source H")
            if preparation["release_head_oid"] != head:
                raise ContractError("preparation proof is not bound to controller H")
            for commit in dict.fromkeys((head, target)):
                selected = kit["preflight_project_revision"](root, commit, budget=budget).selected_runtime_source_inputs
                if selected is None or selected.project_commit != commit:
                    raise ContractError("release target source closure is missing or stale")
                # Verify the complete closure even though this validation does not emit an envelope.
                kit["verify_runtime_source_captures"](root, selected, budget=budget)
            profile_raw = _revision_blob(root, kit, head, ".kent/workflow-profile.toml")
            profile = kit["ProjectProfile"].from_toml(root, profile_raw.decode("utf-8"), check_files=False)
            spec = _load_release_spec(root, kit, profile, revision=head)
            for path, expected in {
                "app/build.gradle.kts": preparation["version_file_sha256"],
                "app/src/main/generated/baselineProfiles/baseline-prof.txt": preparation["baseline_profile_sha256"],
                "app/src/main/generated/baselineProfiles/startup-prof.txt": preparation["startup_profile_sha256"],
            }.items():
                if sha256_bytes(_revision_blob(root, kit, target, path)) != expected:
                    raise ContractError(f"merged target blob does not match preparation proof: {path}")
            # The owning signing contract pins the prepared app source and tracked
            # validation key, and forbids committed production signing inputs. It
            # does not freeze arbitrary Gradle configuration or buildSrc trees.
            if sha256_bytes(_revision_blob(root, kit, target, "app/debug.jks")) != VALIDATION_SIGNING["validation_signing_sha256"]:
                raise ContractError("target tracked validation signing key drifted")
            for path in ("app/keystore.properties", "app/release.jks"):
                if kit["run_git"](root, "ls-tree", target, "--", path).stdout.strip():
                    raise ContractError("target contains a forbidden production signing input")
            variant = next(item for item in spec.operation_variants if item.key == "publish_after_merge")
            target_sources = _normalized_sources(root, kit, spec, revision=target)
            kit["validate_operation_jobs"](variant, target_sources, required=spec.required_jobs_v1,
                                           qualification=spec.qualification_jobs_v1, effect=spec.effect_jobs_v1)
            for path in sorted({row["workflow_path"] for row in spec.effect_jobs_v1.jobs}):
                allowed = _normalized_workflow(root, path, revision=head)
                actual = _normalized_workflow(root, path, revision=target)
                allowed_keys = {row["job_key"] for row in spec.effect_jobs_v1.jobs if row["workflow_path"] == path}
                if {job["job_key"] for job in allowed["jobs"]} != allowed_keys or actual != allowed:
                    raise ContractError("target production workflow differs from full authorized H policy")
    except (ValueError, OSError, RuntimeError) as error:
        raise ContractError(f"merged target qualification failed: {error}") from error

def revalidate_publication_target(root: Path, state: dict[str, Any], publication: Mapping[str, Any]) -> None:
    """Monitor retains the H checkpoint; master may advance after publication."""
    checkpoint = read_profile_checkpoint(root, state["task_short_id"], expected={
        "task_id": state["task_id"], "task_short_id": state["task_short_id"],
        "release_head_oid": publication["release_head_oid"],
    })
    preparation = validate_preparation_proof(root, {
        "operation_id": checkpoint["operation_id"], "branch_name": checkpoint["release_branch"],
        "release_base_oid": checkpoint["release_base_oid"], "candidate_oid": checkpoint["candidate_oid"],
    }, state, publication["release_version"], publication["release_tag"], publication["release_head_oid"])
    if digest_json(preparation) != publication["release_preparation_report_digest"]:
        raise ContractError("publication preparation digest differs from H checkpoint")
    qualify_merged_target(root, state, publication["target_commit"], preparation)

def validate_preparation_proof(root: Path, payload: dict, state: dict, version: str, tag: str, pr_head_oid: str) -> dict:
    expected = {
        "task_id": state["task_id"], "task_short_id": state["task_short_id"],
        "operation_id": payload.get("operation_id", ""),
        "release_type": declarations(state["task"].get("body")).get("release_type", "minor"),
        "release_version": version, "release_tag": tag,
        "release_branch": payload.get("branch_name", f"release/{version}"),
    }
    for key in ("release_base_oid", "candidate_oid"):
        if payload.get(key):
            expected[key] = payload[key]
    checkpoint = read_profile_checkpoint(root, state["task_short_id"], expected=expected)
    for key in ("release_base_oid", "candidate_oid"):
        if key in expected and checkpoint[key] != expected[key]:
            raise ContractError(f"profile checkpoint {key} drifted")
        expected[key] = checkpoint[key]
    if checkpoint["state"] != "completed" or checkpoint["release_head_oid"] != pr_head_oid:
        raise ContractError("release preparation checkpoint is not complete or PR head-bound")
    profile = parse_profile_report(
        checkpoint["profile_report"], checkpoint["profile_report_digest"], expected=expected
    )
    preparation = parse_release_preparation_report(
        checkpoint["release_preparation_report"],
        checkpoint["release_preparation_report_digest"],
        expected=expected,
    )
    if preparation["release_head_oid"] != pr_head_oid or preparation["profile_report_digest"] != checkpoint["profile_report_digest"]:
        raise ContractError("release preparation proof is not bound to the exact PR head")
    validate_release_diff(
        root,
        checkpoint["release_base_oid"],
        pr_head_oid,
        profile,
        preparation,
    )
    expected_blobs = {
        "app/build.gradle.kts": preparation["version_file_sha256"],
        "app/src/main/generated/baselineProfiles/baseline-prof.txt": preparation["baseline_profile_sha256"],
        "app/src/main/generated/baselineProfiles/startup-prof.txt": preparation["startup_profile_sha256"],
    }
    profile_hashes = {
        "app/src/main/generated/baselineProfiles/baseline-prof.txt": (
            profile["baseline_before_sha256"],
            profile["baseline_after_sha256"],
        ),
        "app/src/main/generated/baselineProfiles/startup-prof.txt": (
            profile["startup_before_sha256"],
            profile["startup_after_sha256"],
        ),
    }
    actual_changed_profiles = {
        path for path, (before_hash, after_hash) in profile_hashes.items()
        if before_hash != after_hash
    }
    if set(profile["changed_profiles"]) != actual_changed_profiles:
        raise ContractError("profile report contains a synthetic or omitted changed-profile entry")
    if any(
        git_blob_sha256(root, checkpoint["release_base_oid"], path) != before_hash
        for path, (before_hash, _after_hash) in profile_hashes.items()
    ):
        raise ContractError("release-base profile blob does not match the profile report")
    if any(
        expected_blobs[path] != after_hash
        for path, (_before_hash, after_hash) in profile_hashes.items()
    ):
        raise ContractError("profile and preparation report blob hashes disagree")
    allowed = {"app/build.gradle.kts", *actual_changed_profiles}
    if set(preparation["final_changed_paths"]) != allowed:
        raise ContractError("release preparation changed path set is not exact")
    for path in expected_blobs:
        if git_blob_sha256(root, pr_head_oid, path) != expected_blobs[path]:
            raise ContractError(f"PR head blob does not match preparation proof: {path}")
    return preparation

def declarations(body: Any) -> dict[str, str]:
    values = {}
    if isinstance(body, str):
        for line in body.splitlines():
            match = re.match(r"^\s*(?:[-*]\s+)?([A-Za-z][A-Za-z0-9_-]*)\s*:\s*(.*?)\s*$", line)
            if match and match.group(1) in {"release_type","release_version","release_tag","release_branch"}:
                key, value = match.group(1), match.group(2).strip().strip("`\"'")
                if key in values and values[key] != value:
                    raise ContractError("Task release declarations are ambiguous")
                values[key] = value
    return values

def canonical_pr_url(value: Any) -> str:
    url = require_string(value, "pr_url")
    parsed = urlsplit(url)
    if parsed.scheme != "https" or parsed.netloc != "github.com" or parsed.query or parsed.fragment or not re.fullmatch(r"/rovkinmax/Puber/pull/[1-9][0-9]*", parsed.path):
        raise ContractError("pr_url is not canonical")
    return url

def remote_master(root: Path) -> str:
    result = gh_api(root, f"repos/{REPOSITORY}/git/ref/heads/master")
    if not isinstance(result, dict) or set(result) - {"ref", "node_id", "url", "object"} or result.get("ref") != "refs/heads/master":
        raise ContractError("remote master response is not exact")
    obj = result.get("object")
    if not isinstance(obj, dict) or obj.get("type") != "commit" or not SHA1.fullmatch(str(obj.get("sha", ""))):
        raise ContractError("remote master does not resolve to an exact commit")
    return obj["sha"]

def gh(
    root: Path,
    args: list[str],
    *,
    input_text: str | None = None,
    provider_guard: Callable[[], None] | None = None,
) -> subprocess.CompletedProcess[str]:
    (
        github_provider_read_guard(root)
        if provider_guard is None
        else provider_guard
    )()
    return run([os.environ.get("PUBER_GH_BIN", shutil.which("gh") or "gh"), *args], cwd=root, env=child_env(), check=False, input_text=input_text)

def gh_api(
    root: Path,
    endpoint: str,
    *,
    headers: list[str] | None = None,
    allow_404: bool = False,
    provider_guard: Callable[[], None] | None = None,
) -> Any:
    args = ["api", endpoint]
    for header in headers or []:
        args.extend(["--header", header])
    result = gh(root, args, provider_guard=provider_guard)
    if result.returncode != 0:
        if allow_404 and "404" in (result.stderr or ""):
            return None
        raise GitHubProviderRequestError("GitHub API request failed")
    return _json_one(result.stdout.encode("utf-8"))

def gh_api_bytes(
    root: Path,
    endpoint: str,
    *,
    provider_guard: Callable[[], None] | None = None,
) -> bytes:
    (
        github_provider_read_guard(root)
        if provider_guard is None
        else provider_guard
    )()
    binary = run_bytes([os.environ.get("PUBER_GH_BIN", shutil.which("gh") or "gh"), "api", endpoint, "--header", "Accept: application/octet-stream"], cwd=root, env=child_env(), check=False)
    if binary.returncode != 0:
        raise GitHubProviderRequestError("GitHub asset download failed")
    return binary.stdout

def pr_state(
    root: Path,
    url: str,
    *,
    expected_base_branch: str = "master",
) -> dict[str, Any]:
    expected_base_branch = require_string(
        expected_base_branch, "expected_pr_base_branch"
    )
    number = int(urlsplit(url).path.rsplit("/", 1)[1])
    value = gh_api(root, f"repos/{REPOSITORY}/pulls/{number}")
    if not isinstance(value, dict):
        raise ContractError("PR API response is not an object")
    base, head, repo = value.get("base"), value.get("head"), value.get("base", {}).get("repo") if isinstance(value.get("base"), dict) else None
    if value.get("html_url") != url or value.get("state") != "closed" or value.get("merged_at") is None or value.get("merged") is not True:
        raise ContractError("PR is not exact merged evidence")
    if not isinstance(base, dict) or not isinstance(head, dict) or not isinstance(repo, dict) or base.get("ref") != expected_base_branch or base.get("repo", {}).get("full_name") != REPOSITORY or head.get("repo", {}).get("full_name") != REPOSITORY:
        raise ContractError("PR is not same-repository evidence for the expected target branch")
    if not SHA1.fullmatch(str(head.get("sha", ""))) or not SHA1.fullmatch(str(base.get("sha", ""))) or not SHA1.fullmatch(str(value.get("merge_commit_sha", ""))):
        raise ContractError("PR OID evidence is not exact")
    return {"url": url, "state": "MERGED", "mergedAt": value["merged_at"], "headRefName": head.get("ref"), "headRefOid": head["sha"], "baseRefName": base["ref"], "baseRefOid": base["sha"], "mergeCommit": {"oid": value["merge_commit_sha"]}, "isCrossRepository": False}

def local_tag(root: Path, tag: str) -> str:
    value = git(root, "rev-parse", f"refs/tags/{tag}^{{commit}}", check=False)
    return value if SHA1.fullmatch(value) else ""

def remote_tag(
    root: Path,
    tag: str,
    *,
    provider_guard: Callable[[], None] | None = None,
) -> str:
    value = gh_api(
        root,
        f"repos/{REPOSITORY}/git/ref/tags/{tag}",
        allow_404=True,
        provider_guard=provider_guard,
    )
    if value is None:
        return ""
    if not isinstance(value, dict) or value.get("ref") != f"refs/tags/{tag}" or not isinstance(value.get("object"), dict):
        raise ContractError("remote tag response is not exact")
    obj = value["object"]
    if obj.get("type") == "commit" and SHA1.fullmatch(str(obj.get("sha", ""))):
        return obj["sha"]
    if obj.get("type") == "tag" and SHA1.fullmatch(str(obj.get("sha", ""))):
        annotated = gh_api(
            root,
            f"repos/{REPOSITORY}/git/tags/{obj['sha']}",
            provider_guard=provider_guard,
        )
        if isinstance(annotated, dict) and isinstance(annotated.get("object"), dict) and annotated["object"].get("type") == "commit" and SHA1.fullmatch(str(annotated["object"].get("sha", ""))):
            return annotated["object"]["sha"]
    raise ContractError("remote tag does not resolve to an exact commit")

def remote_release_tags(root: Path) -> list[str]:
    result = run(["git", "ls-remote", "--tags", "origin", "refs/tags/v*"], cwd=root, check=False)
    if result.returncode != 0:
        raise ContractError(result.stderr.strip() or "exact remote release tag line is unavailable")
    output = result.stdout
    tags = set()
    for line in output.splitlines():
        fields = line.split()
        if len(fields) >= 2:
            name = fields[1].removeprefix("refs/tags/").removesuffix("^{}")
            if TAG.fullmatch(name):
                tags.add(name)
    return sorted(tags, key=lambda value: tuple(int(part) for part in value[1:].split(".")))

def parse_run_carrier(raw: Any) -> dict[str, Any]:
    if isinstance(raw, str):
        value = _json_one(raw.encode("utf-8"))
    elif isinstance(raw, dict):
        value = raw
    else:
        raise ContractError("release_run carrier is not an object or JSON object")
    if value == NOT_SELECTED_RUN:
        return dict(value)
    if set(value) != RUN_KEYS or value.get("schema") != "puber_release_run_v1" or value.get("state") != "selected":
        raise ContractError("release_run carrier is not closed")
    if value.get("repository") != REPOSITORY or value.get("workflow_path") != ".github/workflows/release.yml" or value.get("workflow_name") != "Release" or value.get("event") != "push":
        raise ContractError("release_run carrier workflow identity drifted")
    if isinstance(value.get("run_id"), bool) or not isinstance(value.get("run_id"), int) or value["run_id"] <= 0 or isinstance(value.get("attempt"), bool) or not isinstance(value.get("attempt"), int) or value["attempt"] <= 0:
        raise ContractError("release_run carrier IDs are invalid")
    if not SHA1.fullmatch(str(value.get("head_sha", ""))) or not TAG.fullmatch(str(value.get("head_branch", ""))) or value.get("ref") != f"refs/tags/{value['head_branch']}":
        raise ContractError("release_run carrier ref/head is invalid")
    return dict(value)

def selected_run_context(run: Mapping[str, Any]) -> dict[str, Any]:
    return {key: run[key] for key in ("repository", "workflow_path", "workflow_name", "event", "run_id", "attempt", "head_sha", "ref")}

def parse_notes_report(raw: Any, root: Path, task_short_id: str, *, expected_tag: str | None = None, expected_target: str | None = None) -> dict[str, Any]:
    value = raw if isinstance(raw, dict) else parse_closed_json(raw, "puber_release_notes_v1", NOTES_KEYS)
    if set(value) != NOTES_KEYS or value.get("schema") != "puber_release_notes_v1":
        raise ContractError("notes report is not closed")
    path = validate_notes_path(root, value.get("path"), task_short_id=task_short_id)
    if value.get("mode") != 0o600 or not isinstance(value.get("bytes"), int) or value["bytes"] <= 0 or not HEX64.fullmatch(str(value.get("sha256", ""))) or value.get("encoding") != "UTF-8" or value.get("line_endings") != "LF" or value.get("final_newline") is not True or value.get("producer") != ".kent/scripts/workflow-puber-release-publish":
        raise ContractError("notes report metadata is not canonical")
    target = require_string(value.get("target_commit"), "notes target_commit")
    if not SHA1.fullmatch(target) or expected_target and target != expected_target:
        raise ContractError("notes target commit is not exact")
    previous = value.get("previous_tag")
    if previous:
        if not TAG.fullmatch(previous) or expected_tag and tuple(int(part) for part in previous[1:].split(".")) >= tuple(int(part) for part in expected_tag[1:].split(".")):
            raise ContractError("notes previous_tag is not strictly lower than the release tag")
        if previous not in remote_release_tags(root):
            raise ContractError("notes previous_tag is not present in the exact remote release tag line")
    elif previous != "":
        raise ContractError("notes previous_tag must be empty or an exact release tag")
    if expected_tag and value.get("range") != (f"{previous}..{target}" if previous else target):
        raise ContractError("notes range is not exact")
    body = (root / path).read_bytes()
    mode = stat.S_IMODE((root / path).stat().st_mode)
    if mode != 0o600 or len(body) != value["bytes"] or sha256_bytes(body) != value["sha256"] or b"\r" in body or not body.endswith(b"\n") or not re.search(r"[А-Яа-яЁё]", body.decode("utf-8")):
        raise ContractError("notes bytes/readback are not canonical")
    return dict(value)

def parse_profile_report(raw: Any, digest: Any, *, expected: Mapping[str, Any] | None = None) -> dict[str, Any]:
    value = raw if isinstance(raw, dict) else parse_closed_json(raw, "puber_profile_report_v1", PROFILE_REPORT_KEYS)
    if set(value) != PROFILE_REPORT_KEYS or value.get("schema") != "puber_profile_report_v1":
        raise ContractError("profile report is not closed")
    encoded = canonical_json(value).encode("utf-8")
    if not isinstance(digest, str) or digest != sha256_bytes(encoded) or not HEX64.fullmatch(digest):
        raise ContractError("profile report digest mismatch")
    for key in ("operation_id", "task_short_id", "release_type", "release_version",
                "release_tag", "release_branch", "release_base_oid", "candidate_oid"):
        if expected is not None and key in expected and value.get(key) != expected[key]:
            raise ContractError(f"profile report {key} drifted")
    if value.get("command") != ".kent/scripts/workflow-puber-release-profile-generation:tools/generate-baseline-profile.sh" or value.get("lease_state") != "released" or value.get("generation_state") != "passed" or value.get("network_isolation_state") != "passed":
        raise ContractError("profile report command or state is not exact")
    if not re.fullmatch(r"^emulator-[A-Za-z0-9._=-]+$", str(value.get("tv_serial", ""))):
        raise ContractError("profile report TV serial is not an emulator serial")
    if isinstance(value.get("elapsed_ms"), bool) or not isinstance(value.get("elapsed_ms"), int) or value["elapsed_ms"] < 0:
        raise ContractError("profile report elapsed_ms is invalid")
    for key in ("baseline_before_sha256", "baseline_after_sha256", "startup_before_sha256", "startup_after_sha256"):
        if not HEX64.fullmatch(str(value.get(key, ""))):
            raise ContractError("profile report output hash is invalid")
    changed = value.get("changed_profiles")
    if not isinstance(changed, list) or changed != sorted(changed) or len(changed) != len(set(changed)) or any(item not in {"app/src/main/generated/baselineProfiles/baseline-prof.txt", "app/src/main/generated/baselineProfiles/startup-prof.txt"} for item in changed):
        raise ContractError("profile report changed profile set is invalid")
    return dict(value)

def parse_release_preparation_report(raw: Any, digest: Any, *, expected: Mapping[str, Any] | None = None) -> dict[str, Any]:
    value = raw if isinstance(raw, dict) else parse_closed_json(raw, "puber_release_preparation_report_v2", PREPARATION_REPORT_KEYS)
    if set(value) != PREPARATION_REPORT_KEYS or value.get("schema") != "puber_release_preparation_report_v2":
        raise ContractError("release preparation report is not closed")
    if any(type(value.get(key)) is not type(wanted) or value[key] != wanted for key, wanted in VALIDATION_SIGNING.items()):
        raise ContractError("release preparation signing proof drifted")
    encoded = canonical_json(value).encode("utf-8")
    if not isinstance(digest, str) or digest != sha256_bytes(encoded) or not HEX64.fullmatch(digest):
        raise ContractError("release preparation report digest mismatch")
    for key in ("operation_id", "task_short_id", "release_type", "release_version",
                "release_tag", "release_branch", "release_base_oid", "candidate_oid",
                "release_head_oid"):
        if expected is not None and key in expected and value.get(key) != expected[key]:
            raise ContractError(f"release preparation report {key} drifted")
    for key in ("release_base_oid", "candidate_oid", "release_head_oid"):
        if not SHA1.fullmatch(str(value.get(key, ""))):
            raise ContractError("release preparation report commit identity is invalid")
    if not HEX64.fullmatch(str(value.get("profile_report_digest", ""))):
        raise ContractError("release preparation profile digest is invalid")
    if value.get("compile_command") != "./tools/agentw :app:compileProdReleaseArtProfile" or value.get("assemble_command") != "./tools/agentw :app:assembleProdRelease" or value.get("compile_state") != "passed" or value.get("assemble_state") != "passed":
        raise ContractError("release preparation packaging proof is not exact")
    changed = value.get("final_changed_paths")
    allowed = {"app/build.gradle.kts", "app/src/main/generated/baselineProfiles/baseline-prof.txt", "app/src/main/generated/baselineProfiles/startup-prof.txt"}
    if not isinstance(changed, list) or changed != sorted(changed) or len(changed) != len(set(changed)) or any(item not in allowed for item in changed) or "app/build.gradle.kts" not in changed:
        raise ContractError("release preparation changed path set is invalid")
    for key in ("version_file_sha256", "baseline_profile_sha256", "startup_profile_sha256"):
        if not HEX64.fullmatch(str(value.get(key, ""))):
            raise ContractError("release preparation blob hash is invalid")
    if not isinstance(value.get("no_profile_diff"), bool) or value["no_profile_diff"] != (not any(item.startswith("app/src/main/generated/baselineProfiles/") for item in changed)):
        raise ContractError("release preparation no-profile-diff state is invalid")
    if isinstance(value.get("elapsed_ms"), bool) or not isinstance(value.get("elapsed_ms"), int) or value["elapsed_ms"] < 0:
        raise ContractError("release preparation elapsed_ms is invalid")
    return dict(value)

CHECKPOINT_BASENAME = "release-profile-checkpoint.json"
CHECKPOINT_LIMIT = 2 * 1024 * 1024


def _directory_identity(metadata):
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_mode & 0o022:
        raise ContractError("profile checkpoint directory is unsafe")
    return (metadata.st_dev, metadata.st_ino)


@contextmanager
def _checkpoint_directory(root: Path, task_short_id: str, *, create=False):
    if not isinstance(task_short_id, str) or not TASK_SHORT_ID.fullmatch(task_short_id) or not root.is_absolute():
        raise ContractError("invalid checkpoint root or task identity")
    descriptors = []
    names = (str(root), ".kent", "runtime", task_short_id)
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    try:
        for index, name in enumerate(names):
            parent = descriptors[-1] if descriptors else None
            try:
                fd = os.open(name, flags, dir_fd=parent)
            except FileNotFoundError:
                if index < 2:
                    raise ContractError("validated checkpoint repository directory is missing")
                if not create:
                    raise
                try:
                    os.mkdir(name, mode=0o700, dir_fd=parent)
                    os.fsync(parent)
                except FileExistsError:
                    pass
                fd = os.open(name, flags, dir_fd=parent)
            descriptors.append(fd)
            _directory_identity(os.fstat(fd))
        identities = tuple(_directory_identity(os.fstat(fd)) for fd in descriptors)
        # The admitted directory inode is a stable guard shared by every store
        # operation, without adding a file to the closed Janitor entry set.
        # Non-cooperating same-uid filesystem writes cannot be serialized here.
        try:
            fcntl.flock(descriptors[-1], fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ContractError("profile checkpoint store is busy; retry after the current operation") from error
        def stable():
            for index, (name, fd) in enumerate(zip(names, descriptors)):
                parent = descriptors[index - 1] if index else None
                try:
                    linked = os.stat(name, dir_fd=parent, follow_symlinks=False)
                except OSError as error:
                    raise ContractError("profile checkpoint parent disappeared during access") from error
                if (_directory_identity(os.fstat(fd)) != identities[index]
                    or _directory_identity(linked) != identities[index]):
                    raise ContractError("profile checkpoint parent identity drifted")
        stable()
        yield descriptors[-1], identities, stable
        stable()
    except FileNotFoundError:
        raise
    except OSError as error:
        raise ContractError("profile checkpoint descriptor operation failed") from error
    finally:
        for fd in reversed(descriptors): os.close(fd)


def _checkpoint_metadata(metadata):
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1
        or not 0 < metadata.st_size <= CHECKPOINT_LIMIT):
        raise ContractError("profile checkpoint permissions, type or size are unsafe")
    return (metadata.st_dev, metadata.st_ino, metadata.st_size)


def _read_checkpoint_descriptor(directory):
    fd = os.open(CHECKPOINT_BASENAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    try:
        identity = _checkpoint_metadata(os.fstat(fd))
        chunks = bytearray()
        while len(chunks) <= CHECKPOINT_LIMIT:
            chunk = os.read(fd, min(65536, CHECKPOINT_LIMIT + 1 - len(chunks)))
            if not chunk: break
            chunks.extend(chunk)
        if (_checkpoint_metadata(os.fstat(fd)) != identity or len(chunks) != identity[2]
            or _checkpoint_metadata(os.stat(CHECKPOINT_BASENAME, dir_fd=directory, follow_symlinks=False)) != identity):
            raise ContractError("profile checkpoint read identity drifted")
        raw = bytes(chunks)
        return raw, (*identity, sha256_bytes(raw))
    except OSError as error:
        raise ContractError("profile checkpoint file disappeared or changed during read") from error
    finally:
        os.close(fd)


def read_profile_checkpoint(root: Path, task_short_id: str, *, expected: Mapping[str, Any] | None = None,
                            with_receipt=False, with_snapshot=False, missing_ok=False):
    if with_snapshot and not with_receipt:
        raise ContractError("profile checkpoint snapshot requires its deletion receipt")
    try:
        with _checkpoint_directory(root, task_short_id) as (directory, parents, stable):
            raw, identity = _read_checkpoint_descriptor(directory)
            value = validate_profile_checkpoint(_json_one(raw), expected=expected)
            if value["task_short_id"] != task_short_id:
                raise ContractError("profile checkpoint task drifted")
            stable()
            receipt = (parents, identity)
            if with_snapshot:
                return value, receipt, raw
            return (value, receipt) if with_receipt else value
    except FileNotFoundError as error:
        if missing_ok: return None
        raise ContractError("profile checkpoint is missing") from error


def write_profile_checkpoint(root: Path, task_short_id: str, value: Mapping[str, Any]):
    validate_profile_checkpoint(dict(value), expected={"task_short_id": task_short_id})
    raw = canonical_bytes(value) + b"\n"
    if len(raw) > CHECKPOINT_LIMIT:
        raise ContractError("profile checkpoint exceeds size bound")
    with _checkpoint_directory(root, task_short_id, create=True) as (directory, parents, stable):
        previous = None
        try:
            old_raw, previous = _read_checkpoint_descriptor(directory)
            validate_profile_checkpoint(_json_one(old_raw), expected={"task_short_id": task_short_id})
        except FileNotFoundError:
            pass
        temporary = ".release-profile-" + secrets.token_hex(16) + ".tmp"
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        try:
            os.fchmod(fd, 0o600)
            stream = os.fdopen(fd, "wb")
            fd = None  # The stream now owns this descriptor, including write failures.
            with stream:
                stream.write(raw)
                stream.flush()
                os.fsync(stream.fileno())
                identity = _checkpoint_metadata(os.fstat(stream.fileno()))
            stable()
            try:
                _, current = _read_checkpoint_descriptor(directory)
            except FileNotFoundError:
                current = None
            if current != previous:
                raise ContractError("profile checkpoint changed before replacement")
            os.replace(temporary, CHECKPOINT_BASENAME, src_dir_fd=directory, dst_dir_fd=directory)
            os.fsync(directory)
            result, receipt = _read_checkpoint_descriptor(directory)
            if result != raw or receipt != (*identity, sha256_bytes(raw)):
                raise ContractError("profile checkpoint canonical write readback drifted")
            stable()
        finally:
            if fd is not None: os.close(fd)
            try: os.unlink(temporary, dir_fd=directory)
            except FileNotFoundError: pass


def delete_profile_checkpoint(root: Path, task_short_id: str, receipt):
    with _checkpoint_directory(root, task_short_id) as (directory, parents, stable):
        if parents != receipt[0]:
            raise ContractError("profile checkpoint deletion parent receipt mismatch")
        _, identity = _read_checkpoint_descriptor(directory)
        if identity != receipt[1]:
            raise ContractError("profile checkpoint deletion file receipt mismatch")
        stable()
        os.unlink(CHECKPOINT_BASENAME, dir_fd=directory)
        os.fsync(directory)
        try:
            os.stat(CHECKPOINT_BASENAME, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            return
        raise ContractError("profile checkpoint deletion absence proof failed")


def validate_profile_checkpoint(value, *, expected=None):
    if not isinstance(value, dict) or set(value) != PROFILE_CHECKPOINT_KEYS or value.get("schema") != "puber_release_profile_checkpoint_v2":
        raise ContractError("profile checkpoint field set is not closed")
    if any(key in value for key in ("token", "credential", "environment")):
        raise ContractError("profile checkpoint contains sensitive fields")
    for key in ("task_id", "task_short_id", "operation_id", "release_branch", "release_base_oid", "candidate_oid", "release_head_oid", "resource_serial", "profile_report", "profile_report_digest", "release_preparation_report", "release_preparation_report_digest"):
        if not isinstance(value.get(key), str):
            raise ContractError("profile checkpoint string field is invalid")
    if not TASK_ID.fullmatch(value["task_id"]) or not TASK_SHORT_ID.fullmatch(value["task_short_id"]) or not HEX64.fullmatch(value["operation_id"]) or not RELEASE_BRANCH.fullmatch(value["release_branch"]) or not SHA1.fullmatch(value["release_base_oid"]) or not SHA1.fullmatch(value["candidate_oid"]) or (value["release_head_oid"] and not SHA1.fullmatch(value["release_head_oid"])):
        raise ContractError("profile checkpoint identity is invalid")
    identity_keys = (
        "task_id", "task_short_id", "operation_id", "release_branch",
        "release_base_oid", "candidate_oid", "release_head_oid",
    )
    if expected is not None and any(key in expected and value.get(key) != expected[key] for key in identity_keys):
        raise ContractError("profile checkpoint identity drifted")
    if not isinstance(value["state"], str) or value["state"] not in {"acquiring", "generating", "failed", "completed"}:
        raise ContractError("profile checkpoint state is invalid")
    if not isinstance(value["candidate_serials"], list) or any(not isinstance(item, str) for item in value["candidate_serials"]) or value["candidate_serials"] != sorted(value["candidate_serials"]) or any(not re.fullmatch(r"^emulator-[A-Za-z0-9._=-]+$", str(item)) for item in value["candidate_serials"]):
        raise ContractError("profile checkpoint candidate serials are invalid")
    serials = value["candidate_serials"]
    if len(serials) != len(set(serials)) or (not serials and value["state"] != "failed"):
        raise ContractError("profile checkpoint serial set is invalid")
    if value["resource_serial"] and value["resource_serial"] not in serials:
        raise ContractError("profile checkpoint resource is not selected")
    hashes = value["output_hashes"]
    paths = {"app/src/main/generated/baselineProfiles/baseline-prof.txt", "app/src/main/generated/baselineProfiles/startup-prof.txt"}
    if not isinstance(hashes, dict) or set(hashes) != paths or any(not isinstance(h, str) or not HEX64.fullmatch(h) for h in hashes.values()):
        raise ContractError("profile checkpoint output hashes are invalid")
    bound = dict(expected or {})
    bound.update({key: value[key] for key in identity_keys})
    version = value["release_branch"].removeprefix("release/")
    bound.update({"release_version": version, "release_tag": "v" + version})
    if bool(value["profile_report"]) != bool(value["profile_report_digest"]):
        raise ContractError("profile checkpoint profile proof is incomplete")
    if value["profile_report"]:
        profile = parse_profile_report(value["profile_report"], value["profile_report_digest"], expected=bound)
        if profile["tv_serial"] != value["resource_serial"] or any(hashes[path] != profile[key] for path, key in (
            ("app/src/main/generated/baselineProfiles/baseline-prof.txt", "baseline_after_sha256"),
            ("app/src/main/generated/baselineProfiles/startup-prof.txt", "startup_after_sha256"))):
            raise ContractError("profile checkpoint nested profile identity drifted")
    if value["state"] == "completed" and not value["profile_report"]:
        raise ContractError("completed checkpoint lacks profile proof")
    if bool(value["release_preparation_report"]) != bool(value["release_preparation_report_digest"]):
        raise ContractError("profile checkpoint preparation proof is incomplete")
    if value["release_preparation_report"]:
        if not value["profile_report"]:
            raise ContractError("preparation checkpoint lacks profile proof")
        bound["release_type"] = profile["release_type"]
        preparation = parse_release_preparation_report(value["release_preparation_report"], value["release_preparation_report_digest"], expected=bound)
        if value["state"] != "completed" or preparation["profile_report_digest"] != value["profile_report_digest"] or preparation["baseline_profile_sha256"] != hashes["app/src/main/generated/baselineProfiles/baseline-prof.txt"] or preparation["startup_profile_sha256"] != hashes["app/src/main/generated/baselineProfiles/startup-prof.txt"]:
            raise ContractError("profile checkpoint nested preparation identity drifted")
    return value

def git_blob_sha256(root: Path, revision: str, relative: str) -> str:
    if not SHA1.fullmatch(revision) or relative not in {"app/build.gradle.kts", "app/src/main/generated/baselineProfiles/baseline-prof.txt", "app/src/main/generated/baselineProfiles/startup-prof.txt"}:
        raise ContractError("release blob request is outside the closed allowlist")
    try:
        return sha256_bytes(_revision_blob(root, _kit_modules(), revision, relative))
    except (ValueError, OSError, RuntimeError) as error:
        raise ContractError(f"release blob is missing or unsafe: {relative}") from error

def release_diff_paths(root: Path, base_oid: str, head_oid: str) -> list[str]:
    if not SHA1.fullmatch(base_oid) or not SHA1.fullmatch(head_oid):
        raise ContractError("release diff OIDs are not exact")
    result = run(["git", "diff", "--name-only", "--no-renames", f"{base_oid}..{head_oid}"], cwd=root, check=False)
    if result.returncode != 0:
        raise ContractError("release diff cannot be read")
    paths = [line for line in result.stdout.splitlines() if line]
    if len(paths) != len(set(paths)):
        raise ContractError("release diff contains duplicate paths")
    allowed = {"app/build.gradle.kts", "app/src/main/generated/baselineProfiles/baseline-prof.txt", "app/src/main/generated/baselineProfiles/startup-prof.txt"}
    if any(path not in allowed for path in paths) or "app/build.gradle.kts" not in paths:
        raise ContractError("release diff contains an unrelated path or omits the version bump")
    return sorted(paths)

def validate_release_diff(root: Path, base_oid: str, head_oid: str, profile_report: Mapping[str, Any], preparation_report: Mapping[str, Any]) -> list[str]:
    paths = release_diff_paths(root, base_oid, head_oid)
    changed_profiles = profile_report.get("changed_profiles")
    expected = {"app/build.gradle.kts", *(changed_profiles if isinstance(changed_profiles, list) else [])}
    if set(paths) != expected or paths != sorted(preparation_report.get("final_changed_paths", [])):
        raise ContractError("release diff does not match the closed profile/preparation reports")
    return paths

def publication_report(operation_digest: str, pr_url: str, version: str, tag: str, target: str, notes: Mapping[str, Any], *, tag_phase: str, tag_status: str, unresolved: bool, previous_operation_digest: str = "", release_head_oid: str = "", release_preparation_report_digest: str = "") -> tuple[str, str]:
    if not HEX64.fullmatch(operation_digest):
        raise ContractError("operation digest is not exact")
    if previous_operation_digest and not HEX64.fullmatch(previous_operation_digest):
        raise ContractError("previous operation digest is not exact")
    if not SHA1.fullmatch(target) or not SHA1.fullmatch(release_head_oid) or not HEX64.fullmatch(release_preparation_report_digest):
        raise ContractError("publication provenance identity is not exact")
    report = {"schema": "puber_publication_report_v1", "operation_digest": operation_digest, "previous_operation_digest": previous_operation_digest, "pr_url": pr_url, "release_version": version, "release_tag": tag, "target_commit": target, "release_head_oid": release_head_oid, "release_preparation_report_digest": release_preparation_report_digest, "notes_report": dict(notes), "notes_digest": notes["sha256"], "tag_phase": tag_phase, "tag_status": tag_status, "unresolved": unresolved}
    encoded = canonical_json(report)
    return encoded, sha256_bytes(encoded.encode("utf-8"))

def parse_publication_report(raw: Any, digest: Any, *, expected_pr: str | None = None, expected_version: str | None = None, expected_tag: str | None = None, expected_target: str | None = None, task_short_id: str | None = None, root: Path | None = None, expected_release_head: str | None = None, expected_preparation_digest: str | None = None) -> dict[str, Any]:
    value = raw if isinstance(raw, dict) else parse_closed_json(raw, "puber_publication_report_v1", PUBLICATION_KEYS)
    if set(value) != PUBLICATION_KEYS or value.get("schema") != "puber_publication_report_v1":
        raise ContractError("publication report is not closed")
    if not isinstance(digest, str) or digest != sha256_bytes(canonical_json(value).encode("utf-8")) or not HEX64.fullmatch(digest) or not HEX64.fullmatch(str(value.get("operation_digest", ""))):
        raise ContractError("publication report digest mismatch")
    safe_version_tag(value.get("release_version"), value.get("release_tag"))
    if expected_version and value["release_version"] != expected_version or expected_tag and value["release_tag"] != expected_tag:
        raise ContractError("publication report version/tag drifted")
    if expected_pr and value["pr_url"] != expected_pr or expected_target and value["target_commit"] != expected_target:
        raise ContractError("publication report PR/target drifted")
    if not SHA1.fullmatch(str(value.get("target_commit", ""))) or not SHA1.fullmatch(str(value.get("release_head_oid", ""))) or not HEX64.fullmatch(str(value.get("release_preparation_report_digest", ""))) or value.get("pr_url") and canonical_pr_url(value["pr_url"]) != value["pr_url"]:
        raise ContractError("publication report identity is invalid")
    if expected_release_head and value["release_head_oid"] != expected_release_head or expected_preparation_digest and value["release_preparation_report_digest"] != expected_preparation_digest:
        raise ContractError("publication report preparation provenance drifted")
    phase = value.get("tag_phase")
    tag_status = value.get("tag_status")
    unresolved = value.get("unresolved")
    if phase not in {"prepared", "tag_published"} or not isinstance(tag_status, str) or not isinstance(unresolved, bool):
        raise ContractError("publication report phase is invalid")
    if phase == "prepared" and (tag_status != "prepared" or unresolved is not True):
        raise ContractError("prepared publication report status is not exact")
    if phase == "tag_published" and tag_status not in {"already_present_exact", "created_and_pushed", "local_tag_pushed", "push_ack_recovered"}:
        raise ContractError("tag-published publication report status is not exact")
    if not isinstance(value.get("notes_report"), dict):
        raise ContractError("publication report notes report is not an object")
    if root and task_short_id:
        parse_notes_report(value["notes_report"], root, task_short_id, expected_tag=value["release_tag"], expected_target=value["target_commit"])
    if value.get("notes_digest") != value["notes_report"].get("sha256"):
        raise ContractError("publication report notes digest mismatch")
    previous_operation_digest = value.get("previous_operation_digest")
    if previous_operation_digest and not HEX64.fullmatch(previous_operation_digest):
        raise ContractError("publication report previous operation digest is invalid")
    if previous_operation_digest == value.get("operation_digest"):
        raise ContractError("publication report operation continuity is circular")
    return dict(value)

def parse_run_api(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != RUN_API_KEYS:
        raise ContractError("release run API evidence is not closed")
    if isinstance(value["run_id"], bool) or not isinstance(value["run_id"], int) or value["run_id"] <= 0 or isinstance(value["attempt"], bool) or not isinstance(value["attempt"], int) or value["attempt"] <= 0:
        raise ContractError("release run API IDs are invalid")
    if value["path"] != ".github/workflows/release.yml" or value["name"] != "Release" or value["event"] != "push" or not SHA1.fullmatch(str(value["head_sha"])) or not TAG.fullmatch(str(value["head_branch"])) or value["status"] != "completed" or value["conclusion"] != "success":
        raise ContractError("release run API identity/outcome is invalid")
    return dict(value)

def parse_job(value: Any, attempt: int) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != JOB_KEYS or value.get("name") != "Build & Publish" or value.get("status") != "completed" or value.get("conclusion") != "success" or isinstance(value.get("id"), bool) or not isinstance(value.get("id"), int) or value["id"] <= 0 or isinstance(value.get("attempt"), bool) or value.get("attempt") != attempt:
        raise ContractError("release job evidence is not exact")
    return dict(value)

def _observed_job(value: Any, attempt: int) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ContractError("release job observation is not an object")
    identifier = value.get("id")
    if isinstance(identifier, bool) or not isinstance(identifier, int) or identifier <= 0:
        raise ContractError("release job observation ID is invalid")
    name = value.get("name")
    if not isinstance(name, str) or not name.strip() or len(name.encode("utf-8")) > 256:
        raise ContractError("release job observation name is invalid")
    status = value.get("status")
    conclusion = value.get("conclusion")
    if status != "completed" or not isinstance(conclusion, str):
        raise ContractError("release job observation is not terminal")
    return {
        "id": identifier,
        "name": name,
        "status": status,
        "conclusion": conclusion,
        "attempt": attempt,
    }

def _read_release_run_all_jobs(
    root: Path,
    run: Mapping[str, Any],
    target: str,
    tag: str,
    *,
    provider_guard: Callable[[], None] | None = None,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Read one pinned run and classify every job reported for that attempt."""
    try:
        observed = _github_observer(
            root,
            provider_guard=provider_guard,
        ).observe_run(
            REPOSITORY,
            run["run_id"],
            attempt=run["attempt"],
        )
    except ContractError:
        raise
    except Exception as error:
        code = getattr(error, "code", "invalid_observation")
        if not isinstance(code, str) or not re.fullmatch(r"[a-z_]+", code):
            code = "invalid_observation"
        raise ContractError(f"release run observation failed: {code}") from error
    if not isinstance(observed, dict) or set(observed) != {"run", "jobs", "checks"}:
        raise ContractError("release run observation is not closed")
    response = observed["run"]
    if not isinstance(response, dict):
        raise ContractError("release run observation identity is invalid")
    if (
        response.get("id") != run["run_id"]
        or response.get("run_attempt") != run["attempt"]
        or response.get("path") != ".github/workflows/release.yml"
        or response.get("name") != "Release"
        or response.get("event") != "push"
        or response.get("head_sha") != target
        or response.get("head_branch") != tag
        or not isinstance(response.get("repository"), dict)
        or response["repository"].get("full_name") != REPOSITORY
        or response.get("status") != "completed"
        or response.get("conclusion") != "success"
    ):
        raise ContractError("release run readback identity switched or drifted")
    run_api = parse_run_api({
        "run_id": response["id"],
        "attempt": response["run_attempt"],
        "path": response["path"],
        "name": response["name"],
        "event": response["event"],
        "head_sha": response["head_sha"],
        "head_branch": response["head_branch"],
        "status": response["status"],
        "conclusion": response["conclusion"],
    })
    raw_jobs = observed["jobs"]
    if not isinstance(raw_jobs, list) or not raw_jobs:
        raise ContractError("release run jobs are missing")
    jobs = [_observed_job(item, run["attempt"]) for item in raw_jobs]
    checks = observed["checks"]
    if not isinstance(checks, list) or len(checks) != len(jobs):
        raise ContractError("release run job/check observation is incomplete")
    classification = _runtime_contracts_module(root).classify_github_checks(
        checks,
        require_ci=True,
    )
    if not isinstance(classification, dict):
        raise ContractError("release run check classification is not closed")
    if classification.get("state") != "green":
        diagnostic = classification.get("diagnostic")
        code = diagnostic.get("code") if isinstance(diagnostic, dict) else classification.get("state")
        if not isinstance(code, str) or not re.fullmatch(r"[a-z_]+", code):
            code = "invalid_observation"
        raise ContractError(f"release run checks are not terminal green: {code}")
    effect_jobs = [job for job in jobs if job["name"] == "Build & Publish"]
    if len(effect_jobs) != 1:
        raise ContractError("release effect job identity is missing or ambiguous")
    effect_job = parse_job(effect_jobs[0], run["attempt"])
    return run_api, effect_job

def parse_checksum_proof(value: Any, assets: list[dict[str, Any]]) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != CHECKSUM_KEYS or value.get("schema") != "puber_checksum_proof_v1" or value.get("download_sizes_match") is not True or value.get("apk_checksum_equal") is not True:
        raise ContractError("checksum proof is not closed")
    apk = next((asset for asset in assets if asset["name"].endswith(".apk")), None)
    checksum = next((asset for asset in assets if asset["name"].endswith(".apk.sha256")), None)
    if apk is None or checksum is None:
        raise ContractError("checksum proof assets are incomplete")
    if value["apk_asset_id"] != apk["id"] or value["apk_name"] != apk["name"] or value["apk_size"] != apk["size"] or value["checksum_asset_id"] != checksum["id"] or value["checksum_name"] != checksum["name"] or value["checksum_size"] != checksum["size"]:
        raise ContractError("checksum proof asset identity drifted")
    for key in ("apk_download_sha256", "checksum_download_sha256", "parsed_checksum_digest"):
        if not HEX64.fullmatch(str(value.get(key, ""))):
            raise ContractError("checksum proof digest is invalid")
    if value["parsed_checksum_filename"] != apk["name"]:
        raise ContractError("checksum proof filename is invalid")
    if value["apk_download_sha256"] != apk["download_sha256"] or value["checksum_download_sha256"] != checksum["download_sha256"] or value["parsed_checksum_digest"] != value["apk_download_sha256"]:
        raise ContractError("checksum proof byte digest equality is invalid")
    return dict(value)

def parse_release_metadata(value: Any, expected_tag: str | None = None, expected_target: str | None = None) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != RELEASE_METADATA_KEYS or value.get("target_commitish") != "master" or value.get("draft") is not False or value.get("prerelease") is not False:
        raise ContractError("release metadata is not the actual workflow shape")
    safe_version_tag(value.get("tag_name", "")[1:], value.get("tag_name", ""))
    if expected_tag and value["tag_name"] != expected_tag or expected_target and value.get("remote_tag_target") != expected_target:
        raise ContractError("release metadata tag/target drifted")
    if value.get("name") != f"Puber {value['tag_name']}" or value.get("html_url") != f"https://github.com/{REPOSITORY}/releases/tag/{value['tag_name']}" or not isinstance(value.get("body"), str) or not SHA1.fullmatch(str(value.get("remote_tag_target", ""))):
        raise ContractError("release metadata identity is invalid")
    return dict(value)

def parse_release_report(raw: Any, digest: Any, *, expected_publication_digest: str | None = None, expected_notes_digest: str | None = None, expected_tag: str | None = None, expected_target: str | None = None) -> dict[str, Any]:
    value = raw if isinstance(raw, dict) else parse_closed_json(raw, "puber_release_report_v1", RELEASE_KEYS)
    if set(value) != RELEASE_KEYS or value.get("schema") != "puber_release_report_v1" or not isinstance(digest, str) or digest != sha256_bytes(canonical_json(value).encode("utf-8")) or value.get("unresolved") is not False:
        raise ContractError("release report is not closed or its digest mismatches")
    if not HEX64.fullmatch(str(value.get("observation_operation_digest", ""))) or not HEX64.fullmatch(str(value.get("observation_provenance_fingerprint", ""))):
        raise ContractError("release observation authority evidence is missing or invalid")
    run = parse_run_carrier(value["run"])
    if run == NOT_SELECTED_RUN:
        raise ContractError("release report run is not selected")
    if expected_target and run["head_sha"] != expected_target:
        raise ContractError("release report selected run target drifted")
    if expected_tag and (run["head_branch"] != expected_tag or run["ref"] != f"refs/tags/{expected_tag}"):
        raise ContractError("release report selected run tag/ref drifted")
    if not isinstance(value.get("jobs"), dict) or set(value["jobs"]) != {"run", "job"}:
        raise ContractError("release report jobs are not closed")
    run_api = parse_run_api(value["jobs"]["run"])
    job = parse_job(value["jobs"]["job"], run["attempt"])
    if run_api["run_id"] != run["run_id"] or run_api["attempt"] != run["attempt"] or run_api["head_sha"] != run["head_sha"] or run_api["head_branch"] != run["head_branch"]:
        raise ContractError("release report run API evidence drifted")
    metadata = parse_release_metadata(value["release"], expected_tag=expected_tag, expected_target=expected_target)
    assets = value["assets"]
    if not isinstance(assets, list) or len(assets) != 2 or any(not isinstance(asset, dict) or set(asset) != ASSET_KEYS for asset in assets):
        raise ContractError("release report assets are not closed")
    if {asset["name"] for asset in assets} != {f"puber-{metadata['tag_name']}.apk", f"puber-{metadata['tag_name']}.apk.sha256"}:
        raise ContractError("release report asset names are not exact")
    for asset in assets:
        if isinstance(asset["id"], bool) or not isinstance(asset["id"], int) or asset["id"] <= 0 or isinstance(asset["size"], bool) or not isinstance(asset["size"], int) or asset["size"] <= 0 or not HEX64.fullmatch(str(asset["download_sha256"])) or not isinstance(asset["browser_download_url"], str) or not asset["browser_download_url"].startswith("https://"):
            raise ContractError("release report asset evidence is invalid")
    if len({asset["id"] for asset in assets}) != len(assets):
        raise ContractError("release report asset IDs are duplicated")
    checksum = parse_checksum_proof(value["checksum"], assets)
    if expected_target and metadata["remote_tag_target"] != expected_target or metadata.get("tag_name") != (expected_tag or metadata.get("tag_name")) or metadata.get("body") is None:
        raise ContractError("release report metadata proof is incomplete")
    if not HEX64.fullmatch(str(value.get("notes_digest", ""))) or not HEX64.fullmatch(str(value.get("publication_report_digest", ""))):
        raise ContractError("release report carrier digests are invalid")
    if expected_publication_digest and value["publication_report_digest"] != expected_publication_digest or expected_notes_digest and value["notes_digest"] != expected_notes_digest:
        raise ContractError("release report carrier digest drifted")
    return dict(value)

def notes_report(root: Path, task_short_id: str, tag: str, target: str) -> dict[str, Any]:
    task_short_id = _safe_task_short_id(task_short_id)
    _, tag = safe_version_tag(tag[1:], tag)
    if not SHA1.fullmatch(target):
        raise ContractError("notes target is not exact")
    path_value = f".todo/{task_short_id}/release-notes-ru.md"
    path = root / path_value
    remote_tags = remote_release_tags(root)
    current_version = tuple(int(part) for part in tag[1:].split("."))
    previous_values = [value for value in remote_tags if value != tag and tuple(int(part) for part in value[1:].split(".")) < current_version]
    previous = previous_values[-1] if previous_values else ""
    revision = f"{previous}..{target}" if previous else target
    log_result = run(["git", "log", "--format=%s", revision], cwd=root, check=False)
    if log_result.returncode != 0:
        raise ContractError("exact release notes range cannot be resolved")
    subjects = log_result.stdout.splitlines()[:100]
    body = ("puber_release_notes_v1\n\n# Изменения\n\n" + "\n".join(f"- {subject}" for subject in subjects) + "\n").encode("utf-8")
    if not re.search(r"[А-Яа-яЁё]", body.decode("utf-8")):
        body += "- Изменения релиза подтверждены.\n".encode("utf-8")
    if path.exists():
        if path.is_symlink() or not path.is_file() or path.read_bytes() != body:
            raise ContractError("existing canonical release notes conflict")
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, temp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        try:
            os.chmod(temp, 0o600)
            with os.fdopen(fd, "wb") as stream:
                stream.write(body); stream.flush(); os.fsync(stream.fileno())
            os.replace(temp, path)
            directory_fd = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        finally:
            Path(temp).unlink(missing_ok=True)
    readback = path.read_bytes()
    if path.is_symlink() or not path.is_file() or stat.S_IMODE(path.stat().st_mode) != 0o600 or readback != body or b"\r" in readback or not readback.endswith(b"\n") or not re.search(r"[А-Яа-яЁё]", readback.decode("utf-8")):
        raise ContractError("canonical notes readback failed")
    return {"schema":"puber_release_notes_v1","path":path_value,"mode":0o600,"bytes":len(readback),"sha256":sha256_bytes(readback),"encoding":"UTF-8","line_endings":"LF","final_newline":True,"producer":".kent/scripts/workflow-puber-release-publish","previous_tag":previous,"range":revision,"target_commit":target}

def publish_tag(root: Path, tag: str, target: str) -> str:
    remote = remote_tag(root, tag)
    local = local_tag(root, tag)
    if remote:
        if remote != target:
            raise ContractError("remote tag conflicts with exact target")
        if local and local != target:
            raise ContractError("local tag conflicts with exact target")
        return "already_present_exact"
    if local and local != target:
        raise ContractError("local tag exists while remote tag is absent")
    if not local:
        git(root, "tag", tag, target)
    pushed = run(["git", "push", "origin", f"refs/tags/{tag}"], cwd=root, check=False)
    remote_after = remote_tag(root, tag)
    if remote_after == target and local_tag(root, tag) == target:
        return "push_ack_recovered" if pushed.returncode else ("created_and_pushed" if not local else "local_tag_pushed")
    if pushed.returncode:
        raise ContractError("tag push failed and remote readback is absent")
    if local_tag(root, tag) != target or remote_after != target:
        raise ContractError("tag readback mismatch")
    return "created_and_pushed"

def discover_release_run(root: Path, tag: str, target: str) -> dict[str, Any]:
    response = gh_api(root, f"repos/{REPOSITORY}/actions/runs?event=push&head_sha={target}&per_page=100")
    if not isinstance(response, dict) or not isinstance(response.get("workflow_runs"), list):
        raise ContractError("release run discovery response is not exact")
    matches = []
    for row in response["workflow_runs"]:
        if not isinstance(row, dict):
            raise ContractError("release run row is not an object")
        if row.get("path") == ".github/workflows/release.yml" and row.get("name") == "Release" and row.get("event") == "push" and row.get("head_sha") == target and row.get("head_branch") == tag and row.get("repository", {}).get("full_name") == REPOSITORY:
            matches.append(row)
    if len(matches) != 1:
        raise ContractError("release run is missing or ambiguous")
    row = matches[0]
    if isinstance(row.get("id"), bool) or not isinstance(row.get("id"), int) or row["id"] <= 0 or isinstance(row.get("run_attempt"), bool) or not isinstance(row.get("run_attempt"), int) or row["run_attempt"] <= 0:
        raise ContractError("discovered run identity is invalid")
    return {"schema": "puber_release_run_v1", "state": "selected", "repository": REPOSITORY, "workflow_path": ".github/workflows/release.yml", "workflow_name": "Release", "event": "push", "run_id": row["id"], "attempt": row["run_attempt"], "head_sha": target, "ref": f"refs/tags/{tag}", "head_branch": tag}

def read_release_run(
    root: Path,
    run: Mapping[str, Any],
    target: str,
    tag: str,
    *,
    provider_guard: Callable[[], None] | None = None,
) -> tuple[dict[str, Any], dict[str, Any]]:
    """Return the legacy effect proof after a complete all-job observation.

    The singular ``jobs.job`` carrier remains the exact publication-effect
    proof consumed by Cleanup.  It is deliberately not used as the ordinary
    monitoring set: every job from the selected run/attempt is classified
    before this function returns.
    """
    run_api, effect_job = _read_release_run_all_jobs(
        root,
        run,
        target,
        tag,
        provider_guard=provider_guard,
    )
    return run_api, effect_job

def read_release(
    root: Path,
    tag: str,
    target: str,
    *,
    provider_guard: Callable[[], None] | None = None,
) -> dict[str, Any]:
    release = gh_api(
        root,
        f"repos/{REPOSITORY}/releases/tags/{tag}",
        provider_guard=provider_guard,
    )
    remote_target = remote_tag(
        root,
        tag,
        provider_guard=provider_guard,
    )
    if remote_target != target:
        raise ContractError("remote release tag does not resolve to the exact target")
    if not isinstance(release, dict) or release.get("tag_name") != tag or release.get("target_commitish") != "master" or release.get("name") != f"Puber {tag}" or release.get("draft") is not False or release.get("prerelease") is not False or release.get("html_url") != f"https://github.com/{REPOSITORY}/releases/tag/{tag}":
        raise ContractError("GitHub Release identity/state is not exact")
    assets = release.get("assets")
    if not isinstance(assets, list) or len(assets) != 2:
        raise ContractError("GitHub Release assets are missing, extra, or ambiguous")
    expected = {f"puber-{tag}.apk", f"puber-{tag}.apk.sha256"}
    if {asset.get("name") for asset in assets if isinstance(asset, dict)} != expected:
        raise ContractError("GitHub Release asset names are not exact")
    normalized_assets = []
    for asset in assets:
        if not isinstance(asset, dict) or isinstance(asset.get("id"), bool) or not isinstance(asset.get("id"), int) or asset["id"] <= 0 or isinstance(asset.get("size"), bool) or not isinstance(asset.get("size"), int) or asset["size"] <= 0 or not isinstance(asset.get("name"), str) or not isinstance(asset.get("browser_download_url"), str) or not asset["browser_download_url"].startswith("https://"):
            raise ContractError("GitHub Release asset identity/size is invalid")
        normalized_assets.append({"id": asset["id"], "name": asset["name"], "size": asset["size"], "browser_download_url": asset["browser_download_url"]})
    if len({asset["id"] for asset in normalized_assets}) != len(normalized_assets):
        raise ContractError("GitHub Release asset IDs are duplicated")
    apk = next(item for item in normalized_assets if item["name"].endswith(".apk"))
    checksum = next(item for item in normalized_assets if item["name"].endswith(".apk.sha256"))
    apk_bytes = gh_api_bytes(
        root,
        f"repos/{REPOSITORY}/releases/assets/{apk['id']}",
        provider_guard=provider_guard,
    )
    checksum_bytes = gh_api_bytes(
        root,
        f"repos/{REPOSITORY}/releases/assets/{checksum['id']}",
        provider_guard=provider_guard,
    )
    if len(apk_bytes) != apk["size"] or len(checksum_bytes) != checksum["size"]:
        raise ContractError("downloaded release asset sizes do not match metadata")
    try:
        checksum_text = checksum_bytes.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ContractError("checksum asset is not valid UTF-8") from error
    lines = checksum_text.splitlines()
    if len(lines) != 1:
        raise ContractError("checksum asset is not one exact line")
    match = re.fullmatch(r"([0-9a-f]{64})[ \t]+\*?(.+)", lines[0])
    if not match or match.group(2) != apk["name"] or match.group(1) != sha256_bytes(apk_bytes):
        raise ContractError("checksum asset does not match APK bytes")
    apk_download_sha256 = sha256_bytes(apk_bytes)
    checksum_download_sha256 = sha256_bytes(checksum_bytes)
    for asset in normalized_assets:
        asset["download_sha256"] = apk_download_sha256 if asset["id"] == apk["id"] else checksum_download_sha256
    checksum_proof = {
        "schema": "puber_checksum_proof_v1",
        "apk_asset_id": apk["id"],
        "apk_name": apk["name"],
        "apk_size": apk["size"],
        "apk_download_sha256": apk_download_sha256,
        "checksum_asset_id": checksum["id"],
        "checksum_name": checksum["name"],
        "checksum_size": checksum["size"],
        "checksum_download_sha256": checksum_download_sha256,
        "parsed_checksum_digest": match.group(1),
        "parsed_checksum_filename": match.group(2),
        "download_sizes_match": True,
        "apk_checksum_equal": True,
    }
    return {"tag_name": release["tag_name"], "target_commitish": release["target_commitish"], "name": release["name"], "draft": release["draft"], "prerelease": release["prerelease"], "html_url": release["html_url"], "body": release.get("body", ""), "remote_tag_target": remote_target, "assets": normalized_assets, "checksum": checksum_proof}

def report_json(value: Mapping[str, Any]) -> str:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))

def main() -> int:
    try:
        payload, state, edge = validate_envelope(read_zero_argument(), ROOT, "release_intent_gate")
    except ContractError as error:
        print(json.dumps({"error": str(error)}, ensure_ascii=False), file=sys.stderr)
        return 2
    values = declarations(state["task"].get("body"))
    kind = values.get("release_type", "minor")
    current = re.search(r"currentVersion\s*=\s*[\"'](\d+\.\d+\.\d+)[\"']", (ROOT / "app/build.gradle.kts").read_text(encoding="utf-8"))
    if not current:
        print(json.dumps({"error": "currentVersion is missing"}, ensure_ascii=False), file=sys.stderr)
        return 2
    major, minor, patch = (int(item) for item in current.group(1).split("."))
    version = values.get("release_version") or (f"{major+1}.0.0" if kind == "major" else f"{major}.{minor}.{patch+1}" if kind == "patch" else f"{major}.{minor+1}.0")
    tag = values.get("release_tag", f"v{version}")
    operation_id = digest_json({"task_id": state["task_id"], "commit": state["commit"], "workflow_id": WORKFLOW_ID})
    if kind not in RELEASE_TYPE:
        return _intent_failure(state, operation_id, "minor", version, "release_type must be exactly minor, patch, or major", invalid=True)
    try:
        safe_version_tag(version, tag)
        release_branch = safe_release_branch(
            values.get("release_branch", f"release/{version}"),
            version,
        )
        attested = attest(ROOT, state, "release_intent_gate", edge["key"])
        operation_id = attested["binding"].provenance_fingerprint
        return _intent_success(state, operation_id, kind, version, release_branch)
    except ContractError as error:
        return _intent_failure(state, operation_id, kind, version, str(error))

def _intent_success(state: dict[str, Any], operation_id: str, kind: str, version: str, release_branch: str) -> int:
    fields = {"workspace_path": str(ROOT), "operation_id": operation_id, "task_short_id": state["task_short_id"], "release_type": kind, "release_version": version, "release_branch": release_branch}
    emit_exact(ROOT, "release_intent_passed", "prepare", fields)
    return 0

def _intent_failure(state: dict[str, Any], operation_id: str, kind: str, version: str, reason: str, *, invalid: bool = False) -> int:
    transition = "release_intent_invalid" if invalid else "release_intent_blocked"
    fields = {"workspace_path": str(ROOT), "operation_id": operation_id, "task_short_id": state["task_short_id"], "release_type": kind, "release_version": version, "blocker_reason": reason}
    emit_exact(ROOT, transition, "release_intent_gate", fields)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
