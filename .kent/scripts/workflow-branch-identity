#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
from typing import Optional
from urllib.parse import urlparse


JIRA_KEY = re.compile(r"(?<![A-Z0-9])([A-Z][A-Z0-9]+-\d+)(?![A-Z0-9])", re.I)
URL = re.compile(r"https?://[^\s<>()\[\]{}\"']+")
POLICIES = {"task", "jira", "github_issue"}
HANDOFF_KEYS = ("workspace_path", "plan_path", "work_kind")
DEFAULT_KENT_PATHS = (
    str(Path.home() / ".kent" / "bin" / "kent"),
    "/opt/homebrew/bin/kent",
    "/usr/local/bin/kent",
)
TOML_TABLE = re.compile(r"^\[([A-Za-z0-9_.-]+)\]\s*(?:#.*)?$")
BRANCH_POLICY_ASSIGNMENT = re.compile(
    r'^branch_identity\s*=\s*"([a-z_]+)"\s*(?:#.*)?$'
)


def complete(transition: str, commentary: str = "", **values: str) -> None:
    payload = {"transition": transition}
    if commentary:
        payload["commentary"] = commentary
    payload.update(values)
    print(json.dumps(payload, ensure_ascii=False))


def blocked(reason: str, handoff: dict[str, str]) -> int:
    complete(
        "branch_identity_blocked",
        blocker_reason=reason,
        **handoff,
    )
    return 0


def run(
    args: list[str],
    *,
    cwd: Path,
    timeout: int = 30,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        args,
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise RuntimeError(f"{' '.join(args)} failed: {detail}")
    return result


def repository_root() -> Path:
    start = Path.cwd().resolve()
    result = run(["git", "rev-parse", "--show-toplevel"], cwd=start)
    root = Path(result.stdout.strip()).resolve()
    if root != start:
        raise ValueError(
            f"script must run at the task worktree root: {start}; found {root}"
        )
    return root


def workflow_input() -> dict[str, object]:
    payload = json.load(sys.stdin)
    if not isinstance(payload, dict):
        raise ValueError("workflow input must be a JSON object")
    return payload


def task_id(payload: dict[str, object]) -> str:
    identity = payload.get("_kent")
    if not isinstance(identity, dict):
        raise ValueError("workflow input is missing _kent identity")
    value = identity.get("task_id")
    if not isinstance(value, str) or not value.strip():
        raise ValueError("workflow input is missing _kent.task_id")
    return value.strip()


def handoff_values(payload: dict[str, object]) -> dict[str, str]:
    present = [key for key in HANDOFF_KEYS if key in payload]
    if not present:
        return {}
    if len(present) != len(HANDOFF_KEYS):
        missing = sorted(set(HANDOFF_KEYS) - set(present))
        raise ValueError(
            "workflow branch handoff is incomplete; missing "
            + ", ".join(missing)
        )
    values: dict[str, str] = {}
    for key in HANDOFF_KEYS:
        value = payload[key]
        if not isinstance(value, str):
            raise ValueError(f"{key} must be a string")
        values[key] = value.strip()
    if not values["workspace_path"]:
        raise ValueError("workspace_path must be non-empty")
    if not values["work_kind"]:
        raise ValueError("work_kind must be non-empty")
    return values


def resolve_kent_bin() -> str:
    configured = os.environ.get("KENT_BIN")
    candidates = (configured,) if configured else ("kent", *DEFAULT_KENT_PATHS)
    for candidate in candidates:
        if not candidate:
            continue
        if os.path.sep in candidate:
            path = Path(candidate).expanduser()
            if path.is_file() and os.access(path, os.X_OK):
                return str(path)
            continue
        resolved = shutil.which(candidate)
        if resolved:
            return resolved
    if configured:
        raise RuntimeError(
            f"configured Kent CLI is not executable: {configured}"
        )
    raise RuntimeError(
        "Kent CLI was not found; set KENT_BIN to its absolute path"
    )


def task_payload(root: Path, identity: str) -> dict[str, object]:
    kent_bin = resolve_kent_bin()
    result = run(
        [
            kent_bin,
            "task",
            "show",
            identity,
            "--project",
            str(root),
            "--json",
        ],
        cwd=root,
    )
    decoded = json.loads(result.stdout)
    if not isinstance(decoded, dict):
        raise RuntimeError("kent task show returned a non-object payload")
    return decoded


def profile_policy(root: Path) -> str:
    profile_path = root / ".kent" / "workflow-profile.toml"
    table = ""
    value = ""
    for line_number, raw_line in enumerate(
        profile_path.read_text().splitlines(),
        start=1,
    ):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        table_match = TOML_TABLE.fullmatch(line)
        if table_match:
            table = table_match.group(1)
            continue
        if table != "policies":
            continue
        key = line.split("=", 1)[0].strip()
        if key != "branch_identity":
            continue
        assignment = BRANCH_POLICY_ASSIGNMENT.fullmatch(line)
        if assignment is None:
            raise ValueError(
                "policies.branch_identity must be one quoted lowercase "
                f"identifier at {profile_path}:{line_number}"
            )
        if value:
            raise ValueError("policies.branch_identity is declared more than once")
        value = assignment.group(1)
    value = value or "task"
    if value not in POLICIES:
        raise ValueError(f"unsupported policies.branch_identity: {value!r}")
    return value


def task_string(payload: dict[str, object], key: str) -> str:
    value = payload.get(key)
    if isinstance(value, str):
        return value.strip()
    return ""


def task_short_id(payload: dict[str, object]) -> str:
    summary = payload.get("summary")
    if isinstance(summary, dict):
        value = summary.get("short_id")
        if isinstance(value, str) and value.strip():
            return value.strip()
    value = payload.get("short_id")
    if isinstance(value, str) and value.strip():
        return value.strip()
    raise ValueError("kent task show payload is missing task short ID")


def task_body(payload: dict[str, object]) -> str:
    body = task_string(payload, "body")
    if body:
        return body
    summary = payload.get("summary")
    if isinstance(summary, dict):
        preview = summary.get("body_preview")
        if isinstance(preview, str):
            return preview
    return ""


def jira_url_key(value: str) -> str:
    parsed = urlparse(value)
    if parsed.scheme not in {"http", "https"}:
        return ""
    parts = [part for part in parsed.path.split("/") if part]
    for index, part in enumerate(parts[:-1]):
        if part.lower() != "browse":
            continue
        match = JIRA_KEY.fullmatch(parts[index + 1])
        if match:
            return match.group(1).upper()
    return ""


def jira_key(source_url: str, body: str) -> str:
    source_match = JIRA_KEY.search(source_url)
    if source_match:
        return source_match.group(1).upper()
    for match in URL.finditer(body):
        key = jira_url_key(match.group(0).rstrip(".,;:!?"))
        if key:
            return key
    return ""


def github_repository(root: Path) -> Optional[tuple[str, str]]:
    result = run(
        ["git", "remote", "get-url", "origin"],
        cwd=root,
        check=False,
    )
    if result.returncode != 0:
        return None
    remote = result.stdout.strip()
    if remote.startswith("git@github.com:"):
        path = remote.removeprefix("git@github.com:")
    else:
        parsed = urlparse(remote)
        if parsed.hostname not in {"github.com", "www.github.com"}:
            return None
        path = parsed.path.lstrip("/")
    path = path.removesuffix(".git").strip("/")
    parts = path.split("/")
    if len(parts) != 2 or not all(parts):
        return None
    return parts[0].lower(), parts[1].lower()


def github_issue_number(root: Path, source_url: str, body: str) -> str:
    repository = github_repository(root)
    if repository is None:
        return ""
    candidates = []
    if source_url:
        candidates.append(source_url)
    candidates.extend(
        match.group(0).rstrip(".,;:!?")
        for match in URL.finditer(body)
    )
    for candidate in candidates:
        parsed = urlparse(candidate)
        if parsed.hostname not in {"github.com", "www.github.com"}:
            continue
        parts = [part for part in parsed.path.split("/") if part]
        if (
            len(parts) == 4
            and (parts[0].lower(), parts[1].removesuffix(".git").lower())
            == repository
            and parts[2] == "issues"
            and parts[3].isdigit()
            and int(parts[3]) > 0
        ):
            return str(int(parts[3]))
    return ""


def desired_branch(
    policy: str,
    root: Path,
    source_url: str,
    body: str,
    fallback: str,
) -> str:
    if policy == "jira":
        key = jira_key(source_url, body)
        return f"feature/{key}" if key else fallback
    if policy == "github_issue":
        issue = github_issue_number(root, source_url, body)
        return f"issue-{issue}" if issue else fallback
    return fallback


def current_branch(root: Path) -> str:
    result = run(["git", "branch", "--show-current"], cwd=root)
    branch = result.stdout.strip()
    if not branch:
        raise ValueError("task worktree is detached")
    return branch


def validate_branch(root: Path, branch: str) -> None:
    result = run(
        ["git", "check-ref-format", "--branch", branch],
        cwd=root,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "invalid ref"
        raise ValueError(f"invalid branch {branch!r}: {detail}")


def local_branch_exists(root: Path, branch: str) -> bool:
    return (
        run(
            ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
            cwd=root,
            check=False,
        ).returncode
        == 0
    )


def remote_branch_state(root: Path, branch: str) -> str:
    result = run(
        [
            "git",
            "ls-remote",
            "--exit-code",
            "--heads",
            "origin",
            f"refs/heads/{branch}",
        ],
        cwd=root,
        timeout=45,
        check=False,
    )
    if result.returncode == 0:
        return "exists"
    if result.returncode == 2:
        return "absent"
    detail = result.stderr.strip() or result.stdout.strip() or "no output"
    raise RuntimeError(f"cannot inspect origin branch {branch!r}: {detail}")


def apply_branch_identity(
    incoming: dict[str, object],
    handoff: dict[str, str],
) -> int:
    root = repository_root()
    if handoff:
        workspace = Path(handoff["workspace_path"]).expanduser().resolve()
        if workspace != root:
            return blocked(
                f"Workflow передал workspace_path {workspace}, но Script "
                f"запущен в {root}. Нужно восстановить канонический task root.",
                handoff,
            )
    task = task_payload(root, task_id(incoming))
    short_id = task_short_id(task)
    policy = profile_policy(root)
    source_url = task_string(task, "source_url")
    body = task_body(task)
    desired = desired_branch(policy, root, source_url, body, short_id)
    current = current_branch(root)

    if current == desired:
        complete(
            "branch_identity_ready",
            f"Ветка уже соответствует политике проекта: {current}.",
            **handoff,
        )
        return 0
    if current != short_id:
        return blocked(
            f"Текущая ветка {current!r} не совпадает ни с Kent ID "
            f"{short_id!r}, ни с ожидаемой веткой {desired!r}. Нужно проверить "
            "владельца worktree и явно решить, какую ветку сохранять.",
            handoff,
        )
    if desired == short_id:
        complete(
            "branch_identity_ready",
            f"Внешний идентификатор не найден; сохранена Kent-ветка {short_id}.",
            **handoff,
        )
        return 0

    validate_branch(root, desired)
    if local_branch_exists(root, desired):
        return blocked(
            f"Локальная ветка {desired!r} уже существует. Нужно удалить её "
            "только если она доказанно устарела, либо отменить дублирующую задачу.",
            handoff,
        )
    try:
        remote_state = remote_branch_state(root, desired)
    except RuntimeError as error:
        return blocked(
            f"Не удалось безопасно проверить remote-ветку {desired!r}: {error}",
            handoff,
        )
    if remote_state == "exists":
        return blocked(
            f"Remote-ветка origin/{desired} уже существует. Нужно проверить её "
            "владельца и удалить только доказанно устаревший дубль либо отменить "
            "новую задачу.",
            handoff,
        )

    try:
        run(["git", "branch", "-m", desired], cwd=root)
    except RuntimeError as error:
        return blocked(
            f"Не удалось безопасно переименовать ветку {short_id!r} в "
            f"{desired!r}: {error}",
            handoff,
        )
    complete(
        "branch_identity_ready",
        f"Ветка переименована: {short_id} → {desired}.",
        **handoff,
    )
    return 0


def main() -> int:
    incoming = workflow_input()
    handoff = handoff_values(incoming)
    try:
        return apply_branch_identity(incoming, handoff)
    except (
        json.JSONDecodeError,
        OSError,
        RuntimeError,
        subprocess.TimeoutExpired,
        ValueError,
    ) as error:
        return blocked(
            "Не удалось выполнить branch identity из-за инфраструктурной "
            f"ошибки: {error}. После устранения причины повторите Script.",
            handoff,
        )


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (json.JSONDecodeError, OSError, ValueError) as error:
        print(f"workflow-branch-identity: {error}", file=sys.stderr)
        raise SystemExit(1)
