#!/usr/bin/env python3
from __future__ import annotations

import importlib.util
import base64
import hashlib
import json
import os
import re
import stat
import subprocess
import shutil
import tomllib
from urllib.parse import urlencode
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

CALLER_SESSION_ID = os.environ.get("KENT_SESSION_ID", "")
CALLER_STEP_ID = os.environ.get("KENT_STEP_ID", "")
sys.dont_write_bytecode = True
_helper_path = Path(__file__).with_name("workflow-puber-release-intent")
_spec = importlib.util.spec_from_loader("puber_release_runtime", SourceFileLoader("puber_release_runtime", str(_helper_path)))
helper = importlib.util.module_from_spec(_spec)
assert _spec and _spec.loader
_spec.loader.exec_module(helper)
ROOT = helper.ROOT
SESSION_IDENTITY_KEYS = {"workspace_id", "workspace_name", "workspace_root", "worktree_id", "worktree_name", "worktree_root", "recorded_branch_ref"}
CI_REPORT_NAME = re.compile(r"ci-report-([0-9a-f]{64})\.json")
RETENTION_BASENAME = "release-cleanup-retention.json"
RETENTION_SCHEMA = "puber_release_cleanup_retention_v1"
RETENTION_LIMIT = 8 * 1024 * 1024
NOT_APPLICABLE_BRANCH = "not-applicable"
_PROVIDER_READ_GUARD = None
_PROVIDER_POLICY_ENABLED = False
_PROVIDER_PACKET_FILES: set[str] = set()
_PROVIDER_PACKET_LIMIT = 0

ENTRY_OUTCOMES = {
    "release_release_published": "published", "release_cancel_cleanup": "cancel",
    "merge_watch_close_without_merge": "closed", "task_janitor_blocked": "recovery",
}


def _caller(state: dict, previous: dict | None = None) -> tuple[str, dict]:
    task, _node = helper._task_identity(ROOT, state["task_id"], "cleanup")
    if task["current_scripts"] != [] or task["current_nodes"][0].get("session_id") != CALLER_SESSION_ID:
        raise helper.ContractError("Cleanup Agent caller changed")
    identity = helper.session_identity(ROOT, CALLER_SESSION_ID)
    if previous and (previous["cleanup_session_id"] != CALLER_SESSION_ID or previous["session_identity"] != identity):
        raise helper.ContractError("sealed Cleanup owner differs from the reactivated current Agent")
    return CALLER_SESSION_ID, identity


def _parse_janitor_report(raw: str, task_short_id: str) -> tuple[dict, str, str, str]:
    if not isinstance(raw, str) or len(raw.encode("utf-8")) > 2 * 1024 * 1024:
        raise helper.ContractError("Janitor cleanup_report is unbounded or not text")
    lines = raw.splitlines()
    if len(lines) < 3:
        raise helper.ContractError("Janitor cleanup_report must contain a report, terminal marker, and Janitor suffix")
    previous = helper.parse_closed_json(lines[0], "puber_cleanup_report_v1", helper.CLEANUP_KEYS)
    if helper.canonical_json(previous) != lines[0]:
        raise helper.ContractError("Janitor cleanup_report first line is not canonical")
    identity = previous.get("session_identity")
    if not isinstance(identity, dict) or set(identity) != SESSION_IDENTITY_KEYS or any(not isinstance(identity[key], str) or not identity[key].strip() for key in SESSION_IDENTITY_KEYS - {"recorded_branch_ref"}):
        raise helper.ContractError("Janitor cleanup_report Session identity is not closed")
    kit = helper._kit_modules()
    marker_indices = [index for index, line in enumerate(lines[1:], start=1) if line.startswith("TERMINAL_EVIDENCE_V1 ")]
    if len(marker_indices) != 1:
        raise helper.ContractError("Janitor cleanup_report must contain exactly one terminal marker")
    marker_index = marker_indices[0]
    try:
        marker = kit["validate_cleanup_report"](lines[0] + "\n" + lines[marker_index])
        marker_line = kit["terminal_marker_line"](marker)
    except Exception as error:
        raise helper.ContractError(f"Janitor terminal evidence marker is invalid: {error}") from error
    if marker["task_short_id"] != task_short_id or marker_line != lines[marker_index]:
        raise helper.ContractError("Janitor terminal evidence marker has the wrong task or is not canonical")
    annotations = [line for index, line in enumerate(lines[1:], start=1) if index != marker_index]
    if not annotations or not annotations[0].startswith("Janitor ") or any(not line.strip() or "\x00" in line for line in annotations):
        raise helper.ContractError("Janitor cleanup_report annotations are not a bounded Janitor blocker")
    suffix = "\n".join(annotations)
    if len(suffix.encode("utf-8")) > 512 * 1024:
        raise helper.ContractError("Janitor cleanup_report annotations are unbounded")
    if marker["redaction"]["report_sha256"] != helper.sha256_bytes(lines[0].encode("utf-8")):
        raise helper.ContractError("Janitor terminal marker redaction digest does not match the canonical report line")
    return previous, marker_line, suffix, lines[0]

def _validate_carriers(state: dict, carrier: dict, *, require_release_run: bool = False) -> tuple[dict | None, dict | None]:
    publication = None
    if carrier.get("publication_report"):
        publication = helper.parse_publication_report(
            carrier["publication_report"],
            carrier.get("publication_report_digest"),
            task_short_id=state["task_short_id"],
            root=ROOT,
        )
        if carrier.get("release_notes_path") != publication["notes_report"]["path"] or carrier.get("release_notes_digest") != publication["notes_digest"]:
            raise helper.ContractError("cleanup notes carrier does not match publication report")
        helper.parse_notes_report(
            publication["notes_report"],
            ROOT,
            state["task_short_id"],
            expected_tag=publication["release_tag"],
            expected_target=publication["target_commit"],
        )
    release = None
    if carrier.get("release_report"):
        expected_publication = carrier.get("publication_report_digest") or None
        expected_notes = carrier.get("release_notes_digest") or None
        release = helper.parse_release_report(
            carrier["release_report"],
            carrier.get("release_report_digest"),
            expected_publication_digest=expected_publication,
            expected_notes_digest=expected_notes,
            expected_tag=publication["release_tag"] if publication else None,
            expected_target=publication["target_commit"] if publication else None,
        )
        if publication and release["publication_report_digest"] != carrier["publication_report_digest"]:
            raise helper.ContractError("cleanup release/publication report digest mismatch")
        if release["notes_digest"] != carrier.get("release_notes_digest"):
            raise helper.ContractError("cleanup release/notes digest mismatch")
    if require_release_run:
        if release is None:
            raise helper.ContractError("published cleanup is missing its release report")
        outer_run = helper.parse_run_carrier(carrier.get("release_run"))
        if outer_run == helper.NOT_SELECTED_RUN or outer_run != release["run"]:
            raise helper.ContractError("cleanup release_run carrier does not equal the nested release report run")
    return publication, release

def _validate_terminal_marker_ledger(task_short_id: str, marker: dict[str, object] | None, kit: dict[str, object], *, allow_profile_checkpoint: bool = False) -> dict:
    runtime_root = ROOT / ".kent" / "runtime"
    marker_digest = kit["canonical_sha256"](marker) if marker is not None else None
    kent_root = ROOT / ".kent"
    for path, label in ((kent_root, ".kent"), (runtime_root, ".kent/runtime")):
        try:
            metadata = path.lstat()
        except (OSError, ValueError) as error:
            raise helper.ContractError(f"terminal evidence {label} is missing") from error
        if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
            raise helper.ContractError(f"terminal evidence {label} is unsafe")
    # Discovery is only for an interrupted original edge, before Janitor. It
    # requires the active task ledger and never discovers a tombstone by guess.
    expected_name = f".evidence-cleanup-{marker_digest}" if marker is not None else ""
    tombstone_names = []
    try:
        runtime_entries = list(runtime_root.iterdir())
    except (OSError, ValueError) as error:
        raise helper.ContractError("terminal evidence runtime directory is unreadable") from error
    for entry in runtime_entries:
        if entry.name.startswith(".evidence-cleanup-"):
            if entry.name != expected_name:
                raise helper.ContractError(
                    "terminal evidence has an unexpected cleanup tombstone "
                    f"(expected {expected_name!r}, found {entry.name!r})"
                )
            tombstone_names.append(entry)
    if len(tombstone_names) > 1:
        raise helper.ContractError("terminal evidence has duplicate cleanup tombstones")
    active_dir = runtime_root / task_short_id
    tombstone_dir = runtime_root / expected_name
    def component(path: Path, label: str, directory: bool, *, missing_ok: bool = False) -> bool:
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            if missing_ok:
                return False
            raise helper.ContractError(f"terminal evidence {label} is missing")
        except (OSError, ValueError) as error:
            raise helper.ContractError(f"terminal evidence {label} is unreadable") from error
        if stat.S_ISLNK(metadata.st_mode) or (stat.S_ISDIR(metadata.st_mode) != directory):
            raise helper.ContractError(f"terminal evidence {label} is unsafe")
        return True
    active_present = component(active_dir, "active task directory", True, missing_ok=True)
    tombstone_present = component(tombstone_dir, "cleanup tombstone directory", True, missing_ok=True) if marker is not None else False
    if bool(tombstone_names) != tombstone_present:
        raise helper.ContractError("terminal evidence cleanup tombstone component is ambiguous")
    if active_present and tombstone_present:
        raise helper.ContractError("terminal evidence has both active ledger and cleanup tombstone")
    if not active_present and not tombstone_present:
        raise helper.ContractError("terminal evidence task ledger/tombstone is missing")
    selected_dir = active_dir if active_present else tombstone_dir
    allowed_entries = {
        "evidence-ledger.jsonl",
        "evidence-recovery.json",
        "evidence-continuation.jsonl",
        "fix-checkpoint.json",
        "smoke-checkpoint.json",
    }
    if allow_profile_checkpoint:
        allowed_entries.add("release-profile-checkpoint.json")
    def safe_file(path: Path, label: str) -> None:
        try:
            metadata = path.lstat()
        except (OSError, ValueError) as error:
            raise helper.ContractError(f"terminal evidence {label} is unreadable") from error
        if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1 or metadata.st_uid != os.getuid() or (stat.S_IMODE(metadata.st_mode) & 0o077) != 0 or metadata.st_size > 8 * 1024 * 1024:
            raise helper.ContractError(f"terminal evidence {label} is unsafe")
    try:
        entries = list(selected_dir.iterdir())
    except (OSError, ValueError) as error:
        raise helper.ContractError("terminal evidence ledger directory is unreadable") from error
    if len(entries) > 68 or any(entry.name not in allowed_entries and not CI_REPORT_NAME.fullmatch(entry.name) for entry in entries):
        raise helper.ContractError("terminal evidence ledger directory has unexpected entries")
    for entry in entries:
        if entry.name == helper.CHECKPOINT_BASENAME:
            if not active_present:
                raise helper.ContractError("profile checkpoint is forbidden in a cleanup tombstone")
            helper.read_profile_checkpoint(ROOT, task_short_id)
        else:
            safe_file(entry, entry.name)
    ledger = selected_dir / "evidence-ledger.jsonl"
    component(ledger, "evidence ledger", False)
    try:
        ledger_path = ROOT / ".kent" / "scripts" / "workflow-evidence-ledger"
        ledger_spec = importlib.util.spec_from_loader(
            "cleanup_inventory_evidence_reader",
            SourceFileLoader("cleanup_inventory_evidence_reader", str(ledger_path)),
        )
        ledger_module = importlib.util.module_from_spec(ledger_spec)
        ledger_spec.loader.exec_module(ledger_module)
        descriptors = [os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)]
        try:
            for component_name in (".kent", "runtime"):
                descriptors.append(
                    ledger_module._open_directory(
                        descriptors[-1], component_name, create=False,
                    )
                )
            descriptors.append(
                ledger_module._open_directory(
                    descriptors[-1], selected_dir.name, create=False,
                )
            )
            opened = os.fstat(descriptors[-1])
            observed = selected_dir.lstat()
            if (
                opened.st_dev != observed.st_dev
                or opened.st_ino != observed.st_ino
                or opened.st_uid != os.getuid()
                or opened.st_mode & 0o022
            ):
                raise helper.ContractError(
                    "terminal evidence directory identity changed during admission"
                )
            view = ledger_module.load_evidence_view(
                descriptors[-1], task=task_short_id,
            )
            records = view["records"]
        finally:
            for descriptor in reversed(descriptors):
                os.close(descriptor)
        has_seal = any(
            record.get("record_kind") == "terminal_evidence_seal_v1"
            for record in records
        )
        if not has_seal:
            if marker is not None:
                raise helper.ContractError(
                    "terminal marker exists without a terminal seal record"
                )
            return None
        readback = kit["validate_terminal_chain"](records, task_short_id=task_short_id)
        references = set()
        for record in records:
            for artifact in record.get("artifacts", []):
                name = artifact.rsplit("/", 1)[-1]
                if not name.startswith("ci-report-"):
                    continue
                if not CI_REPORT_NAME.fullmatch(name) or artifact != f".kent/runtime/{task_short_id}/{name}":
                    raise helper.ContractError("CI artifact is not an exact logical Task ledger reference")
                references.add(name)
        reports = {entry.name for entry in entries if CI_REPORT_NAME.fullmatch(entry.name)}
        if len(references) > 64 or reports != references:
            raise helper.ContractError("CI artifact inventory differs from the Task ledger")
        def identity(metadata):
            return (metadata.st_dev, metadata.st_ino, metadata.st_mode, metadata.st_uid,
                    metadata.st_nlink, metadata.st_size, metadata.st_mtime_ns, metadata.st_ctime_ns)
        total = 0
        for name in sorted(reports):
            path = selected_dir / name
            directory = os.open(selected_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            descriptor = -1
            try:
                directory_metadata = os.fstat(directory)
                if directory_metadata.st_uid != os.getuid() or (directory_metadata.st_dev, directory_metadata.st_ino) != (selected_dir.lstat().st_dev, selected_dir.lstat().st_ino):
                    raise helper.ContractError("CI artifact directory ownership or identity drifted")
                descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
                before = os.fstat(descriptor)
                safe_file(path, name)
                if identity(before) != identity(path.lstat()):
                    raise helper.ContractError("CI artifact changed during admission")
                max_report_bytes = max(
                    kit["MAX_CI_REPORT_BYTES"],
                    kit["MAX_DYNAMIC_CI_REPORT_BYTES"],
                )
                raw = os.read(descriptor, max_report_bytes + 1)
                total += len(raw)
                if total > 4 * 1024 * 1024:
                    raise helper.ContractError("CI artifacts exceed total byte limit")
                report = kit["validate_ci_archive"](
                    kit["parse_canonical_json"](
                        raw,
                        label="CI artifact",
                        max_bytes=max_report_bytes,
                    )
                )
                if helper.canonical_bytes(report) != raw or helper.sha256_bytes(raw) != CI_REPORT_NAME.fullmatch(name).group(1):
                    raise helper.ContractError("CI artifact canonical bytes or filename digest mismatch")
                if identity(os.fstat(descriptor)) != identity(before) or identity(path.lstat()) != identity(before):
                    raise helper.ContractError("CI artifact changed during readback")
            finally:
                if descriptor >= 0:
                    os.close(descriptor)
                os.close(directory)
    except Exception as error:
        raise helper.ContractError(f"terminal evidence ledger readback is invalid: {error}") from error
    if marker is not None and readback != marker:
        raise helper.ContractError("terminal evidence marker does not match the sealed ledger")
    return readback

def _sealed_release_digests(marker_line: str, fresh: dict, *, publication_digest: str, preparation_digest: str) -> tuple[str, str]:
    try:
        marker = fresh["kit"]["parse_terminal_marker_line"](marker_line)
    except Exception as error:
        raise helper.ContractError(f"preserved release terminal marker is invalid: {error}") from error
    operation_digests = marker.get("operation_report_digests")
    if not isinstance(operation_digests, list):
        raise helper.ContractError("preserved release terminal marker has no closed operation digests")
    sealed = {}
    for item in operation_digests:
        if not isinstance(item, dict) or set(item) != {"kind", "sha256"}:
            raise helper.ContractError("preserved release terminal marker operation digest is not closed")
        kind = item.get("kind")
        digest = item.get("sha256")
        if not isinstance(kind, str) or kind in sealed or not isinstance(digest, str) or not helper.HEX64.fullmatch(digest):
            raise helper.ContractError("preserved release terminal marker operation digest is invalid")
        sealed[kind] = digest
    if set(sealed) != {"merge", "publication", "qualification", "runtime_source"}:
        raise helper.ContractError("preserved release terminal marker does not contain the exact release digest set")
    if sealed["publication"] != publication_digest:
        raise helper.ContractError("preserved release terminal marker publication digest drifted")
    if sealed["merge"] != preparation_digest:
        raise helper.ContractError("preserved release terminal marker preparation digest drifted")
    return sealed["qualification"], sealed["merge"]

def _cleanup_report(state: dict, session: str, session_identity: dict[str, str], payload: dict, *, operation_digest: str, unresolved: bool, blocker: str, fresh: dict, profile_report_digest: str = "", preparation_report_digest: str = "", existing_marker: str | None = None, preserved_prefix: str | None = None, preserved_suffix: str | None = None, recover_seal: bool = False, before_seal=None) -> tuple[str, str]:
    publication = payload.get("publication_report", "")
    release = payload.get("release_report", "")
    notes_path = payload.get("release_notes_path", "")
    value = {"schema": "puber_cleanup_report_v1", "operation_digest": operation_digest, "cleanup_session_id": session, "cleanup_mode": "report_only", "session_identity": dict(session_identity), "publication_report": publication, "publication_report_digest": payload.get("publication_report_digest", ""), "release_report": release, "release_report_digest": payload.get("release_report_digest", ""), "release_notes_path": notes_path, "release_notes_digest": payload.get("release_notes_digest", ""), "unresolved": unresolved, "destructive_action": False, "blocker_reason": blocker}
    encoded = helper.canonical_json(value)
    operation_digests = [{"kind": "runtime_source", "sha256": fresh["binding"].runtime_source_envelope_digest}]
    for kind, digest in (("publication", value["publication_report_digest"]), ("qualification", profile_report_digest), ("merge", preparation_report_digest)):
        if digest:
            operation_digests.append({"kind": kind, "sha256": digest})
    operation_digests.sort(key=lambda item: item["kind"])
    if recover_seal:
        # No seal command is allowed here: absence of a checkpoint is not
        # authority to manufacture terminal evidence. Independently read the
        # existing chain and bind it to this exact original-edge outcome.
        kit = fresh["kit"]
        if existing_marker is None:
            raise helper.ContractError(
                "original cleanup replay is missing its admitted terminal marker"
            )
        marker = kit["parse_terminal_marker_line"](existing_marker)
        readback_marker = _validate_terminal_marker_ledger(state["task_short_id"], marker, kit,
            allow_profile_checkpoint=bool(profile_report_digest or preparation_report_digest))
        marker_line = kit["terminal_marker_line"](readback_marker)
        if marker_line != existing_marker:
            raise helper.ContractError(
                "original cleanup replay marker differs from the admitted ledger"
            )
        if marker["operation_report_digests"] != operation_digests:
            raise helper.ContractError("original cleanup proof digests differ from the terminal seal")
        sealed_runtime = next(item["sha256"] for item in marker["operation_report_digests"] if item["kind"] == "runtime_source")
        if (unresolved or blocker
            or marker["retention_class"] != "cleanup_report_only"
            or marker["redaction"] != {"status": "passed", "report_sha256": helper.sha256_bytes(encoded.encode("utf-8"))}
            or sealed_runtime != fresh["binding"].runtime_source_envelope_digest):
            raise helper.ContractError("original-edge retry does not match the exact terminal seal")
        report = encoded + "\n" + marker_line
        try:
            kit["validate_cleanup_report"](report)
        except Exception as error:
            raise helper.ContractError(f"recovered cleanup report is not terminally sealed: {error}") from error
        return report, helper.sha256_bytes(report.encode("utf-8"))
    if existing_marker is not None:
        if preserved_prefix is None or preserved_suffix is None:
            raise helper.ContractError("preserved terminal report context is incomplete")
        prefix_lines = preserved_prefix.splitlines()
        if len(prefix_lines) != 1:
            raise helper.ContractError("preserved terminal report prefix is not exact")
        previous = helper.parse_closed_json(prefix_lines[0], "puber_cleanup_report_v1", helper.CLEANUP_KEYS)
        if helper.canonical_json(previous) != prefix_lines[0]:
            raise helper.ContractError("preserved terminal report line is not canonical")
        try:
            marker = fresh["kit"]["parse_terminal_marker_line"](existing_marker)
            normalized_request = {
                "schema": "terminal-evidence-seal-request-v1",
                "operation_report_digests": marker["operation_report_digests"],
                "redaction": marker["redaction"],
                "retention_class": marker["retention_class"],
            }
            fresh["kit"]["validate_terminal_seal_request"](normalized_request)
            fresh["kit"]["validate_cleanup_report"](prefix_lines[0] + "\n" + existing_marker)
            _validate_terminal_marker_ledger(state["task_short_id"], marker, fresh["kit"])
        except Exception as error:
            raise helper.ContractError(f"preserved terminal evidence is invalid: {error}") from error
        if marker["task_short_id"] != state["task_short_id"] or marker["redaction"]["report_sha256"] != helper.sha256_bytes(prefix_lines[0].encode("utf-8")):
            raise helper.ContractError("preserved terminal evidence does not bind the canonical report line")
        report = prefix_lines[0] + "\n" + preserved_suffix + "\n" + existing_marker
        try:
            fresh["kit"]["validate_cleanup_report"](report)
        except Exception as error:
            raise helper.ContractError(f"re-emitted Janitor report is not terminally sealed: {error}") from error
        return report, helper.sha256_bytes(report.encode("utf-8"))
    if existing_marker is None:
        request = {
            "schema": "terminal-evidence-seal-request-v1",
            "operation_report_digests": operation_digests,
            "redaction": {"status": "passed", "report_sha256": helper.sha256_bytes(encoded.encode("utf-8"))},
            "retention_class": "cleanup_report_only",
        }
        try:
            kit = fresh["kit"]
            kit["validate_terminal_seal_request"](request)
            if before_seal is not None:
                before_seal(encoded, request)
            evidence = fresh["profile"].commands["evidence"]
            if not isinstance(evidence, str) or Path(evidence).is_absolute() or Path(evidence).as_posix() != evidence:
                raise helper.ContractError("profile evidence command is not project-relative")
            result = helper.run([str(ROOT / evidence), "seal", "--task", state["task_short_id"], "--workspace", str(ROOT)], cwd=ROOT, env=helper.child_env(), input_text=helper.canonical_json(request))
            sealed = helper._json_one(result.stdout.encode("utf-8"))
            if set(sealed) != {"ledger_path", "terminal_marker", "event_hash"} or not helper.HEX64.fullmatch(str(sealed.get("event_hash", ""))):
                raise helper.ContractError("terminal evidence seal response is not closed")
            expected_ledger = ROOT / ".kent" / "runtime" / state["task_short_id"] / "evidence-ledger.jsonl"
            if sealed["ledger_path"] != str(expected_ledger):
                raise helper.ContractError("terminal evidence ledger path is not the exact task-local path")
            marker_line = helper.require_string(sealed.get("terminal_marker"), "terminal_marker")
            marker = kit["parse_terminal_marker_line"](marker_line)
            if marker["task_short_id"] != state["task_short_id"]:
                raise helper.ContractError("terminal marker task identity drifted")
            if sealed["event_hash"] != marker["final_hash"] or marker["retention_class"] != "cleanup_report_only" or marker["redaction"] != request["redaction"] or marker["operation_report_digests"] != kit["validate_terminal_seal_request"](request)["operation_report_digests"]:
                raise helper.ContractError("terminal evidence seal response does not match the exact request")
            if marker["redaction"]["report_sha256"] != helper.sha256_bytes(encoded.encode("utf-8")):
                raise helper.ContractError("terminal evidence redaction digest does not match the canonical report line")
            kit["validate_cleanup_report"](encoded + "\n" + marker_line)
            _validate_terminal_marker_ledger(
                state["task_short_id"],
                marker,
                kit,
                allow_profile_checkpoint=bool(profile_report_digest or preparation_report_digest),
            )
        except helper.ContractError:
            raise
        except Exception as error:
            raise helper.ContractError(f"terminal evidence seal failed: {error}") from error
    else:
        marker_line = existing_marker
        try:
            marker = fresh["kit"]["parse_terminal_marker_line"](marker_line)
            if marker["task_short_id"] != state["task_short_id"]:
                raise helper.ContractError("preserved terminal marker task identity drifted")
            fresh["kit"]["validate_cleanup_report"](encoded + "\n" + marker_line)
        except helper.ContractError:
            raise
        except Exception as error:
            raise helper.ContractError(f"preserved terminal evidence marker is invalid: {error}") from error
    report = encoded + "\n" + marker_line
    return report, helper.sha256_bytes(report.encode("utf-8"))

def _read_ledger(state: dict, marker_hint: dict | None = None) -> tuple[list[dict], dict | None]:
    """Read existing evidence only; never create a missing approval/attempt store."""
    path = ROOT / ".kent/scripts/workflow-evidence-ledger"
    spec = importlib.util.spec_from_loader("cleanup_evidence_reader", SourceFileLoader("cleanup_evidence_reader", str(path)))
    ledger = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(ledger)
    descriptors = [os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)]
    try:
        for component in (".kent", "runtime"):
            descriptors.append(ledger._open_directory(descriptors[-1], component, create=False))
        try:
            descriptors.append(ledger._open_directory(descriptors[-1], state["task_short_id"], create=False))
        except FileNotFoundError:
            if marker_hint is None:
                if any(name.startswith(".evidence-cleanup-") for name in os.listdir(descriptors[-1])):
                    raise helper.ContractError("terminal evidence requires its existing exact marker")
                return [], None
            tombstone = ".evidence-cleanup-" + helper._kit_modules()["canonical_sha256"](marker_hint)
            descriptors.append(ledger._open_directory(descriptors[-1], tombstone, create=False))
        entries = os.listdir(descriptors[-1])
        allowed = {
            "evidence-ledger.jsonl",
            "evidence-recovery.json",
            "evidence-continuation.jsonl",
            "fix-checkpoint.json",
            "smoke-checkpoint.json",
            helper.CHECKPOINT_BASENAME,
        }
        if (
            len(entries) > 68
            or any(
                name not in allowed and not CI_REPORT_NAME.fullmatch(name)
                for name in entries
            )
        ):
            raise helper.ContractError(
                "cleanup runtime inventory has an unknown entry; preserve all state"
            )
        # The stock generic checkpoint schema has progress arrays but no
        # authoritative completion/resource-release receipt. Even remaining=[]
        # cannot prove a fix/smoke obligation ended. Only its owning stage may
        # settle and clear it; Cleanup must not silently discard the file.
        for stage in ("fix", "smoke"):
            try:
                os.stat(f"{stage}-checkpoint.json", dir_fd=descriptors[-1], follow_symlinks=False)
            except FileNotFoundError:
                continue
            raise helper.ContractError(f"{stage} checkpoint completion/resource release is unproven; preserve and settle it in its owning stage")
        view = ledger.load_evidence_view(
            descriptors[-1], task=state["task_short_id"],
        )
        records = view["records"]
        if len(records) > 8192:
            raise helper.ContractError("cleanup ledger record limit exceeded")
        seals = [i for i,r in enumerate(records) if r.get("record_kind") == "terminal_evidence_seal_v1"]
        if seals and seals != [len(records)-1]:
            raise helper.ContractError("cleanup seal is not terminal")
        marker = helper._kit_modules()["validate_terminal_chain"](records, task_short_id=state["task_short_id"]) if seals else None
        return records, marker
    except FileNotFoundError:
        return [], None
    except (OSError, ValueError) as error:
        raise helper.ContractError(f"cleanup ledger cannot be read safely: {error}") from error
    finally:
        for descriptor in reversed(descriptors): os.close(descriptor)


def _preflight_cleanup_inventory(
    state: dict,
    marker: dict | None,
) -> None:
    """Validate existing ledger, cache, checkpoint, and file inventory before seal."""
    task_dir = ROOT / ".kent" / "runtime" / state["task_short_id"]
    checkpoint_path = task_dir / helper.CHECKPOINT_BASENAME
    try:
        checkpoint_metadata = checkpoint_path.lstat()
    except FileNotFoundError:
        checkpoint_present = False
    except OSError as error:
        raise helper.ContractError(
            "profile checkpoint inventory is unreadable"
        ) from error
    else:
        if stat.S_ISLNK(checkpoint_metadata.st_mode) or not stat.S_ISREG(
            checkpoint_metadata.st_mode
        ):
            raise helper.ContractError(
                "profile checkpoint inventory is unsafe"
            )
        checkpoint_present = True
    kit = helper._kit_modules()
    observed = _validate_terminal_marker_ledger(
        state["task_short_id"],
        marker,
        kit,
        allow_profile_checkpoint=checkpoint_present,
    )
    if observed != marker:
        raise helper.ContractError(
            "terminal evidence history changed during cleanup preflight"
        )


def _retention_open_directory(task_short_id: str, *, create: bool):
    """Open the fixed ignored receipt directory without following links."""
    descriptors: list[int] = []
    try:
        descriptors.append(os.open(ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW))
        for name, private in (
            ("build", False),
            ("kent-workflow", True),
            (task_short_id, True),
        ):
            try:
                descriptor = os.open(
                    name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=descriptors[-1],
                )
            except FileNotFoundError:
                if not create:
                    for opened in reversed(descriptors):
                        os.close(opened)
                    return None
                try:
                    os.mkdir(name, 0o700, dir_fd=descriptors[-1])
                except FileExistsError:
                    pass
                descriptor = os.open(
                    name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=descriptors[-1],
                )
                if private:
                    os.fchmod(descriptor, 0o700)
            metadata = os.fstat(descriptor)
            mode = stat.S_IMODE(metadata.st_mode)
            if (
                not stat.S_ISDIR(metadata.st_mode)
                or metadata.st_uid != os.getuid()
                or (mode != 0o700 if private else bool(mode & 0o022))
            ):
                os.close(descriptor)
                raise helper.ContractError("cleanup retention directory is unsafe")
            descriptors.append(descriptor)
        return descriptors[-1], descriptors
    except (OSError, ValueError) as error:
        for opened in reversed(descriptors):
            try:
                os.close(opened)
            except OSError:
                pass
        if isinstance(error, helper.ContractError):
            raise
        raise helper.ContractError("cleanup retention directory is unavailable") from error


def _retention_read(
    task_short_id: str,
    *,
    allowed_temporary: str | None = None,
) -> tuple[dict | None, bytes | None, str | None]:
    opened = _retention_open_directory(task_short_id, create=False)
    if opened is None:
        return None, None, None
    directory, descriptors = opened
    try:
        entries = os.listdir(directory)
        allowed = {RETENTION_BASENAME}
        packet_prefix = (
            f"build/kent-workflow/{task_short_id}/packets/"
        )
        packet_names = {
            path[len(packet_prefix):]
            for path in _PROVIDER_PACKET_FILES
            if path.startswith(packet_prefix)
        }
        if len(packet_names) != len(_PROVIDER_PACKET_FILES):
            raise helper.ContractError(
                "Cleanup producer artifact closure is not task-local"
            )
        if packet_names:
            if (
                type(_PROVIDER_PACKET_LIMIT) is not int
                or not 0 < _PROVIDER_PACKET_LIMIT <= RETENTION_LIMIT
            ):
                raise helper.ContractError(
                    "Cleanup producer artifact size contract is unavailable"
                )
            allowed.add("packets")
            try:
                packet_directory = os.open(
                    "packets",
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                    dir_fd=directory,
                )
            except OSError as error:
                raise helper.ContractError(
                    "Cleanup producer artifact directory is unsafe"
                ) from error
            try:
                packet_metadata = os.fstat(packet_directory)
                if (
                    packet_metadata.st_uid != os.getuid()
                    or stat.S_IMODE(packet_metadata.st_mode) != 0o700
                    or set(os.listdir(packet_directory)) != packet_names
                ):
                    raise helper.ContractError(
                        "Cleanup producer artifacts differ from authenticated ancestry"
                    )
                for name in sorted(packet_names):
                    match = re.fullmatch(
                        r"(?:base|emitted)-([0-9a-f]{64})\.json",
                        name,
                    )
                    if match is None:
                        raise helper.ContractError(
                            "Cleanup producer artifact name is invalid"
                        )
                    descriptor = os.open(
                        name,
                        os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                        dir_fd=packet_directory,
                    )
                    try:
                        before = os.fstat(descriptor)
                        if (
                            not stat.S_ISREG(before.st_mode)
                            or before.st_uid != os.getuid()
                            or stat.S_IMODE(before.st_mode) != 0o600
                            or before.st_nlink != 1
                            or before.st_size > _PROVIDER_PACKET_LIMIT
                        ):
                            raise helper.ContractError(
                                "Cleanup producer artifact file is unsafe"
                            )
                        raw = bytearray()
                        while len(raw) <= _PROVIDER_PACKET_LIMIT:
                            chunk = os.read(
                                descriptor,
                                min(
                                    65536,
                                    _PROVIDER_PACKET_LIMIT + 1 - len(raw),
                                ),
                            )
                            if not chunk:
                                break
                            raw.extend(chunk)
                        after = os.fstat(descriptor)
                        if (
                            len(raw) != before.st_size
                            or hashlib.sha256(raw).hexdigest() != match.group(1)
                            or (
                                before.st_dev,
                                before.st_ino,
                                before.st_size,
                                before.st_mtime_ns,
                                before.st_ctime_ns,
                            )
                            != (
                                after.st_dev,
                                after.st_ino,
                                after.st_size,
                                after.st_mtime_ns,
                                after.st_ctime_ns,
                            )
                        ):
                            raise helper.ContractError(
                                "Cleanup producer artifact changed during read"
                            )
                    finally:
                        os.close(descriptor)
            finally:
                os.close(packet_directory)
        if allowed_temporary is not None:
            if (
                not re.fullmatch(r"\.release-cleanup-retention-[0-9a-f]{24}\.tmp", allowed_temporary)
                or allowed_temporary == RETENTION_BASENAME
            ):
                raise helper.ContractError("cleanup retention temporary name is invalid")
            allowed.add(allowed_temporary)
        if any(name not in allowed for name in entries) or len(entries) > len(allowed):
            raise helper.ContractError(
                "cleanup retention directory has unknown entries; preserve all state"
            )
        if RETENTION_BASENAME not in entries:
            return None, None, None
        descriptor = os.open(
            RETENTION_BASENAME,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
            dir_fd=directory,
        )
        try:
            before = os.fstat(descriptor)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_uid != os.getuid()
                or stat.S_IMODE(before.st_mode) != 0o600
                or before.st_nlink != 1
                or not 0 < before.st_size <= RETENTION_LIMIT
            ):
                raise helper.ContractError("cleanup retention receipt file is unsafe")
            raw = bytearray()
            while len(raw) <= RETENTION_LIMIT:
                chunk = os.read(descriptor, min(65536, RETENTION_LIMIT + 1 - len(raw)))
                if not chunk:
                    break
                raw.extend(chunk)
            after = os.fstat(descriptor)
            linked = os.stat(
                RETENTION_BASENAME, dir_fd=directory, follow_symlinks=False
            )
            if (
                len(raw) != before.st_size
                or (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
                != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
                or (before.st_dev, before.st_ino) != (linked.st_dev, linked.st_ino)
            ):
                raise helper.ContractError("cleanup retention receipt changed during read")
            value = helper._json_one(bytes(raw))
            if (
                helper.canonical_bytes(value) + b"\n" != bytes(raw)
                or value.get("schema") != RETENTION_SCHEMA
                or value.get("task_short_id") != task_short_id
            ):
                raise helper.ContractError("cleanup retention receipt is not canonical")
            _validate_retention_value(value)
            raw_bytes = bytes(raw)
            return value, raw_bytes, helper.sha256_bytes(raw_bytes)
        finally:
            os.close(descriptor)
    finally:
        for opened in reversed(descriptors):
            os.close(opened)


def _validate_retention_value(value: dict) -> None:
    expected = {
        "schema", "phase", "task_id", "task_short_id", "controller_commit",
        "execution_commit", "incoming_transition", "caller_session_id",
        "caller_identity", "source_envelope_digest", "operation_digest",
        "input_json", "input_sha256", "checkpoint_present",
        "checkpoint_bytes_b64", "checkpoint_sha256", "seal_request",
        "report_prefix", "report_prefix_sha256", "final_cleanup_report",
        "final_marker_line", "final_report_sha256",
    }
    if set(value) != expected or value.get("schema") != RETENTION_SCHEMA:
        raise helper.ContractError("cleanup retention receipt fields are not closed")
    for field in (
        "task_id", "task_short_id", "controller_commit", "execution_commit",
        "incoming_transition", "caller_session_id", "source_envelope_digest",
        "operation_digest", "input_json", "input_sha256",
        "checkpoint_bytes_b64", "checkpoint_sha256", "report_prefix",
        "report_prefix_sha256", "final_cleanup_report", "final_marker_line",
        "final_report_sha256",
    ):
        if not isinstance(value.get(field), str):
            raise helper.ContractError("cleanup retention string field is invalid")
    if (
        value["schema"] != RETENTION_SCHEMA
        or value["phase"] not in {"prepared", "sealed"}
        or not helper.TASK_ID.fullmatch(value["task_id"])
        or not helper.TASK_SHORT_ID.fullmatch(value["task_short_id"])
        or not helper.SHA1.fullmatch(value["controller_commit"])
        or not helper.SHA1.fullmatch(value["execution_commit"])
        or value["incoming_transition"] not in ENTRY_OUTCOMES
        or not helper.HEX64.fullmatch(value["source_envelope_digest"])
        or not helper.HEX64.fullmatch(value["operation_digest"])
        or not helper.HEX64.fullmatch(value["input_sha256"])
        or not helper.HEX64.fullmatch(value["checkpoint_sha256"])
        or not helper.HEX64.fullmatch(value["report_prefix_sha256"])
        or not isinstance(value["checkpoint_present"], bool)
        or not isinstance(value["caller_identity"], dict)
        or set(value["caller_identity"]) != SESSION_IDENTITY_KEYS
        or not isinstance(value["seal_request"], dict)
    ):
        raise helper.ContractError("cleanup retention receipt identity is invalid")
    if helper.sha256_bytes(value["input_json"].encode("utf-8")) != value["input_sha256"]:
        raise helper.ContractError("cleanup retention input digest mismatch")
    input_value = helper._json_one(value["input_json"].encode("utf-8"))
    if (
        helper.canonical_json(input_value) != value["input_json"]
        or set(input_value) != {"task_id", "incoming_transition", "parameters"}
        or input_value["task_id"] != value["task_id"]
        or input_value["incoming_transition"] != value["incoming_transition"]
        or not isinstance(input_value["parameters"], dict)
        or any(
            not isinstance(key, str) or not isinstance(item, str)
            for key, item in input_value["parameters"].items()
        )
    ):
        raise helper.ContractError("cleanup retention original input is invalid")
    if (
        input_value["incoming_transition"] != value["incoming_transition"]
        or any(
            not isinstance(item, str)
            for item in value["caller_identity"].values()
        )
        or any(
            not value["caller_identity"][key].strip()
            for key in SESSION_IDENTITY_KEYS - {"recorded_branch_ref"}
        )
    ):
        raise helper.ContractError("cleanup retention owner identity is invalid")
    try:
        checkpoint = base64.b64decode(value["checkpoint_bytes_b64"], validate=True)
    except (ValueError, base64.binascii.Error) as error:
        raise helper.ContractError("cleanup retention checkpoint encoding is invalid") from error
    if (
        len(checkpoint) > helper.CHECKPOINT_LIMIT
        or value["checkpoint_present"] != bool(checkpoint)
        or helper.sha256_bytes(checkpoint) != value["checkpoint_sha256"]
        or base64.b64encode(checkpoint).decode("ascii") != value["checkpoint_bytes_b64"]
    ):
        raise helper.ContractError("cleanup retention checkpoint bytes differ")
    prefix = value["report_prefix"]
    if (
        len(prefix.encode("utf-8")) > 2 * 1024 * 1024
        or helper.sha256_bytes(prefix.encode("utf-8")) != value["report_prefix_sha256"]
        or helper.canonical_json(
            helper.parse_closed_json(prefix, "puber_cleanup_report_v1", helper.CLEANUP_KEYS)
        ) != prefix
    ):
        raise helper.ContractError("cleanup retention report prefix is invalid")
    prefix_value = helper.parse_closed_json(
        prefix, "puber_cleanup_report_v1", helper.CLEANUP_KEYS
    )
    kit = helper._kit_modules()
    try:
        request = kit["validate_terminal_seal_request"](value["seal_request"])
    except Exception as error:
        raise helper.ContractError("cleanup retention seal request is invalid") from error
    if (
        helper.canonical_json(request) != helper.canonical_json(value["seal_request"])
        or request["redaction"]["report_sha256"]
        != helper.sha256_bytes(prefix.encode("utf-8"))
        or request["retention_class"] != "cleanup_report_only"
        or prefix_value["cleanup_session_id"] != value["caller_session_id"]
        or prefix_value["operation_digest"] != value["operation_digest"]
        or prefix_value["unresolved"] is not False
        or prefix_value["blocker_reason"] != ""
    ):
        raise helper.ContractError("cleanup retention request/report binding differs")
    if value["phase"] == "prepared":
        if value["final_cleanup_report"] or value["final_marker_line"] or value["final_report_sha256"]:
            raise helper.ContractError("prepared retention receipt contains terminal output")
    else:
        report = value["final_cleanup_report"]
        if (
            not report
            or not value["final_marker_line"]
            or not helper.HEX64.fullmatch(value["final_report_sha256"])
            or helper.sha256_bytes(report.encode("utf-8")) != value["final_report_sha256"]
            or report != prefix + "\n" + value["final_marker_line"]
        ):
            raise helper.ContractError("sealed retention receipt output is invalid")
        try:
            marker = kit["parse_terminal_marker_line"](value["final_marker_line"])
            kit["validate_cleanup_report"](report)
        except Exception as error:
            raise helper.ContractError("sealed retention report is not valid") from error
        if (
            marker["task_short_id"] != value["task_short_id"]
            or marker["operation_report_digests"]
            != request["operation_report_digests"]
            or marker["redaction"] != request["redaction"]
            or marker["retention_class"] != request["retention_class"]
        ):
            raise helper.ContractError("sealed retention marker differs from its request")


def _retention_write(task_short_id: str, value: dict, *, expected_sha256: str | None) -> str:
    _validate_retention_value(value)
    raw = helper.canonical_bytes(value) + b"\n"
    if len(raw) > RETENTION_LIMIT:
        raise helper.ContractError("cleanup retention receipt exceeds its bound")
    current, _current_bytes, current_sha256 = _retention_read(task_short_id)
    if current_sha256 != expected_sha256:
        raise helper.ContractError("cleanup retention receipt changed before replacement")
    opened = _retention_open_directory(task_short_id, create=True)
    if opened is None:
        raise helper.ContractError("cleanup retention directory could not be created")
    directory, descriptors = opened
    temporary = ".release-cleanup-retention-" + helper.secrets.token_hex(12) + ".tmp"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory,
        )
        os.fchmod(descriptor, 0o600)
        created = os.fstat(descriptor)
        created_identity = (
            created.st_dev,
            created.st_ino,
            created.st_uid,
            created.st_mode,
            created.st_nlink,
        )
        view = memoryview(raw)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise helper.ContractError("cleanup retention receipt write was incomplete")
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        current, _current_bytes, current_sha256 = _retention_read(
            task_short_id, allowed_temporary=temporary
        )
        if current_sha256 != expected_sha256:
            raise helper.ContractError("cleanup retention receipt changed before commit")
        temporary_descriptor = os.open(
            temporary,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
            dir_fd=directory,
        )
        try:
            before = os.fstat(temporary_descriptor)
            temporary_raw = bytearray()
            while len(temporary_raw) <= RETENTION_LIMIT:
                chunk = os.read(
                    temporary_descriptor,
                    min(65536, RETENTION_LIMIT + 1 - len(temporary_raw)),
                )
                if not chunk:
                    break
                temporary_raw.extend(chunk)
            after = os.fstat(temporary_descriptor)
            linked = os.stat(
                temporary, dir_fd=directory, follow_symlinks=False
            )
            observed = (
                before.st_dev,
                before.st_ino,
                before.st_uid,
                before.st_mode,
                before.st_nlink,
            )
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_uid != os.getuid()
                or stat.S_IMODE(before.st_mode) != 0o600
                or before.st_nlink != 1
                or observed != created_identity
                or len(temporary_raw) != before.st_size
                or bytes(temporary_raw) != raw
                or (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
                != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
                or (before.st_dev, before.st_ino)
                != (linked.st_dev, linked.st_ino)
            ):
                raise helper.ContractError(
                    "cleanup retention temporary changed before commit"
                )
        finally:
            os.close(temporary_descriptor)
        os.replace(
            temporary,
            RETENTION_BASENAME,
            src_dir_fd=directory,
            dst_dir_fd=directory,
        )
        os.fsync(directory)
        result, result_raw, result_sha256 = _retention_read(task_short_id)
        if result != value or result_raw != raw:
            raise helper.ContractError("cleanup retention receipt readback differs")
        return result_sha256
    except OSError as error:
        raise helper.ContractError("cleanup retention receipt write failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        for opened_descriptor in reversed(descriptors):
            os.close(opened_descriptor)


def _retention_comment_body(value: dict, digest: str) -> str:
    return (
        "PuberCleanupRetentionV1 "
        f"task={value['task_id']} short={value['task_short_id']} "
        f"session={value['caller_session_id']} phase={value['phase']} "
        f"path=build/kent-workflow/{value['task_short_id']}/{RETENTION_BASENAME} "
        f"sha256={digest}"
    )


def _retention_comment_search(state: dict, body: str) -> bool:
    command = [
        helper._kent_bin(ROOT), "task", "search", body,
        "--include-comments", "--case-sensitive",
        "--project", helper.PROJECT_ID, "--page-size", "2",
        "--offset", "0", "--json",
    ]
    try:
        result = subprocess.run(
            command,
            cwd=ROOT,
            env=helper.child_env(),
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise helper.ContractError("cleanup Task-record readback is UNKNOWN") from error
    if result.returncode != 0 or result.stderr.strip() or len(result.stdout.encode()) > 2 * 1024 * 1024:
        raise helper.ContractError("cleanup Task-record search is incomplete")
    try:
        result_value = helper._json_one(result.stdout.encode("utf-8"))
    except (ValueError, UnicodeError) as error:
        raise helper.ContractError("cleanup Task-record search returned invalid JSON") from error
    if set(result_value) != {"groups", "mode"} or result_value["mode"] != "literal":
        raise helper.ContractError("cleanup Task-record search shape is not exact")
    groups = result_value["groups"]
    if not isinstance(groups, list):
        raise helper.ContractError("cleanup Task-record search groups are invalid")
    if not groups:
        return False
    if len(groups) != 1:
        raise helper.ContractError("cleanup Task-record reference is ambiguous")
    group = groups[0]
    expected_group_keys = {
        "hits", "project_id", "project_key", "short_id", "status", "task_id",
        "title", "total_hit_count", "workflow_id",
    }
    if (
        not isinstance(group, dict)
        or set(group) != expected_group_keys
        or group["task_id"] != state["task_id"]
        or group["short_id"] != state["task_short_id"]
        or group["project_id"] != helper.PROJECT_ID
        or type(group["total_hit_count"]) is not int
        or group["total_hit_count"] != 1
        or not isinstance(group["hits"], list)
        or len(group["hits"]) != 1
    ):
        raise helper.ContractError("cleanup Task-record reference identity is not exact")
    hit = group["hits"][0]
    if (
        not isinstance(hit, dict)
        or set(hit) != {"literal", "ordinal", "source"}
        or not isinstance(hit["source"], dict)
        or hit["source"].get("kind") != "comment"
        or set(hit["source"]) - {"kind", "comment_id"}
        or not isinstance(hit["literal"], dict)
        or set(hit["literal"]) != {
            "after", "before", "left_truncated", "match", "right_truncated",
        }
        or hit["literal"]["match"] != body
        or hit["literal"]["before"] != ""
        or hit["literal"]["after"] != ""
        or hit["literal"]["left_truncated"] is not False
        or hit["literal"]["right_truncated"] is not False
    ):
        raise helper.ContractError("cleanup Task-record comment readback is not exact")
    return True


def _retain_task_comment(
    state: dict,
    value: dict,
    digest: str,
    *,
    require_existing: bool = False,
) -> None:
    body = _retention_comment_body(value, digest)
    if _retention_comment_search(state, body):
        return
    if require_existing:
        raise helper.ContractError(
            "sealed cleanup Task-record reference is missing; preserve all state"
        )
    command = [
        helper._kent_bin(ROOT), "task", "comment", "add", state["task_id"],
        "--project", helper.PROJECT_ID, "--body", body,
        "--author", "agent", "--author-id", CALLER_SESSION_ID,
    ]
    try:
        result = subprocess.run(
            command,
            cwd=ROOT,
            env=helper.child_env(),
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise helper.ContractError("cleanup Task-record retention write is UNKNOWN") from error
    if (
        result.returncode != 0
        or len(result.stdout.encode()) > 64 * 1024
        or len(result.stderr.encode()) > 64 * 1024
    ):
        raise helper.ContractError("cleanup Task-record retention write failed")
    if not _retention_comment_search(state, body):
        raise helper.ContractError("cleanup Task-record retention readback is missing")


def _preflight_retention(state: dict, marker: dict | None) -> dict | None:
    value, _raw, digest = _retention_read(state["task_short_id"])
    if value is None:
        if marker is not None:
            raise helper.ContractError(
                "terminal seal has no retained original cleanup input; preserve all state"
            )
        return None
    if (
        value["task_id"] != state["task_id"]
        or value["task_short_id"] != state["task_short_id"]
        or value["controller_commit"] != state["controller_commit"]
        or value["execution_commit"] != state["commit"]
    ):
        raise helper.ContractError("cleanup retention receipt identity drifted")
    if value["caller_session_id"] != CALLER_SESSION_ID:
        if value["phase"] == "sealed":
            raise helper.ContractError(
                "sealed cleanup retention receipt belongs to a different owner session"
            )
        raise helper.ContractError(
            "prepared cleanup retention receipt belongs to a different caller session"
        )
    checkpoint = helper.read_profile_checkpoint(
        ROOT,
        state["task_short_id"],
        expected={
            "task_id": state["task_id"],
            "task_short_id": state["task_short_id"],
            "release_base_oid": state["commit"],
            "release_head_oid": state["controller_commit"],
        },
        with_receipt=True,
        with_snapshot=True,
        missing_ok=True,
    )
    if checkpoint is None:
        checkpoint_raw = b""
        if value["phase"] != "sealed" or marker is None:
            raise helper.ContractError(
                "checkpoint is absent before a complete matching seal; preserve all state"
            )
        _retain_task_comment(state, value, digest, require_existing=True)
    else:
        _checkpoint_value, _checkpoint_receipt, checkpoint_raw = checkpoint
        if (
            not value["checkpoint_present"]
            or helper.sha256_bytes(checkpoint_raw) != value["checkpoint_sha256"]
            or base64.b64encode(checkpoint_raw).decode("ascii")
            != value["checkpoint_bytes_b64"]
        ):
            raise helper.ContractError(
                "profile checkpoint differs from retained original bytes; preserve all state"
            )
    if checkpoint_raw and not value["checkpoint_present"]:
        raise helper.ContractError(
            "checkpoint presence differs from the retained original state"
        )
    if not checkpoint_raw and value["checkpoint_present"] and (
        value["phase"] != "sealed" or marker is None
    ):
        raise helper.ContractError(
            "original checkpoint is absent before a complete matching seal"
        )
    if marker is not None:
        marker_line = _seal_matches_retention(marker, value)
        if (
            value["phase"] == "sealed"
            and marker_line != value["final_marker_line"]
        ):
            raise helper.ContractError(
                "terminal seal differs from the completed retention receipt"
            )
    elif value["phase"] != "prepared":
        raise helper.ContractError("retention phase conflicts with the absent seal")
    return value


def _retention_for_report(
    state: dict,
    raw: dict,
    session: str,
    session_identity: dict[str, str],
    checkpoint_raw: bytes,
    report_prefix: str,
    seal_request: dict,
    operation_digest: str,
    source_envelope_digest: str,
) -> dict:
    prefix_bytes = report_prefix.encode("utf-8")
    input_json = helper.canonical_json(raw)
    return {
        "schema": RETENTION_SCHEMA,
        "phase": "prepared",
        "task_id": state["task_id"],
        "task_short_id": state["task_short_id"],
        "controller_commit": state["controller_commit"],
        "execution_commit": state["commit"],
        "incoming_transition": raw["incoming_transition"],
        "caller_session_id": session,
        "caller_identity": dict(session_identity),
        "source_envelope_digest": source_envelope_digest,
        "operation_digest": operation_digest,
        "input_json": input_json,
        "input_sha256": helper.sha256_bytes(input_json.encode("utf-8")),
        "checkpoint_present": bool(checkpoint_raw),
        "checkpoint_bytes_b64": base64.b64encode(checkpoint_raw).decode("ascii"),
        "checkpoint_sha256": helper.sha256_bytes(checkpoint_raw),
        "seal_request": dict(seal_request),
        "report_prefix": report_prefix,
        "report_prefix_sha256": helper.sha256_bytes(prefix_bytes),
        "final_cleanup_report": "",
        "final_marker_line": "",
        "final_report_sha256": "",
    }


def _seal_matches_retention(marker: dict, value: dict) -> str:
    kit = helper._kit_modules()
    marker_line = kit["terminal_marker_line"](marker)
    request = value["seal_request"]
    if (
        marker["task_short_id"] != value["task_short_id"]
        or marker["operation_report_digests"]
        != request["operation_report_digests"]
        or marker["redaction"] != request["redaction"]
        or marker["retention_class"] != request["retention_class"]
        or marker["redaction"]["report_sha256"]
        != value["report_prefix_sha256"]
    ):
        raise helper.ContractError(
            "terminal seal differs from the durable pre-seal retention receipt"
        )
    return marker_line


def _select_original_input(
    provided: dict,
    value: dict | None,
    marker: dict | None,
    identity: dict,
) -> dict:
    if value is None:
        if marker is not None:
            raise helper.ContractError(
                "sealed cleanup has no retained original input"
            )
        return provided
    original = helper._json_one(value["input_json"].encode("utf-8"))
    if (
        original.get("task_id") != value["task_id"]
        or original.get("incoming_transition") != value["incoming_transition"]
    ):
        raise helper.ContractError(
            "retained original cleanup input identity differs"
        )
    if provided == original:
        return original
    if (
        provided.get("task_id") != value["task_id"]
        or provided.get("incoming_transition") != "task_janitor_blocked"
        or not isinstance(provided.get("parameters"), dict)
        or set(provided["parameters"])
        != {
            "workspace_path",
            "operation_id",
            "branch_name",
            "pr_base_branch",
            "cleanup_mode",
            "cleanup_report",
        }
        or any(
            not isinstance(item, str)
            for item in provided["parameters"].values()
        )
        or marker is None
    ):
        raise helper.ContractError(
            "cleanup retry is not the original input or its exact Janitor replay"
        )
    parameters = provided["parameters"]
    prior, marker_line, _suffix, prefix = _parse_janitor_report(
        parameters["cleanup_report"], value["task_short_id"]
    )
    expected_marker = _seal_matches_retention(marker, value)
    original_parameters = original["parameters"]
    expected_workspace_path = (
        original_parameters["workspace_path"]
        if "workspace_path" in original_parameters
        else str(ROOT)
    )
    expected_branch_name = (
        original_parameters["branch_name"]
        if "branch_name" in original_parameters
        else identity["branch"]
    )
    expected_pr_base_branch = original_parameters["pr_base_branch"]
    if (
        prefix != value["report_prefix"]
        or marker_line != expected_marker
        or parameters["workspace_path"] != expected_workspace_path
        or parameters["branch_name"] != expected_branch_name
        or parameters["pr_base_branch"] != expected_pr_base_branch
        or parameters["cleanup_mode"] != prior["cleanup_mode"]
    ):
        raise helper.ContractError(
            "Janitor replay differs from retained original cleanup proof"
        )
    if not helper.HEX64.fullmatch(parameters["operation_id"]):
        raise helper.ContractError("Janitor replay operation identity is invalid")
    expected_operation_id = original_parameters.get("operation_id")
    if value["checkpoint_present"]:
        checkpoint = helper._json_one(
            base64.b64decode(value["checkpoint_bytes_b64"], validate=True)
        )
        checkpoint_operation_id = checkpoint.get("operation_id")
        if not isinstance(checkpoint_operation_id, str):
            raise helper.ContractError(
                "retained release checkpoint has no operation identity"
            )
        if expected_operation_id and expected_operation_id != checkpoint_operation_id:
            raise helper.ContractError(
                "retained original/checkpoint operation identities differ"
            )
        expected_operation_id = checkpoint_operation_id
    if (
        expected_operation_id is not None
        and parameters["operation_id"] != expected_operation_id
    ):
        raise helper.ContractError(
            "Janitor replay operation identity differs from retained cleanup"
        )
    if value["phase"] != "sealed":
        raise helper.ContractError(
            "Janitor replay precedes complete durable cleanup retention"
        )
    return original


def _api(endpoint: str, *, absent=False):
    """A bounded existing gh CLI read; only an explicit visible-resource 404 is absent."""
    if _PROVIDER_POLICY_ENABLED:
        guard = _PROVIDER_READ_GUARD
        if not callable(guard):
            raise helper.ContractError(
                "GitHub provider guard is unavailable; no provider read was attempted"
            )
        guard()
    binary = os.environ.get("PUBER_GH_BIN") or shutil.which("gh")
    if not binary:
        raise helper.ContractError("GitHub reader is unavailable")
    try:
        result = subprocess.run([binary, "api", endpoint, "--include", "--method", "GET"], cwd=ROOT,
            env=helper.child_env(), capture_output=True, text=True, timeout=45, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise helper.ContractError("GitHub observation is UNKNOWN") from error
    raw = result.stdout.replace("\r\n", "\n")
    if len(raw.encode()) > 8 * 1024 * 1024 or "\n\n" not in raw:
        raise helper.ContractError("GitHub response is incomplete or oversized")
    headers, body = raw.split("\n\n", 1)
    status = re.fullmatch(r"HTTP/[^ ]+ ([0-9]{3})(?: .*)?", headers.splitlines()[0])
    if not status:
        raise helper.ContractError("GitHub status readback is UNKNOWN")
    code = int(status[1])
    if code == 404 and absent:
        return None, headers
    if code != 200 or result.returncode != 0:
        raise helper.ContractError("GitHub observation failed or visibility is UNKNOWN")
    value = helper._json_one(b'{"value":' + body.encode() + b'}')["value"]
    if absent and value is None:
        raise helper.ContractError("HTTP200 null is not an absence proof")
    return value, headers


def _prepare_agent_provider_read_guard(
    task_id: str,
    task_short_id: str,
    commentary: object,
):
    global _PROVIDER_PACKET_FILES, _PROVIDER_PACKET_LIMIT
    _PROVIDER_PACKET_FILES = set()
    _PROVIDER_PACKET_LIMIT = 0
    profile_path = ROOT / ".kent/workflow-profile.toml"
    if profile_path.is_symlink() or not profile_path.is_file():
        raise helper.ContractError("Release profile is unavailable for provider admission")
    try:
        profile = tomllib.loads(profile_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, tomllib.TOMLDecodeError) as error:
        raise helper.ContractError("Release profile is invalid for provider admission") from error
    policies = profile.get("policies", {})
    if not isinstance(policies, dict) or policies.get("delivery_reliability") != "v1":
        return None
    if not isinstance(commentary, str) or not commentary:
        raise helper.ContractError(
            "native Cleanup Agent producer commentary is required"
        )
    checkpoint = helper._qualified_checkpoint_module(
        ROOT,
        required=(
            "current_delivery_identity",
            "delivery_native_read",
            "delivery_module",
        ),
    )
    delivery_loader = getattr(checkpoint, "delivery_module", None)
    if not callable(delivery_loader):
        raise helper.ContractError("qualified GitHub delivery API is unavailable")
    delivery = delivery_loader()
    if not all(
        callable(getattr(delivery, name, None))
        for name in (
            "producer_locator",
            "producer_reference_closure",
            "prepare_github_provider_read_guard",
        )
    ):
        raise helper.ContractError("qualified GitHub provider guard API is unavailable")
    packet_limit = getattr(delivery, "PACKET_LIMIT", None)
    if type(packet_limit) is not int or not 0 < packet_limit <= RETENTION_LIMIT:
        raise helper.ContractError("qualified producer artifact byte bound is invalid")
    try:
        locator = delivery.producer_locator(commentary)
        if not isinstance(locator, str) or not locator:
            raise ValueError("Cleanup Agent source footer is absent")
        # The Puber runtime helper scrubs Kent execution variables at import.
        # Reintroduce only the inherited current Agent IDs for the bounded
        # native readback, then restore the scrubbed process environment.
        previous_session = os.environ.pop("KENT_SESSION_ID", None)
        previous_step = os.environ.pop("KENT_STEP_ID", None)
        try:
            os.environ["KENT_SESSION_ID"] = CALLER_SESSION_ID
            os.environ["KENT_STEP_ID"] = CALLER_STEP_ID
            identity = checkpoint.current_delivery_identity(ROOT, task_short_id)
        finally:
            os.environ.pop("KENT_SESSION_ID", None)
            os.environ.pop("KENT_STEP_ID", None)
            if previous_session is not None:
                os.environ["KENT_SESSION_ID"] = previous_session
            if previous_step is not None:
                os.environ["KENT_STEP_ID"] = previous_step
        if (
            not isinstance(identity, dict)
            or identity.get("task_id") != task_id
            or identity.get("task_short_id") != task_short_id
            or identity.get("workspace_path") != str(ROOT)
            or identity.get("session_id") != CALLER_SESSION_ID
        ):
            raise ValueError("native current Cleanup Agent identity differs")
        closure = delivery.producer_reference_closure(
            ROOT,
            locator,
            identity=identity,
        )
        if (
            not isinstance(closure, list)
            or not closure
            or any(not isinstance(path, str) for path in closure)
        ):
            raise ValueError("Cleanup Agent producer closure is incomplete")
        _PROVIDER_PACKET_FILES = set(closure)
        _PROVIDER_PACKET_LIMIT = packet_limit
        prepared = delivery.prepare_github_provider_read_guard(
            ROOT,
            [locator],
            identity,
        )
        blocked_type = getattr(delivery, "GitHubProviderRetryBlocked", None)
        if not isinstance(blocked_type, type):
            raise ValueError("qualified provider block type is missing")
    except Exception as error:
        raise helper.ContractError(
            "Cleanup Agent producer ancestry or native identity is invalid"
        ) from error

    def require_provider_read() -> None:
        try:
            prepared()
        except blocked_type as error:
            state = getattr(error, "state", None)
            if state not in {"not_before", "unknown"}:
                state = "unknown"
            raise helper.ContractError(
                f"GitHub provider read is blocked by inherited retry state: {state}"
            ) from None
        except Exception:
            raise helper.ContractError(
                "GitHub provider retry guard failed closed"
            ) from None

    return require_provider_read


def _pages(endpoint: str, *, array_key=None) -> list:
    rows = []
    total = None
    for page in range(1, 11):
        data, headers = _api(endpoint + ("&" if "?" in endpoint else "?") + f"per_page=100&page={page}")
        if array_key:
            if not isinstance(data, dict) or type(data.get("total_count")) is not int or data["total_count"] < 0:
                raise helper.ContractError("GitHub page total is UNKNOWN")
            if total is not None and total != data["total_count"]:
                raise helper.ContractError("GitHub page inventory changed")
            total = data["total_count"]
            data = data.get(array_key)
        if not isinstance(data, list) or len(data) > 100 or any(not isinstance(row, dict) for row in data):
            raise helper.ContractError("GitHub collection page is malformed")
        rows.extend(data)
        next_page = bool(re.search(r'rel="next"', headers))
        if len(data) < 100:
            if next_page or total is not None and total != len(rows):
                raise helper.ContractError("GitHub collection is truncated")
            ids = [row.get("id") for row in rows]
            if any(type(id) is not int or id <= 0 for id in ids) or len(set(ids)) != len(ids):
                raise helper.ContractError("GitHub collection IDs are ambiguous")
            return rows
    raise helper.ContractError("GitHub collection completeness exceeds bounded pagination")


def _release_identity(state: dict) -> dict:
    values = helper.declarations(state["task"].get("body"))
    version = values.get("release_version")
    version, tag = helper.safe_version_tag(version, values.get("release_tag") or f"v{version}")
    branch = helper.safe_release_branch(values.get("release_branch") or f"release/{version}", version)
    if state["caller_identity"]["recorded_branch_ref"] != f"refs/heads/{branch}":
        raise helper.ContractError("Task release branch differs from the actual H worktree")
    checkpoint = helper.read_profile_checkpoint(ROOT, state["task_short_id"], expected={
        "task_id":state["task_id"],"task_short_id":state["task_short_id"],"release_branch":branch,
    }, missing_ok=True)
    return {"version":version,"tag":tag,"branch":branch,"head":state["controller_commit"],"checkpoint":checkpoint}


def _observe(
    state: dict,
    identity: dict,
    records: list[dict],
    expected_pr_base_branch: str,
) -> dict:
    expected_pr_base_branch = helper.require_string(
        expected_pr_base_branch, "pr_base_branch"
    )
    repo, _headers = _api(f"repos/{helper.REPOSITORY}")
    if (not isinstance(repo, dict) or repo.get("id") != 994786793 or repo.get("full_name") != helper.REPOSITORY
            or repo.get("default_branch") != "master" or not isinstance(repo.get("permissions"), dict) or repo["permissions"].get("pull") is not True
            or repo.get("permissions", {}).get("push") is not True):
        raise helper.ContractError("repository identity or complete Release visibility is UNKNOWN")
    query = urlencode({"state":"all", "head":f"rovkinmax:{identity['branch']}"})
    found = _pages(f"repos/{helper.REPOSITORY}/pulls?" + query)
    prs = []
    for row in found:
        number = row.get("number")
        if type(number) is not int or number <= 0:
            raise helper.ContractError("PR discovery identity is incomplete")
        detail, _headers = _api(f"repos/{helper.REPOSITORY}/pulls/{number}")
        if (not isinstance(detail, dict) or detail.get("id") != row["id"] or detail.get("number") != number
                or detail.get("html_url") != f"https://github.com/{helper.REPOSITORY}/pull/{number}"
                or detail.get("state") not in {"open","closed"} or type(detail.get("merged")) is not bool):
            raise helper.ContractError("PR state is incomplete")
        for value in (row, detail):
            if any(not isinstance(value.get(side), dict) or not isinstance(value[side].get("repo"), dict) for side in ("head","base")):
                raise helper.ContractError("PR repository/head/base observation is UNKNOWN")
            if (value.get("head", {}).get("ref") != identity["branch"] or value.get("head", {}).get("sha") != identity["head"]
                    or not isinstance(value.get("base", {}).get("ref"), str)
                    or not value["base"]["ref"].strip()
                    or expected_pr_base_branch == NOT_APPLICABLE_BRANCH
                    or value.get("base", {}).get("ref") != expected_pr_base_branch
                    or not helper.SHA1.fullmatch(str(value["base"].get("sha", "")))
                    or any(value.get(side, {}).get("repo", {}).get("full_name") != helper.REPOSITORY for side in ("head","base"))):
                raise helper.ContractError("matching PR head/target identity is foreign or drifted")
        if row["base"]["sha"] != detail["base"]["sha"]:
            raise helper.ContractError("PR base changed during discovery")
        if detail["merged"]:
            if detail["state"] != "closed" or not isinstance(detail.get("merged_at"), str) or not helper.SHA1.fullmatch(str(detail.get("merge_commit_sha", ""))):
                raise helper.ContractError("merged PR proof is contradictory")
        elif detail.get("merged_at") is not None:
            raise helper.ContractError("unmerged PR has contradictory merge proof")
        observed_pr = {key:detail.get(key) for key in ("id","number","html_url","state","merged","merged_at","merge_commit_sha")}
        observed_pr.update({side:{"ref":detail[side]["ref"],"sha":detail[side].get("sha"),"repo":{"full_name":detail[side]["repo"]["full_name"]}} for side in ("head","base")})
        prs.append(observed_pr)
    if len(prs) > 1:
        raise helper.ContractError("matching PR history is ambiguous")
    local = helper.run(["git","show-ref","--verify","--quiet",f"refs/tags/{identity['tag']}"], cwd=ROOT, check=False)
    if local.returncode not in (0,1):
        raise helper.ContractError("local tag absence is UNKNOWN")
    remote, _headers = _api(f"repos/{helper.REPOSITORY}/git/ref/tags/{identity['tag']}", absent=True)
    all_releases = _pages(f"repos/{helper.REPOSITORY}/releases")
    if any(not isinstance(row.get("tag_name"), str) or not row["tag_name"] or type(row.get("draft")) is not bool or type(row.get("prerelease")) is not bool for row in all_releases):
        raise helper.ContractError("Release visibility/identity is UNKNOWN")
    # Compare identity/outcome fields, not counters/timestamps changed by our
    # own read-only artifact downloads or unrelated repository activity.
    releases = [{key:row.get(key) for key in ("id","tag_name","draft","prerelease")} for row in all_releases if row["tag_name"] == identity["tag"]]
    all_runs = _pages(f"repos/{helper.REPOSITORY}/actions/workflows/release.yml/runs?event=push", array_key="workflow_runs")
    if any(not isinstance(row.get("head_branch"), str) or not row["head_branch"] or not helper.SHA1.fullmatch(str(row.get("head_sha", ""))) or row.get("path") != ".github/workflows/release.yml" or row.get("event") != "push" for row in all_runs):
        raise helper.ContractError("production run identity is UNKNOWN")
    runs = [{key:row.get(key) for key in ("id","run_attempt","head_sha","head_branch","path","event","status","conclusion")} for row in all_runs if row["head_branch"] == identity["tag"]]
    all_artifacts = _pages(f"repos/{helper.REPOSITORY}/actions/artifacts", array_key="artifacts")
    if any(not isinstance(row.get("name"), str) or not row["name"] or type(row.get("expired")) is not bool or type(row.get("size_in_bytes")) is not int or row["size_in_bytes"] < 0 for row in all_artifacts):
        raise helper.ContractError("Actions artifact visibility/identity is UNKNOWN")
    artifacts = []
    for row in all_artifacts:
        if row["name"] == f"puber-{identity['tag']}":
            value = {key:row.get(key) for key in ("id","name","expired","size_in_bytes")}
            source = row.get("workflow_run")
            value["workflow_run"] = {key:source.get(key) for key in ("id","head_sha","head_branch")} if isinstance(source,dict) else None
            artifacts.append(value)
    notes = ROOT / ".todo" / state["task_short_id"]
    notes_present = False
    if notes.exists() or notes.is_symlink():
        if notes.is_symlink() or not notes.is_dir():
            raise helper.ContractError("Task notes location is unsafe")
        names = list(notes.iterdir())
        if len(names) > 256: raise helper.ContractError("Task notes inventory exceeds bound")
        notes_present = any(p.name == "release-notes-ru.md" or p.name.startswith(".release-notes-ru.md.") for p in names)
    history = any(r.get("node_key") in {"publish","monitor"} or r.get("evidence_type") in {"publication","release_report"} for r in records)
    return {"prs":prs,"local_tag":local.returncode==0,"remote_tag":remote,"releases":releases,"runs":runs,"artifacts":artifacts,"notes":notes_present,"history":history}


def _observable_outcome(facts: dict, carrier: dict) -> str:
    claimed = any(carrier.get(key) for key in ("publication_report","release_report","release_run","release_notes_path"))
    if (claimed or facts["local_tag"] or facts["remote_tag"] is not None or facts["releases"] or facts["runs"] or facts["artifacts"]
            or facts["notes"] or facts["history"] or any(p["merged"] for p in facts["prs"])):
        return "published"
    if facts["prs"]:
        if facts["prs"][0]["state"] != "closed": raise helper.ContractError("OPEN PR cannot be hidden as cancellation")
        return "closed"
    return "cancel"


def _verify_outcome(state: dict, identity: dict, facts: dict, outcome: str, carrier: dict, marker: dict | None) -> tuple[dict | None, dict | None]:
    if carrier.get("workspace_path") and Path(carrier["workspace_path"]).resolve() != ROOT:
        raise helper.ContractError("Cleanup carrier workspace drifted")
    if carrier.get("branch_name") and carrier["branch_name"] != identity["branch"]:
        raise helper.ContractError("Cleanup carrier branch drifted")
    expected_base_branch = helper.require_string(
        carrier.get("pr_base_branch"), "pr_base_branch"
    )
    if outcome == "cancel":
        if expected_base_branch != NOT_APPLICABLE_BRANCH:
            raise helper.ContractError(
                "no-PR cleanup must mark its absent target branch not-applicable"
            )
    elif (
        len(facts["prs"]) != 1
        or facts["prs"][0]["base"].get("ref") != expected_base_branch
        or expected_base_branch == NOT_APPLICABLE_BRANCH
    ):
        raise helper.ContractError(
            "Cleanup target branch differs from the independently observed PR"
        )
    if outcome != "published":
        if _observable_outcome(facts, carrier) != outcome:
            raise helper.ContractError("unpublished cleanup conflicts with publication indicators")
        expected_url = facts["prs"][0]["html_url"] if outcome == "closed" else ""
        if carrier.get("pr_url", "") != expected_url:
            raise helper.ContractError("Cleanup carrier cannot hide or replace the independently found PR")
        if outcome == "closed" and carrier.get("pr_head_oid") != identity["head"]:
            raise helper.ContractError("closed PR head proof differs from fresh observation")
        return None, None
    if len(facts["prs"]) != 1 or facts["prs"][0]["merged"] is not True:
        raise helper.ContractError("publication evidence is partial or has no exact merged PR")
    publication, release = _validate_carriers(state, carrier, require_release_run="release_run" in carrier)
    if publication is None or release is None:
        raise helper.ContractError("full publication and release carriers are mandatory")
    pr = facts["prs"][0]; target = pr["merge_commit_sha"]
    if (publication["pr_url"] != pr["html_url"] or publication["release_head_oid"] != identity["head"]
            or publication["release_version"] != identity["version"] or publication["release_tag"] != identity["tag"]
            or publication["target_commit"] != target or publication["unresolved"] is not False):
        raise helper.ContractError("publication carrier identity/outcome differs from observed release")
    if facts["local_tag"] and helper.local_tag(ROOT, identity["tag"]) != target:
        raise helper.ContractError("local publication tag conflicts with T")
    if len(facts["runs"]) != 1 or len(facts["releases"]) != 1:
        raise helper.ContractError("publication run/Release observation is missing or ambiguous")
    run = release["run"]; observed = facts["runs"][0]
    if observed.get("id") != run["run_id"] or observed.get("run_attempt") != run["attempt"] or observed.get("head_sha") != target:
        raise helper.ContractError("publication run/attempt is not current exact T")
    if any(not isinstance(row.get("workflow_run"), dict) or row["workflow_run"].get("id") != run["run_id"] or row.get("workflow_run", {}).get("head_sha") != target for row in facts["artifacts"]):
        raise helper.ContractError("publication Actions artifact belongs to another run/target")
    if identity["checkpoint"] is not None:
        helper.revalidate_publication_target(ROOT, state, publication)
    else:
        if marker is None: raise helper.ContractError("publication preparation proof is missing")
        _sealed_release_digests(helper._kit_modules()["terminal_marker_line"](marker), {"kit":helper._kit_modules()}, publication_digest=carrier["publication_report_digest"], preparation_digest=publication["release_preparation_report_digest"])
        # Immutable H plus its existing terminal preparation binding, not an invented report.
        prepared = {"release_head_oid":identity["head"], **{key:helper.git_blob_sha256(ROOT, identity["head"], path) for key,path in (
            ("version_file_sha256","app/build.gradle.kts"), ("baseline_profile_sha256","app/src/main/generated/baselineProfiles/baseline-prof.txt"), ("startup_profile_sha256","app/src/main/generated/baselineProfiles/startup-prof.txt"))}}
        helper.qualify_merged_target(ROOT, state, target, prepared)
    actual_run, actual_job = helper.read_release_run(
        ROOT,
        run,
        target,
        identity["tag"],
        provider_guard=_PROVIDER_READ_GUARD,
    )
    actual_release = helper.read_release(
        ROOT,
        identity["tag"],
        target,
        provider_guard=_PROVIDER_READ_GUARD,
    )
    if release["jobs"] != {"run":actual_run,"job":actual_job} or release["assets"] != actual_release["assets"] or release["checksum"] != actual_release["checksum"] or release["release"] != {key:actual_release[key] for key in helper.RELEASE_METADATA_KEYS}:
        raise helper.ContractError("published artifacts/run/report differ from actual read-only observation")
    body = (ROOT / publication["notes_report"]["path"]).read_text()
    if actual_release["body"] != body:
        raise helper.ContractError("Release notes differ; Cleanup never edits them")
    return publication, release


def _admit_sealed_controller(parameters: dict, state: dict) -> None:
    hint = None
    if parameters.get("cleanup_report"):
        _prior, line, _suffix, _prefix = _parse_janitor_report(parameters["cleanup_report"], state["task_short_id"])
        hint = helper._kit_modules()["parse_terminal_marker_line"](line)
    records, marker = _read_ledger(state, hint)
    _preflight_cleanup_inventory(state, marker)
    retention = _preflight_retention(state, marker)
    checkpoint = helper.read_profile_checkpoint(
        ROOT,
        state["task_short_id"],
        expected={
            "task_id": state["task_id"],
            "task_short_id": state["task_short_id"],
            "release_base_oid": state["commit"],
            "release_head_oid": state["controller_commit"],
        },
        missing_ok=True,
    )
    if marker is None and checkpoint is None:
        raise helper.ContractError(
            "prepared controller checkpoint and terminal seal are missing"
        )
    if checkpoint is not None:
        if (
            checkpoint["state"] != "completed"
            or not checkpoint["release_preparation_report"]
        ):
            raise helper.ContractError(
                "unfinished profile checkpoint cannot enter Cleanup"
            )
    if marker is not None and (
        retention is None
        or retention["phase"] not in {"prepared", "sealed"}
    ):
        raise helper.ContractError(
            "terminal controller has no admitted original cleanup receipt"
        )
    helper.release_diff_paths(ROOT, state["commit"], state["controller_commit"])
    if parameters.get("cleanup_report"):
        previous, line, _suffix, _prefix = _parse_janitor_report(parameters["cleanup_report"], state["task_short_id"])
        if helper._kit_modules()["parse_terminal_marker_line"](line) != marker or previous["cleanup_session_id"] != CALLER_SESSION_ID:
            raise helper.ContractError("sealed controller recovery owner/marker differs")
    # An original cancellation/CLOSED invocation has no Janitor carrier. Admit
    # only enough to recompute its observed outcome and exact canonical report;
    # _cleanup_report must match owner/outcome/digests against the existing seal
    # before any effect. This does not manufacture a report or another seal.
    if marker is not None:
        fresh = helper.attest(ROOT, state, "cleanup", "task_janitor_blocked")
        if not any(
            item["kind"] == "runtime_source"
            and item["sha256"]
            == fresh["binding"].runtime_source_envelope_digest
            for item in marker["operation_report_digests"]
        ):
            raise helper.ContractError(
                "terminal controller source differs from H"
            )


def main() -> int:
    global _PROVIDER_READ_GUARD, _PROVIDER_POLICY_ENABLED
    global _PROVIDER_PACKET_FILES, _PROVIDER_PACKET_LIMIT
    _PROVIDER_READ_GUARD = None
    _PROVIDER_POLICY_ENABLED = False
    _PROVIDER_PACKET_FILES = set()
    _PROVIDER_PACKET_LIMIT = 0
    provided = None
    native_commentary = None
    try:
        provided = helper.read_zero_argument()
        required_input = {"task_id", "incoming_transition", "parameters"}
        if (
            not isinstance(provided, dict)
            or frozenset(provided) not in {
                frozenset(required_input),
                frozenset(required_input | {"commentary"}),
            }
            or not isinstance(provided["parameters"], dict)
        ):
            raise helper.ContractError(
                "Cleanup Agent input must contain exactly task_id/incoming_transition/parameters and optional native commentary; no _kent"
            )
        native_commentary = provided.get("commentary")
        if native_commentary is not None and (
            not isinstance(native_commentary, str)
            or len(native_commentary.encode("utf-8")) > 8192
        ):
            raise helper.ContractError("Cleanup Agent native commentary is invalid")
        provided_payload = provided["parameters"]
        task = helper.task_show(ROOT, provided["task_id"])
        task_short_id = helper._safe_task_short_id(
            task.get("summary", {}).get("short_id")
            if isinstance(task.get("summary"), dict)
            else None
        )
        janitor_previous = None
        if provided["incoming_transition"] == "task_janitor_blocked":
            if not isinstance(provided_payload.get("cleanup_report"), str):
                raise helper.ContractError("Janitor recovery is missing its sealed report")
            janitor_previous, _marker_line, _suffix, _prefix = _parse_janitor_report(
                provided_payload["cleanup_report"], task_short_id
            )
        _PROVIDER_READ_GUARD = _prepare_agent_provider_read_guard(
            provided["task_id"],
            task_short_id,
            native_commentary,
        )
        _PROVIDER_POLICY_ENABLED = _PROVIDER_READ_GUARD is not None
        allowed_notes_path = provided_payload.get("release_notes_path")
        if allowed_notes_path is None and janitor_previous is not None:
            allowed_notes_path = janitor_previous.get("release_notes_path")
        state = helper.validate_cleanup_agent(
            ROOT,
            provided["task_id"],
            CALLER_SESSION_ID,
            allowed_notes_path=allowed_notes_path,
            cleanup_recovery_admission=lambda current_state: _admit_sealed_controller(
                provided_payload, current_state
            ),
        )
        marker_hint = None
        if provided_payload.get("cleanup_report"):
            _prior, line, _suffix, _prefix = _parse_janitor_report(provided_payload["cleanup_report"], state["task_short_id"])
            marker_hint = helper._kit_modules()["parse_terminal_marker_line"](line)
        records, marker = _read_ledger(state, marker_hint)
        _preflight_cleanup_inventory(state, marker)
        retained = _preflight_retention(state, marker)
        identity = _release_identity(state)
        business_input = dict(provided)
        business_input.pop("commentary", None)
        raw = _select_original_input(
            business_input,
            retained,
            marker,
            identity,
        )
        payload = raw["parameters"]
        prior = None; marker_line = None; suffix = None; prefix = None
        carrier = dict(payload)
        if marker is not None and payload.get("cleanup_report"):
            prior, marker_line, suffix, prefix = _parse_janitor_report(payload["cleanup_report"], state["task_short_id"])
            if helper._kit_modules()["parse_terminal_marker_line"](marker_line) != marker:
                raise helper.ContractError("supplied cleanup seal differs from actual terminal ledger")
            carrier = {**payload, **{key:prior[key] for key in ("publication_report","publication_report_digest","release_report","release_report_digest","release_notes_path","release_notes_digest")}}
            if payload.get("cleanup_mode") != prior["cleanup_mode"]:
                raise helper.ContractError("sealed cleanup mode cannot be changed")
        facts = _observe(
            state,
            identity,
            records,
            helper.require_string(carrier.get("pr_base_branch"), "pr_base_branch"),
        )
        operation_id = helper.require_string(
            carrier.get("operation_id"), "operation_id"
        )
        if not helper.HEX64.fullmatch(operation_id):
            raise helper.ContractError("Cleanup original operation identity is invalid")
        checkpoint_value = identity.get("checkpoint")
        if (
            checkpoint_value is not None
            and checkpoint_value.get("operation_id") != operation_id
        ):
            raise helper.ContractError(
                "Cleanup operation identity differs from the release checkpoint"
            )
        outcome = _observable_outcome(facts, carrier)
        hint = raw["incoming_transition"]
        if hint not in ENTRY_OUTCOMES:
            raise helper.ContractError("unknown Cleanup route hint")
        if prior is not None:
            if hint != "task_janitor_blocked": raise helper.ContractError("terminal recovery cannot be relabelled")
        elif marker is not None:
            if hint == "task_janitor_blocked" or ENTRY_OUTCOMES[hint] != outcome:
                raise helper.ContractError("terminal seal requires the same original observed outcome")
        elif ENTRY_OUTCOMES[hint] != outcome:
            raise helper.ContractError("route hint cannot weaken independently observed cleanup outcome")
        edge = helper.graph_edge(ROOT, hint, "cleanup")
        if set(payload) != {field["key"] for field in edge["parameters"]} or any(not isinstance(value,str) for value in payload.values()):
            raise helper.ContractError("Cleanup parameters do not match the independently admitted route")
        session, session_identity = _caller(state, prior)
        if prior is not None:
            original_hint = next(key for key,value in ENTRY_OUTCOMES.items() if value == outcome)
            original_binding = helper.attest(ROOT,state,"cleanup",original_hint)["binding"].provenance_fingerprint
            if prior["operation_digest"] != original_binding:
                raise helper.ContractError("sealed original observable outcome cannot be changed")
            if outcome == "closed":
                carrier.update(pr_url=facts["prs"][0]["html_url"],pr_head_oid=identity["head"],pr_base_oid=facts["prs"][0]["base"].get("sha"))
        publication, release = _verify_outcome(state, identity, facts, outcome, carrier, marker)
        checkpoint = identity["checkpoint"]
        checkpoint_receipt = None
        checkpoint_raw = b""
        profile_digest = ""; preparation_digest = ""
        if checkpoint is not None:
            if checkpoint["state"] != "completed" or not checkpoint["release_preparation_report"]:
                raise helper.ContractError("unfinished profile/device/preparation obligation blocks cleanup")
            preparation = helper.validate_preparation_proof(ROOT, {"operation_id":checkpoint["operation_id"],"branch_name":identity["branch"],"release_base_oid":checkpoint["release_base_oid"]}, state, identity["version"], identity["tag"], identity["head"])
            checkpoint, checkpoint_receipt, checkpoint_raw = helper.read_profile_checkpoint(
                ROOT,
                state["task_short_id"],
                expected={
                    "task_id": state["task_id"],
                    "task_short_id": state["task_short_id"],
                    "release_base_oid": state["commit"],
                    "release_head_oid": identity["head"],
                },
                with_receipt=True,
                with_snapshot=True,
            )
            if checkpoint != identity["checkpoint"]:
                raise helper.ContractError(
                    "profile checkpoint changed after Cleanup admission"
                )
            profile_digest, preparation_digest = checkpoint["profile_report_digest"], checkpoint["release_preparation_report_digest"]
        elif marker is not None:
            digests = {item["kind"]:item["sha256"] for item in marker["operation_report_digests"]}
            profile_digest, preparation_digest = digests.get("qualification",""), digests.get("merge","")
        if marker is None and not records:
            raise helper.ContractError("ordinary task evidence is required before terminal sealing")
        fresh = helper.attest(ROOT,state,"cleanup",hint)
        carrier["branch_name"] = identity["branch"]
        if publication is not None:
            carrier["pr_url"] = publication["pr_url"]
        # Outcome and caller are re-read before any new seal, not selected by the hint.
        confirmed = _observe(
            state,
            identity,
            records,
            carrier["pr_base_branch"],
        )
        if confirmed != facts or _read_ledger(state, marker) != (records,marker) or _caller(state,prior) != (session,session_identity):
            raise helper.ContractError("cleanup outcome/owner changed before sealing")
        _verify_outcome(state,identity,confirmed,outcome,carrier,marker)
        current_records, current_marker = _read_ledger(state, marker)
        if (current_records, current_marker) != (records, marker):
            raise helper.ContractError(
                "cleanup evidence changed before terminal retention"
            )
        _preflight_cleanup_inventory(state, marker)
        blocker = prior["blocker_reason"] if prior else ""
        retention_box = {"value": retained, "digest": None}

        def prepare_retention(report_prefix: str, seal_request: dict) -> None:
            candidate = _retention_for_report(
                state,
                raw,
                session,
                session_identity,
                checkpoint_raw,
                report_prefix,
                seal_request,
                fresh["binding"].provenance_fingerprint,
                fresh["binding"].runtime_source_envelope_digest,
            )
            current, _current_raw, current_digest = _retention_read(
                state["task_short_id"]
            )
            if current is None:
                if retained is not None:
                    raise helper.ContractError(
                        "prepared cleanup receipt disappeared before seal"
                    )
                current_digest = _retention_write(
                    state["task_short_id"],
                    candidate,
                    expected_sha256=None,
                )
                current = candidate
            elif current != candidate:
                raise helper.ContractError(
                    "prepared cleanup receipt differs from the exact original input"
                )
            _retain_task_comment(state, current, current_digest)
            retention_box.update(value=current, digest=current_digest)

        report, _digest = _cleanup_report(state,session,session_identity,carrier,
            operation_digest=fresh["binding"].provenance_fingerprint,unresolved=prior["unresolved"] if prior else False,
            blocker=blocker,fresh=fresh,profile_report_digest=profile_digest,preparation_report_digest=preparation_digest,
            existing_marker=marker_line or (
                fresh["kit"]["terminal_marker_line"](marker)
                if marker is not None else None
            ),preserved_prefix=prefix,preserved_suffix=suffix,
            recover_seal=marker is not None and prior is None,
            before_seal=prepare_retention,
        )
        retained_value, _retained_raw, retained_digest = _retention_read(
            state["task_short_id"]
        )
        if retained_value is None:
            raise helper.ContractError(
                "cleanup report has no complete private retention receipt"
            )
        if retained_value["phase"] == "prepared":
            if (
                marker is None
                and retention_box["value"] != retained_value
                or report.splitlines()[0] != retained_value["report_prefix"]
            ):
                raise helper.ContractError(
                    "sealed cleanup report differs from its prepared retention receipt"
                )
            final_marker_line = report.splitlines()[-1]
            final_marker = fresh["kit"]["parse_terminal_marker_line"](
                final_marker_line
            )
            if _seal_matches_retention(final_marker, retained_value) != final_marker_line:
                raise helper.ContractError(
                    "sealed cleanup result differs from its prepared request"
                )
            sealed_value = {
                **retained_value,
                "phase": "sealed",
                "final_cleanup_report": report,
                "final_marker_line": final_marker_line,
                "final_report_sha256": helper.sha256_bytes(
                    report.encode("utf-8")
                ),
            }
            retained_digest = _retention_write(
                state["task_short_id"],
                sealed_value,
                expected_sha256=retained_digest,
            )
            retained_value = sealed_value
        elif (
            report != retained_value["final_cleanup_report"]
            or report.splitlines()[-1] != retained_value["final_marker_line"]
        ):
            raise helper.ContractError(
                "replayed cleanup report differs from its completed retention receipt"
            )
        final_marker = fresh["kit"]["parse_terminal_marker_line"](
            retained_value["final_marker_line"]
        )
        _retain_task_comment(state, retained_value, retained_digest)
        if checkpoint_receipt is not None and not blocker and not (prior and prior["unresolved"]):
            latest = _observe(
                state,
                identity,
                records,
                carrier["pr_base_branch"],
            )
            expected_marker = fresh["kit"]["parse_terminal_marker_line"](report.splitlines()[-1])
            current_records, current_marker = _read_ledger(state, expected_marker)
            expected_ledger_records = (
                current_records == records
                if marker is not None
                else current_records[:-1] == records
            )
            if (latest != facts or _caller(state,prior) != (session,session_identity)
                    or current_marker != expected_marker
                    or not expected_ledger_records
                    or not current_records
                    or current_records[-1].get("record_kind") != "terminal_evidence_seal_v1"):
                raise helper.ContractError("cleanup outcome/owner/evidence changed before checkpoint deletion")
            _verify_outcome(state,identity,latest,outcome,carrier,marker)
            current_checkpoint = helper.read_profile_checkpoint(
                ROOT,
                state["task_short_id"],
                expected={
                    "task_id": state["task_id"],
                    "task_short_id": state["task_short_id"],
                    "release_base_oid": state["commit"],
                    "release_head_oid": identity["head"],
                },
                with_receipt=True,
                with_snapshot=True,
            )
            if current_checkpoint[2] != checkpoint_raw:
                raise helper.ContractError(
                    "profile checkpoint changed before receipt-backed deletion"
                )
            helper.delete_profile_checkpoint(
                ROOT, state["task_short_id"], current_checkpoint[1]
            )
            _validate_terminal_marker_ledger(state["task_short_id"],final_marker,fresh["kit"])
        fields = {"cleanup_report":report,"workspace_path":str(ROOT),"operation_id":carrier["operation_id"],"branch_name":identity["branch"],"pr_base_branch":carrier["pr_base_branch"],"pr_url":carrier.get("pr_url", ""),"cleanup_mode":"report_only","cleanup_session_id":session,"task_short_id":state["task_short_id"],**{key:carrier.get(key,"") for key in ("publication_report","publication_report_digest","release_report","release_report_digest","release_notes_path","release_notes_digest")}}
        helper.emit_exact(
            ROOT,
            "cleanup_task_janitor",
            "task_janitor",
            fields,
            commentary=native_commentary,
        )
        return 0
    except (helper.ContractError, OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        failure = {
            "error": str(error),
            "destructive_action": False,
        }
        if isinstance(native_commentary, str):
            failure["commentary"] = native_commentary
        print(json.dumps(failure, ensure_ascii=False), file=sys.stderr)
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
