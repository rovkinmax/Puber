def native_transition_id(graph, edge_key):
    edges=[edge for edge in graph['edges'] if edge.get('key')==edge_key]
    assert len(edges)==1,edge_key
    groups=[group for group in graph['transition_groups']
        if group.get('id')==edges[0].get('transition_group_id')]
    assert len(groups)==1,edge_key
    return groups[0]['transition_id']

def reconstruct_script_producer(root,helper,env,metadata,output,source_commentary):
    previous_modules={name:module for name,module in sys.modules.items()
        if name=='workflowkit' or name.startswith('workflowkit.')}
    previous_path=list(sys.path)
    for name in previous_modules:
        del sys.modules[name]
    try:
        with patch.dict(os.environ,env):
            delivery=helper._qualified_delivery_module(
                root,
                required=('producer_locator','reconstruct_producer',
                    'observe_script_identity','packet_decode'),
            )
            locator=delivery.producer_locator(output.get('commentary'))
            assert locator
            identity=delivery.observe_script_identity(
                root,None,metadata,native_read=helper._provider_native_read)
            producer=delivery.reconstruct_producer(
                root,locator,identity=identity)
            source_locator=delivery.producer_locator(source_commentary)
            refs=delivery.packet_decode(
                producer['binding']['producer_refs'].encode('utf-8'))['refs']
            assert refs==[source_locator],(refs,source_locator)
            return producer
    finally:
        sys.path[:]=previous_path
        for name in list(sys.modules):
            if name=='workflowkit' or name.startswith('workflowkit.'):
                del sys.modules[name]
        sys.modules.update(previous_modules)

