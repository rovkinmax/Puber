def load(path, name):
    spec = importlib.util.spec_from_loader(name, SourceFileLoader(name, str(path)))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module

fixture = load(ROOT / '.kent/scripts/tests/test-workflow-puber-release-publish', 'ci_release_fixture')
fixture.helper._kit_modules()
