with tempfile.TemporaryDirectory() as directory:
    base = Path(directory)
    work, policy, head, bare = fixture.materialize(base, base / 'origin.git')
    adapter = load(work / '.kent/scripts/workflow-puber-release-ci', 'actual_ci_adapter')
    helper = adapter.helper
    task_id = 'task-12345678-1234-4234-8234-123456789abc'
    checkpoint = fixture.fixture_checkpoint(work, policy, head, task_id)
    helper.write_profile_checkpoint(work, 'PUB-99', checkpoint)
    preparation = json.loads(checkpoint['release_preparation_report'])
    carrier = {key: preparation[key] for key in revisioned_carrier if key in preparation}
    carrier.update({key: checkpoint[key] for key in ('profile_report','profile_report_digest','release_preparation_report','release_preparation_report_digest')})
    carrier.update(workspace_path=str(work), task_short_id='PUB-99', verification_summary='Actual fixture packaging evidence',
        pr_url='https://github.com/rovkinmax/Puber/pull/7', branch_name='release/99.0.0', merge_strategy='rebase', pr_head_oid=head, pr_base_oid=policy)
    actual_pr = dict(url=carrier['pr_url'], headRefOid=head, baseRefOid=policy, headRefName=carrier['branch_name'],
        baseRefName='master', state='OPEN', mergedAt=None, mergeCommit=None)
    methods = dict(full_name='rovkinmax/Puber', default_branch='master', allow_merge_commit=True, allow_squash_merge=False, allow_rebase_merge=True)
    rules = [{'type':'required_linear_history'}]
    checks = [dict(workflow='PR Checks',name=name,bucket='pass',state='SUCCESS',link='https://github.com/rovkinmax/Puber/actions/runs/1') for name in ('Build','Detekt','Unit Tests')]
    task = {key: [] for key in ('actions','current_nodes','current_scripts','label_ids','live_sessions')}
    task.update(attention_count=0, retained_session_count=0, project={}, source_workspace={}, worktree_path=str(work),
        body='release_type: minor\nrelease_version: 99.0.0\nrelease_tag: v99.0.0\nrelease_branch: release/99.0.0\n',
        execution_target={'commit_oid':policy}, status={},
        summary={'id':task_id,'short_id':'PUB-99','project_id':helper.PROJECT_ID,'workflow_id':helper.WORKFLOW_ID},
        workflow={'workflow_id':helper.WORKFLOW_ID,'version':88,'name':'Puber Release'})
    original_run = helper.run
    executions = []
    def github_command(_root, args, **kwargs):
        assert args[0] == 'api'
        endpoint = args[1]
        if endpoint == 'repos/rovkinmax/Puber': value = dict(methods)
        elif endpoint.endswith('/rules/branches/master'): value = list(rules)
        elif endpoint.endswith('/protection'): return subprocess.CompletedProcess(args, 1, '', '404')
        elif endpoint.endswith('/pulls/7'):
            value = {'html_url':actual_pr['url'],'state':'closed','merged':True,'merged_at':actual_pr['mergedAt'],
                'head':{'ref':actual_pr['headRefName'],'sha':actual_pr['headRefOid'],'repo':{'full_name':'rovkinmax/Puber'}},
                'base':{'ref':'master','sha':actual_pr['baseRefOid'],'repo':{'full_name':'rovkinmax/Puber'}},
                'merge_commit_sha':actual_pr['mergeCommit']['oid']}
        else: raise AssertionError(endpoint)
        return subprocess.CompletedProcess(args, 0, json.dumps(value), '')

    def shared_process(command, *, input_text, **kwargs):
        path = Path(command[0]); payload = json.loads(input_text)
        assert set(payload) <= set(adapter.SHARED_INPUTS)
        executions.append(path.name)
        if path.name == 'workflow-prepare-github-ci':
            try:
                result = ci_contract.prepare_ci_payload(payload, gh_bin='/fixture/gh')
            except ci_contract.CiContractError:
                result = ci_contract.preparation_failure(payload)
            return subprocess.CompletedProcess(command, 0, json.dumps(result), '')
        shared = load(path, 'actual_shared_' + path.name.replace('-', '_'))
        def gh(_bin, _workspace, args, **kw):
            if 'input_bytes' in kw:
                request = json.loads(kw['input_bytes'])
                assert request['operation'] == 'archive_ci_report'
                artifact = ci_contract.archive_ci_report(work, 'PUB-99', json.loads(request['ci_report']))
                return subprocess.CompletedProcess(args, 0, json.dumps({'ci_report_artifact':artifact}).encode(), b'')
            raise AssertionError(args)
        output = io.StringIO()
        with contextlib.ExitStack() as stack:
            stack.enter_context(patch.object(shared, 'resolve_gh_bin', return_value='/fixture/gh'))
            if path.name == 'workflow-wait-github-ci':
                stack.enter_context(patch.object(shared, 'read_pr', side_effect=lambda *a, **k: dict(actual_pr)))
                stack.enter_context(patch.object(shared, 'observe_source_checks', side_effect=lambda *a, **k: (copy.deepcopy(checks), subprocess.CompletedProcess([],0,b'',b''))))
                stack.enter_context(patch.object(shared, 'run_gh', side_effect=gh))
            else:
                stack.enter_context(patch.object(shared, 'read_state', side_effect=lambda *a, **k: {**actual_pr,'reviewDecision':'APPROVED','mergeStateStatus':'CLEAN','statusCheckRollup':[]}))
                stack.enter_context(patch.object(shared, 'read_source_checks', side_effect=lambda *a, **k: copy.deepcopy(checks)))
                stack.enter_context(patch.object(shared, 'read_feedback', return_value=[]))
            stack.enter_context(patch.object(sys, 'stdin', io.StringIO(input_text)))
            stack.enter_context(contextlib.redirect_stdout(output))
            code = shared.main()
        return subprocess.CompletedProcess(command, code, output.getvalue(), '')

    def invoke(operation, incoming, values):
        node = by_key[operation]['id']
        task.update(current_nodes=[{'node_id':node}],current_scripts=[{'path':str(work.resolve() / '.kent/scripts/workflow-puber-release-ci'),'current_node':{'node_id':node}}],status={'node_ids':[node]})
        fields = {field['key']:values[field['key']] for field in edge(incoming)['parameters']}
        payload = {**fields,'commentary':('' if incoming == 'ship_pr_ci_watch' else 'Rendered native commentary'),'_kent':{'task_id':task_id,'node_id':node,'transition_branch_key':incoming}}
        output = io.StringIO()
        with patch.object(sys,'stdin',io.BytesIO(helper.canonical_bytes(payload))) as stream, contextlib.redirect_stdout(output):
            # The real helper expects stdin.buffer; use a text wrapper just as a Script process.
            with patch.object(sys,'stdin',io.TextIOWrapper(stream,encoding='utf-8')):
                code = adapter.main()
        assert code == 0, output.getvalue()
        result = json.loads(output.getvalue())
        assert set(result) - {'transition','commentary'} == {field['key'] for field in edge(result['transition'])['parameters']}
        assert task['execution_target']['commit_oid'] == policy
        return result

    test_env = {f'KENT_{kind}_WATCH_{key}':value for kind in ('CI','PR') for key,value in (
        ('TEST_MODE','1'),('MAX_ERRORS','1'),('MAX_POLLS','1'),('INTERVAL_SECONDS','0'))}
    with patch.dict(os.environ,test_env), patch.object(helper,'task_show',return_value=task), \
         patch.object(helper,'gh',side_effect=github_command), patch.object(helper,'run',side_effect=shared_process), \
         patch.object(ci_contract,'read_pull_request',side_effect=lambda *a,**k:dict(actual_pr)):
        # Do not intercept local Git commands; helper.run owns both Git and Script execution.
        def effects(command, **kwargs):
            return shared_process(command,**kwargs) if Path(command[0]).name in adapter.SHARED_PATHS.values() else original_run(command,**kwargs)
        helper.run.side_effect = effects
        initial = invoke('ci_prepare','ship_pr_ci_watch',carrier)
        assert initial['transition'] == 'ci_prepare_ready_initial', initial
        admitted = helper.validate_task(work.resolve(), task_id, 'ci_prepare', task)
        assert admitted['commit'] == policy and admitted['controller_commit'] == head
        assert admitted['task']['execution_target']['commit_oid'] == policy
        task_without_tag = {**task, 'body': task['body'].replace('release_tag: v99.0.0\n', '')}
        assert helper.validate_task(work.resolve(), task_id, 'ci_prepare', task_without_tag)['controller_commit'] == head
        attested = helper.attest(work.resolve(), admitted, 'ci_prepare', 'ship_pr_ci_watch')
        assert attested['selected'].project_commit == head
        assert attested['context'].project_commit == head and admitted['commit'] != head
        checkpoint_path = work / '.kent/runtime/PUB-99/release-profile-checkpoint.json'
        saved = checkpoint_path.read_bytes()
        for label, altered in (
            ('foreign lock', {**checkpoint, 'release_base_oid': 'f' * 40}),
            ('foreign head', {**checkpoint, 'release_head_oid': policy}),
            ('missing preparation', {**checkpoint, 'release_preparation_report': '', 'release_preparation_report_digest': ''}),
        ):
            checkpoint_path.write_bytes(helper.canonical_bytes(altered) + b'\n')
            try:
                helper.validate_task(work.resolve(), task_id, 'ci_prepare', task)
            except helper.ContractError:
                pass
            else:
                raise AssertionError('K/H admission accepted ' + label)
            checkpoint_path.write_bytes(saved)
        assert task['execution_target']['commit_oid'] == policy

        assert 'ci_report' not in initial and initial['verification_summary'] == carrier['verification_summary']
        passed = invoke('ci_watch','ci_prepare_ready_initial',initial)
        assert passed['transition'] == 'ci_watch_passed', passed
        report = runtime.validate_ci_report(json.loads(passed['ci_report']))
        assert report['attempts'][-1]['head_oid'] == head
        retry = invoke('ci_prepare','waiting_pr_ci_recheck',passed)
        assert retry['transition'] == 'ci_prepare_ready_retry' and retry['ci_report'] == passed['ci_report'], retry
        for label, altered in (
            ('failed',[{**row,'bucket':'fail','state':'FAILURE'} if row['name']=='Build' else row for row in checks]),
            ('missing',[row for row in checks if row['name']!='Build']),
            ('skipped',[{**row,'bucket':'skipping','state':'SKIPPED'} if row['name']=='Build' else row for row in checks]),
        ):
            original = checks[:]; checks[:] = altered
            observed = invoke('ci_watch','ci_prepare_ready_initial',initial)
            assert observed['transition'] == 'ci_watch_failed', (label,observed)
            runtime.validate_ci_report(json.loads(observed['ci_report']))
            checks[:] = original
        checks.append(dict(workflow='Other',name='Extra',bucket='pass',state='SUCCESS',link='https://github.com/rovkinmax/Puber/actions/runs/2'))
        extra = invoke('ci_watch','ci_prepare_ready_initial',initial)
        assert extra['transition'] == 'ci_watch_passed', extra
        assert json.loads(extra['ci_report'])['attempts'][-1]['unexpected_check_count'] == 1
        checks.pop()
        waiting = invoke('merge_watch','waiting_pr_merge_watch',passed)
        assert waiting['transition'] in {'merge_watch_state_changed','merge_watch_still_waiting'}, waiting
        if waiting['transition'] == 'merge_watch_state_changed':
            assert waiting['pr_feedback_cursor'] != 'uninitialized'
            waiting = invoke('merge_watch','waiting_pr_merge_watch',waiting)
        assert waiting['transition'] == 'merge_watch_still_waiting', waiting
        # P advances without an effective required-policy change: retain history.
        advanced = fixture.target_with_changes(work, policy, {'docs/ci-policy-fixture.txt':b'new mainline\n'})
        actual_pr['baseRefOid'] = advanced
        changed = invoke('ci_watch','ci_prepare_ready_retry',retry)
        assert changed['transition'] == 'ci_watch_state_changed', changed
        reprepared = invoke('ci_prepare','ci_watch_state_changed',changed)
        assert reprepared['transition'] == 'ci_prepare_ready_retry', reprepared
        assert json.loads(reprepared['ci_policy_snapshot'])['target_commit'] == advanced
        assert reprepared['ci_report'] == changed['ci_report']
        # A changed H cannot borrow the old preparation checkpoint or go green.
        actual_pr['headRefOid'] = advanced
        bad_head = invoke('ci_prepare','waiting_pr_ci_recheck',passed)
        assert bad_head['transition'] == 'ci_prepare_needs_user_action', bad_head
        actual_pr['headRefOid'] = head
        # Production requires new preparation for H changes. Independently execute the
        # actual shared new-H cycle and verify its omitted report is not synthesized.
        newer_head = fixture.target_with_changes(work, head, {'docs/new-ci-head.txt':b'new H source\n'})
        actual_pr['headRefOid'] = newer_head
        fresh_cycle = ci_contract.prepare_ci_payload(reprepared, gh_bin='/fixture/gh')
        assert fresh_cycle['transition'] == 'ci_prepare_ready_initial' and 'ci_report' not in fresh_cycle
        assert json.loads(fresh_cycle['expected_ci_checks'])['project_commit'] == newer_head
        actual_pr['headRefOid'] = head
        methods['allow_squash_merge'] = True
        ambiguous = invoke('ci_prepare','waiting_pr_ci_recheck',passed)
        assert ambiguous['transition'] == 'ci_prepare_needs_user_action', ambiguous
        methods['allow_squash_merge'] = False
        # A genuinely merged PR has actual base B distinct from prior policy P.
        target = fixture.rebased_target(work, policy, head)
