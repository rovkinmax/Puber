            os.environ[key] = str(
                uuid.uuid5(uuid.NAMESPACE_URL, f"puber-janitor-test:{suffix}")
            )
    with tempfile.TemporaryDirectory(prefix="puber-janitor-contract-") as directory:
        legacy = Path(directory) / "workflow-task-janitor"
        shutil.copyfile(ROOT / ".kent/scripts/workflow-task-janitor", legacy)
        legacy.chmod(0o755)
        fixtures.JANITOR = legacy
