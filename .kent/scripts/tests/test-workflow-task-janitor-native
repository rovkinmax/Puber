#!/usr/bin/env python3
"""Exercise Puber's materialized commands with the pinned Kit fixture suite."""
from __future__ import annotations

import importlib.util
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import unittest
import uuid
import tomllib
from unittest.mock import patch

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[3]
_profile = tomllib.loads(
    (ROOT / ".kent/workflow-profile.toml").read_text(encoding="utf-8")
)
_kit_binding = _profile.get("kit_runtime")
if (
    not isinstance(_kit_binding, dict)
    or set(_kit_binding) != {"schema_version", "root", "commit", "publication_ref"}
    or _kit_binding.get("schema_version") != 1
    or _kit_binding.get("commit") != "30b908c9fc7097c0464ae67d58f891a1dd7103fb"
    or _kit_binding.get("publication_ref") != "refs/remotes/origin/main"
):
    raise SystemExit("Janitor tests require Puber's exact qualified Kit source binding")
KIT = Path(_kit_binding["root"]).resolve(strict=True)
if str(KIT) != _kit_binding["root"]:
    raise SystemExit("Puber Kit binding root must be canonical")
_kit_override = os.environ.get("PUBER_STAGE_A_KIT_ROOT")
if _kit_override and Path(_kit_override).resolve(strict=True) != KIT:
    raise SystemExit("Puber test Kit override differs from the profile binding")
head = subprocess.check_output(
    ["git", "-C", str(KIT), "rev-parse", "HEAD"],
    text=True,
).strip()
if head != _kit_binding["commit"]:
    raise SystemExit("Janitor Kit HEAD differs from the profile binding")
if subprocess.check_output(
    ["git", "-C", str(KIT), "rev-parse", "--verify", _kit_binding["publication_ref"]],
    text=True,
).strip() != _kit_binding["commit"]:
    raise SystemExit("Janitor Kit publication ref differs from the profile binding")
if subprocess.check_output(
    ["git", "-C", str(KIT), "status", "--porcelain=v1", "--untracked-files=all"],
    text=True,
):
    raise SystemExit("Janitor Kit binding must remain clean")

spec = importlib.util.spec_from_file_location(
    "pinned_janitor_fixtures", KIT / "tests/test_workflow_runtime.py"
)
assert spec is not None and spec.loader is not None
fixtures = importlib.util.module_from_spec(spec)
sys.path.insert(0, str(KIT))
spec.loader.exec_module(fixtures)


class PuberJanitorTest(fixtures.WorkflowJanitorTest):
    """Keep upstream failure-path coverage while testing actual consumer bytes."""

    def make_ci_terminal_state(self, *args, **kwargs):
        append_index = 0
        original_run = subprocess.run

        def run_with_native_step(*run_args, **run_kwargs):
            nonlocal append_index
            command = run_args[0] if run_args else run_kwargs.get("args")
            if (
                isinstance(command, (list, tuple))
                and command
                and Path(command[0]).name == "workflow-evidence-ledger"
                and "append" in command
            ):
                environment = dict(run_kwargs.get("env") or os.environ)
                environment["KENT_SESSION_ID"] = os.environ["KENT_SESSION_ID"]
                environment["KENT_STEP_ID"] = str(uuid.uuid5(
                    uuid.NAMESPACE_URL,
                    f"puber-janitor:{self.id()}:{append_index}",
                ))
                run_kwargs["env"] = environment
                append_index += 1
            elif (
                isinstance(command, (list, tuple))
                and command
                and Path(command[0]).name == "workflow-evidence-ledger"
                and "seal" in command
            ):
                workspace_index = command.index("--workspace")
                self._last_ci_ledger_workspace = Path(
                    command[workspace_index + 1]
                )
            return original_run(*run_args, **run_kwargs)

        with patch.object(subprocess, "run", side_effect=run_with_native_step):
            return super().make_ci_terminal_state(*args, **kwargs)

    def test_ci_ledger_record_limit_is_inclusive_and_bounded(self):
        def resize_records(total):
            def resize(rows):
                prototype = {
                    "schema_version": 1,
                    "task_short_id": "TASK-1",
                    "artifacts": rows[0]["artifacts"],
                }
                rows[:] = [dict(prototype) for _ in range(total - 1)]

            return resize

        fixture = self.make_ci_terminal_state(
            count=1,
            mutate_records=resize_records(8192),
        )
        result = self.ci_cleanup(fixture)
        self.assertTrue(result[0], result)
        self.assertFalse(fixture[3].exists())

        with self.assertRaisesRegex(
            AssertionError,
            "terminal seal exceeds logical byte or record limit",
        ):
            self.make_ci_terminal_state(
                count=1,
                mutate_records=resize_records(8193),
            )
        ledger = (
            self._last_ci_ledger_workspace
            / ".kent/runtime/TASK-1/evidence-ledger.jsonl"
        )
        self.assertTrue(ledger.is_file())
        self.assertEqual(len(ledger.read_bytes().splitlines()), 8192)

        # The producer correctly refuses to seal 8193 records. Preserve the
        # Janitor's independent read-side bound coverage with a deliberately
        # tampered, otherwise valid 8192-record sealed fixture.
        oversized = self.make_ci_terminal_state(
            count=1,
            mutate_records=resize_records(8192),
        )
        active, tombstone = oversized[3], oversized[4]
        oversized_ledger = active / "evidence-ledger.jsonl"
        sealed_bytes = oversized_ledger.read_bytes()
        self.assertEqual(len(sealed_bytes.splitlines()), 8192)
        tampered_bytes = sealed_bytes + sealed_bytes.splitlines(keepends=True)[-1]
        oversized_ledger.write_bytes(tampered_bytes)

        runtime = oversized[1].runtime_contracts()
        with self.assertRaisesRegex(
            runtime.RuntimeContractError,
            "evidence exceeds record limit",
        ):
            runtime.validate_evidence_view(
                tampered_bytes,
                task_short_id="TASK-1",
            )
        result = self.ci_cleanup(oversized)
        self.assertFalse(result[0], result)
        self.assertIn("ledger is missing or invalid", result[1])
        self.assertTrue(active.is_dir())
        self.assertFalse(tombstone.exists())
        self.assertEqual(oversized_ledger.read_bytes(), tampered_bytes)

    def install_v2_runtime_commands(self, root: Path) -> Path:
        scripts = root / ".kent/scripts"
        scripts.mkdir(parents=True)
        for name in (
            "workflow-task-janitor",
            "workflow-evidence-ledger",
            "workflow_runtime_contracts.py",
        ):
            target = scripts / name
            shutil.copyfile(ROOT / ".kent/scripts" / name, target)
            target.chmod(0o755)
        return scripts

    def test_kent_29_cli_compatibility_on_puber_janitor(self) -> None:
        donor = KIT
        suite = donor / "tests/test_worktree_cli_compatibility.py"
        self.assertFalse(suite.is_symlink(), suite)
        self.assertTrue(suite.is_file(), suite)
        result = subprocess.run(
            [sys.executable, "-B", str(suite)],
            cwd=donor,
            text=True,
            capture_output=True,
            env={
                **os.environ,
                "KENT_WORKTREE_JANITOR_PATH": str(
                    ROOT / ".kent/scripts/workflow-task-janitor"
                ),
                "PYTHONDONTWRITEBYTECODE": "1",
            },
            check=False,
        )
        self.assertEqual(
            result.returncode, 0, result.stdout + result.stderr,
        )

    def test_puber_runtime_handle_is_retained_through_janitor_cleanup(self) -> None:
        suite = ROOT / ".kent/scripts/tests/test-puber-qualified-runtime"
        result = subprocess.run(
            [sys.executable, str(suite)],
            cwd=ROOT,
            text=True,
            capture_output=True,
            env={
                key: value
                for key, value in os.environ.items()
                if key != "KENT_ENGINEERING_KIT_ROOT"
            },
            check=False,
        )
        self.assertEqual(
            result.returncode, 0, result.stdout + result.stderr,
        )
        self.assertIn(
            "Puber Janitor preserves the exact qualified/checkpoint handles",
            result.stdout,
        )

    def test_sealed_accepted_plan_cache_is_preserved_before_native_delete(self) -> None:
        root, worktree, scripts, marker = self.make_managed_worktree(with_v2=True)
        contract = fixtures.load_template_module(
            ROOT / ".kent/scripts/workflow-plan-contract", "puber_plan_fixture",
        )
        path = worktree / ".kent/runtime/TASK-1/plan-contract.json"
        normalized = "# Plan\n\n- [ ] Preserve accepted scope.\n"
        contract.write_snapshot(
            path, root=worktree, task="TASK-1", plan_path=".todo/fixture/plan.md",
            work_kind="bugfix", normalized=normalized,
            digest=hashlib.sha256(normalized.encode()).hexdigest(),
        )
        before = path.read_bytes()
        ledger = path.with_name("evidence-ledger.jsonl")
        ledger_before = ledger.read_bytes()
        wrapper = self.completed_wrapper(root)
        called = root / "native-delete-called"
        result = subprocess.run(
            [str(scripts / "workflow-task-janitor")],
            cwd=worktree, text=True, capture_output=True,
            input=self.janitor_input(
                worktree, branch_name="TASK-1", cleanup_mode="no_pr",
                cleanup_report="Cleanup complete.\n" + marker,
            ),
            env={
                **os.environ, "KENT_WORKTREE_WRAPPER": str(wrapper),
                "KENT_TEST_PRIMARY": str(root),
                "KENT_TEST_WRAPPER_MARKER": str(called),
            },
        )
        report = json.loads(result.stdout)
        self.assertEqual(report["transition"], "task_janitor_blocked", report)
        self.assertIn(
            "unknown_runtime_entry: unadmitted runtime material",
            report["cleanup_report"],
        )
        self.assertFalse(called.exists())
        self.assertEqual(path.read_bytes(), before)
        self.assertEqual(ledger.read_bytes(), ledger_before)


if __name__ == "__main__":
    # Upstream legacy cases deliberately have no sibling runtime module.
    # V2 cases install all three actual consumer files through the override.
    # The Release helper clears inherited Kent context when imported by the
    # closure test, so provide canonical synthetic identities for these local
    # subprocess fixtures.
    uuid_pattern = re.compile(
        r"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    )
    for key, suffix in (
        ("KENT_SESSION_ID", "session"),
        ("KENT_STEP_ID", "step"),
    ):
        if not uuid_pattern.fullmatch(os.environ.get(key, "")):
            os.environ[key] = str(
                uuid.uuid5(uuid.NAMESPACE_URL, f"puber-janitor-test:{suffix}")
            )
    with tempfile.TemporaryDirectory(prefix="puber-janitor-contract-") as directory:
        legacy = Path(directory) / "workflow-task-janitor"
        shutil.copyfile(ROOT / ".kent/scripts/workflow-task-janitor", legacy)
        legacy.chmod(0o755)
        fixtures.JANITOR = legacy
        unittest.main()
