with tempfile.TemporaryDirectory(prefix="puber-janitor-runtime-") as tmp:
    project = Path(tmp) / "project"
    shutil.copytree(
        SOURCE_ROOT,
        project,
        ignore=shutil.ignore_patterns(".git", "__pycache__"),
    )
    project = project.resolve()
    kit_root = Path(tmp) / "kit"
    (kit_root / "workflowkit").mkdir(parents=True)
    wrapper = load(
        project / ".kent/scripts/workflow-puber-release-janitor",
        "puber_janitor_runtime_test",
    )
    facade = FakeFacade(project, kit_root)
    wrapper.ROOT = project
    wrapper.helper.ROOT = project
    qualification_order: list[str] = []

    original_qualifier = facade.qualified_kit_runtime

    def record_qualification(**kwargs):
        qualification_order.append("qualified")
        return original_qualifier(**kwargs)

    facade.qualified_kit_runtime = record_qualification

    def native_graph(_payload):
        qualification_order.append("native_graph")
        return {"task_short_id": "PUB-99"}

    with patch.object(
        wrapper.helper,
        "_qualified_checkpoint_module",
        return_value=facade,
    ), patch.object(wrapper, "_current_native_graph", side_effect=native_graph):
        graph = json.loads(
            (project / wrapper.helper.GRAPH_PATH).read_text(encoding="utf-8")
        )
        janitor = next(node for node in graph["nodes"] if node["key"] == "task_janitor")
        ingress = next(
            edge for edge in graph["edges"]
            if edge.get("key") == "cleanup_task_janitor"
        )
        fields = {
            parameter["key"]: "fixture"
            for parameter in ingress["parameters"]
        }
        fields.update(
            workspace_path=str(project),
            operation_id="a" * 64,
            branch_name="release/99.0.0",
            pr_base_branch="master",
            cleanup_mode="report_only",
            cleanup_report="",
            _kent={
                "task_id": TASK_ID,
                "node_id": janitor["id"],
            },
        )
        payload = wrapper._validate_payload(fields)
        assert payload == fields
        assert qualification_order == ["qualified", "native_graph"]
        assert facade.qualified_calls[-1][1] == fields["_kent"]

    janitor_metadata = fields["_kent"]
    handle = facade.handle
    shared_receipt: list[tuple[object, object]] = []

    class SharedJanitor:
        @staticmethod
        def format_cleanup_report(original, report, *, runtime=None):
            return report

        def main(self, *, qualified, checkpoint):
            shared_receipt.append((qualified, checkpoint))
            assert qualified is handle
            assert checkpoint is facade
            shutil.rmtree(project)
            self.complete(
                "task_janitor_done",
                "Janitor removed managed worktree fixture.",
            )
            return 0

    qualification_order.clear()
    facade.qualified_calls.clear()
    raw = {
        **{key: value for key, value in fields.items() if key != "_kent"},
        "_kent": janitor_metadata,
    }

    output = io.StringIO()
    with patch.object(
        wrapper.helper,
        "_qualified_checkpoint_module",
        return_value=facade,
    ), patch.object(
        wrapper.helper,
        "read_zero_argument",
        return_value=raw,
    ), patch.object(
        wrapper,
        "_current_native_graph",
        side_effect=native_graph,
    ), patch.object(
        wrapper,
        "_restore_replay_payload",
        side_effect=lambda value: dict(value),
    ), patch.object(
        wrapper,
        "_load_janitor",
        return_value=SharedJanitor(),
    ), patch.object(
        wrapper,
        "_prepare_output_templates",
        return_value={
            "task_janitor_done": {"transition": "done", "cleanup_report": ""}
        },
    ), patch.object(
        wrapper.helper,
        "render_exact",
        return_value={"transition": "done"},
    ), patch.object(sys, "stdout", output):
        assert wrapper.main() == 0

    assert shared_receipt == [(handle, facade)], shared_receipt
    assert not project.exists()
    assert facade.qualified_calls == [
        (project, janitor_metadata, None, None)
    ], facade.qualified_calls
    assert qualification_order == ["qualified", "native_graph"], qualification_order
    assert json.loads(output.getvalue())["cleanup_report"].startswith(
        "Janitor removed managed worktree"
    )
    print(
        "Puber Janitor preserves the exact qualified/checkpoint handles through "
        "shared cleanup and workspace deletion: passed"
    )
