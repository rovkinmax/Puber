def load(path: Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


class FakeFacade:
    """Test-only native qualification/facade; never installed in product files."""

    def __init__(self, project_root: Path, kit_root: Path):
        kit_root = kit_root.resolve()
        self.qualified_calls: list[tuple[Path, object, str | None, str | None]] = []
        self.module_calls: list[tuple[str, Path, object]] = []
        self.delivery_calls: list[tuple[Path, object]] = []
        self.handle = SimpleNamespace(
            native_authorized=True,
            project_root=project_root,
            source_root=kit_root,
        )
        self.modules = self._make_modules(kit_root)
        self.delivery = SimpleNamespace(
            producer_locator=lambda _commentary: None,
            observe_script_identity=lambda *_args, **_kwargs: {},
            require_github_provider_read=lambda *_args, **_kwargs: None,
            GitHubProviderRetryBlocked=RuntimeError,
        )

    def qualified_kit_runtime(self, *, project_root, source_binding):
        self.qualified_calls.append(
            (
                project_root,
                source_binding,
                os.environ.get("KENT_SESSION_ID"),
                os.environ.get("KENT_STEP_ID"),
            )
        )
        if source_binding is not None and (
            not isinstance(source_binding, dict)
            or set(source_binding) != {"task_id", "node_id"}
        ):
            raise ValueError("fixture received a malformed native Script binding")
        return self.handle

    def kit_module(self, name, *, project_root, qualified):
        self.module_calls.append((name, project_root, qualified))
        if qualified is not self.handle or project_root != self.handle.project_root:
            raise ValueError("fixture received a foreign runtime handle")
        return self.modules[name]

    def delivery_module(self, *, project_root, qualified):
        self.delivery_calls.append((project_root, qualified))
        if qualified is not self.handle or project_root != self.handle.project_root:
            raise ValueError("fixture received a foreign runtime handle")
        return self.delivery

    @staticmethod
    def _make_modules(kit_root: Path):
        package_path = kit_root / "workflowkit" / "__init__.py"
        module_paths = {
            "workflowkit": package_path,
            "runtime": kit_root / "workflowkit/runtime.py",
            "revision": kit_root / "workflowkit/revision.py",
            "ci_contract": kit_root / "workflowkit/ci_contract.py",
            "merge_strategy": kit_root / "workflowkit/merge_strategy.py",
            "delivery": kit_root / "workflowkit/delivery.py",
        }
        names_by_module = {
            "workflowkit": (
                "ProjectProfile", "ReleaseSpec",
                "NormalizedGitHubWorkflowSourceV1",
                "preflight_project_revision",
                "capture_runtime_execution_context",
                "capture_runtime_authority_binding_verified",
                "validate_operation_jobs",
                "canonicalize_publication_operation",
            ),
            "runtime": (
                "validate_terminal_seal_request", "validate_terminal_marker",
                "parse_terminal_marker_line", "terminal_marker_line",
                "validate_cleanup_report", "validate_terminal_chain",
                "canonical_sha256", "validate_ci_report", "validate_ci_archive",
                "parse_canonical_json", "MAX_CI_REPORT_BYTES",
                "MAX_DYNAMIC_CI_REPORT_BYTES", "merge_github_retry_constraints",
                "validate_expected_ci_checks", "expected_ci_checks_sha256",
                "validate_ci_policy_snapshot", "ci_policy_projection_sha256",
            ),
            "revision": (
                "read_blob_bytes", "tree_mode",
                "verify_runtime_source_captures", "source_read_budget", "run_git",
            ),
            "ci_contract": ("normalize_github_workflow", "read_pull_request"),
            "merge_strategy": ("resolve_github_merge_strategy",),
            "delivery": (
                "capture_script_producer", "observe_script_identity",
                "producer_locator", "reconstruct_producer",
                "producer_reference_closure", "packet_decode", "packet_json",
                "pack_delivery", "transition_contract_reference",
            ),
        }
        result = {}
        for name, module_path in module_paths.items():
            values = {"__file__": str(module_path)}
            for attribute in names_by_module[name]:
                values[attribute] = (
                    1 if attribute in {
                        "MAX_CI_REPORT_BYTES",
                        "MAX_DYNAMIC_CI_REPORT_BYTES",
                    }
                    else (lambda *_args, **_kwargs: None)
                )
            result[name] = SimpleNamespace(**values)
        return result


def assert_raises(error_type, callback):
    try:
        callback()
    except error_type:
        return
    raise AssertionError(f"expected {error_type.__name__}")


with tempfile.TemporaryDirectory(prefix="puber-qualified-runtime-") as tmp:
    base = Path(tmp)
    project = base / "project"
    shutil.copytree(
        SOURCE_ROOT,
        project,
        ignore=shutil.ignore_patterns(".git", "__pycache__"),
    )
    kit_root = base / "kit"
    (kit_root / "workflowkit").mkdir(parents=True)
    facade = FakeFacade(project, kit_root)
    helper = load(
        project / ".kent/scripts/workflow-puber-release-intent",
        "puber_qualified_runtime_helper",
    )
    helper.ROOT = project
    with patch.object(
        helper,
        "_qualified_checkpoint_module",
        return_value=facade,
    ):
        helper._reset_runtime_invocation()
        assert_raises(
            helper.ContractError,
            lambda: helper.validate_envelope(
                {"_kent": {"task_id": TASK_ID}},
                project,
                "fixture",
            ),
        )
        assert facade.qualified_calls == []

        ordering: list[str] = []
        original_qualified = facade.qualified_kit_runtime

        def qualification_probe(**kwargs):
            ordering.append("qualified")
            return original_qualified(**kwargs)

        facade.qualified_kit_runtime = qualification_probe

        class StopAtTaskLookup(Exception):
            pass

        def stop_at_node_lookup(_root, _node):
            ordering.append("node_lookup")
            raise StopAtTaskLookup

        with patch.object(helper, "_node_id", side_effect=stop_at_node_lookup):
            assert_raises(
                StopAtTaskLookup,
                lambda: helper.validate_envelope(
                    {
                        "_kent": {"task_id": TASK_ID, "node_id": NODE_ID},
                        "entry_transition": "fixture",
                    },
                    project,
                    "fixture",
                ),
            )
        assert ordering == ["qualified", "node_lookup"], ordering
        assert facade.qualified_calls[-1][1] == {
            "task_id": TASK_ID,
            "node_id": NODE_ID,
        }

        helper._reset_runtime_invocation()
        qualified = helper._bind_qualified_runtime(
            project,
            {"task_id": TASK_ID, "node_id": NODE_ID},
        )
        delivery = helper._qualified_delivery_module(project)
        kit = helper._kit_modules(project)
        assert delivery is facade.delivery
        assert kit["ProjectProfile"] is facade.modules["workflowkit"].ProjectProfile
        assert all(call[2] is qualified for call in facade.module_calls)
        assert facade.delivery_calls == [(project, qualified)]
        assert len(facade.qualified_calls) == 2

        assert "verify_runtime_source_captures" in kit and "source_read_budget" in kit
        assert "capture_runtime_authority_binding_verified" in kit
        assert "collect_runtime_external_captures" not in kit
        assert "capture_runtime_authority_binding" not in kit
        verified_binding = facade.modules["workflowkit"].capture_runtime_authority_binding_verified
        del facade.modules["workflowkit"].capture_runtime_authority_binding_verified
        try:
            with patch.object(helper, "_KIT_MODULES_CACHE", None):
                assert_raises(helper.ContractError, lambda: helper._kit_modules(project))
        finally:
            facade.modules["workflowkit"].capture_runtime_authority_binding_verified = verified_binding

        # Both immutable revisions share one accounting object, and the new
        # verifier must execute even when qualification uses no emitted proof.
        from contextlib import contextmanager
        entered, verified, preflight = [], [], []
        budget = object()
        proof = object()
        @contextmanager
        def accounting():
            entered.append(budget)
            yield budget
        def select(_root, commit, *, budget):
            assert budget is entered[0]
            preflight.append(commit)
            return SimpleNamespace(selected_runtime_source_inputs=SimpleNamespace(project_commit=commit))
        def verify(_root, selected, *, budget):
            assert budget is entered[0]
            verified.append(selected.project_commit)
            return proof
        class FinishedCaptureCheck(Exception):
            pass
        class StopBeforePolicy:
            @staticmethod
            def from_toml(*args, **kwargs):
                raise FinishedCaptureCheck()
        observed = {**kit, "source_read_budget": accounting,
            "preflight_project_revision": select, "verify_runtime_source_captures": verify,
            "ProjectProfile": StopBeforePolicy}
        h, t = "a" * 40, "b" * 40
        with patch.object(helper, "_kit_modules", return_value=observed), \
             patch.object(helper, "git", return_value=h), \
             patch.object(helper, "_revision_blob", return_value=b"unused after capture"):
            assert_raises(FinishedCaptureCheck, lambda: helper.qualify_merged_target(
                project, {"commit": "c" * 40, "controller_commit": h}, t, {"release_head_oid": h}))
            assert entered == [budget] and preflight == [h, t] and verified == [h, t]
            assert helper._external_captures(project, None, SimpleNamespace(project_commit=h), budget=budget) is proof
            verified.clear()
            def incomplete(*args, **kwargs):
                raise RuntimeError("incomplete source proof")
            observed["verify_runtime_source_captures"] = incomplete
            assert_raises(helper.ContractError, lambda: helper.qualify_merged_target(
                project, {"commit": "c" * 40, "controller_commit": h}, t, {"release_head_oid": h}))
            assert verified == []
        captured_versions = []
        with patch.object(helper, "_kit_modules", return_value={"source_read_budget": accounting}), \
             patch.object(helper, "_attest", side_effect=lambda *a, budget, **kw: captured_versions.append(budget) or {"proof": proof}):
            assert helper.attest(project, {}, "ci_prepare", "ship_pr_ci_watch") == {"proof": proof}
        assert captured_versions == [budget]
        print("Puber H/T share accounting, eagerly verify both closures and reject partial proof: passed")

        shutil.rmtree(project)
        assert helper._qualified_delivery_module(project) is facade.delivery
        assert helper._kit_modules(project) is kit
        assert len(facade.qualified_calls) == 2
        assert facade.delivery_calls == [
            (project, qualified),
            (project, qualified),
        ]

    print(
        "Puber Script runtime qualification order, shared-handle facade calls, "
        "and retained-handle-after-root-deletion: passed"
    )

