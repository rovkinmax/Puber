def pack_agent_transition_commentary(
    work: Path,
    task_path: Path,
    graph: dict,
    environment: dict[str, str],
    transition_key: str,
    task_short_id: str,
    values: dict[str, str],
    producer_commentary: str | None = None,
) -> str:
    """Build disposable Agent producer evidence through the selected Kit API."""
    script = work / ".kent/scripts/workflow-checkpoint"
    loader = SourceFileLoader("wait_fixture_checkpoint_adapter", str(script))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None and spec.loader is not None
    checkpoint = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(checkpoint)
    previous_kit_modules = {
        name: module
        for name, module in sys.modules.items()
        if name == "workflowkit" or name.startswith("workflowkit.")
    }
    previous_path = list(sys.path)
    for name in previous_kit_modules:
        del sys.modules[name]
    try:
        with patch.dict(os.environ, environment):
            delivery = checkpoint.delivery_module()
            identity = checkpoint.current_delivery_identity(
                work.resolve(),
                task_short_id,
            )
            detail = json.loads(task_path.read_text(encoding="utf-8"))
            native_graph = {
                "workflow_id": detail["summary"]["workflow_id"],
                "expected_version": detail["workflow"]["version"],
                "graph": {
                    key: graph[key]
                    for key in ("nodes", "transition_groups", "edges")
                },
            }
            transition = native_transition_id(graph, transition_key)
            contract = delivery.transition_contract_reference(
                identity,
                detail,
                native_graph,
                transition,
            )
            producer_refs = []
            if producer_commentary is not None:
                if not isinstance(producer_commentary, str):
                    raise AssertionError("fixture upstream producer commentary is invalid")
                producer_locator = delivery.producer_locator(producer_commentary)
                if producer_locator is not None:
                    producer_refs.append(producer_locator)
            locator, packet_bytes = delivery.pack_delivery(
                work.resolve(),
                {
                    "schema": "workflow-pack-delivery-v1",
                    "transition": transition,
                    "values": values,
                    "transition_contract_ref": contract,
                    "delivery_mode": "preserve",
                    "producer_refs": producer_refs,
                },
                identity=identity,
                task_detail=detail,
                graph=native_graph,
            )
            packet = delivery.packet_decode(packet_bytes)
            if (
                packet.get("transition") != transition
                or delivery.producer_locator(packet.get("commentary")) != locator
            ):
                raise AssertionError("fixture Agent producer packet is not exact")
            return packet["commentary"]
    finally:
        sys.path[:] = previous_path
        for name in list(sys.modules):
            if name == "workflowkit" or name.startswith("workflowkit."):
                del sys.modules[name]
        sys.modules.update(previous_kit_modules)

