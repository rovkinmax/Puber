        with publish_fixture.FixtureSandbox.create() as sandbox:
            with publish_fixture.fixture_context(mode="canonical", sandbox=sandbox, candidate_freeze=candidate_freeze):
                blocker = sys.argv[1] == "--canonical-blocker"
                publish_fixture.test_clean_master_to_exactly_one_release_pr(
                    lambda prepared: test_monitor(True, prepared, publish_blocker_only=blocker))
    else:
        with publish_fixture.FixtureSandbox.create() as sandbox:
            with publish_fixture.fixture_context(mode="mock", sandbox=sandbox, candidate_freeze=candidate_freeze):
                test_monitor(False)
                test_monitor(True)
        # Each canonical process creates one private Kit and never runs mock lanes.
        for lane in ("--canonical-happy", "--canonical-blocker"):
            with publish_fixture.FixtureSandbox.create() as sandbox:
                options = ["--kit-candidate-freeze", str(candidate_freeze)] if candidate_freeze else []
                result = sandbox.run_child([sys.executable, "-B", str(Path(__file__).resolve()), lane, *options])
                if result.returncode:
                    raise SystemExit(result.returncode)
    print("workflow-wait-github-release: passed all ordinary/canonical happy/blocker lanes")
