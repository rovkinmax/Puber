def reset_kit_imports() -> None:
    for name in tuple(sys.modules):
        if name == "workflowkit" or name.startswith("workflowkit."):
            del sys.modules[name]

def sh(args, cwd, **kwargs):
    return publish_fixture.require_context()["sandbox"].run_child(
        args, cwd=cwd, check=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs)


def native_transition_id(graph: dict, edge_key: str) -> str:
    edges = [edge for edge in graph["edges"] if edge["key"] == edge_key]
    assert len(edges) == 1, edge_key
    groups = [
        group for group in graph["transition_groups"]
        if group["id"] == edges[0]["transition_group_id"]
    ]
    assert len(groups) == 1, edge_key
    return groups[0]["transition_id"]

def materialize_shared_observer(work: Path) -> None:
    source = ROOT / ".kent/scripts/workflow_github_observation.py"
    target = work / ".kent/scripts/workflow_github_observation.py"
    if source.is_file() and not target.is_file():
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)

def pinned_kit(root: Path) -> Path:
    target = root / "kit-pinned"
    sh(["git", "clone", "--quiet", str(publish_fixture.KIT), str(target)], root)
    sh(["git", "checkout", "--quiet", publish_fixture._kit_binding["commit"]], target)
    assert sh(
        ["git", "status", "--porcelain=v1", "--untracked-files=all"],
        target,
    ).stdout == ""
    return target

