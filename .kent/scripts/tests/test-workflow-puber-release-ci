            # A second private initial-route scenario proves unknown timing is
            # retained and blocks the next real Script wrapper before its
            # provider pre-read. The native Kent state here is a disposable
            # fixture, not an installed/runtime Task claim.
            environment["PUBER_D13_FAKE_GH_FAIL"] = "unknown"
            unknown_failure = run_native({
