            environment["PUBER_D13_FAKE_GH_FAIL"] = "0"
            remaining_ms = (
                known_constraint["not_before_unix_ms"]
                - time.time_ns() // 1_000_000
            )
            if remaining_ms > 0:
                time.sleep(remaining_ms / 1000 + 0.05)
            final_result = run_native(final_native)
            assert final_result["transition"] == "ci_prepare_ready_initial"
            assert all(
                final_result.get(key) == fixture_release[key]
