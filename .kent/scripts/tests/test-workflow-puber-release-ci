def canonical(value) -> bytes:
    return json.dumps(
        value,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
        allow_nan=False,
    ).encode("utf-8")


def native_transition_id(graph: dict, edge_key: str) -> str:
    edges = [edge for edge in graph["edges"] if edge.get("key") == edge_key]
    assert len(edges) == 1, edge_key
    groups = [
        group for group in graph["transition_groups"]
        if group.get("id") == edges[0].get("transition_group_id")
    ]
    assert len(groups) == 1, edge_key
    return groups[0]["transition_id"]


def validate_context(value: object) -> dict:
    assert isinstance(value, dict)
    assert value.get("schema") == "workflow-delivery-context-v2"
    assert value.get("phase") == "post_pr"
    assert set(value) <= {
        "schema", "phase", "pr_url", "branch_name", "pr_base_branch",
        "merge_strategy", "pr_feedback_cursor", "ci_contract", "ci_report",
    }
    for key in (
        "pr_url", "branch_name", "pr_base_branch", "merge_strategy",
        "pr_feedback_cursor",
    ):
        assert isinstance(value.get(key), str) and value[key]
    return dict(value)


def validated_resume(raw: str) -> str | None:
    try:
        validate_context(json.loads(raw))
    except (AssertionError, TypeError, ValueError):
        return None
    return raw


def unwrap_context(payload: dict) -> dict:
    result = dict(payload)
    raw = result.pop("delivery_context", None)
    if raw is None:
        return result
    context = validate_context(json.loads(raw))
    for key in (
        "pr_url", "branch_name", "pr_base_branch", "merge_strategy",
        "pr_feedback_cursor", "ci_contract", "ci_report",
    ):
        if key in payload:
            if key in context:
                if payload[key] != context[key]:
                    raise ValueError("delivery context conflict")
            elif payload[key] != "":
                raise ValueError("delivery context conflict")
        result.pop(key, None)
        if key in context:
            result[key] = context[key]
    return result


def make_modules(child_holder: dict | None = None) -> dict:
    holder = child_holder if child_holder is not None else {}

    def validate_diagnostic(value: object) -> dict:
        assert isinstance(value, str)
        parsed = json.loads(value)
        assert set(parsed) <= {
            "schema", "code", "classification", "input_strings_sha256",
            "resume_context",
        }
        assert parsed["schema"] == "workflow-ci-preparation-diagnostic-v1"
        assert parsed["classification"] in {
            "transient", "archive_blocked", "identity_conflict", "invalid_input",
        }
        return parsed

    def producer_locator(commentary: str) -> str | None:
        if commentary == "Kent producer packet: child-locator":
            return "child-locator"
        return None

    def observe(*_args, **_kwargs):
        return {
            "task_id": task_id,
            "task_short_id": task_short_id,
            "project_id": "project-fixture",
            "workspace_path": str(ROOT),
            "invocation_kind": "script",
            "node_id": node_id,
            "transition_branch_key": None,
        }

    def reconstruct(_root, locator, *, identity, **_kwargs):
        assert locator == "child-locator"
        assert identity["task_id"] == task_id
        return holder["child"]

    return {
        "validate_ci_preparation_diagnostic": validate_diagnostic,
        "typed_preparation_failure": lambda _payload, _error: {},
        "validate_delivery_context": validate_context,
        "_validated_resume_context": validated_resume,
        "unwrap_delivery_context_payload": unwrap_context,
        "kit_canonical_bytes": canonical,
        "producer_locator": producer_locator,
        "observe_script_identity": observe,
        "producer_reference_closure": lambda *_args, **_kwargs: [],
        "producer_github_retry_constraints": lambda _producers: [],
        "merge_github_retry_constraints": lambda _constraints: None,
        "reconstruct_producer": reconstruct,
        "packet_decode": lambda raw: json.loads(raw),
        "packet_json": canonical,
    }


