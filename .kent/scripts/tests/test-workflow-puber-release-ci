                    restored_carrier.get(key) == fixture_release[key]
                    for key in fixture_ci.RELEASE_RESTORE_FIELDS
                )
                assert (
                    restored_carrier["delivery_context"]
                    == first_pack["delivery_context"]
                )
            assert subprocess.run(
                ["git", "-C", str(fixture_root), "status", "--porcelain"],
                check=True,
                capture_output=True,
