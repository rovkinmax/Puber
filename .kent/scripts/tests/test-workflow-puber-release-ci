def actual_typed_roundtrip(candidate_value: str) -> None:
    """Exercise the real shared CI CLI and Kit producer/Agent protocols.

    The dirty Kit source is read-only input. A private, disposable copy of its
    required files gets a local fixture commit so both project and Kit
    fail-closed source selectors continue to require exact clean revisions.
    Neither fixture revision is a released/qualified production source.
    """
    candidate_root = Path(candidate_value).expanduser().resolve(strict=True)
    checkpoint_source = candidate_root / "templates/project/workflow-checkpoint"
    janitor_source = candidate_root / "templates/project/workflow-task-janitor"
    cli_source = candidate_root / "scripts/prepare-github-ci"
    workflowkit_source = candidate_root / "workflowkit"
    assert checkpoint_source.is_file()
    assert janitor_source.is_file()
    assert cli_source.is_file()
    assert workflowkit_source.is_dir()
    source_files = [
        checkpoint_source,
        janitor_source,
        cli_source,
        *sorted(workflowkit_source.rglob("*.py")),
    ]

    def source_digests() -> dict[str, str]:
        return {
            str(path): hashlib.sha256(path.read_bytes()).hexdigest()
            for path in source_files
        }

    before_digests = source_digests()
    before_status = subprocess.run(
        ["git", "-C", str(candidate_root), "status", "--short"],
        check=True,
        capture_output=True,
    ).stdout
    before_head = subprocess.run(
        ["git", "-C", str(candidate_root), "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
    ).stdout.decode().strip()
    kit_modules_before = {
        name: module
        for name, module in sys.modules.items()
        if name == "workflowkit" or name.startswith("workflowkit.")
    }
    original_path = list(sys.path)
    for name in kit_modules_before:
        del sys.modules[name]

    try:
        with tempfile.TemporaryDirectory(prefix="puber-d13-ci-roundtrip-") as temporary:
            temp_root = Path(temporary).resolve()
            fixture_root = temp_root / "project"
            fixture_root.mkdir()
            for name in (
                "scripts", "workflows", "commands", "context",
                "subagents", "adapters", "skills",
            ):
                source = ROOT / ".kent" / name
