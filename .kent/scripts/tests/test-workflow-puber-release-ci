            )
            janitor_input = {
                "_kent": {
                    "task_id": task_id_fixture,
                    "node_id": janitor_node["id"],
                },
                "workspace_path": str(fixture_root),
                "operation_id": fixture_release["operation_id"],
                "branch_name": fixture_release["branch_name"],
                "pr_base_branch": "not-applicable",
                "pr_url": "",
                "cleanup_mode": "closed_without_merge",
                "cleanup_report": "Release PR closed without merge.",
                "cleanup_session_id": str(uuid.uuid4()),
                "task_short_id": task_short_fixture,
                "publication_report": "",
                "publication_report_digest": "",
                "release_report": "",
                "release_report_digest": "",
                "release_notes_path": "",
                "release_notes_digest": "",
                "commentary": failure["commentary"],
