            janitor_node = nodes["task_janitor"]
            janitor_script = fixture_root / ".kent/scripts/workflow-puber-release-janitor"
            janitor_native_detail = {
                **native_detail,
                "current_nodes": [{"node_id": janitor_node["id"]}],
