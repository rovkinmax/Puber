portable = json.loads((ROOT / ".kent/workflows/specs/puber-engineering-delivery-v21.json").read_text())
assert len(portable["nodes"]) == 31 and len(portable["edges"]) == 89
assert len({(edge["source"], edge["transition"]) for edge in portable["edges"]}) == 87
print("prepared-native88-source90-delivery21: passed")

actual_source = subprocess.run([str(GENERATOR_KIT / "scripts/generate-workflow"), "--project", str(ROOT), "--kind", "delivery", "--version", "23"], capture_output=True, text=True, check=True).stdout
assert actual_source == (ROOT / ".kent/workflows/specs/puber-engineering-delivery-v23.json").read_text()
assert_native_join_parameter_contract(json.loads(actual_source))
release_graph = json.loads((ROOT / ".kent/workflows/puber-release.json").read_text())
assert not any(node.get("kind") == "join" for node in release_graph["nodes"])
historical_v21 = next(
