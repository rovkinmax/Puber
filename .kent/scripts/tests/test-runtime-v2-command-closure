assert hashlib.sha256((ROOT / ".kent/workflows/specs/puber-engineering-delivery-v21.json").read_bytes()).hexdigest() == historical_v21
assert 'prepare_ci = ".kent/scripts/workflow-prepare-github-ci"' in profile
assert 'prepare_ci = "2.0.0"' in profile
