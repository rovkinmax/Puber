GENERATOR_COMMIT=COMMIT
assert GENERATOR_KIT.is_dir()
assert subprocess.run(["git","rev-parse","HEAD"],cwd=GENERATOR_KIT,text=True,capture_output=True).stdout.strip()==GENERATOR_COMMIT
assert subprocess.run(["git","status","--porcelain=v1","--untracked-files=all"],cwd=GENERATOR_KIT,text=True,capture_output=True).stdout==""
pairs=[(".kent/scripts/workflow-prepare-github-ci","templates/project/workflow-prepare-github-ci"),(".kent/scripts/workflow_runtime_contracts.py","workflowkit/runtime.py"),(".kent/scripts/workflow-evidence-ledger","templates/project/workflow-evidence-ledger"),(".kent/scripts/workflow-task-janitor","templates/project/workflow-task-janitor"),(".kent/scripts/workflow-wait-github-pr","templates/project/workflow-wait-github-pr"),(".kent/scripts/workflow-wait-github-ci","templates/project/workflow-wait-github-ci")]
