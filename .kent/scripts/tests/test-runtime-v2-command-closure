def assert_native_join_parameter_contract(workflow):
    kinds = {node["key"]: node.get("kind") for node in workflow["nodes"]}
    joins = {key for key, kind in kinds.items() if kind == "join"}
    for join in joins:
        for edge in workflow["edges"]:
            if edge["source"] == join:
                assert edge.get("parameters", []) == [], edge["key"]
        seen = set()
        for edge in workflow["edges"]:
            if edge["target"] != join:
                continue
            for parameter in edge.get("parameters", []):
                assert parameter["key"] not in seen, (join, parameter["key"])
                seen.add(parameter["key"])
