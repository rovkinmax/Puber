assert hashlib.sha256((ROOT/".kent/scripts/workflow-verify-report").read_bytes()).digest()==hashlib.sha256(expected_verify).digest()
profile=(ROOT/'.kent/workflow-profile.toml').read_text(); assert 'runtime_contracts = "2.0.0"' in profile and 'topology_kind = "puber-release"' in profile
print('runtime-v2-command-closure: passed')

import json, runpy
pins = runpy.run_path(str(ROOT / ".kent/scripts/workflow-puber-release-intent"))["VALIDATION_SIGNING"]
manifest = json.loads((ROOT / ".kent/workflows/puber-release.manifest.json").read_text())

def assert_native_join_parameter_contract(workflow):
    kinds = {node["key"]: node.get("kind") for node in workflow["nodes"]}
    joins = {key for key, kind in kinds.items() if kind == "join"}
    for join in joins:
        for edge in workflow["edges"]:
            if edge["source"] == join:
                assert edge.get("parameters", []) == [], edge["key"]
        seen = set()
        for edge in workflow["edges"]:
            if edge["target"] != join:
                continue
            for parameter in edge.get("parameters", []):
                assert parameter["key"] not in seen, (join, parameter["key"])
                seen.add(parameter["key"])
assert "app/debug.jks" not in manifest["additional_paths"]
debug_roots = [
    item for item in manifest["external_roots"]
    if item.get("kind") == "source-sha256"
    and item.get("key") == "app/debug.jks=" + pins["validation_signing_sha256"]
]
assert debug_roots == [{
    "kind": "source-sha256",
    "key": "app/debug.jks=" + pins["validation_signing_sha256"],
    "runtime_digest_required": True,
}]
blob = subprocess.run(["git", "ls-files", "--stage", "--", "app/debug.jks"], cwd=ROOT, text=True, capture_output=True, check=True).stdout.strip()
assert blob == "100644 " + pins["validation_signing_blob_oid"] + " 0\tapp/debug.jks"
assert hashlib.sha256((ROOT / "app/debug.jks").read_bytes()).hexdigest() == pins["validation_signing_sha256"]
certificate = subprocess.run(["keytool", "-exportcert", "-keystore", str(ROOT / "app/debug.jks"), "-storepass", "android", "-alias", "androiddebugkey"], capture_output=True, check=True).stdout
assert hashlib.sha256(certificate).hexdigest() == pins["validation_signer_certificate_sha256"]
print("runtime-v2-validation-key-closure: passed")

assert subprocess.run(["git", "status", "--porcelain=v1", "--untracked-files=all"], cwd=KIT, text=True, capture_output=True, check=True).stdout == ""
assert pins is not None
runtime = runpy.run_path(str(ROOT / ".kent/scripts/workflow-puber-release-intent"))
