def sha256(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def git(*args: str, cwd: Path = ROOT) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-C", str(cwd), *args],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def git_mode(path: str) -> str:
    return git("ls-files", "-s", "--", path).stdout.decode().split()[0]


def assert_safe_interpreter(path: Path) -> None:
    metadata = path.stat()
    assert stat.S_ISREG(metadata.st_mode), path
    assert metadata.st_uid == 0, path
    assert metadata.st_mode & stat.S_IXUSR, path
    assert not metadata.st_mode & 0o022, path


def write_executable(path: Path, content: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(content)
    path.chmod(0o700)


def install_verifier(root: Path, wrapper: bytes | None = None) -> None:
    scripts = root / ".kent/scripts"
    scripts.mkdir(parents=True, exist_ok=True)
    write_executable(
        scripts / "workflow-verify-report",
        VERIFY.read_bytes() if wrapper is None else wrapper,
    )
    write_executable(scripts / "workflow-compile-verify", CHILD.read_bytes())
    (scripts / "workflow_runtime_contracts.py").write_bytes(RUNTIME.read_bytes())
    (root / ".gitignore").write_text("/build/\n", encoding="utf-8")
    if (root / ".git").is_dir():
        (root / ".git/info").mkdir(parents=True, exist_ok=True)
        (root / ".git/info/exclude").write_text("/build/\n", encoding="utf-8")


def initialize_repository(root: Path) -> None:
    root.mkdir(parents=True, exist_ok=True)
    subprocess.run(["git", "init", "-q"], cwd=root, check=True)


