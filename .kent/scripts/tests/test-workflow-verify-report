def fake_command(
    path: Path,
    marker: Path,
    *,
    exit_code: int = 0,
    admission_fd: int | None = None,
    signal_self: bool = False,
    sleep_seconds: float = 0.0,
    output_bytes: int = 0,
) -> None:
    descriptor_check = (
        "descriptor_closed = None\n"
        if admission_fd is None
        else (
            "try:\n"
            f"    os.fstat({admission_fd})\n"
            "except OSError:\n"
            "    descriptor_closed = True\n"
            "else:\n"
            "    descriptor_closed = False\n"
        )
    )
    source = (
        "#!/usr/bin/python3\n"
        "import json\n"
        "import os\n"
        "from pathlib import Path\n"
        "import signal\n"
        "import sys\n"
        "import time\n"
        "assert sys.stdin.buffer.read() == b''\n"
        "assert 'private-transport-commentary' not in json.dumps(dict(os.environ))\n"
        f"{descriptor_check}"
        f"expected_tmp = Path({str(marker.parent.resolve() / 'build/kent-workflow/gradle-tmp')!r})\n"
        "actual_tmp = Path(os.environ.get('TMPDIR', ''))\n"
        "tmp_ok = actual_tmp == expected_tmp and actual_tmp.is_dir()\n"
        "sentinel = actual_tmp / 'fake-gradle-sentinel'\n"
        "if tmp_ok:\n"
        "    sentinel.write_text('sentinel', encoding='utf-8')\n"
        "    tmp_ok = sentinel.read_text(encoding='utf-8') == 'sentinel'\n"
        "    sentinel.unlink()\n"
        f"Path({str(marker)!r}).write_text(json.dumps({{\n"
        "    'argv': sys.argv[1:],\n"
        "    'cwd': os.getcwd(),\n"
        "    'tmpdir': str(actual_tmp),\n"
        "    'tmp_ok': tmp_ok,\n"
        "    'descriptor_closed': descriptor_closed,\n"
        "    'pythonpath': os.environ.get('PYTHONPATH'),\n"
        "    'pythonhome': os.environ.get('PYTHONHOME'),\n"
        "    'env_hook': os.environ.get('ENV'),\n"
        "    'bash_env': os.environ.get('BASH_ENV'),\n"
        "}), encoding='utf-8')\n"
        f"sys.stdout.buffer.write(b'O' * {output_bytes} + b'fake stdout\\n')\n"
        "sys.stdout.flush()\n"
        "sys.stderr.write('fake stderr\\n')\n"
        "sys.stderr.flush()\n"
        f"time.sleep({sleep_seconds!r})\n"
        + ("os.kill(os.getpid(), signal.SIGTERM)\n" if signal_self else "")
        + f"raise SystemExit({exit_code})\n"
    )
    write_executable(path, source.encode())


def parse_wrapper_result(
    root: Path,
    result: subprocess.CompletedProcess[str],
) -> tuple[dict[str, object], dict[str, object], bytes]:
    assert result.returncode == 0, result.stderr
    assert result.stderr == ""
    carrier = json.loads(result.stdout)
    report = json.loads(carrier["verification_report"])
    framed = (
        (root / report["log_path"]).read_bytes()
        if report["log_path"] is not None
        else b""
    )
    if framed:
        assert sha256(framed) == report["log_sha256"]
    return carrier, report, framed


def run_wrapper(
    root: Path,
    review_context: str = "PUB-78 focused verification",
    *,
    runtime: bool = False,
    branch: bool = True,
    transport: dict[str, object] | None = None,
) -> tuple[dict[str, object], dict[str, object], bytes]:
    result = subprocess.run(
        [str(root / ".kent/scripts/workflow-verify-report")],
        cwd=root,
        input=json.dumps(
            {
                "workspace_path": str(root),
                "review_context": review_context,
                **({"_kent": runtime_metadata(branch=branch)} if runtime else {}),
                **(transport or {}),
            }
        ),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=parent_environment,
        check=False,
    )
    return parse_wrapper_result(root, result)


def open_admission_directory(root: Path, *, mode: int = 0o700) -> tuple[Path, int]:
    admission = root / "admission"
    admission.mkdir(mode=mode, exist_ok=True)
    admission.chmod(mode)
    return admission, os.open(admission, os.O_RDONLY | os.O_DIRECTORY)


def direct_child(
    root: Path,
    payload: bytes,
    *,
    tmpdir: str,
    descriptor: int | None = None,
    hostile: bool = False,
) -> subprocess.CompletedProcess[bytes]:
    environment = dict(parent_environment)
    environment["TMPDIR"] = tmpdir
    if hostile:
        environment.update(hostile_environment)
        environment["TMPDIR"] = tmpdir
    return subprocess.run(
        [str(CHILD)],
        cwd=root,
        input=payload,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=environment,
        pass_fds=() if descriptor is None else (descriptor,),
        check=False,
    )


def valid_payload(root: Path, review_context: object = "focused") -> bytes:
    return json.dumps(
        {"workspace_path": str(root), "review_context": review_context},
        separators=(",", ":"),
    ).encode()


