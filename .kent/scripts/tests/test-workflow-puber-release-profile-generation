class ResourceAPI:
    """Synchronous command fixture, with worker acknowledgement before effects."""
    def __init__(self, fixture, mode):
        self.fixture, self.mode, self.calls = fixture, mode, []
        self.binding = {
            "protocol": "puber-resource-lease-v1", "profile": "release.clean",
            "config_sha256": "c" * 64, "context_sha256": "d" * 64,
            "attempt": "e" * 32,
            "owner": module.helper.resource_lease_release_owner(TASK_ID, "e" * 32, "d" * 64),
            "run_directory": "", "resource": None, "cleanup_proof": None,
        }

    def release_attempt(self, context):
        assert "session" not in context
        self.context = context
        self.calls.append("attempt")
        return dict(self.binding)

    def private(self, *_args, **_kwargs):
        pass

    def write(self, path, value):
        assert value["native_binding"] == self.fixture.payload["_kent"]
        self.worker = value
        path.write_text(json.dumps(value))
        path.chmod(0o600)
        self.calls.append("persist-worker")

    def configuration(self):
        return {}, {}, "c" * 64

    def run_release(self, binding, context, worker, *, env):
        self.calls.append("run")
        assert "ANDROID_SERIAL" not in env
        assert not any(key in env for key in ("KENT_SESSION_ID", "KENT_RUN_ID", "KENT_STEP_ID"))
        checkpoint = self.fixture.checkpoint()
        assert checkpoint["state"] == "acquiring" and checkpoint["resource_serial"] == ""
        assert "candidate_serials" not in checkpoint
        assert checkpoint["resource_lease"] == binding
        if self.mode == "lost-before-ack":
            return 1
        if self.mode == "interrupt-before-generation":
            raise KeyboardInterrupt()
        acquired = dict(binding, run_directory=str(self.fixture.root / ".kent/runtime/fake-run"),
                        resource={"id": "lease-id", "generation": 1, "slot": "release-slot"})
        before = checkpoint["output_hashes"]
        module._resource_checkpoint(self.fixture.state, acquired, "generating", SERIALS[1], before)
        self.calls.append("ack")
        for relative in module.PROFILE_PATHS:
            with (self.fixture.root / relative).open("ab") as stream:
                stream.write(b"Lcom/kino/puber/Generated;\n")
        self.calls.append("generate")
        if self.mode == "interrupt-during-generation":
            raise KeyboardInterrupt()
        hashes = {p: hashlib.sha256((self.fixture.root / p).read_bytes()).hexdigest() for p in module.PROFILE_PATHS}
        module._resource_checkpoint(self.fixture.state, acquired, "cleanup", SERIALS[1], hashes)
        self.calls.append("finalizers")
        return 1 if self.mode in {"generator-failure", "lost-after-ack"} else 0

    def inspect_command(self, binding, context, *, terminal=False):
        assert terminal and context == self.context
        self.calls.append("cleanup")
        if self.mode in {"cleanup-failure", "lost-before-ack", "lease-loss", "uncertain-stop"}:
            raise ValueError("unknown ownership/cleanup; preserve evidence")
        resource = {"id": "lease-id", "generation": 1, "slot": "release-slot"}
        return str(self.fixture.root / ".kent/runtime/fake-run"), resource, {
            "phase": "finished", "command_stop": "confirmed", "state": "completed",
            "cleanup_pending": False, "quarantined": False, "resource": resource,
        }


def test_resource_parent_matrix():
    for mode in (
        "success", "lost-before-ack", "lost-after-ack", "generator-failure",
        "cleanup-failure", "lease-loss", "uncertain-stop",
        "interrupt-before-generation", "interrupt-during-generation",
    ):
        fixture = Fixture()
        api = ResourceAPI(fixture, mode)
        # The isolated fixture profile selects the new path; production selection
        # remains legacy during S3 expansion.
        profile = fixture.root / ".kent/workflow-profile.toml"
        profile.write_bytes((ROOT / "tools/fixtures/mobile-resource-migration/workflow-profile-resource-lease.toml").read_bytes())
        sh(["git", "add", ".kent/workflow-profile.toml"], fixture.root)
        sh(["git", "commit", "-q", "-m", "resource fixture selection"], fixture.root)
        fixture.candidate = sh(["git", "rev-parse", "HEAD"], fixture.root)
        fixture.state.update(candidate_oid=fixture.candidate, release_base_oid=fixture.candidate)
        fixture.payload.update(candidate_oid=fixture.candidate, release_base_oid=fixture.candidate)
        fixture.payload["_kent"] = {"task_id": TASK_ID, "node_id": "fixture-profile-node"}
        try:
            with patch.object(module, "_load_resource_adapter", return_value=api):
                assert module.main() == 0, mode
                checkpoint = fixture.checkpoint()
                if mode == "success":
                    assert checkpoint["state"] == "completed"
                    assert checkpoint["resource_lease"]["cleanup_proof"]["command_stop"] == "confirmed"
                    assert fixture.events[-1][0] == "profile_generation_passed"
                    assert api.calls.index("ack") < api.calls.index("generate") < api.calls.index("finalizers") < api.calls.index("cleanup")
                    run_calls = api.calls.count("run")
                    assert module.main() == 0
                    assert api.calls.count("run") == run_calls
                else:
                    assert checkpoint["state"] != "completed", mode
                    assert fixture.events[-1][0] == "profile_generation_needs_user_action", mode
                    if "generate" in api.calls:
                        assert all((fixture.root / p).read_bytes() != fixture.original_profiles[p] for p in module.PROFILE_PATHS)
                    run_calls = api.calls.count("run")
                    assert module.main() == 0
                    assert api.calls.count("run") == run_calls, "ambiguous command was replayed"
                assert TOKEN not in json.dumps(checkpoint)
        finally:
            fixture.close()


def test_resource_worker_acknowledgement_and_qualified_source():
    for mode in ("success", "generator-failure"):
        fixture = Fixture(mode=mode)
        module._assert_runtime_source_closure = fixture.originals["source"]
        api = ResourceAPI(fixture, mode)
        context = module._script_context({
            "task_id": TASK_ID, "task_short_id": "PUB-99", "node_id": "fixture-profile-node",
            "commit": fixture.candidate, "controller_commit": fixture.candidate,
        }, fixture.state)
        before = {p: hashlib.sha256(raw).hexdigest() for p, raw in fixture.original_profiles.items()}
        module._resource_checkpoint(fixture.state, api.binding, "acquiring", "", before)
        worker = {
            "context": context, "binding": api.binding, "before_hashes": before,
            "native_binding": fixture.payload["_kent"],
        }
        run = str(fixture.root / ".kent/runtime/owned-command")
        resource = {"id": "lease-id", "generation": 1, "slot": "release-slot"}
        def owned(binding, _context, **_kwargs):
            assert fixture.checkpoint()["state"] == "acquiring"
            return run, resource, SERIALS[1]
        checks = []
        def recheck(binding, _context):
            assert fixture.checkpoint()["state"] == "generating"
            assert fixture.checkpoint()["resource_lease"]["run_directory"] == run
            checks.append("owned")
            return {"ANDROID_SERIAL": SERIALS[1], "RESOURCE_LEASE_RUN_DIRECTORY": run}
        budget = object()
        selection = SimpleNamespace(project_commit=context["controller_commit"])
        profile = object()
        source_events = []

        @contextlib.contextmanager
        def source_read_budget():
            source_events.append("enter")
            try:
                yield budget
            finally:
                source_events.append("exit")

        def preflight(root, commit, *, budget):
            assert root == fixture.root and commit == context["controller_commit"]
            assert budget is source_budget
            source_events.append("preflight")
            return SimpleNamespace(selected_runtime_source_inputs=selection)

        def verify(root, selected, *, budget):
            assert root == fixture.root and selected is selection and budget is source_budget
            source_events.append("verify")
            return object()  # Kit-owned opaque proof; callers cannot reconstruct it.

        source_budget = budget
        kit = {
            "source_read_budget": source_read_budget,
            "preflight_project_revision": preflight,
            "ProjectProfile": SimpleNamespace(from_toml=lambda *_args, **_kwargs: profile),
            "verify_runtime_source_captures": verify,
        }
        mobile = SimpleNamespace(worker_record=lambda _path: worker, inspect_command=owned,
                                 command_environment=recheck)
        try:
            with patch.object(module, "_load_resource_adapter", return_value=mobile), \
                 patch.object(module.helper, "_bind_qualified_runtime") as bind, \
                 patch.object(module.helper, "_kit_modules", return_value=kit), \
                 patch.dict(os.environ, {"ANDROID_SERIAL": SERIALS[1], "RESOURCE_LEASE_RUN_DIRECTORY": run}):
                code = module._resource_worker("/private/owned-worker.json")
                assert code == (0 if mode == "success" else 17)
                assert fixture.checkpoint()["state"] == ("cleanup" if code == 0 else "failed")
                bind.assert_called_once_with(fixture.root, fixture.payload["_kent"])
                assert source_events == ["enter", "preflight", "verify", "exit"]
                assert checks == ["owned", "owned"]
                assert fixture.events == [], "internal worker emitted native transition"
        finally:
            fixture.close()


