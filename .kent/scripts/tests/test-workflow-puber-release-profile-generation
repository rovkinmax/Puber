    return {
        "task_id": TASK_ID,
        "task_short_id": "PUB-99",
        "operation_id": "a" * 64,
        "release_type": "minor",
        "release_version": "99.0.0",
        "release_tag": "v99.0.0",
        "release_branch": "release/99.0.0",
        "release_base_oid": candidate,
        "candidate_oid": candidate,
    }


class FakeLeaseAPI:
    def __init__(self, *, owners=None, release_error=None):
        self.owners = owners or ["Absent", "Absent"]
        self.release_error = release_error
        self.calls: list[tuple[str, object]] = []

    def inspect_recovery(self, context, resources):
        self.calls.append(("inspect", (context, list(resources))))
        return [
            {
                "schema": "mobile-script-recovery-v1",
                "resource": resource,
                "owner_kind": owner,
                "owner_sha256": "none" if owner == "Absent" else "b" * 64,
            }
            for resource, owner in zip(resources, self.owners)
        ]

    def acquire_any(self, context, resources, *, wait_seconds):
        self.calls.append(("acquire", (context, list(resources), wait_seconds)))
        return SimpleNamespace(
            resource="emulator-5556",
            token=TOKEN,
            owner_sha256="c" * 64,
        )

    def release(self, context, lease):
        self.calls.append(("release", (context, lease)))
        if self.release_error:
            raise self.release_error


class Fixture:
    def __init__(self, *, mode="success", owners=None, release_error=None):
        self.temp = tempfile.TemporaryDirectory(prefix="puber-profile-")
        self.root = Path(self.temp.name).resolve()
        self.mode = mode
        self.original_root = module.ROOT
        self.originals = {
            "read": module.helper.read_zero_argument,
            "task_show": module.helper.task_show,
            "validate": module.helper.validate_envelope,
            "source": module._assert_runtime_source_closure,
            "inventory": module._inventory,
            "lease_loader": module._load_script_lease_adapter,
            "emit": module.helper.emit_exact,
            "handlers": {
                item: signal.getsignal(item)
                for item in (signal.SIGINT, signal.SIGHUP, signal.SIGTERM)
            },
        }
        self.events: list[tuple[str, str, dict]] = []
        self.lease = FakeLeaseAPI(owners=owners, release_error=release_error)
        self._materialize()
        module.ROOT = self.root
        module.helper.read_zero_argument = lambda: self.payload
        module.helper.task_show = lambda *_args: self.task
        module.helper.validate_envelope = lambda *_args, **_kwargs: (
            dict(self.payload),
            {
                "task": self.task,
                "task_id": TASK_ID,
                "task_short_id": "PUB-99",
                "node_id": "fixture-profile-node",
                "commit": self.candidate,
                "controller_commit": self.candidate,
            },
            {},
        )
        module._assert_runtime_source_closure = lambda _state: None
        module._inventory = lambda _adapter: list(SERIALS)
        module._load_script_lease_adapter = lambda: self.lease
        module.helper.emit_exact = self._emit

    def _materialize(self):
        for relative, raw in zip(
            module.PROFILE_PATHS,
            (b"Lcom/kino/puber/Main;\n", b"SLcom/kino/puber/Startup;\n"),
        ):
            path = self.root / relative
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(raw)
        (self.root / ".gitignore").write_text(".kent/runtime/\n", encoding="utf-8")
        (self.root / ".kent/workflows").mkdir(parents=True)
        (self.root / module.helper.GRAPH_PATH).write_bytes(
            (ROOT / module.helper.GRAPH_PATH).read_bytes()
        )
        (self.root / ".kent").mkdir(exist_ok=True)
        (self.root / ".kent/workflow-profile.toml").write_bytes(
            (ROOT / ".kent/workflow-profile.toml").read_bytes()
        )
        adapter = self.root / ".kent/adapters/mobile/emulator-resource-lock.sh"
        adapter.parent.mkdir(parents=True)
        adapter.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
        adapter.chmod(0o755)
        generator = self.root / "tools/generate-baseline-profile.sh"
        generator.parent.mkdir(parents=True)
        command = (
            "#!/bin/sh\n"
            f"printf '%s\\n' 'Lcom/kino/puber/Generated;' >> '{module.PROFILE_PATHS[0]}'\n"
            f"printf '%s\\n' 'SLcom/kino/puber/Generated;' >> '{module.PROFILE_PATHS[1]}'\n"
        )
        if self.mode == "generator-failure":
            command += "exit 17\n"
        generator.write_text(command, encoding="utf-8")
        generator.chmod(0o755)
        sh(["git", "init", "-q"], self.root)
        sh(["git", "config", "user.email", "test@example.invalid"], self.root)
        sh(["git", "config", "user.name", "Puber Test"], self.root)
        sh(["git", "checkout", "-q", "-b", "release/99.0.0"], self.root)
        sh(["git", "add", "."], self.root)
        sh(["git", "commit", "-q", "-m", "profile fixture"], self.root)
        self.candidate = sh(["git", "rev-parse", "HEAD"], self.root)
        values = state(self.candidate)
        self.payload = {
            "workspace_path": str(self.root),
            **{key: values[key] for key in (
                "operation_id", "task_short_id", "release_type", "release_version",
                "release_tag", "release_branch", "release_base_oid", "candidate_oid",
            )},
            "_kent": {
                "task_id": TASK_ID,
                "node_id": "fixture-profile-node",
            },
            "entry_transition": "prepare_profile_generation",
        }
        self.task = {"summary": {"id": TASK_ID, "short_id": "PUB-99"}}
        self.state = values
        self.original_profiles = {
            path: (self.root / path).read_bytes() for path in module.PROFILE_PATHS
        }

    def _emit(self, root, transition, target, fields, **kwargs):
        self.events.append((transition, target, dict(fields)))

    def run(self):
        try:
            return module.main()
        finally:
            for name, function in self.originals.items():
                if name == "handlers":
                    continue
                if name == "read":
                    module.helper.read_zero_argument = function
                elif name == "task_show":
                    module.helper.task_show = function
                elif name == "validate":
                    module.helper.validate_envelope = function
                elif name == "source":
                    module._assert_runtime_source_closure = function
                elif name == "inventory":
                    module._inventory = function
                elif name == "lease_loader":
                    module._load_script_lease_adapter = function
                elif name == "emit":
                    module.helper.emit_exact = function

    def checkpoint(self):
        return module.helper.read_profile_checkpoint(self.root, "PUB-99")

    def close(self):
        module.ROOT = self.original_root
        for name, function in self.originals.items():
            if name == "handlers":
                for signum, handler in function.items():
                    signal.signal(signum, handler)
            elif name == "read":
                module.helper.read_zero_argument = function
            elif name == "task_show":
                module.helper.task_show = function
            elif name == "validate":
                module.helper.validate_envelope = function
            elif name == "source":
                module._assert_runtime_source_closure = function
            elif name == "inventory":
                module._inventory = function
            elif name == "lease_loader":
                module._load_script_lease_adapter = function
            elif name == "emit":
                module.helper.emit_exact = function
        self.temp.cleanup()


def test_report_and_checkpoint_contract() -> None:
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / ".kent").mkdir()
        value = {
            "schema": module.CHECKPOINT_SCHEMA,
            "task_id": TASK_ID,
            "task_short_id": "PUB-99",
            "operation_id": "a" * 64,
            "release_branch": "release/99.0.0",
            "release_base_oid": "b" * 40,
            "candidate_oid": "c" * 40,
            "release_head_oid": "",
            "candidate_serials": SERIALS,
            "state": "acquiring",
            "resource_serial": "",
            "profile_report": "",
            "profile_report_digest": "",
            "release_preparation_report": "",
            "release_preparation_report_digest": "",
            "output_hashes": {path: "d" * 64 for path in module.PROFILE_PATHS},
        }
        module.helper.write_profile_checkpoint(root, "PUB-99", value)
        checkpoint = root / ".kent/runtime/PUB-99/release-profile-checkpoint.json"
        assert stat.S_IMODE(checkpoint.stat().st_mode) == 0o600
        snapshot = module.helper.read_profile_checkpoint(root, "PUB-99")
        assert snapshot == value
        for changed in (
            {**value, "token": TOKEN},
            {**value, "state": "unknown"},
            {**value, "candidate_serials": []},
        ):
            try:
                module.helper.write_profile_checkpoint(root, "PUB-99", changed)
            except module.helper.ContractError:
                pass
            else:
                raise AssertionError("unsafe Script checkpoint was accepted")
        assert module.helper.read_profile_checkpoint(root, "PUB-99") == value


def test_network_free_stage_forwards_only_valid_producer_commentary() -> None:
    legacy = "prior human note"
    assert module._forward_producer_commentary({"commentary": legacy}) == legacy

    locator = (
        "build/kent-workflow/PUB-99/packets/base-"
        + "a" * 64
        + ".json"
    )
    commentary = f"prior human note\nKENT_PACKET_SOURCE_V1 {locator}"
    original = module.helper._qualified_delivery_module
    module.helper._qualified_delivery_module = lambda *_args, **_kwargs: (
        SimpleNamespace(
            producer_locator=lambda value: (
                locator if value == commentary else None
            )
        )
    )
    try:
        assert module._forward_producer_commentary(
            {"commentary": commentary}
        ) == commentary
        try:
            module._forward_producer_commentary(
                {"commentary": commentary + "\nKENT_PACKET_SOURCE_V1 " + locator}
            )
        except module.ProfileError:
            pass
        else:
            raise AssertionError("duplicate producer commentary was forwarded")
    finally:
        module.helper._qualified_delivery_module = original


def test_success_acquires_generates_releases_then_records_completed_checkpoint():
    fixture = Fixture()
    try:
        assert fixture.run() == 0
        assert [call[0] for call in fixture.lease.calls] == ["acquire", "release"]
        assert fixture.lease.calls[0][1][1] == SERIALS
        assert fixture.lease.calls[0][1][2] == 900
        checkpoint = fixture.checkpoint()
        assert checkpoint["state"] == "completed"
        assert checkpoint["resource_serial"] == "emulator-5556"
        report = json.loads(checkpoint["profile_report"])
        assert report["lease_state"] == "released"
        assert report["tv_serial"] == "emulator-5556"
        assert report["changed_profiles"] == sorted(module.PROFILE_PATHS)
        assert TOKEN not in json.dumps(checkpoint)
        assert TOKEN not in json.dumps(fixture.events)
        assert fixture.events[-1][0] == "profile_generation_passed"
        assert fixture.events[-1][1] == "finalize_release"
        assert fixture.events[-1][2]["profile_report_digest"] == checkpoint["profile_report_digest"]
        assert "KENT_SESSION_ID" not in module._child_env("emulator-5556")
    finally:
        fixture.close()


def test_generator_failure_preserves_checkpoint_outputs_and_lease():
    fixture = Fixture(mode="generator-failure")
    try:
        assert fixture.run() == 0
        checkpoint = fixture.checkpoint()
        assert checkpoint["state"] == "generating"
        assert checkpoint["resource_serial"] == "emulator-5556"
        assert [call[0] for call in fixture.lease.calls] == ["acquire"]
        assert fixture.events[-1][0] == "profile_generation_needs_user_action"
        assert all(
            (fixture.root / path).read_bytes()
            != fixture.original_profiles[path]
            for path in module.PROFILE_PATHS
        )
        assert all(
            b"Generated" in (fixture.root / path).read_bytes()
            for path in module.PROFILE_PATHS
        )
        assert TOKEN not in json.dumps(checkpoint)
    finally:
        fixture.close()


def test_ambiguous_prior_owner_blocks_without_acquire_release_or_restore():
    fixture = Fixture(mode="generator-failure", owners=["ScriptOwnerV1", "Absent"])
    try:
        checkpoint = module._checkpoint(
            "PUB-99",
            state=fixture.state,
            candidate_serials=SERIALS,
            status="generating",
            resource_serial="emulator-5554",
            output_hashes={
                path: hashlib.sha256(raw).hexdigest()
                for path, raw in fixture.original_profiles.items()
            },
        )
        before = {
            path: (fixture.root / path).read_bytes()
            for path in module.PROFILE_PATHS
        }
        assert fixture.run() == 0
        assert [call[0] for call in fixture.lease.calls] == ["inspect"]
        assert fixture.checkpoint() == checkpoint
        assert {path: (fixture.root / path).read_bytes() for path in before} == before
        assert fixture.events[-1][0] == "profile_generation_needs_user_action"
        assert TOKEN not in json.dumps(fixture.events)
    finally:
        fixture.close()


def test_release_failure_keeps_generating_checkpoint_and_generated_bytes():
    fixture = Fixture(release_error=ValueError("release acknowledgement unknown"))
    try:
        assert fixture.run() == 0
        checkpoint = fixture.checkpoint()
        assert checkpoint["state"] == "generating"
        assert checkpoint["resource_serial"] == "emulator-5556"
        assert [call[0] for call in fixture.lease.calls] == ["acquire", "release"]
        assert all((fixture.root / path).read_bytes() != fixture.original_profiles[path]
                   for path in module.PROFILE_PATHS)
        assert fixture.events[-1][0] == "profile_generation_needs_user_action"
        assert TOKEN not in json.dumps(checkpoint)
        assert TOKEN not in json.dumps(fixture.events)
    finally:
        fixture.close()


