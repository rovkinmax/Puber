def report_for(changed: list[str]) -> tuple[str, str]:
    value = {
        "schema": module.PROFILE_REPORT_SCHEMA,
        "operation_id": "a" * 64,
        "task_short_id": "PUB-99",
        "release_type": "minor",
        "release_version": "99.0.0",
        "release_tag": "v99.0.0",
        "release_branch": "release/99.0.0",
        "release_base_oid": "b" * 40,
        "candidate_oid": "c" * 40,
        "tv_serial": "emulator-5554",
        "command": module.COMMAND_IDENTITY,
        "lease_state": "released",
        "generation_state": "passed",
        "network_isolation_state": "passed",
        "elapsed_ms": 12,
        "baseline_before_sha256": "1" * 64,
        "baseline_after_sha256": "2" * 64,
        "startup_before_sha256": "3" * 64,
        "startup_after_sha256": "3" * 64,
        "changed_profiles": changed,
    }
    encoded = module.helper.canonical_json(value)
    return encoded, module.helper.sha256_bytes(encoded.encode())


def test_closed_report_changed_and_identical_outputs() -> None:
    for changed in (
        [module.PROFILE_PATHS[0]],
        [],
        list(module.PROFILE_PATHS),
    ):
        raw, digest = report_for(changed)
        assert module._validate_report(raw, digest, state=state())["changed_profiles"] == changed
    raw, digest = report_for([])
    invalid = json.loads(raw)
    invalid["unexpected"] = True
    try:
        module._validate_report(json.dumps(invalid), digest, state=state())
    except module.helper.ContractError:
        pass
    else:
        raise AssertionError("open profile report was accepted")


def test_checkpoint_is_atomic_mode_0600_and_sensitive_fields_are_rejected() -> None:
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / ".kent").mkdir()
        path = root / ".kent/runtime/PUB-99/release-profile-checkpoint.json"
        value = {
            "schema": module.CHECKPOINT_SCHEMA,
            "task_id": state()["task_id"],
            "task_short_id": state()["task_short_id"],
            "operation_id": state()["operation_id"],
            "release_branch": state()["release_branch"],
            "release_base_oid": state()["release_base_oid"],
            "candidate_oid": state()["candidate_oid"],
            "release_head_oid": "",
            "candidate_serials": ["emulator-5554"],
            "state": "acquiring",
            "resource_serial": "",
            "profile_report": "",
            "profile_report_digest": "",
            "release_preparation_report": "",
            "release_preparation_report_digest": "",
            "output_hashes": {path_name: "d" * 64 for path_name in module.PROFILE_PATHS},
        }
        module.helper.write_profile_checkpoint(root, "PUB-99", value)
        assert stat.S_IMODE(path.stat().st_mode) == 0o600
        assert module.helper.read_profile_checkpoint(root, "PUB-99") == value
        unsafe = dict(value)
        unsafe["token"] = "must-not-be-accepted"
        try:
            module.helper.write_profile_checkpoint(root, "PUB-99", unsafe)
        except module.helper.ContractError:
            pass
        else:
            raise AssertionError("sensitive checkpoint field was accepted")


def test_lease_envelope_rejects_wrong_resource_and_missing_token() -> None:
