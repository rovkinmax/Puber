class FakeLeaseAPI:
    def __init__(self, *, owners=None, release_error=None):
        self.owners = owners or ["Absent", "Absent"]
        self.release_error = release_error
        self.calls: list[tuple[str, object]] = []

    def inspect_recovery(self, context, resources):
        self.calls.append(("inspect", (context, list(resources))))
        return [
            {
                "schema": "mobile-script-recovery-v1",
                "resource": resource,
                "owner_kind": owner,
                "owner_sha256": "none" if owner == "Absent" else "b" * 64,
            }
            for resource, owner in zip(resources, self.owners)
        ]

    def acquire_any(self, context, resources, *, wait_seconds):
        self.calls.append(("acquire", (context, list(resources), wait_seconds)))
        return SimpleNamespace(
            resource="emulator-5556",
            token=TOKEN,
            owner_sha256="c" * 64,
        )

    def release(self, context, lease):
        self.calls.append(("release", (context, lease)))
        if self.release_error:
            raise self.release_error


