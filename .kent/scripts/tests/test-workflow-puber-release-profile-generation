def test_preparation_report_is_closed_and_digest_bound() -> None:
    value = {
        **module.helper.VALIDATION_SIGNING,
        "schema": "puber_release_preparation_report_v2",
        "operation_id": "a" * 64,
        "task_short_id": "PUB-99",
        "release_type": "minor",
        "release_version": "99.0.0",
        "release_tag": "v99.0.0",
        "release_branch": "release/99.0.0",
        "release_base_oid": "b" * 40,
        "candidate_oid": "c" * 40,
        "release_head_oid": "d" * 40,
        "profile_report_digest": "e" * 64,
        "compile_command": "./tools/agentw :app:compileProdReleaseArtProfile",
        "compile_state": "passed",
        "assemble_command": "./tools/agentw :app:assembleProdRelease",
        "assemble_state": "passed",
        "final_changed_paths": ["app/build.gradle.kts"],
        "version_file_sha256": "1" * 64,
        "baseline_profile_sha256": "2" * 64,
        "startup_profile_sha256": "3" * 64,
        "no_profile_diff": True,
        "elapsed_ms": 42,
    }
    encoded = module.helper.canonical_json(value)
    digest = module.helper.sha256_bytes(encoded.encode())
    assert module.helper.parse_release_preparation_report(encoded, digest)["no_profile_diff"] is True
    broken = dict(value)
    broken["final_changed_paths"] = ["app/build.gradle.kts", module.PROFILE_PATHS[0]]
    broken_raw = module.helper.canonical_json(broken)
    broken_digest = module.helper.sha256_bytes(broken_raw.encode())
    try:
        module.helper.parse_release_preparation_report(broken_raw, broken_digest)
    except module.helper.ContractError:
        pass
    else:
        raise AssertionError("synthetic profile diff was accepted")


