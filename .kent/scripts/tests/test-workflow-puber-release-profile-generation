    def _git(self, *args: str) -> CompletedProcess[str]:
        return subprocess.run(
            ["git", *args],
            cwd=self.root,
            check=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )

    def _emit(
        self,
        _root: Path,
        transition: str,
        target_node: str,
        fields: dict[str, object],
    ) -> None:
        self.transitions.append((transition, target_node, fields))

    def set_modes(self, generator: str, adapter: str = "normal") -> None:
        (self.control / "generator-mode").write_text(generator, encoding="utf-8")
        (self.control / "adapter-mode").write_text(adapter, encoding="utf-8")
        self.adapter_log.unlink(missing_ok=True)
        self.generator_log.unlink(missing_ok=True)
        (self.control / "release-count").unlink(missing_ok=True)

    def calls(self) -> list[list[str]]:
        if not self.adapter_log.exists():
            return []
        return [
            json.loads(line)
            for line in self.adapter_log.read_text(encoding="utf-8").splitlines()
        ]

    def run(self) -> tuple[int, str, str]:
        stdout = io.StringIO()
        stderr = io.StringIO()
        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
            result = module.main()
        assert "private-transport-commentary" not in stdout.getvalue() + stderr.getvalue()
        assert "private-transport-commentary" not in json.dumps(self.transitions)
        for checkpoint in (self.root / ".kent/runtime").rglob("*.json"):
            assert "private-transport-commentary" not in checkpoint.read_text()
        return result, stdout.getvalue(), stderr.getvalue()

    def checkpoint(self) -> dict[str, object]:
        value = module._read_checkpoint("PUB-99")
        assert value is not None
        return value

    def seed_checkpoint(self, status: str, outputs: dict[str, bytes]) -> None:
        module._checkpoint(
            "PUB-99",
            state={
                **state(),
                "release_base_oid": self.candidate_oid,
                "candidate_oid": self.candidate_oid,
            },
            candidate_serials=["emulator-5554", "emulator-5556"],
            status=status,
            resource_serial="emulator-5556" if status == "generating" else "",
            output_hashes={
                path: module.helper.sha256_bytes(raw) for path, raw in outputs.items()
            },
        )
        if status == "generating":
            (self.control / "owned-token").write_text("opaque-token", encoding="utf-8")
            (self.control / "owned-resource").write_text("emulator-5556", encoding="utf-8")

    def assert_profiles_restored(self) -> None:
        for relative, raw in self.original_profiles.items():
            assert (self.root / relative).read_bytes() == raw
        assert (self.root / "sentinel.txt").read_bytes() == self.sentinel_before

    def close(self) -> None:
        module.ROOT = self.original_root
