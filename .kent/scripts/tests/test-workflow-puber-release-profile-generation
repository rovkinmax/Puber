def test_child_environment_is_allowlisted_and_serial_is_explicit() -> None:
    old = os.environ.get("KinoPubAccessToken")
    old_path = os.environ.get("PUBER_PROFILE_GENERATOR_BIN")
    try:
        os.environ["KinoPubAccessToken"] = "sentinel"
        os.environ["PUBER_PROFILE_GENERATOR_BIN"] = "/tmp/sentinel"
        child = module._child_env("emulator-5554")
    finally:
        if old is None:
            os.environ.pop("KinoPubAccessToken", None)
        else:
            os.environ["KinoPubAccessToken"] = old
        if old_path is None:
            os.environ.pop("PUBER_PROFILE_GENERATOR_BIN", None)
        else:
            os.environ["PUBER_PROFILE_GENERATOR_BIN"] = old_path
    assert child["ANDROID_SERIAL"] == "emulator-5554"
    assert "KinoPubAccessToken" not in child
    assert "PUBER_PROFILE_GENERATOR_BIN" not in child
    assert all(key in module._child_env("emulator-5554") for key in ("PATH", "HOME"))


def test_main_admission_rejects_tool_override_and_dangling_local_properties() -> None:
    original_root = module.ROOT
    original_read = module.helper.read_zero_argument
    original_validate = module.helper.validate_envelope
    original_override = os.environ.get("PUBER_PROFILE_GENERATOR_BIN")
    try:
        module.helper.read_zero_argument = lambda: {}
        module.helper.validate_envelope = lambda *args, **kwargs: ({}, {}, {})
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            module.ROOT = root
            adapter = root / ".kent/adapters/mobile/emulator-resource-lock.sh"
            adapter.parent.mkdir(parents=True)
            adapter.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
            adapter.chmod(0o755)
            fake = root / "arbitrary-generator"
            fake.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
            fake.chmod(0o755)
            os.environ["PUBER_PROFILE_GENERATOR_BIN"] = str(fake)
            errors = io.StringIO()
            with contextlib.redirect_stderr(errors):
                assert module.main() == 2
            assert "executable override is forbidden" in errors.getvalue()

            os.environ.pop("PUBER_PROFILE_GENERATOR_BIN", None)
            (root / "local.properties").symlink_to(root / "missing-local.properties")
            errors = io.StringIO()
            with contextlib.redirect_stderr(errors):
                assert module.main() == 2
            assert "local.properties is unsafe" in errors.getvalue()
    finally:
        module.ROOT = original_root
        module.helper.read_zero_argument = original_read
        module.helper.validate_envelope = original_validate
        if original_override is None:
            os.environ.pop("PUBER_PROFILE_GENERATOR_BIN", None)
        else:
            os.environ["PUBER_PROFILE_GENERATOR_BIN"] = original_override


