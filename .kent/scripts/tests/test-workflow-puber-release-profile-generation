        self.state = values
        self.original_profiles = {
            path: (self.root / path).read_bytes() for path in module.PROFILE_PATHS
        }

    def _emit(self, root, transition, target, fields, **kwargs):
        self.events.append((transition, target, dict(fields)))

    def run(self):
        try:
            return module.main()
        finally:
            for name, function in self.originals.items():
                if name == "handlers":
                    continue
                if name == "read":
                    module.helper.read_zero_argument = function
                elif name == "task_show":
                    module.helper.task_show = function
                elif name == "validate":
                    module.helper.validate_envelope = function
                elif name == "source":
                    module._assert_runtime_source_closure = function
                elif name == "inventory":
                    module._inventory = function
                elif name == "lease_loader":
                    module._load_script_lease_adapter = function
                elif name == "emit":
                    module.helper.emit_exact = function

    def checkpoint(self):
        return module.helper.read_profile_checkpoint(self.root, "PUB-99")

    def close(self):
        module.ROOT = self.original_root
        for name, function in self.originals.items():
            if name == "handlers":
                for signum, handler in function.items():
                    signal.signal(signum, handler)
            elif name == "read":
                module.helper.read_zero_argument = function
            elif name == "task_show":
                module.helper.task_show = function
            elif name == "validate":
                module.helper.validate_envelope = function
            elif name == "source":
                module._assert_runtime_source_closure = function
            elif name == "inventory":
                module._inventory = function
            elif name == "lease_loader":
                module._load_script_lease_adapter = function
            elif name == "emit":
                module.helper.emit_exact = function
        self.temp.cleanup()


def test_report_and_checkpoint_contract() -> None:
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / ".kent").mkdir()
        value = {
            "schema": module.CHECKPOINT_SCHEMA,
            "task_id": TASK_ID,
            "task_short_id": "PUB-99",
            "operation_id": "a" * 64,
            "release_branch": "release/99.0.0",
            "release_base_oid": "b" * 40,
            "candidate_oid": "c" * 40,
            "release_head_oid": "",
            "candidate_serials": SERIALS,
            "state": "acquiring",
            "resource_serial": "",
            "profile_report": "",
            "profile_report_digest": "",
            "release_preparation_report": "",
            "release_preparation_report_digest": "",
            "output_hashes": {path: "d" * 64 for path in module.PROFILE_PATHS},
        }
        module.helper.write_profile_checkpoint(root, "PUB-99", value)
        checkpoint = root / ".kent/runtime/PUB-99/release-profile-checkpoint.json"
        assert stat.S_IMODE(checkpoint.stat().st_mode) == 0o600
        snapshot = module.helper.read_profile_checkpoint(root, "PUB-99")
        assert snapshot == value
        for changed in (
            {**value, "token": TOKEN},
            {**value, "state": "unknown"},
            {**value, "candidate_serials": []},
        ):
            try:
                module.helper.write_profile_checkpoint(root, "PUB-99", changed)
            except module.helper.ContractError:
                pass
            else:
                raise AssertionError("unsafe Script checkpoint was accepted")
        assert module.helper.read_profile_checkpoint(root, "PUB-99") == value


def test_network_free_stage_forwards_only_valid_producer_commentary() -> None:
    legacy = "prior human note"
    assert module._forward_producer_commentary({"commentary": legacy}) == legacy

    locator = (
        "build/kent-workflow/PUB-99/packets/base-"
        + "a" * 64
        + ".json"
    )
    commentary = f"prior human note\nKENT_PACKET_SOURCE_V1 {locator}"
    original = module.helper._qualified_delivery_module
    module.helper._qualified_delivery_module = lambda *_args, **_kwargs: (
        SimpleNamespace(
            producer_locator=lambda value: (
                locator if value == commentary else None
            )
        )
    )
    try:
        assert module._forward_producer_commentary(
            {"commentary": commentary}
        ) == commentary
        try:
            module._forward_producer_commentary(
                {"commentary": commentary + "\nKENT_PACKET_SOURCE_V1 " + locator}
            )
        except module.ProfileError:
            pass
        else:
            raise AssertionError("duplicate producer commentary was forwarded")
    finally:
        module.helper._qualified_delivery_module = original


def test_success_acquires_generates_releases_then_records_completed_checkpoint():
    fixture = Fixture()
    try:
        assert fixture.run() == 0
        assert [call[0] for call in fixture.lease.calls] == ["acquire", "release"]
        assert fixture.lease.calls[0][1][1] == SERIALS
        assert fixture.lease.calls[0][1][2] == 900
        checkpoint = fixture.checkpoint()
        assert checkpoint["state"] == "completed"
        assert checkpoint["resource_serial"] == "emulator-5556"
        report = json.loads(checkpoint["profile_report"])
        assert report["lease_state"] == "released"
        assert report["tv_serial"] == "emulator-5556"
        assert report["changed_profiles"] == sorted(module.PROFILE_PATHS)
        assert TOKEN not in json.dumps(checkpoint)
        assert TOKEN not in json.dumps(fixture.events)
        assert fixture.events[-1][0] == "profile_generation_passed"
        assert fixture.events[-1][1] == "finalize_release"
        assert fixture.events[-1][2]["profile_report_digest"] == checkpoint["profile_report_digest"]
        assert "KENT_SESSION_ID" not in module._child_env("emulator-5556")
    finally:
        fixture.close()


def test_generator_failure_preserves_checkpoint_outputs_and_lease():
    fixture = Fixture(mode="generator-failure")
    try:
        assert fixture.run() == 0
        checkpoint = fixture.checkpoint()
        assert checkpoint["state"] == "generating"
        assert checkpoint["resource_serial"] == "emulator-5556"
        assert [call[0] for call in fixture.lease.calls] == ["acquire"]
        assert fixture.events[-1][0] == "profile_generation_needs_user_action"
        assert all(
            (fixture.root / path).read_bytes()
            != fixture.original_profiles[path]
            for path in module.PROFILE_PATHS
        )
        assert all(
            b"Generated" in (fixture.root / path).read_bytes()
            for path in module.PROFILE_PATHS
        )
        assert TOKEN not in json.dumps(checkpoint)
    finally:
        fixture.close()


