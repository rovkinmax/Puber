def test_owned_recovery_accepts_only_one_bare_token_without_leaking_it() -> None:
    from unittest.mock import patch
    for raw in (
        "", "token=opaque-token\n", "opaque-token\nsecond-token\n",
        "opaque-token\n\n", " opaque-token\n", "opaque-token \n",
        "opaque token\n", "opaque-token\r\n",
    ):
        calls = []
        def run(args, **_kwargs):
            calls.append(args)
            return CompletedProcess(args, 0, raw, "")
        with patch.object(module.helper, "run", side_effect=run):
            try:
                module._recover_owned("/fake/adapter", ["emulator-5554"])
            except module.helper.ContractError as error:
                assert "opaque-token" not in str(error)
            else:
                raise AssertionError("malformed resume-owned token was accepted")
        assert calls == [["/fake/adapter", "resume-owned", "emulator-5554"]]
    for raw in ("opaque-token", "opaque-token\n"):
        calls = []
        def run(args, **_kwargs):
            calls.append(args)
            return CompletedProcess(args, 0, raw if args[1] == "resume-owned" else "", "")
        with patch.object(module.helper, "run", side_effect=run):
            assert module._recover_owned("/fake/adapter", ["emulator-5554"]) == {"emulator-5554"}
        assert calls == [
            ["/fake/adapter", "resume-owned", "emulator-5554"],
            ["/fake/adapter", "release", "emulator-5554", "opaque-token"],
        ]


def _documented_lease_block() -> str:
    document = (ROOT / "docs/release.md").read_text(encoding="utf-8")
    section = document.split(
        "The release profile stage requires a running **Android TV emulator**",
        1,
    )[1]
    return section.split("```bash\n", 1)[1].split("\n```", 1)[0]


def test_documented_lease_block_executes_checked_inventory_and_exact_release() -> None:
    block = _documented_lease_block()
    assert 'acquire-any' not in block
    assert block.count('resume-owned') == 1
    document = (ROOT / "docs/release.md").read_text()
    assert "fresh acquisition only" in document and "resume only the descriptor-safe workflow" in document
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        adapter = root / ".kent/adapters/mobile/emulator-resource-lock.sh"
        adapter.parent.mkdir(parents=True)
        log = root / "effects.jsonl"
        adapter.write_text("""#!/usr/bin/env python3
import json, os, sys
from pathlib import Path
args = sys.argv[1:]
with Path(os.environ["DOC_LOG"]).open("a") as f: f.write(json.dumps(args) + "\\n")
mode = os.environ["DOC_MODE"]
if args == ["adb-emulators", "tv"]:
    inventories = {"empty":"", "duplicate":"emulator-5554\\nemulator-5554\\n", "malformed":"emulator-5554 extra\\n", "blank":"emulator-5554\\n\\n", "absent":"emulator-5556\\n"}
    sys.stdout.write(inventories.get(mode, "emulator-5554\\nemulator-5556\\n"))
elif args == ["acquire", "emulator-5554", "900", "7200"]:
    if mode == "acquire_failed": sys.exit(1)
    sys.stdout.write({"missing_token":"", "malformed_ack":"token=oops\\n", "multiple":"first\\nsecond\\n"}.get(mode, "doc-token\\n"))
elif args == ["resume-owned", "emulator-5554"]:
    print("recovered-token")
elif args[0] == "release":
    if mode == "release_failed": sys.exit(1)
else: sys.exit(2)
""")
        adapter.chmod(0o755)
        generator = root / "tools/generate-baseline-profile.sh"
        generator.parent.mkdir()
        generator.write_text("""#!/usr/bin/env python3
import json, os, sys
from pathlib import Path
with Path(os.environ["DOC_LOG"]).open("a") as f: f.write(json.dumps(["generator", os.environ["ANDROID_SERIAL"]]) + "\\n")
if os.environ["DOC_MODE"] == "generator_failed": sys.exit(1)
""")
        generator.chmod(0o755)
        def execute(mode, serial="emulator-5554"):
            log.unlink(missing_ok=True)
            result = subprocess.run(["bash", "-c", block], cwd=root, text=True, capture_output=True,
                env={**os.environ, "KENT_TASK_ID":state()["task_id"], "DEVICE_SERIAL":serial, "DOC_LOG":str(log), "DOC_MODE":mode})
            return result, [json.loads(line) for line in log.read_text().splitlines()] if log.exists() else []
        inventory = ["adb-emulators", "tv"]
        acquire = ["acquire", "emulator-5554", "900", "7200"]
        for serial in ("", "physical-123", "emulator-5554 extra"):
            result, calls = execute("success", serial)
            assert result.returncode and calls == [], (result.stderr, calls)
        for mode in ("empty", "duplicate", "malformed", "blank", "absent"):
            result, calls = execute(mode)
            assert result.returncode and calls == [inventory], (mode, result.stderr, calls)
        result, calls = execute("success")
        assert result.returncode == 0, result.stderr
        assert calls == [inventory, acquire, ["generator", "emulator-5554"], ["release", "emulator-5554", "doc-token"]], calls
        for mode in ("missing_token", "malformed_ack", "multiple"):
            result, calls = execute(mode)
            assert result.returncode and calls == [inventory, acquire, ["resume-owned", "emulator-5554"], ["release", "emulator-5554", "recovered-token"]], (mode, calls, result.stderr)
        for mode in ("generator_failed", "release_failed"):
            result, calls = execute(mode)
            assert result.returncode and calls[-1] == ["release", "emulator-5554", "doc-token"]
        result, calls = execute("acquire_failed")
        assert result.returncode and calls == [inventory, acquire]
        # A standalone invocation never consumes a prior checkpoint or resumes its lease.
        # Such recovery belongs to the workflow Script, not this fresh-acquire recipe.
        checkpoint = root / ".kent/runtime/PUB-99/release-profile-checkpoint.json"
        checkpoint.parent.mkdir(parents=True)
        checkpoint.write_bytes(b"prior checkpoint is not standalone recovery authority")
        original = checkpoint.read_bytes()
        result, calls = execute("success")
        assert result.returncode == 0 and calls[1] == acquire
        assert not any(call[0] == "resume-owned" for call in calls)
        assert checkpoint.read_bytes() == original


def test_descriptor_store_adversarial_matrix() -> None:
    from unittest.mock import patch
    helper = module.helper
    def blocked(call):
        try: call()
        except (helper.ContractError, OSError): return
        raise AssertionError("unsafe checkpoint operation was accepted")
    def value():
        return {"schema": module.CHECKPOINT_SCHEMA,
            **{k: state()[k] for k in ("task_id", "task_short_id", "operation_id", "release_branch", "release_base_oid", "candidate_oid")},
            "release_head_oid":"", "candidate_serials":["emulator-5554"], "state":"acquiring", "resource_serial":"",
            "profile_report":"", "profile_report_digest":"", "release_preparation_report":"", "release_preparation_report_digest":"",
            "output_hashes":{p:"d"*64 for p in module.PROFILE_PATHS}}
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / ".kent").mkdir()
        helper.write_profile_checkpoint(root, "PUB-99", value())
        path = root / ".kent/runtime/PUB-99/release-profile-checkpoint.json"
        raw = path.read_bytes()
        _, receipt = helper.read_profile_checkpoint(root, "PUB-99", with_receipt=True)
        for component in (root / ".kent", root / ".kent/runtime", path.parent, path):
            saved = component.with_name(component.name + "-saved")
            component.rename(saved)
            component.symlink_to(saved, target_is_directory=saved.is_dir())
            try:
                blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
                blocked(lambda: helper.write_profile_checkpoint(root, "PUB-99", value()))
                blocked(lambda: helper.delete_profile_checkpoint(root, "PUB-99", receipt))
                assert path.read_bytes() == raw
            finally:
                component.unlink(); saved.rename(component)
        for component in (root, root / ".kent", root / ".kent/runtime", path.parent):
            mode = stat.S_IMODE(component.stat().st_mode)
            component.chmod(0o777)
            blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
            blocked(lambda: helper.write_profile_checkpoint(root, "PUB-99", value()))
            component.chmod(mode)
        for component in (root / ".kent", root / ".kent/runtime", path.parent):
            saved = component.with_name(component.name + "-saved")
            component.rename(saved); component.write_text("unrelated")
            blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
            assert component.read_text() == "unrelated"
            component.unlink(); saved.rename(component)
        # Receipt rejects an identical-byte replacement inode and leaves it intact.
        replacement = path.with_name("replacement")
        replacement.write_bytes(raw); replacement.chmod(0o600); os.replace(replacement, path)
        replaced = path.stat().st_ino
        blocked(lambda: helper.delete_profile_checkpoint(root, "PUB-99", receipt))
        assert path.read_bytes() == raw and path.stat().st_ino == replaced
        _, receipt = helper.read_profile_checkpoint(root, "PUB-99", with_receipt=True)
        saved = path.parent.with_name("PUB-99-old")
        path.parent.rename(saved); path.parent.mkdir(mode=0o700)
        path.write_bytes(raw); path.chmod(0o600)
        blocked(lambda: helper.delete_profile_checkpoint(root, "PUB-99", receipt))
        assert path.read_bytes() == raw
        for mode in (0o644, 0o400, 0o666):
            path.chmod(mode); blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
        path.chmod(0o600)
        linked = path.with_name("hardlink")
        os.link(path, linked)
        blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
        linked.unlink()
        for make in (lambda: os.mkfifo(path, 0o600), lambda: path.mkdir()):
            path.unlink(); make()
            blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
            if path.is_dir(): path.rmdir()
            else: path.unlink()
            path.write_bytes(raw); path.chmod(0o600)
        malformed = [b"{}", b'{"schema":1,"schema":2}', b'{"x":NaN}', b'{"x":1e999}',
            b'{"x":' + b'[' * 40 + b'0' + b']' * 40 + b'}', b'!' * (helper.CHECKPOINT_LIMIT + 1),
            raw.replace(b'checkpoint_v2', b'checkpoint_v1')]
        for invalid in malformed:
            path.write_bytes(invalid)
            blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
            blocked(lambda: helper.write_profile_checkpoint(root, "PUB-99", value()))
            assert path.read_bytes() == invalid
        path.write_bytes(raw)
        # Deterministic owner and in-read identity drift without chown or devices.
        real_fstat = os.fstat
        def foreign(fd):
            result = real_fstat(fd)
            fields = list(result); fields[4] = os.getuid() + 1
            return os.stat_result(fields)
        with patch.object(helper.os, "fstat", side_effect=foreign):
            blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
        real_read = os.read
        changed = False
        def drift(fd, count):
            nonlocal changed
            data = real_read(fd, count)
            if not changed:
                changed = True
                with path.open("ab") as stream: stream.write(b" ")
            return data
        with patch.object(helper.os, "read", side_effect=drift):
            blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
        path.write_bytes(raw)
        unrelated = path.with_name("unrelated"); unrelated.write_bytes(b"preserve")
        for name in ("replace", "fsync", "fdopen"):
            with patch.object(helper.os, name, side_effect=OSError("injected interrupted write")):
                blocked(lambda: helper.write_profile_checkpoint(root, "PUB-99", value()))
            assert path.read_bytes() == raw and unrelated.read_bytes() == b"preserve"
            assert not list(path.parent.glob(".release-profile-*.tmp"))
        real_fsync = os.fsync
        def fail_directory_fsync(fd):
            if stat.S_ISDIR(real_fstat(fd).st_mode): raise OSError("directory fsync failed after replace")
            return real_fsync(fd)
        with patch.object(helper.os, "fsync", side_effect=fail_directory_fsync):
            blocked(lambda: helper.write_profile_checkpoint(root, "PUB-99", value()))
        # A failed durability acknowledgement may leave a complete canonical postimage,
        # never a partial checkpoint or success receipt.
        assert helper.read_profile_checkpoint(root, "PUB-99") == value()
        assert path.read_bytes() == raw and unrelated.read_bytes() == b"preserve"
        real_open = os.open
        def swap_parent(name, flags, *args, **kwargs):
            fd = real_open(name, flags, *args, **kwargs)
            if name == helper.CHECKPOINT_BASENAME:
                parent = path.parent
                parent.rename(parent.with_name("PUB-99-swapped"))
                parent.mkdir(mode=0o700)
                path.write_bytes(raw); path.chmod(0o600)
            return fd
        with patch.object(helper.os, "open", side_effect=swap_parent):
            blocked(lambda: helper.read_profile_checkpoint(root, "PUB-99"))
        assert path.read_bytes() == raw
        _, receipt = helper.read_profile_checkpoint(root, "PUB-99", with_receipt=True)
        helper.delete_profile_checkpoint(root, "PUB-99", receipt)
        assert not path.exists()
        assert (path.parent.with_name("PUB-99-swapped") / "unrelated").read_bytes() == b"preserve"


