        attempted = []

        def interleave(*args, **kwargs):
            destination = args[0] if operation == "unlink" else args[1]
            if destination == mod.CHECKPOINT_BASENAME and not attempted:
                attempted.append(True)
                try:
                    mod.write_profile_checkpoint(
