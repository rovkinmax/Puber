    class ProviderRetryBlocked(Exception):
        def __init__(self, state: str) -> None:
            self.state = state
            super().__init__("private provider diagnostic must not escape")


    class FakeDelivery:
        GitHubProviderRetryBlocked = ProviderRetryBlocked

        def __init__(
            self,
            *,
            block: str | None = None,
            source_admission_error: Exception | None = None,
        ) -> None:
            self.block = block
            self.source_admission_error = source_admission_error
            self.calls = []

        def admit_script_source_ingress(self, root, native_context, *, kent_path):
            self.calls.append(
                ("source-admission", root, native_context, kent_path)
            )
            if self.source_admission_error is not None:
                raise self.source_admission_error
            return SimpleNamespace(
                project_id=mod.PROJECT_ID,
                workflow_id=mod.WORKFLOW_ID,
                project_root="/fixture/primary",
                source_admission_sha256="f" * 64,
                receipt_sha256="e" * 64,
                gate="legacy",
            )

        def producer_locator(self, commentary):
            self.calls.append(("locator", commentary))
            if "invalid-footer" in commentary or "duplicate-footer" in commentary:
                raise ValueError("invalid or duplicate producer footer")
            return (
                "build/kent-workflow/PUB-99/packets/base-" + "a" * 64 + ".json"
                if "Kent producer packet:" in commentary
                else None
            )

        def observe_script_identity(self, root, task, native_context, *, native_read):
            self.calls.append(("identity", root, task, native_context, native_read))
            return {
                "task_short_id": task,
                "node_id": native_context["node_id"],
                "invocation_kind": "script",
            }

        def require_github_provider_read(self, root, refs, identity):
            self.calls.append(("provider", root, refs, identity))
            if self.block:
                raise ProviderRetryBlocked(self.block)


    class EmissionStdout(io.StringIO):
        @property
        def buffer(self):
            return self

        def write(self, value):
            if isinstance(value, bytes):
                value = value.decode("utf-8")
            return super().write(value)


    # Ordinary Script fallback must not forward untrusted transport commentary.
