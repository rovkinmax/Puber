                else:
                    concurrency_failures.append(operation)
            return original_operation(*args, **kwargs)

        with patch.object(mod.os, operation, side_effect=interleave):
            if operation == "unlink":
                mod.delete_profile_checkpoint(
                    checkpoint_root, "PUB-99", old_receipt
                )
            else:
                mod.write_profile_checkpoint(
                    checkpoint_root, "PUB-99", checkpoint_value
