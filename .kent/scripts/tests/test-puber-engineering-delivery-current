            rejected(run_admission({"_kent": native_context}))
            kit_operation.write_bytes(operation_before)
            kit_operation.chmod(operation_mode)

            # Later Script uses the real later-node path through the same native
            # frame; the Kit facade delegates to admit_source_admission.
            plan_contract = next(
                node for node in graph["nodes"] if node["key"] == "plan_contract"
            )
            later_script_path = plan_contract["script_path"]
            later_node_context = {
                "task_id": TASK_ID,
                "node_id": plan_contract["id"],
            }
            task = json.loads(original_task)
            task["current_scripts"] = [{
                "current_node": {
                    "node_id": plan_contract["id"],
                    "transition_branch_key": None,
                },
                "path": later_script_path,
            }]
            task_path.write_bytes(canonical(task))
            child = (
                "import importlib.machinery,importlib.util,json,sys; "
                "from pathlib import Path; "
                f"p=Path({str(fixture.project)!r}); "
                f"b=p/'.kent/scripts/workflow_kit_runtime.py'; "
                "l=importlib.machinery.SourceFileLoader('later_runtime',str(b)); "
