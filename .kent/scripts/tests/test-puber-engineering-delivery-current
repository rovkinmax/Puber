def classify_release_cohort(
    actual_bytes: dict[str, bytes],
    historical_bytes: dict[str, bytes],
    mobile_bytes: dict[str, bytes],
) -> str:
    expected_paths = set(RELEASE_COHORT_PATHS)
    cohorts = {
        "historical": historical_bytes,
        "mobile": mobile_bytes,
    }
    if set(actual_bytes) != expected_paths:
        raise AssertionError("Release cohort is missing or contains unexpected paths")
    if any(set(cohort_bytes) != expected_paths for cohort_bytes in cohorts.values()):
        raise AssertionError("Release cohort definition is incomplete")
    if cohorts["historical"] == cohorts["mobile"]:
        raise AssertionError("Release cohorts are not uniquely distinguishable")
    matches = [
        name for name, cohort_bytes in cohorts.items()
        if actual_bytes == cohort_bytes
    ]
    if len(matches) != 1:
        raise AssertionError("Release files are not one exact, coherent byte cohort")
    return matches[0]


