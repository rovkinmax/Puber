    def test_publication_ancestry_and_exact_runtime_in_disposable_fixture(self):
        with fixture_repositories() as create:
            kit = create("kit")
            base = kit.parent
            command("git", "clone", "--shared", "--no-checkout", str(KIT_ROOT), str(kit))
            git(kit, "config", "user.email", "fixture@example.invalid")
            git(kit, "config", "user.name", "Disposable fixture")
            git(kit, "config", "core.hooksPath", os.devnull)
            git(kit, "checkout", "--detach", KIT_COMMIT)
            kit_bootstrap = kit / "workflowkit/kit_runtime.py"
            kit_bootstrap.chmod(0o600)
            git(kit, "commit", "--allow-empty", "-qm", "Published descendant")
            descendant = git(kit, "rev-parse", "HEAD")
            git(kit, "update-ref", "refs/remotes/origin/main", descendant)
            git(kit, "checkout", "--detach", KIT_COMMIT)
            builder = module_from_bootstrap(BUILDER_PATH, "puber_builder_fixture")
            builder.KIT_ROOT = kit
            builder.PROFILE = base / "profile.toml"
            builder.PROFILE.write_text(
                (ROOT / ".kent/workflow-profile.toml").read_text().replace(str(KIT_ROOT), str(kit)),
                encoding="utf-8",
            )
            builder.BOOTSTRAP = base / "bootstrap.py"
            shutil.copy2(ROOT / ".kent/scripts/workflow_kit_runtime.py", builder.BOOTSTRAP)
            # Qualification inspects loaded module provenance too. Do not borrow
            # workflowkit modules from another test's retained source root.
            loaded = {key: sys.modules.pop(key) for key in tuple(sys.modules)
                      if key == "workflowkit" or key.startswith("workflowkit.")}
            try:
                builder.qualify_inputs()  # Published descendant; runtime still exact K.
                with mock.patch.dict(os.environ, {
                    "GIT_DIR": str(ROOT / ".git"), "GIT_WORK_TREE": str(ROOT),
                    "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "core.hooksPath",
                    "GIT_CONFIG_VALUE_0": "/nonexistent/foreign-hooks",
                }):
                    builder.qualify_inputs()
                git(kit, "update-ref", "-d", builder.KIT_REF)
                with self.assertRaises(ValueError):
                    builder.qualify_inputs()
                unrelated = git(
                    kit, "commit-tree", git(kit, "rev-parse", "HEAD^{tree}"),
                    "-m", "Unrelated publication",
                )
                git(kit, "update-ref", builder.KIT_REF, unrelated)
                with self.assertRaises(ValueError):
                    builder.qualify_inputs()
                git(kit, "replace", unrelated, descendant)
                with self.assertRaises(ValueError):
                    builder.qualify_inputs()
                git(kit, "replace", "-d", unrelated)
                git(kit, "update-ref", builder.KIT_REF, descendant)
                git(kit, "checkout", "--detach", descendant)
                with self.assertRaises(ValueError):
                    builder.qualify_inputs()
                git(kit, "checkout", "--detach", KIT_COMMIT)
                dirty = kit / "unexpected-source"
                dirty.write_text("dirty\n", encoding="utf-8")
                with self.assertRaises(ValueError):
                    builder.qualify_inputs()
                dirty.unlink()
                for path, mode in ((builder.BOOTSTRAP, 0o755), (kit_bootstrap, 0o644)):
                    original = stat.S_IMODE(path.stat().st_mode)
                    path.chmod(mode)
                    with self.assertRaises(ValueError):
                        builder.qualify_inputs()
                    path.chmod(original)
                for path in (builder.BOOTSTRAP, kit_bootstrap):
                    original = path.read_bytes()
                    path.write_bytes(original + b"\n")
                    with self.assertRaises(ValueError):
                        builder.qualify_inputs()
                    path.write_bytes(original)
                builder.qualify_inputs()
            finally:
                sys.modules.update(loaded)

