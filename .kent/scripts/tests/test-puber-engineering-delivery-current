            # A later Agent has no Script carrier of its own; it must resolve
            # the same published ingress through its native Session/Task graph.
            agent = next(node for node in graph["nodes"] if node["key"] == "plan")
            task = json.loads(original_task)
            task["current_scripts"] = []
            task["current_nodes"] = [{
