def canonical(value: object) -> bytes:
    return json.dumps(
        value, ensure_ascii=False, sort_keys=True,
        separators=(",", ":"), allow_nan=False,
    ).encode("utf-8")


def command(*args: str, cwd: Path = ROOT, env=None) -> str:
    if args[0] == "git":
        env = {
            **{key: value for key, value in (os.environ if env is None else env).items()
               if not key.startswith("GIT_")},
            "GIT_OPTIONAL_LOCKS": "0", "GIT_TERMINAL_PROMPT": "0",
            "GIT_NO_REPLACE_OBJECTS": "1", "GIT_NO_LAZY_FETCH": "1",
            "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_SYSTEM": os.devnull,
            "GIT_CONFIG_GLOBAL": os.devnull,
        }
        if args[1] == "clone":
            confined_fixture_root(Path(args[-1]))
        args = (
            "git", "--no-replace-objects", "-c", f"core.hooksPath={os.devnull}",
            "-c", "core.fsmonitor=false", "-c", "protocol.allow=never",
            "-c", "protocol.file.allow=always", "-c", "gc.auto=0", *args[1:],
        )
    result = subprocess.run(
        list(args), cwd=cwd, env=env, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, text=True, check=False, timeout=120,
    )
    if result.returncode:
        raise AssertionError(
            f"command failed ({result.returncode}): {args}\n"
            f"stdout:\n{result.stdout}\nstderr:\n{result.stderr}"
        )
    return result.stdout.strip()


OWNED_FIXTURE_ROOTS: set[Path] = set()


@contextmanager
def fixture_repositories():
    with tempfile.TemporaryDirectory() as directory:
        base = Path(directory).resolve()
        registered = set()

        def create(name):
            if Path(name).name != name or name in {".", ".."}:
                raise AssertionError("fixture repository requires a single directory name")
            root = base / name
            root.mkdir()
            OWNED_FIXTURE_ROOTS.add(root)
            registered.add(root)
            return root

        try:
            yield create
        finally:
            OWNED_FIXTURE_ROOTS.difference_update(registered)


def confined_fixture_root(root: Path) -> Path:
    canonical = root.resolve()
    if canonical.is_relative_to(ROOT.resolve()) or canonical.is_relative_to(KIT_ROOT.resolve()):
        raise AssertionError("source repositories cannot be fixture write targets")
    if canonical not in OWNED_FIXTURE_ROOTS:
        raise AssertionError("fixture writes require an owned registered repository")
    if (canonical / ".git").is_symlink():
        raise AssertionError("fixture Git directory cannot be a symlink")
    return canonical


def git(root: Path, *args: str) -> str:
    if args[0] not in {"ls-files", "ls-tree", "rev-parse", "status", "show"}:
        canonical = confined_fixture_root(root)
        if args[0] == "init" and (canonical / ".git").exists():
            raise AssertionError("fixture init cannot reinitialize an existing Git directory")
        if args[0] != "init":
            if not (canonical / ".git").is_dir():
                raise AssertionError("fixture writes require a private Git directory")
            top = command("git", "-C", str(root), "rev-parse", "--show-toplevel", cwd=root)
            directory = command("git", "-C", str(root), "rev-parse", "--absolute-git-dir", cwd=root)
            if Path(top).resolve() != canonical or Path(directory).resolve() != canonical / ".git":
                raise AssertionError("fixture write target escaped its disposable repository")
    return command("git", "-C", str(root), *args, cwd=root)


def source_paths(root: Path) -> list[str]:
    return git(root, "ls-files", "-z").split("\0")[:-1]


def infrastructure_path(path: str, *, kit: bool) -> bool:
    if "__pycache__" in Path(path).parts:
        return False
    if kit:
        return path.startswith((
            "scripts/", "workflowkit/", "templates/", "agents/", "global/",
            "prompts/", "skills/", "adapters/", "contracts/",
        ))
    return (
        path in {
            "AGENTS.md", ".gitignore", ".kent/workflow-profile.toml",
            ".kent/project-contract.md",
        }
        or path.startswith((
            ".kent/scripts/", ".kent/commands/", ".kent/context/",
            ".kent/skills/", ".kent/workflows/",
        ))
    )


def tracked_mode(root: Path, revision: str, path: str) -> int:
    record = command(
        "git", "-C", str(root), "ls-tree", revision, "--", path, cwd=root,
    )
    mode = record.split(" ", 1)[0]
    return 0o755 if mode == "100755" else 0o644


