def release_snapshot(
    candidate_root: Path = ROOT,
    release_manifest_bytes: bytes | None = None,
) -> dict[str, tuple[str, int]]:
    snapshot = {}
    actual_cohort_bytes = {}
    expected_historical_bytes = {}
    expected_mobile_bytes = {}
    streaming_inputs = {
        ".kent/scripts/workflow-puber-release-intent",
        ".kent/scripts/workflow_runtime_contracts.py",
        ".kent/workflows/builders/puber_release_current.py",
    }
    for relative in PRESERVED_RELEASE_PATHS:
        if relative in RELEASE_COHORT_PATHS:
            expected_bytes = historical_release_bytes(relative)
        else:
            expected = subprocess.run(
                ["git", "-C", str(ROOT), "show", f"{BASE_COMMIT}:{relative}"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
            )
            if expected.returncode:
                raise AssertionError(f"published Release source is absent: {relative}")
            expected_bytes = expected.stdout
        current = candidate_root / relative
        current_bytes = current.read_bytes()
        snapshot[relative] = (
            hashlib.sha256(current_bytes).hexdigest(),
            stat.S_IMODE(current.stat().st_mode),
        )
        if relative == ".kent/scripts/workflow_kit_runtime.py":
            expected_bytes = (KIT_ROOT / "workflowkit/kit_runtime.py").read_bytes()
        elif relative == ".kent/workflows/puber-release-current.manifest.json":
            expected_bytes = (
                expected_release_manifest_bytes()
                if release_manifest_bytes is None
                else release_manifest_bytes
            )
        # The separately approved streaming source package owns these Release
        # integration inputs. Engineering still snapshots their actual bytes
        # and modes before/after its operations; it must not revert that package
        # to the older Engineering baseline. Package suites validate their API,
        # canonical copy and full source closure independently.
        if relative in RELEASE_COHORT_PATHS:
            expected_historical_bytes[relative] = expected_bytes
            expected_mobile_bytes[relative] = mobile_release_bytes(
                relative,
                expected_bytes,
            )
            actual_cohort_bytes[relative] = current_bytes
        elif relative not in streaming_inputs:
            assert_exact_bytes(current_bytes, expected_bytes, relative)
        current_mode = stat.S_IMODE(current.stat().st_mode)
        assert bool(current_mode & 0o111) == bool(
            tracked_mode(ROOT, BASE_COMMIT, relative) & 0o111
        ), relative
    cohort = classify_release_cohort(
        actual_cohort_bytes,
        expected_historical_bytes,
        expected_mobile_bytes,
    )
    return snapshot


