    def test_release_cohorts_are_exact_and_preserve_negative_guards(self):
        historical_bytes = {
            relative: historical_release_bytes(relative)
            for relative in RELEASE_COHORT_PATHS
        }
        mobile_bytes = {
            relative: mobile_release_bytes(relative, historical_bytes[relative])
            for relative in RELEASE_COHORT_PATHS
        }
        historical_hashes = {
            relative: hashlib.sha256(raw).hexdigest()
            for relative, raw in historical_bytes.items()
        }
        mobile_hashes = {
            relative: hashlib.sha256(raw).hexdigest()
            for relative, raw in mobile_bytes.items()
        }
        self.assertEqual(historical_hashes, HISTORICAL_RELEASE_SHA256)
        self.assertEqual(mobile_hashes, MOBILE_RELEASE_SHA256)
        self.assertEqual(
            classify_release_cohort(
                historical_bytes, historical_bytes, mobile_bytes,
            ),
            "historical",
        )
        self.assertEqual(
            classify_release_cohort(mobile_bytes, historical_bytes, mobile_bytes),
            "mobile",
        )

        graph_path = ".kent/workflows/puber-release-current.json"
        for revision in (97, 98, 100):
            observed = dict(mobile_bytes)
            observed[graph_path] = replace_unique(
                mobile_bytes[graph_path],
                b"    \"version\": 99,\n",
                f"    \"version\": {revision},\n".encode("ascii"),
            )
            with self.subTest(unqualified_mobile_native_revision=revision):
                with self.assertRaises(AssertionError):
                    classify_release_cohort(
                        observed, historical_bytes, mobile_bytes,
                    )

        # A partial historical/mobile mixture is never a third accepted cohort.
        for mask in range(1 << len(RELEASE_COHORT_PATHS)):
            observed = {
                relative: (
                    mobile_bytes[relative]
                    if mask & (1 << index)
                    else historical_bytes[relative]
                )
                for index, relative in enumerate(RELEASE_COHORT_PATHS)
            }
            if mask in {0, (1 << len(RELEASE_COHORT_PATHS)) - 1}:
                expected = "historical" if mask == 0 else "mobile"
                self.assertEqual(
                    classify_release_cohort(
                        observed, historical_bytes, mobile_bytes,
                    ),
                    expected,
                )
            else:
                with self.subTest(mixed_cohort=mask):
                    with self.assertRaises(AssertionError):
                        classify_release_cohort(
                            observed, historical_bytes, mobile_bytes,
                        )

        missing = dict(historical_bytes)
        missing.pop(RELEASE_COHORT_PATHS[0])
        extra = {
            **historical_bytes,
            "unexpected-release-file": b"not an approved Release input",
        }
        for invalid in (missing, extra):
            with self.assertRaises(AssertionError):
                classify_release_cohort(
                    invalid, historical_bytes, mobile_bytes,
                )

        profile_path = ".kent/workflow-profile.toml"
        profile_bytes = historical_bytes[profile_path]
        normalized_root = b"archive-published-2708-456"
        with self.assertRaises(AssertionError):
            replace_unique(profile_bytes, b"missing-kit-root", b"replacement")
        with self.assertRaises(AssertionError):
            replace_unique(profile_bytes + normalized_root, normalized_root, b"replacement")

        # An unrelated Kit pin or any extra graph/spec byte must not be
        # normalized into either accepted cohort.
        drift_cases = {
            profile_path: replace_unique(
                profile_bytes,
                KIT_COMMIT.encode("ascii"),
                b"0" * 40,
            ),
            ".kent/workflows/puber-release-current.json":
                historical_bytes[".kent/workflows/puber-release-current.json"] + b"\n",
            ".kent/workflows/specs/puber-release-current.toml":
                historical_bytes[".kent/workflows/specs/puber-release-current.toml"] + b"\n",
        }
        for relative, drifted_bytes in drift_cases.items():
            observed = dict(historical_bytes)
            observed[relative] = drifted_bytes
            with self.subTest(unrelated_drift=relative):
                with self.assertRaises(AssertionError):
                    classify_release_cohort(
                        observed, historical_bytes, mobile_bytes,
                    )

        # Exercise the real preservation path against a private source copy:
        # exact noncohort inputs reject content/mode drift, while the explicitly
        # streamed inputs are detected by the before/after byte+mode snapshot.
        with tempfile.TemporaryDirectory() as directory:
            candidate_root = Path(directory) / "candidate"
            copy_source_tree(ROOT, candidate_root, list(PRESERVED_RELEASE_PATHS))
            manifest_bytes = expected_release_manifest_bytes()
            before = release_snapshot(candidate_root, manifest_bytes)

            exact_path = candidate_root / ".kent/scripts/workflow-puber-release-ci"
            exact_bytes = exact_path.read_bytes()
            exact_path.write_bytes(exact_bytes + b"\n")
            with self.assertRaises(AssertionError):
                release_snapshot(candidate_root, manifest_bytes)
            exact_path.write_bytes(exact_bytes)

            exact_mode = stat.S_IMODE(exact_path.stat().st_mode)
            exact_path.chmod(exact_mode & ~0o111)
            with self.assertRaises(AssertionError):
                release_snapshot(candidate_root, manifest_bytes)
            exact_path.chmod(exact_mode)
            assert_snapshot_unchanged(
                before,
                release_snapshot(candidate_root, manifest_bytes),
            )

            streamed_path = (
                candidate_root / ".kent/scripts/workflow-puber-release-intent"
            )
            streamed_bytes = streamed_path.read_bytes()
            streamed_path.write_bytes(streamed_bytes + b"\n")
            after_stream_drift = release_snapshot(candidate_root, manifest_bytes)
            with self.assertRaises(AssertionError):
                assert_snapshot_unchanged(before, after_stream_drift)
            streamed_path.write_bytes(streamed_bytes)

            cohort_path = candidate_root / profile_path
            cohort_mode = stat.S_IMODE(cohort_path.stat().st_mode)
            cohort_path.chmod(0o600 if cohort_mode != 0o600 else 0o644)
            after_mode_drift = release_snapshot(candidate_root, manifest_bytes)
            with self.assertRaises(AssertionError):
                assert_snapshot_unchanged(before, after_mode_drift)
            cohort_path.chmod(cohort_mode)
            assert_snapshot_unchanged(
                before,
                release_snapshot(candidate_root, manifest_bytes),
            )

