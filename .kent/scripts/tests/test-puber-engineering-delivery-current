    def test_candidate_is_deterministic_and_preserves_native_graph(self):
        before_release = release_snapshot()
        builder = runpy.run_path(str(BUILDER_PATH))
        expected = builder["candidate_bytes"]()
        self.assertEqual(expected, CANDIDATE_PATH.read_bytes())
        self.assertEqual(builder["candidate_bytes"](), expected)

        frozen = json.loads(FIXTURE_PATH.read_text(encoding="utf-8"))
        candidate = json.loads(CANDIDATE_PATH.read_text(encoding="utf-8"))
        original = frozen["graph"]
        graph = candidate["graph"]
        self.assertEqual(frozen["workflow_id"], WORKFLOW_ID)
        self.assertEqual(frozen["expected_version"], 13)
        self.assertEqual(candidate["activation_status"], "UNACTIVATED")
        self.assertEqual(candidate["workflow_id"], WORKFLOW_ID)
        self.assertEqual(candidate["expected_version"], 13)
        self.assertEqual(
            candidate["baseline_fixture_sha256"],
            hashlib.sha256(FIXTURE_PATH.read_bytes()).hexdigest(),
        )
        self.assertEqual(
            candidate["baseline_prefix_sha256"],
            builder["prefix_digest"](original),
        )
        self.assertEqual(
            (len(graph["nodes"]), len(graph["edges"]), len(graph["transition_groups"])),
            (32, 105, 103),
        )
        self.assertEqual(
            {edge["key"] for edge in graph["edges"]} - {edge["key"] for edge in original["edges"]},
            NEW_TRANSITIONS | {"engineering_source_admitted"},
        )

        nodes = {node["key"]: node for node in graph["nodes"]}
        old_nodes = {node["key"]: node for node in original["nodes"]}
        for key, node in old_nodes.items():
            self.assertEqual((nodes[key]["id"], nodes[key]["kind"]), (node["id"], node["kind"]), key)
        self.assertEqual(nodes["engineering_source_admission"]["kind"], "script")
        self.assertEqual(
            nodes["engineering_source_admission"]["script_path"],
            ".kent/scripts/workflow-puber-engineering-admission",
        )

        edges = {edge["key"]: edge for edge in graph["edges"]}
        old_edges = {edge["key"]: edge for edge in original["edges"]}
        for key, edge in old_edges.items():
            self.assertEqual(edges[key]["id"], edge["id"], key)
            self.assertEqual(
                edges[key].get("requires_approval", False),
                edge.get("requires_approval", False),
                key,
            )
        groups = {group["id"]: group for group in graph["transition_groups"]}
        self.assertTrue(
            {group["id"] for group in original["transition_groups"]} <= set(groups)
        )
        self.assertEqual(edges["start_plan"]["id"], INGRESS_EDGE_ID)
        self.assertEqual(edges["start_plan"]["transition_group_id"], INGRESS_GROUP_ID)
        self.assertEqual(edges["start_plan"]["target_node_id"], nodes["engineering_source_admission"]["id"])
        self.assertNotIn("prompt_template", edges["start_plan"])
        self.assertNotIn("parameters", edges["start_plan"])
        self.assertEqual(edges["start_plan"]["requires_approval"], False)
        self.assertEqual(edges["engineering_source_admitted"]["target_node_id"], nodes["plan"]["id"])
        self.assertEqual(edges["engineering_source_admitted"]["requires_approval"], False)
        self.assertEqual(edges["engineering_source_admitted"]["context_mode"], "new_session")
        self.assertEqual(edges["engineering_source_admitted"]["context_source"], {"kind": "immediate_source"})
        self.assertNotIn(
            "SANITIZED LEGACY INITIAL ADMISSION HEADER",
            edges["engineering_source_admitted"].get("prompt_template", ""),
        )
        self.assertTrue(edges["engineering_source_admitted"].get("prompt_template"))
        self.assertTrue(edges["prepare_pr_fix"]["requires_approval"])
        self.assertFalse(any(
            group["source_node_id"] == nodes["backlog"]["id"]
            and edge["target_node_id"] == nodes["plan"]["id"]
            for edge in graph["edges"]
            for group in [groups[edge["transition_group_id"]]]
        ))

        # Parameter-key changes and same-key description changes are distinct
        # compatibility inputs and remain visible in the reviewed projection.
        changed_keys = []
        changed_definitions = []
        same_keys_changed_definitions = []
        for key, old in old_edges.items():
            new = edges[key]
            old_parameters = old.get("parameters", [])
            new_parameters = new.get("parameters", [])
            old_keys = [row["key"] for row in old_parameters]
            new_keys = [row["key"] for row in new_parameters]
            if old_keys != new_keys:
                changed_keys.append(key)
            if old_parameters != new_parameters:
                changed_definitions.append(key)
                if old_keys == new_keys:
                    same_keys_changed_definitions.append(key)
        self.assertEqual((len(changed_keys), len(changed_definitions), len(same_keys_changed_definitions)), (24, 74, 50))

        candidate_text = CANDIDATE_PATH.read_text(encoding="utf-8")
        for forbidden in (
            "f993", "527830", "delivery-script-ingress-ref-v1",
            "delivery-source-publication-v1", "execution_target_policy",
            '"custom_ref"', '"source_admission"',
        ):
            self.assertNotIn(forbidden, candidate_text)
        self.assertEqual(release_snapshot(), before_release)

