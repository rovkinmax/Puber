            copy_source_tree(ROOT, root, sorted(ALLOWLIST))
            executable = root / ADMISSION_PATH.relative_to(ROOT)
            document = root / DOC_PATH.relative_to(ROOT)
            for script_mode, data_mode in ((0o700, 0o600), (0o755, 0o644)):
                executable.chmod(script_mode)
                document.chmod(data_mode)
                self.assert_source_shape(root)
            for path, modes in ((executable, (0o600, 0o777, 0o775, 0o4755)),
                                (document, (0o755, 0o666, 0o664, 0o1644))):
                original = stat.S_IMODE(path.stat().st_mode)
                for mode in modes:
                    with self.subTest(path=path.name, mode=oct(mode)):
                        path.chmod(mode)
                        with self.assertRaises(AssertionError):
                            self.assert_source_shape(root)
                path.chmod(original)
            document.unlink()
            with self.assertRaises(AssertionError):
                self.assert_source_shape(root)
            document.symlink_to(DOC_PATH)
            with self.assertRaises(AssertionError):
                self.assert_source_shape(root)

    @staticmethod
    def source_snapshot(root):
        return (
            git(root, "rev-parse", "HEAD"),
            git(root, "status", "--porcelain=v1", "--untracked-files=all"),
            {str(path.relative_to(root)): (
                hashlib.sha256(path.read_bytes()).hexdigest(),
                stat.S_IMODE(path.stat().st_mode),
            ) for path in (root / relative for relative in ALLOWLIST | set(PRESERVED_RELEASE_PATHS))},
        )

