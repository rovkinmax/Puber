            frame_path.write_bytes(original_frame)
            frame_path.chmod(0o600)

            profile_before = profile_path.read_bytes()
            original_profile = profile_before.decode("utf-8")
            profile_path.write_text(
                original_profile.replace(fixture.commits[fixture.kit], "0" * 40),
                encoding="utf-8",
            )
            profile_path.chmod(0o644)
            rejected(run_admission({"_kent": native_context}))
            profile_path.write_bytes(profile_before)
            profile_path.chmod(0o644)

            profile_path.write_text(
                original_profile.replace(
                    str(fixture.kit),
                    str(fixture.base / "missing-kit-cohort"),
                ),
                encoding="utf-8",
            )
            profile_path.chmod(0o644)
            rejected(run_admission({"_kent": native_context}))
            profile_path.write_bytes(profile_before)
            profile_path.chmod(0o644)

            bootstrap = fixture.project / ".kent/scripts/workflow_kit_runtime.py"
            bootstrap_before = bootstrap.read_bytes()
