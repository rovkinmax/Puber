def replace_unique(raw: bytes, old: bytes, new: bytes) -> bytes:
    occurrences = raw.count(old)
    if occurrences != 1:
        raise AssertionError(
            f"expected exactly one historical normalization token, found {occurrences}: {old!r}"
        )
    return raw.replace(old, new, 1)


