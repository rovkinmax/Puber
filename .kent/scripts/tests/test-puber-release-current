#!/usr/bin/env python3
from __future__ import annotations

import copy
import importlib.util
import json
import re
import runpy
import subprocess
import sys
import tomllib
import uuid
from importlib.machinery import SourceFileLoader
from pathlib import Path
from unittest.mock import patch

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[3]
BUILDER_PATH = ROOT / ".kent/workflows/builders/puber_release_current.py"
builder = runpy.run_path(str(BUILDER_PATH))

graph_path = ROOT / ".kent/workflows/puber-release-current.json"
graph = json.loads(graph_path.read_text(encoding="utf-8"))
original = json.loads(
    (ROOT / ".kent/workflows/puber-release-kit-5af.json").read_text(
        encoding="utf-8"
    )
)
builder["validate_graph"](graph, original)
new_route_keys = (
    "ci_monitor_retry_preparation",
    "ci_monitor_preparation_needs_user_action",
)
old_group_ids = {group["id"] for group in original["transition_groups"]}
new_groups = [
    group for group in graph["transition_groups"]
    if group["id"] not in old_group_ids
]
new_edges = [
    next(edge for edge in graph["edges"] if edge["key"] == key)
    for key in new_route_keys
]
assert len(new_groups) == len(new_edges) == 2
new_ids = [
    *(group["id"] for group in new_groups),
    *(edge["id"] for edge in new_edges),
]
assert len(set(new_ids)) == 4
assert {
    edge["transition_group_id"] for edge in new_edges
} == {group["id"] for group in new_groups}
assert set(new_ids) == {
    identity
    for mapping in builder["SOURCE_92_NATIVE_IDS"].values()
    for identity in mapping.values()
}
for identity in new_ids:
    assert re.fullmatch(
        r"[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-"
        r"[89ab][0-9a-f]{3}-[0-9a-f]{12}",
        identity,
    ), identity
    parsed = uuid.UUID(identity)
    assert parsed.version == 4 and parsed.variant == uuid.RFC_4122, identity
    assert str(parsed) == identity, identity
assert builder["build_graph"]() == graph
assert builder["build_graph"]() == graph
for invalid_id in (
    new_edges[0]["id"].upper(),
    str(uuid.uuid5(uuid.NAMESPACE_DNS, "invalid-source-92-native-id")),
):
    invalid_graph = copy.deepcopy(graph)
    invalid_edge = next(
        edge for edge in invalid_graph["edges"]
        if edge["key"] == new_route_keys[0]
    )
    invalid_edge["id"] = invalid_id
    try:
        builder["validate_graph"](invalid_graph, original)
    except ValueError as error:
        assert "source-92 native identity mapping differs" in str(error)
    else:
        raise AssertionError(f"invalid source-92 native edge ID accepted: {invalid_id}")
write_targets = []
with patch.dict(
    builder["write_graph_and_manifest"].__globals__,
    {"_write": lambda path, _value: write_targets.append(path)},
):
    builder["write_graph_and_manifest"]()
assert write_targets == [builder["GRAPH"], builder["MANIFEST"]]
assert graph["workflow"]["version"] == 97
assert graph["workflow"]["source_revision"] == 92
assert len(graph["nodes"]) == 18
assert len(graph["transition_groups"]) == 53
assert len(graph["edges"]) == 53
profile = tomllib.loads(
    (ROOT / ".kent/workflow-profile.toml").read_text(encoding="utf-8")
)
assert profile["kit_runtime"] == {
    "schema_version": 1,
    "root": "/Users/rovkinmax/.kent/worktrees/kent-engineering-kit/archive-published-2708-456",
    "commit": "2708c3391905ae10dc9e402d4f4ec0b4de020c9c",
    "publication_ref": "refs/remotes/origin/main",
}
expected_manifest = builder["_expected_manifest"]()
builder_path = profile["release"]["builder_path"]
physical_capture_paths = []
for external_root in expected_manifest["external_roots"]:
    if external_root["kind"] == "builder-sha256":
        physical_capture_paths.append(builder_path)
    else:
        source_path, separator, _digest = external_root["key"].partition("=")
        assert separator and source_path
        physical_capture_paths.append(source_path)
assert len(physical_capture_paths) == len(set(physical_capture_paths)), (
    "one selected source blob must not be captured under multiple external-root descriptors"
)
assert physical_capture_paths.count(builder_path) == 1, (
    "the selected builder must be captured exactly once through builder-sha256"
)
captured_bytes = sum(
    (ROOT / path).stat().st_size for path in physical_capture_paths
)
# Full closure membership is unchanged. Payload size is an observation, not a
# v2 provenance predicate; operation-wide resource limits are enforced by the
# qualified streaming verifier, exercised by the runtime integration suites.
assert captured_bytes == sum(
    (ROOT / path).stat().st_size for path in set(physical_capture_paths)
)
print(f"Complete selected closure: {len(physical_capture_paths)} roots, {captured_bytes} logical bytes")
assert not any(
    "delivery-script-ingress-ref-v1" in str(group.get("description", ""))
    for group in graph["transition_groups"]
)
assert expected_manifest["runtime_attested"] is False
expected_old_groups = copy.deepcopy(original["transition_groups"])
failure_group_id = next(
    edge["transition_group_id"]
    for edge in original["edges"]
    if edge["key"] == "ci_prepare_needs_user_action"
)
next(group for group in expected_old_groups if group["id"] == failure_group_id)[
    "transition_id"
] = "ci_prepare_failed"
assert graph["transition_groups"][:51] == expected_old_groups

edges = {edge["key"]: edge for edge in graph["edges"]}
expected_descriptions = {
    ("publish_needs_user_action", "operation_id"):
        "Stable release operation identity.",
    ("monitor_needs_user_action", "operation_id"):
        "Stable release operation identity.",
    ("publish_needs_user_action", "target_commit"):
        "Exact merge commit T observed for the merged pull request.",
    ("ci_monitor_retry_preparation", "workspace_path"):
        "Path to the task workspace or worktree relevant to this workflow transition.",
    ("ci_monitor_preparation_needs_user_action", "workspace_path"):
        "Path to the task workspace or worktree relevant to this workflow transition.",
}
description_conflicts = []
for (edge_key, parameter_key), expected in expected_descriptions.items():
    actual = next(
        parameter["description"]
        for parameter in edges[edge_key]["parameters"]
        if parameter["key"] == parameter_key
    )
    if actual != expected:
        description_conflicts.append(
            f"{edge_key}.{parameter_key}: expected {expected!r}, found {actual!r}"
        )
assert not description_conflicts, "\n".join(description_conflicts)
assert next(
    parameter["description"]
    for parameter in edges["monitor_needs_user_action"]["parameters"]
    if parameter["key"] == "target_commit"
) == "Immutable S05 carrier field: target_commit."
assert builder["check"]() == []

for key in (
    "ship_pr_ci_watch",
    "ci_waiting_pr",
    "ci_fix",
    "pr_fix",
    "waiting_pr_merge_watch",
    "waiting_pr_needs_user_action",
    "ci_watch_passed",
    "ci_watch_failed",
    "ci_watch_pr_merged",
    "ci_watch_state_changed",
    "ci_watch_needs_user_action",
    "merge_watch_still_waiting",
    "merge_watch_state_changed",
    "merge_watch_pr_merged",
    "merge_watch_needs_user_action",
    "ci_prepare_ready_initial",
    "ci_prepare_ready_retry",
    "ci_prepare_already_merged",
    "waiting_pr_ci_recheck",
    "cleanup_task_janitor",
):
    assert "pr_base_branch" in {
        parameter["key"] for parameter in edges[key]["parameters"]
    }, key

assert tuple(
    parameter["key"] for parameter in edges["pr_feedback"]["parameters"]
) == builder["FULL_PR_FEEDBACK_FIELDS"]
assert "target_commit" in {
    parameter["key"]
    for parameter in edges["merge_watch_pr_merged"]["parameters"]
}
assert "operation_id" in {
    parameter["key"]
    for parameter in edges["cleanup_task_janitor"]["parameters"]
}
for key in (
    "task_janitor_done",
    "task_janitor_blocked",
    "task_janitor_needs_user_action",
    "task_janitor_retry",
    "task_janitor_preserved",
):
    names = [parameter["key"] for parameter in edges[key]["parameters"]]
    assert names.index("operation_id") < names.index("pr_base_branch")

assert {
    "merge_watch_pr_merged",
    "publish_needs_user_action",
    "profile_generation_needs_user_action",
} <= {
    key for key, edge in edges.items() if edge.get("requires_approval") is True
}
assert tuple(
    parameter["key"] for parameter in edges["ci_prepare_failed"]["parameters"]
) == builder["CI_PREPARATION_FAILURE_FIELDS"]
assert tuple(
    parameter["key"] for parameter in edges["ci_monitor_retry_preparation"]["parameters"]
) == builder["CI_PREPARATION_RETRY_FIELDS"]
assert tuple(
    parameter["key"]
    for parameter in edges["ci_monitor_preparation_needs_user_action"]["parameters"]
) == builder["CI_PREPARATION_USER_ACTION_FIELDS"]
assert edges["ci_prepare_failed"]["requires_approval"] is False
assert edges["ci_monitor_retry_preparation"]["requires_approval"] is False
assert edges["ci_monitor_preparation_needs_user_action"]["requires_approval"] is True
assert all(
    "entry_transition" not in {parameter["key"] for parameter in edges[key]["parameters"]}
    for key in (
        "ci_prepare_failed",
        "ci_monitor_retry_preparation",
        "ci_monitor_preparation_needs_user_action",
    )
)
assert not any(
    "puber-engineering-delivery" in str(item)
    for item in expected_manifest["external_roots"]
)
assert expected_manifest["runtime_attested"] is False

intent_spec = importlib.util.spec_from_loader(
    "puber_release_intent_current_test",
    SourceFileLoader(
        "puber_release_intent_current_test",
        str(ROOT / ".kent/scripts/workflow-puber-release-intent"),
    ),
)
intent = importlib.util.module_from_spec(intent_spec)
assert intent_spec and intent_spec.loader
intent_spec.loader.exec_module(intent)

assert intent.WORKFLOW_REVISION == 97
assert intent.SOURCE_REVISION == 92
assert intent.GRAPH_PATH == ".kent/workflows/puber-release-current.json"
assert intent.normalize_transport_nulls(
    {"ci_contract": None, "ci_report": None, "pr_feedback_cursor": "uninitialized"},
    "ci_prepare_already_merged",
) == {
    "ci_contract": None,
    "ci_report": None,
    "pr_feedback_cursor": "uninitialized",
}
for invalid in ("", "null", " null ", 0, False, []):
    try:
        intent.normalize_transport_nulls(
            {"ci_report": invalid},
            "ci_prepare_already_merged",
        )
    except intent.ContractError:
        pass
    else:
        raise AssertionError(f"invalid CI absence/value accepted: {invalid!r}")
for key in ("ci_report", "target_commit"):
    try:
        intent.normalize_transport_nulls(
            {key: None},
            "ci_watch_passed",
        )
    except intent.ContractError:
        pass
    else:
        raise AssertionError(f"unauthorized null accepted for {key}")

# The business route remains the input carrier; native completion uses the
# graph's transition-group ID and returns the edge key only as the Script hint.
minimal_graph = {
    "nodes": [{"id": "node-script", "key": "ci_watch", "kind": "script"}],
    "transition_groups": [
        {
            "id": "group-native-id",
            "source_node_id": "source-id",
            "transition_id": "native-transition-id",
        }
    ],
    "edges": [
        {
            "key": "ci_prepare_ready_initial",
            "target_node_id": "node-script",
            "transition_group_id": "group-native-id",
            "parameters": [
                {"key": "workspace_path"},
                {"key": "entry_transition"},
            ],
        }
    ],
}
with patch.object(intent, "output_edge", return_value=minimal_graph["edges"][0]), \
     patch.object(intent, "_node_id", return_value="node-script"), \
     patch.object(
         intent.json,
         "loads",
         side_effect=lambda _text: minimal_graph,
     ), \
     patch("builtins.print") as printed:
    intent.emit_exact(
        ROOT,
        "ci_prepare_ready_initial",
        "ci_watch",
        {"workspace_path": "/tmp/work"},
    )
assert json.loads(printed.call_args.args[0]) == {
    "transition": "native-transition-id",
    "workspace_path": "/tmp/work",
    "entry_transition": "ci_prepare_ready_initial",
}

print("puber-release-current: passed non-attested graph, carrier, route and null-contract checks")
