@contextmanager
def fixture_context(*, mode, sandbox, candidate_freeze=None):
    global KIT, _kit_binding, _ACTIVE_CONTEXT, _PROCESS_MODE, _test_checkpoint
    if mode not in {"mock", "canonical"}:
        raise AssertionError("unknown publisher fixture mode")
    if _ACTIVE_CONTEXT is not None or (_PROCESS_MODE is not None and _PROCESS_MODE != mode):
        raise AssertionError("fixture modes cannot nest or switch within a process")
    if not isinstance(sandbox, FixtureSandbox) or sandbox.closed:
        raise AssertionError("an active owned sandbox is required")
    if mode == "canonical" and not (
        Path(sys.argv[0]).resolve() == ROOT / ".kent/scripts/tests/test-workflow-wait-github-release"
        and sys.argv[1:2] in (["--canonical-happy"], ["--canonical-blocker"])
        and (sys.argv[2:] == [] or (len(sys.argv) == 4 and sys.argv[2] == "--kit-candidate-freeze"
             and candidate_freeze is not None and Path(sys.argv[3]).resolve() == Path(candidate_freeze).resolve()))
    ):
        raise AssertionError("canonical fixture requires its dedicated child entrypoint")
    from contextlib import ExitStack
    resources = ExitStack()
    saved_env, saved_path = dict(os.environ), list(sys.path)
    saved_modules = {key: value for key, value in sys.modules.items()
                     if key == "workflowkit" or key.startswith("workflowkit.")}
    saved_helper = dict(helper.__dict__)
    for name in saved_modules:
        sys.modules.pop(name, None)
    _PROCESS_MODE = mode
    _ACTIVE_CONTEXT = {"mode": mode, "sandbox": sandbox, "native": None}
    try:
        os.environ.clear()
        os.environ.update(sandbox.environment)
        KIT, _kit_binding = verify_kit_binding(ROOT, sandbox=sandbox, publication="ancestor")
        if candidate_freeze is not None:
            directory = resources.enter_context(sandbox.temporary_directory())
            prepared = prepare_candidate_kit(sandbox, Path(directory), KIT, candidate_freeze)
            KIT, commit = prepared
            _kit_binding = {**_kit_binding, "root": str(KIT), "commit": commit}
            _ACTIVE_CONTEXT["prepared_kit"] = prepared
        if mode == "mock":
            _test_checkpoint = MockCheckpointFacade(KIT, variant="publisher")
            helper._qualified_checkpoint_module = lambda _root, *, required=(): _test_checkpoint
            helper._reset_runtime_invocation()
            helper._bind_qualified_runtime(helper.ROOT, {
                "task_id": "task-12345678-1234-4234-8234-123456789abc",
                "node_id": "test-only-publisher-fixture",
            })
        else:
            assert _test_checkpoint is None
            assert helper._QUALIFIED_KIT_RUNTIME is None
        yield _ACTIVE_CONTEXT
    finally:
        try:
            resources.close()
        finally:
            helper.__dict__.clear()
            helper.__dict__.update(saved_helper)
            os.environ.clear()
            os.environ.update(saved_env)
            sys.path[:] = saved_path
            for key in tuple(sys.modules):
                if key == "workflowkit" or key.startswith("workflowkit."):
                    sys.modules.pop(key)
            sys.modules.update(saved_modules)
            _ACTIVE_CONTEXT = None
            _test_checkpoint = None
            KIT = None
            _kit_binding = None


