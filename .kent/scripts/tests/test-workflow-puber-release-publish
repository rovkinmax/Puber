    def __init__(
        self,
        *,
        work: Path,
        bare: Path,
        env: dict[str, str],
        gh: Path,
        task_id: str,
        task_path: Path,
        agentw: Path,
    ) -> None:
        self.work = work
        self.bare = bare.resolve()
        self.env = env
        self.gh = gh
        self.task_id = task_id
        self.task_path = task_path
        self.agentw = agentw
        self.graph = json.loads(
            (work / ".kent/workflows/puber-release-current.json").read_text(
                encoding="utf-8"
            )
        )
        self.manifest = json.loads(
            (work / ".kent/workflows/puber-release-current.manifest.json").read_text(
                encoding="utf-8"
            )
        )
        self.nodes = {item["key"]: item for item in self.graph["nodes"]}
        self.nodes_by_id = {item["id"]: item for item in self.graph["nodes"]}
        self.edges = {item["key"]: item for item in self.graph["edges"]}
        self.transition_groups = {
            item["id"]: item for item in self.graph["transition_groups"]
        }
        self.stage_log: list[str] = []
        self.stage_inputs: dict[str, dict] = {}
        self._validate_static_contracts()

    def _bound_source(self, relative: str) -> str:
        expected = {
            item["key"].split("=", 1)[0]: item["key"].split("=", 1)[1]
            for item in self.manifest["external_roots"]
            if item.get("kind") == "source-sha256"
            and "=" in item.get("key", "")
        }
        if relative not in expected:
            raise StageContractError(f"unbound stage contract: {relative}")
        path = self.work / relative
        actual = helper.sha256_bytes(path.read_bytes())
        if actual != expected[relative]:
            raise StageContractError(f"stage contract digest drifted: {relative}")
        return path.read_text(encoding="utf-8")

    def _source_node(self, edge_key: str) -> str:
        edge = self.edges[edge_key]
        group = self.transition_groups[edge["transition_group_id"]]
        return self.nodes_by_id[group["source_node_id"]]["key"]

    def _target_node(self, edge_key: str) -> str:
        return self.nodes_by_id[self.edges[edge_key]["target_node_id"]]["key"]

    def _fields(self, edge_key: str) -> list[str]:
        return [item["key"] for item in self.edges[edge_key]["parameters"]]

    def _validate_static_contracts(self) -> None:
        if (
            self.graph["workflow"]["version"] != 99
            or self.graph["workflow"]["source_revision"] != 93
            or self.graph["workflow"]["schema_version"] != 4
            or len(self.graph["nodes"]) != 18
            or len(self.graph["transition_groups"]) != 53
            or len(self.graph["edges"]) != 53
        ):
            raise StageContractError("release graph identity or topology drifted")
        remote = sh(["git", "remote", "get-url", "origin"], self.work).stdout.strip()
        if Path(remote).resolve() != self.bare:
            raise StageContractError("fixture origin is not the isolated bare remote")
        for stage, contract in self.STAGE_CONTRACTS.items():
            node = self.nodes[stage]
            incoming = contract["incoming"]
            outgoing = contract["outgoing"]
            if self._target_node(incoming) != stage:
                raise StageContractError(f"{stage} incoming graph edge drifted")
            if self._source_node(outgoing) != stage:
                raise StageContractError(f"{stage} outgoing graph edge drifted")
            if "role" in contract:
                if (
                    node["kind"] != "agent"
                    or node["subagent_role"] != contract["role"]
                    or node["completion_mode"] != "shell_command"
                ):
                    raise StageContractError(f"{stage} agent contract drifted")
            else:
                if (
                    node["kind"] != "script"
                    or node["script_path"] != contract["script"]
                ):
                    raise StageContractError(f"{stage} script contract drifted")
            source = "\n".join(
                self._bound_source(relative) for relative in contract["sources"]
            )
            prompt = self.edges[incoming].get("prompt_template", "")
            combined = f"{prompt}\n{source}"
            for fragment in contract["fragments"]:
                if fragment not in combined:
                    raise StageContractError(
                        f"{stage} required repository contract drifted: {fragment}"
                    )
        profile_edge = self.edges["profile_generation_passed"]
        if (
            profile_edge.get("context_mode") != "new_session"
            or profile_edge.get("context_source") != {"kind": "immediate_source"}
        ):
            raise StageContractError(
                "profile_generation_passed must start a fresh session from the immediate source"
            )

    def _admit(self, stage: str, incoming: str, carrier: dict) -> None:
        contract = self.STAGE_CONTRACTS[stage]
        if incoming != contract["incoming"]:
            raise StageContractError(f"{stage} incoming transition drifted")
        required = self._fields(incoming)
        if set(carrier) != set(required) or len(carrier) != len(required):
            raise StageContractError(f"{stage} incoming carrier drifted")
        rendered = self.edges[incoming].get("prompt_template", "")
        for key in required:
            rendered = rendered.replace(f"{{{{.Params.{key}}}}}", str(carrier[key]))
        if "{{.Params." in rendered:
            raise StageContractError(f"{stage} prompt carrier binding drifted")
        for relative in contract["sources"]:
            self._bound_source(relative)
        self.stage_inputs[stage] = dict(carrier)

    def _emit(self, edge_key: str, values: dict) -> tuple[str, dict]:
        required = self._fields(edge_key)
        target = self.nodes_by_id[self.edges[edge_key]["target_node_id"]]
        routed_script = target["kind"] == "script" and target["key"] != "task_janitor"
        expected = set(required) - ({"entry_transition"} if routed_script else set())
        if set(values) != expected or len(values) != len(expected):
            raise StageContractError(f"{edge_key} output carrier drifted")
        return edge_key, {
            key: edge_key if routed_script and key == "entry_transition" else values[key]
            for key in required
        }

    def _checkpoint_path(self, task_short_id: str) -> Path:
        return (
            self.work
            / ".kent"
            / "runtime"
            / task_short_id
            / "release-profile-checkpoint.json"
        )

    def _read_checkpoint(self, task_short_id: str) -> dict:
        return helper.read_profile_checkpoint(self.work, task_short_id)

    def _expected(self, carrier: dict) -> dict:
        return {
            key: carrier[key]
            for key in (
                "operation_id",
                "task_short_id",
                "release_type",
                "release_version",
                "release_tag",
                "release_branch",
                "release_base_oid",
                "candidate_oid",
            )
        }

    def _validate_preparation(self, carrier: dict) -> tuple[dict, dict, dict]:
        checkpoint = self._read_checkpoint(carrier["task_short_id"])
        expected = self._expected(carrier)
        if (
            checkpoint["task_id"] != self.task_id
            or checkpoint["state"] != "completed"
            or any(checkpoint[key] != expected[key] for key in (
                "task_short_id",
                "operation_id",
                "release_branch",
                "release_base_oid",
                "candidate_oid",
            ))
        ):
            raise StageContractError("release checkpoint identity drifted")
        profile = helper.parse_profile_report(
            checkpoint["profile_report"],
            checkpoint["profile_report_digest"],
            expected=expected,
        )
        preparation = helper.parse_release_preparation_report(
            checkpoint["release_preparation_report"],
            checkpoint["release_preparation_report_digest"],
            expected=expected,
        )
        current_head = sh(["git", "rev-parse", "HEAD"], self.work).stdout.strip()
        if (
            carrier.get("release_head_oid", current_head) != current_head
            or checkpoint["release_head_oid"] != current_head
            or preparation["release_head_oid"] != current_head
            or preparation["profile_report_digest"]
            != checkpoint["profile_report_digest"]
        ):
            raise StageContractError("release preparation head or digest drifted")
        if (
            carrier.get("profile_report", checkpoint["profile_report"])
            != checkpoint["profile_report"]
            or carrier.get(
                "profile_report_digest", checkpoint["profile_report_digest"]
            )
            != checkpoint["profile_report_digest"]
            or carrier.get(
                "release_preparation_report",
                checkpoint["release_preparation_report"],
            )
            != checkpoint["release_preparation_report"]
            or carrier.get(
                "release_preparation_report_digest",
                checkpoint["release_preparation_report_digest"],
            )
            != checkpoint["release_preparation_report_digest"]
        ):
            raise StageContractError("release preparation carrier drifted")
        changed = helper.validate_release_diff(
            self.work,
            carrier["release_base_oid"],
            current_head,
            profile,
            preparation,
        )
        if changed != preparation["final_changed_paths"]:
            raise StageContractError("release preparation diff drifted")
        return checkpoint, profile, preparation

    def execute(
        self,
        stage: str,
        incoming: str,
        carrier: dict,
    ) -> tuple[str, dict]:
        native = require_context()["native"]
        if native:
            node = self.nodes[stage]
            if node["kind"] == "script":
                native_context = native.enter_script(stage)
                for key in ("KENT_SESSION_ID", "KENT_STEP_ID"):
                    self.env.pop(key, None)
                    os.environ.pop(key, None)
            else:
                native.enter_agent(stage)
                native_context = None
            self.env.update(native.env)
            os.environ.update(self.env)
            helper._reset_runtime_invocation()
            helper._bind_qualified_runtime(self.work, native_context)
        self._admit(stage, incoming, carrier)
        self.stage_log.append(stage)
        if stage == "prepare":
            remote_base = sh(
                ["git", "ls-remote", "origin", "refs/heads/master"], self.work
            ).stdout.split()[0]
            task = json.loads(self.task_path.read_text(encoding="utf-8"))
            if remote_base != task["execution_target"]["commit_oid"]:
                raise StageContractError("release base workspace identity drifted")
            branch = carrier["release_branch"]
            branches = sh(
                ["git", "branch", "--format=%(refname:short)"], self.work
            ).stdout.splitlines()
            if branch not in branches:
                sh(["git", "checkout", "--quiet", "-b", branch, remote_base], self.work)
                candidate = remote_base
            else:
                sh(["git", "checkout", "--quiet", branch], self.work)
                current = sh(["git", "rev-parse", "HEAD"], self.work).stdout.strip()
                if current == remote_base:
                    candidate = remote_base
                else:
                    checkpoint = self._read_checkpoint(carrier["task_short_id"])
                    candidate = checkpoint["candidate_oid"]
                    completed = {
                        **carrier,
                        "release_tag": f"v{carrier['release_version']}",
                        "release_base_oid": remote_base,
                        "candidate_oid": candidate,
                        "release_head_oid": current,
                    }
                    self._validate_preparation(completed)
            return self._emit(
                "prepare_profile_generation",
                {
                    "workspace_path": carrier["workspace_path"],
                    "operation_id": carrier["operation_id"],
                    "task_short_id": carrier["task_short_id"],
                    "release_type": carrier["release_type"],
                    "release_version": carrier["release_version"],
                    "release_tag": f"v{carrier['release_version']}",
                    "release_branch": branch,
                    "release_base_oid": remote_base,
                    "candidate_oid": candidate,
                },
            )

        if stage == "profile_generation":
            payload = {
                "_kent": {
                    "task_id": self.task_id,
                    "node_id": self.nodes[stage]["id"],
                },
                **carrier,
            }
            result = subprocess.run(
                [str(self.work / self.nodes[stage]["script_path"])],
                cwd=self.work,
                input=json.dumps(payload),
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=self.env,
            )
            if result.returncode != 0:
                raise StageContractError(
                    f"profile script failed: {result.stdout} {result.stderr}"
                )
            output = json.loads(result.stdout)
            transition = output.pop("transition")
            if transition != "profile_generation_passed":
                raise StageContractError(
                    f"profile stage failed closed: {output.get('blocker_reason', '')}"
                )
            return self._emit(transition, output)

        if stage == "finalize_release":
            expected = self._expected(carrier)
            profile = helper.parse_profile_report(
                carrier["profile_report"],
                carrier["profile_report_digest"],
                expected=expected,
            )
            checkpoint = self._read_checkpoint(carrier["task_short_id"])
            current_head = sh(["git", "rev-parse", "HEAD"], self.work).stdout.strip()
            if checkpoint["release_preparation_report"]:
                completed = {
                    **carrier,
                    "release_head_oid": current_head,
                    "release_preparation_report": checkpoint[
                        "release_preparation_report"
                    ],
                    "release_preparation_report_digest": checkpoint[
                        "release_preparation_report_digest"
                    ],
                }
                _checkpoint, _profile, preparation = self._validate_preparation(
                    completed
                )
                verification_summary = (
                    "reused closed compileProdReleaseArtProfile and "
                    "assembleProdRelease evidence"
                )
            else:
                if current_head != carrier["candidate_oid"]:
                    raise StageContractError(
                        "finalize candidate changed before packaging"
                    )
                build_file = self.work / "app/build.gradle.kts"
                lines = build_file.read_text(encoding="utf-8").splitlines()
                version_lines = [
                    index
                    for index, line in enumerate(lines)
                    if line.startswith("val currentVersion = ")
                ]
                if len(version_lines) != 1:
                    raise StageContractError("version source drifted")
                lines[version_lines[0]] = (
                    f'val currentVersion = "{carrier["release_version"]}"'
                )
                build_file.write_text("\n".join(lines) + "\n", encoding="utf-8")
                build_env = {
                    key: value
                    for key, value in self.env.items()
                    if key
                    in {
                        "PATH",
                        "HOME",
                        "USER",
                        "LOGNAME",
                        "TMPDIR",
                        "TMP",
                        "TEMP",
                        "TERM",
                        "LANG",
                        "LC_ALL",
                        "JAVA_HOME",
                        "ANDROID_HOME",
                        "ANDROID_SDK_ROOT",
                        "GRADLE_USER_HOME",
                        "KOTLIN_HOME",
                        "CI",
                        "PYTHONDONTWRITEBYTECODE",
                    }
                }
                for task_name in (
                    ":app:compileProdReleaseArtProfile",
                    ":app:assembleProdRelease",
                ):
                    sh([str(self.agentw), task_name], self.work, env={**build_env, "PUBER_RELEASE_SIGNING_MODE": "debug_validation"})
                changed = sh(
                    ["git", "diff", "--name-only"], self.work
                ).stdout.splitlines()
                expected_paths = [
                    "app/build.gradle.kts",
                    *profile["changed_profiles"],
                ]
                if changed != expected_paths:
                    raise StageContractError("finalize changed path set drifted")
                sh(["git", "add", *expected_paths], self.work)
                sh(
                    [
                        "git",
                        "commit",
                        "--quiet",
                        "-m",
                        f"Prepare release {carrier['release_version']}",
                    ],
                    self.work,
                )
                current_head = sh(
                    ["git", "rev-parse", "HEAD"], self.work
                ).stdout.strip()
                baseline_path = (
                    "app/src/main/generated/baselineProfiles/baseline-prof.txt"
                )
                startup_path = (
                    "app/src/main/generated/baselineProfiles/startup-prof.txt"
                )
                preparation = {
                    **helper.VALIDATION_SIGNING,
                    "schema": "puber_release_preparation_report_v2",
                    **expected,
                    "release_head_oid": current_head,
                    "profile_report_digest": carrier["profile_report_digest"],
                    "compile_command": (
                        "./tools/agentw :app:compileProdReleaseArtProfile"
                    ),
                    "compile_state": "passed",
                    "assemble_command": "./tools/agentw :app:assembleProdRelease",
                    "assemble_state": "passed",
                    "final_changed_paths": expected_paths,
                    "version_file_sha256": helper.git_blob_sha256(
                        self.work, current_head, "app/build.gradle.kts"
                    ),
                    "baseline_profile_sha256": helper.git_blob_sha256(
                        self.work, current_head, baseline_path
                    ),
                    "startup_profile_sha256": helper.git_blob_sha256(
                        self.work, current_head, startup_path
                    ),
                    "no_profile_diff": not profile["changed_profiles"],
                    "elapsed_ms": 1,
                }
                preparation_report = helper.canonical_json(preparation)
                preparation_digest = helper.sha256_bytes(
                    preparation_report.encode("utf-8")
                )
                checkpoint.update(
                    {
                        "release_head_oid": current_head,
                        "release_preparation_report": preparation_report,
                        "release_preparation_report_digest": preparation_digest,
                        "output_hashes": {
                            baseline_path: preparation[
                                "baseline_profile_sha256"
                            ],
                            startup_path: preparation["startup_profile_sha256"],
                        },
                    }
                )
                helper.write_profile_checkpoint(self.work, carrier["task_short_id"], checkpoint)
                verification_summary = (
                    "./tools/agentw :app:compileProdReleaseArtProfile passed; "
                    "./tools/agentw :app:assembleProdRelease passed"
                )
            return self._emit(
                "finalize_release_done",
                {
                    **carrier,
                    "release_head_oid": current_head,
                    "release_preparation_report": helper.canonical_json(
                        preparation
                    ),
                    "release_preparation_report_digest": helper.sha256_bytes(
                        helper.canonical_json(preparation).encode("utf-8")
                    ),
                    "verification_summary": verification_summary,
                },
            )

        if stage == "compliance":
            before = sh(
                ["git", "status", "--porcelain=v1", "--untracked-files=all"],
                self.work,
            ).stdout
            _checkpoint, _profile, preparation = self._validate_preparation(carrier)
            if (
                preparation["compile_state"] != "passed"
                or preparation["assemble_state"] != "passed"
            ):
                raise StageContractError("packaging evidence is not passing")
            after = sh(
                ["git", "status", "--porcelain=v1", "--untracked-files=all"],
                self.work,
            ).stdout
            if before != after:
                raise StageContractError("compliance mutated the checkout")
            report = helper.canonical_json(
                {
                    "schema": "puber_release_compliance_report_v1",
                    "release_head_oid": carrier["release_head_oid"],
                    "state": "passed",
                }
            )
            return self._emit(
                "compliance_ship_pr",
                {**carrier, "compliance_report": report},
            )

        if stage == "ship_pr":
            _checkpoint, _profile, preparation = self._validate_preparation(
                carrier
            )
            head_oid = preparation["release_head_oid"]
            push = subprocess.run(
                [
                    "git",
                    "push",
                    "--porcelain",
                    "origin",
                    f"HEAD:refs/heads/{carrier['release_branch']}",
                ],
                cwd=self.work,
                check=True,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            if "forced update" in (push.stdout + push.stderr).lower():
                raise StageContractError("release branch was force-pushed")
            remote_head = sh(
                [
                    "git",
                    "--git-dir",
                    str(self.bare),
                    "rev-parse",
                    f"refs/heads/{carrier['release_branch']}",
                ],
                self.work,
            ).stdout.strip()
            if remote_head != head_oid:
                raise StageContractError("remote release head drifted")
            listed = subprocess.run(
                [
                    str(self.gh),
                    "pr",
                    "list",
                    "--head",
                    carrier["release_branch"],
                    "--base",
                    "master",
                    "--state",
                    "all",
                    "--json",
                    "url,baseRefName,headRefName,headRefOid",
                ],
                cwd=self.work,
                check=True,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=self.env,
            )
            prs = json.loads(listed.stdout)
            if not prs:
                created = subprocess.run(
                    [
                        str(self.gh),
                        "pr",
                        "create",
                        "--base",
                        "master",
                        "--head",
                        carrier["release_branch"],
                        "--title",
                        f"Release {carrier['release_version']}",
                        "--body",
                        "Schema-4 release fixture",
                    ],
                    cwd=self.work,
                    check=True,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    env=self.env,
                )
                pr_url = created.stdout.strip()
            else:
                if len(prs) != 1:
                    raise StageContractError("release PR identity is ambiguous")
                pr_url = prs[0]["url"]
                subprocess.run(
                    [
                        str(self.gh),
                        "pr",
                        "edit",
                        pr_url,
                        "--title",
                        f"Release {carrier['release_version']}",
                        "--body",
                        "Schema-4 release fixture",
                    ],
                    cwd=self.work,
                    check=True,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    env=self.env,
                )
            viewed = subprocess.run(
                [
                    str(self.gh),
                    "pr",
                    "view",
                    pr_url,
                    "--json",
                    "url,baseRefName,headRefName,headRefOid",
                ],
                cwd=self.work,
                check=True,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=self.env,
            )
            pr = json.loads(viewed.stdout)
            if pr != {
                "url": "https://github.com/rovkinmax/Puber/pull/7",
                "baseRefName": "master",
                "headRefName": carrier["release_branch"],
                "headRefOid": head_oid,
            }:
                raise StageContractError("release PR carrier drifted")
            self._validate_preparation(carrier)
            master_oid = sh(
                ["git", "--git-dir", str(self.bare), "rev-parse", "refs/heads/master"],
                self.work,
            ).stdout.strip()
            return self._emit(
                "ship_pr_ci_watch",
                {
                    **{key: carrier[key] for key in self._fields("ship_pr_ci_watch") if key in carrier},
                    "pr_url": pr_url,
                    "branch_name": carrier["release_branch"],
                    "merge_strategy": "rebase",
                    "pr_head_oid": pr["headRefOid"],
                    "pr_base_oid": master_oid,
                    "pr_base_branch": "master",
                },
            )

        raise StageContractError(f"unsupported release stage: {stage}")

    def run_path(self, initial: dict) -> dict:
        stage = "prepare"
        incoming = "release_intent_passed"
        carrier = initial
        while stage != "ci_prepare":
            transition, carrier = self.execute(stage, incoming, carrier)
            stage = self._target_node(transition)
            incoming = transition
        return carrier

