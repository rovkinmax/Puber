def sh(args, cwd, **kwargs):
    return subprocess.run(args, cwd=cwd, check=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs)

def materialize(root: Path, bare: Path) -> tuple[Path, str, str, str]:
    work = root / "work"
    sh(["git", "clone", "--quiet", str(ROOT), str(work)], root)
    manifest = json.loads((ROOT / ".kent/workflows/puber-release.manifest.json").read_text(encoding="utf-8"))
    manifest_paths = set(SCRIPT_PATHS) | set(manifest["additional_paths"])
    for external in manifest["external_roots"]:
        if external.get("kind") == "source-sha256" and "=" in external.get("key", ""):
            manifest_paths.add(external["key"].split("=", 1)[0])
    for relative in sorted(manifest_paths):
        source = ROOT / relative
        target = work / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
    sh(["git", "config", "user.email", "test@example.invalid"], work)
    sh(["git", "config", "user.name", "Puber Test"], work)
    sh(["git", "add", "."], work)
    if subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=work).returncode != 0:
        sh(["git", "commit", "--quiet", "-m", "test fixture source closure"], work)
    base = sh(["git", "rev-parse", "HEAD"], work).stdout.strip()
    sh(["git", "checkout", "--quiet", "-b", "release/99.0.0"], work)
    build_file = work / "app/build.gradle.kts"
    build_file.write_text(
        build_file.read_text(encoding="utf-8").replace('val currentVersion = "1.9.1"', 'val currentVersion = "99.0.0"'),
        encoding="utf-8",
    )
    profile = work / "app/src/main/generated/baselineProfiles/baseline-prof.txt"
    profile.write_bytes(profile.read_bytes() + b"\n# deterministic publish fixture\n")
    sh(["git", "add", "app/build.gradle.kts", str(profile.relative_to(work))], work)
    sh(["git", "commit", "--quiet", "-m", "test release preparation"], work)
    target = sh(["git", "rev-parse", "HEAD"], work).stdout.strip()
    sh(["git", "init", "--bare", str(bare)], root)
    sh(["git", "remote", "set-url", "origin", str(bare)], work)
    sh(["git", "push", "--quiet", "-u", "origin", "HEAD:master"], work)
    return work, base, target, str(bare)

