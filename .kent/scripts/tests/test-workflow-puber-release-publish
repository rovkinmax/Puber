def test_explicit_context_contract():
    # This child deliberately enters mock mode and tests that canonical cannot
    # be entered in the same process; no facade crosses the process boundary.
    code = r'''
import sys, pathlib, importlib.util, os, subprocess
from importlib.machinery import SourceFileLoader
from unittest.mock import patch
sys.dont_write_bytecode=True
root=pathlib.Path(sys.argv[1]);path=root/'.kent/scripts/tests/test-workflow-puber-release-publish'
spec=importlib.util.spec_from_loader('pub_context_test',SourceFileLoader('pub_context_test',str(path)));pub=importlib.util.module_from_spec(spec)
with patch.object(subprocess,'run',side_effect=AssertionError('import attempted Git/process')):
 spec.loader.exec_module(pub)
assert pub._test_checkpoint is None and pub._ACTIVE_CONTEXT is None and pub._kit_binding is None
try:pub.require_context()
except AssertionError:pass
else:raise AssertionError('missing context accepted')
with pub.FixtureSandbox.create() as sb:
 for mode in ['unknown','canonical']:
  try:
   with pub.fixture_context(mode=mode,sandbox=sb):raise RuntimeError('unexpected enter')
  except AssertionError:pass
  else:raise AssertionError('unknown mode/non-child canonical accepted')
 env=dict(os.environ);path=list(sys.path);modules={k:v for k,v in sys.modules.items() if k=='workflowkit' or k.startswith('workflowkit.')};helper=dict(pub.helper.__dict__)
 try:
  with pub.fixture_context(mode='mock',sandbox=sb):
   for mode in ['mock','canonical']:
    try:
     with pub.fixture_context(mode=mode,sandbox=sb):raise RuntimeError('unexpected nested context')
    except AssertionError:pass
    else:raise AssertionError('nested context accepted')
   raise LookupError('forced context failure')
 except LookupError:pass
 assert env==dict(os.environ) and path==sys.path
 assert modules=={k:v for k,v in sys.modules.items() if k=='workflowkit' or k.startswith('workflowkit.')}
 assert helper==pub.helper.__dict__ and pub._test_checkpoint is None
 try:
  with pub.fixture_context(mode='canonical',sandbox=sb):raise RuntimeError('unexpected mode switch')
 except AssertionError:pass
 else:raise AssertionError('mode switch accepted')
print('import/no-bind, missing/unknown/nested/non-child/mode-switch, exception restoration PASS')
'''
    with FixtureSandbox.create() as sandbox:
        result = sandbox.run_child([sys.executable, "-I", "-B", "-c", code, str(ROOT)],
            capture_output=True, text=True)
        assert result.returncode == 0, result.stdout + result.stderr
        print(result.stdout.strip())


def test_profile_streaming_guard():
    """The profile caller must account preflight and eager verification together."""
    from contextlib import contextmanager
    from types import SimpleNamespace
    spec = importlib.util.spec_from_loader("profile_shared_budget_test", SourceFileLoader(
        "profile_shared_budget_test", str(ROOT / ".kent/scripts/workflow-puber-release-profile-generation")))
    script = importlib.util.module_from_spec(spec)
    environment = dict(os.environ)
    try:
        spec.loader.exec_module(script)
    finally:
        os.environ.clear()
        os.environ.update(environment)
    budget = object()
    commit = "a" * 40
    events = []
    selected_value = SimpleNamespace(project_commit=commit)
    @contextmanager
    def accounting():
        events.append("enter")
        try:
            yield budget
        finally:
            events.append("exit")
    def preflight(root, exact_commit, *, budget):
        assert root == ROOT and exact_commit == commit and budget is accounting_budget
        events.append("preflight")
        return SimpleNamespace(selected_runtime_source_inputs=selected_value)
    def verify(root, profile, selected, *, budget):
        assert root == ROOT and selected is selected_value and budget is accounting_budget
        events.append("verify")
    accounting_budget = budget
    kit = {"source_read_budget": accounting, "preflight_project_revision": preflight,
        "ProjectProfile": SimpleNamespace(from_toml=lambda *a, **kw: object())}
    with patch.object(script.helper, "_kit_modules", return_value=kit), \
         patch.object(script.helper, "_external_captures", side_effect=verify):
        script._assert_runtime_source_closure({"commit": commit})
        assert events == ["enter", "preflight", "verify", "exit"]
        for selected_value in (None, SimpleNamespace(project_commit="b" * 40)):
            events.clear()
            try:
                script._assert_runtime_source_closure({"commit": commit})
            except script.ProfileError:
                pass
            else:
                raise AssertionError("profile guard accepted absent or foreign selected source")
            assert events == ["enter", "preflight", "exit"]
        selected_value = SimpleNamespace(project_commit=commit)
        events.clear()
        with patch.object(script.helper, "_external_captures", side_effect=RuntimeError("resource capacity")):
            try:
                script._assert_runtime_source_closure({"commit": commit})
            except RuntimeError as error:
                assert str(error) == "resource capacity"
            else:
                raise AssertionError("profile guard swallowed verification failure")
        assert events == ["enter", "preflight", "exit"]
    print("profile guard shared accounting / eager complete verification / fail-closed: passed")


if __name__ == "__main__":
    candidate_freeze = candidate_freeze_argument(sys.argv[1:])
    test_explicit_context_contract()
    test_profile_streaming_guard()
    with FixtureSandbox.create() as sandbox:
        with fixture_context(mode="mock", sandbox=sandbox, candidate_freeze=candidate_freeze):
            test_publication(False)
            test_publication(True)
            test_clean_master_to_exactly_one_release_pr()
