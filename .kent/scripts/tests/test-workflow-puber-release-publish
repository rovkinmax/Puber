def rebased_target(work: Path, base: str, head: str) -> str:
    """A real rebase over unrelated mainline work, leaving the controller on H."""
    branch = sh(["git", "branch", "--show-current"], work).stdout.strip()
    sh(["git", "checkout", "--quiet", "-b", "fixture-mainline", base], work)
    (work / "docs/rebased-mainline-fixture.txt").write_text("Unrelated mainline source\n")
    sh(["git", "add", "docs/rebased-mainline-fixture.txt"], work)
    sh(["git", "commit", "--quiet", "-m", "unrelated mainline change"], work)
    mainline = sh(["git", "rev-parse", "HEAD"], work).stdout.strip()
    sh(["git", "checkout", "--quiet", "-b", "fixture-merged", head], work)
    sh(["git", "rebase", "--onto", mainline, base], work)
    merged = sh(["git", "rev-parse", "HEAD"], work).stdout.strip()
    sh(["git", "checkout", "--quiet", branch], work)
    assert merged != head and sh(["git", "rev-parse", "HEAD"], work).stdout.strip() == head
    return merged

def target_with_changes(work: Path, target: str, changes: dict[str, bytes | None]) -> str:
    """Commit real target-only Git blobs without altering H or its index."""
    manifest_path = ".kent/workflows/puber-release-current.manifest.json"
    manifest = json.loads(sh(["git", "show", target + ":" + manifest_path], work).stdout)
    for external in manifest["external_roots"]:
        if external["kind"] == "source-sha256":
            path = external["key"].split("=", 1)[0]
            if path in changes and changes[path] is not None:
                external["key"] = path + "=" + helper.sha256_bytes(changes[path])
    changes = {**changes, manifest_path: (json.dumps(manifest, indent=2) + "\n").encode()}
    with require_context()["sandbox"].temporary_directory() as temporary:
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(temporary) / "index")}
        sh(["git", "read-tree", target], work, env=env)
        for path, raw in changes.items():
            if raw is None:
                sh(["git", "update-index", "--force-remove", "--", path], work, env=env)
            else:
                blob = subprocess.run(["git", "hash-object", "-w", "--stdin"], cwd=work,
                                      input=raw, capture_output=True, check=True).stdout.decode().strip()
                mode = sh(["git", "ls-tree", target, "--", path], work).stdout.split(" ", 1)[0] or "100644"
                sh(["git", "update-index", "--add", "--cacheinfo", mode, blob, path], work, env=env)
        tree = sh(["git", "write-tree"], work, env=env).stdout.strip()
        return sh(["git", "commit-tree", tree, "-p", target, "-m", "target-only drift fixture"], work).stdout.strip()

