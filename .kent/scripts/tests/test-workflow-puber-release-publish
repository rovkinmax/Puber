def fixture_checkpoint(work: Path, base_oid: str, target: str, task_id: str) -> dict:
    profile_path = "app/src/main/generated/baselineProfiles/baseline-prof.txt"
    startup_path = "app/src/main/generated/baselineProfiles/startup-prof.txt"
    profile_report_value = {
        "schema": "puber_profile_report_v1",
        "operation_id": "a" * 64,
        "task_short_id": "PUB-99",
        "release_type": "minor",
        "release_version": "99.0.0",
        "release_tag": "v99.0.0",
        "release_branch": "release/99.0.0",
        "release_base_oid": base_oid,
        "candidate_oid": target,
        "tv_serial": "emulator-5554",
        "command": ".kent/scripts/workflow-puber-release-profile-generation:tools/generate-baseline-profile.sh",
        "lease_state": "released",
        "generation_state": "passed",
        "network_isolation_state": "passed",
        "elapsed_ms": 1,
        "baseline_before_sha256": helper.git_blob_sha256(work, base_oid, profile_path),
        "baseline_after_sha256": helper.git_blob_sha256(work, target, profile_path),
        "startup_before_sha256": helper.git_blob_sha256(work, base_oid, startup_path),
        "startup_after_sha256": helper.git_blob_sha256(work, target, startup_path),
        "changed_profiles": [profile_path],
    }
    profile_report = helper.canonical_json(profile_report_value)
    profile_digest = helper.sha256_bytes(profile_report.encode())
    preparation_value = {
        **helper.VALIDATION_SIGNING,
        "schema": "puber_release_preparation_report_v2",
        "operation_id": "a" * 64,
        "task_short_id": "PUB-99",
        "release_type": "minor",
        "release_version": "99.0.0",
        "release_tag": "v99.0.0",
        "release_branch": "release/99.0.0",
        "release_base_oid": base_oid,
        "candidate_oid": target,
        "release_head_oid": target,
        "profile_report_digest": profile_digest,
        "compile_command": "./tools/agentw :app:compileProdReleaseArtProfile",
        "compile_state": "passed",
        "assemble_command": "./tools/agentw :app:assembleProdRelease",
        "assemble_state": "passed",
        "final_changed_paths": ["app/build.gradle.kts", profile_path],
        "version_file_sha256": helper.git_blob_sha256(work, target, "app/build.gradle.kts"),
        "baseline_profile_sha256": helper.git_blob_sha256(work, target, profile_path),
        "startup_profile_sha256": helper.git_blob_sha256(work, target, startup_path),
        "no_profile_diff": False,
        "elapsed_ms": 1,
    }
    for field, replacement in (
        ("schema", "puber_release_preparation_report_v1"),
        ("packaging_artifact_publishable", True),
        ("production_signing_used", True),
        ("packaging_artifact_signer_certificate_sha256", "0" * 64),
    ):
        forged = {**preparation_value, field: replacement}
        try:
            helper.parse_release_preparation_report(forged, helper.digest_json(forged))
        except helper.ContractError:
            pass
        else:
            raise AssertionError("forged preparation signing claim was accepted")
    preparation_report = helper.canonical_json(preparation_value)
    preparation_digest = helper.sha256_bytes(preparation_report.encode())
    checkpoint = {
        "schema": "puber_release_profile_checkpoint_v2",
        "task_id": task_id,
        "task_short_id": "PUB-99",
        "operation_id": "a" * 64,
        "release_branch": "release/99.0.0",
        "release_base_oid": base_oid,
        "candidate_oid": target,
        "release_head_oid": target,
        "candidate_serials": ["emulator-5554"],
        "state": "completed",
        "resource_serial": "emulator-5554",
        "profile_report": profile_report,
        "profile_report_digest": profile_digest,
        "release_preparation_report": preparation_report,
        "release_preparation_report_digest": preparation_digest,
        "output_hashes": {
            profile_path: preparation_value["baseline_profile_sha256"],
            startup_path: preparation_value["startup_profile_sha256"],
        },
    }
    return checkpoint

