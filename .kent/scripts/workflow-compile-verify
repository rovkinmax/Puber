#!/bin/sh
exec /usr/bin/python3 -I -c '
import json
import math
import os
import re
import stat
import subprocess
import sys
from pathlib import Path


INPUT_LIMIT = 1024 * 1024
FIELD_LIMIT = INPUT_LIMIT
REVIEW_CONTEXT_LIMIT = 256 * 1024
TASK = ":app:compileDevDebugKotlin"
TASK_PATTERN = re.compile(r"[A-Z][A-Z0-9]*-[0-9]+\Z")
HELPER_PATHS = (
    "/opt/homebrew/bin",
    "/usr/local/bin",
    "/home/linuxbrew/.linuxbrew/bin",
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin",
)
SUPPORTED_WORK_KINDS = {
    "feature",
    "bugfix",
    "refactor",
    "migration",
    "dependency",
    "test",
}
EVIDENCE_HELPER = ".kent/scripts/workflow-mock-scenario-evidence"


def reject_constant(value):
    raise ValueError(value)

def finite_float(value):
    result = float(value)
    if not math.isfinite(result):
        raise ValueError(value)
    return result


def unique_pairs(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(key)
        result[key] = value
    return result


def emit(transition):
    sys.stdout.write("{\"transition\":\"" + transition + "\"}\n")


def block(message):
    sys.stderr.write(message + "\n")
    emit("blocked")
    raise SystemExit(0)


def valid_field(value):
    if not isinstance(value, str) or not value:
        return False
    try:
        return len(value.encode("utf-8")) <= FIELD_LIMIT
    except UnicodeEncodeError:
        return False


def load_json(raw):
    return json.loads(
        raw,
        object_pairs_hook=unique_pairs,
        parse_constant=reject_constant,
        parse_float=finite_float,
    )


def validate_review_context(current, value):
    if not valid_field(value):
        block("compile verifier input is invalid")
    try:
        raw = value.encode("utf-8")
        if len(raw) > REVIEW_CONTEXT_LIMIT:
            block("compile verifier input is invalid")
        envelope = load_json(raw)
    except (RecursionError, UnicodeError, ValueError):
        block("compile verifier input is invalid")

    if not isinstance(envelope, dict):
        block("mock-scenario evidence is invalid")
    task = envelope.get("task_short_id")
    work_kind = envelope.get("work_kind")
    if (
        not isinstance(task, str)
        or TASK_PATTERN.fullmatch(task) is None
        or not isinstance(work_kind, str)
        or work_kind not in SUPPORTED_WORK_KINDS
    ):
        block("mock-scenario evidence is invalid")

    helper = current
    try:
        for component in (".kent", "scripts"):
            helper = helper / component
            parent_metadata = helper.lstat()
            if (
                stat.S_ISLNK(parent_metadata.st_mode)
                or not stat.S_ISDIR(parent_metadata.st_mode)
            ):
                block("mock-scenario evidence validation is unavailable")
        helper = helper / Path(EVIDENCE_HELPER).name
        metadata = helper.lstat()
    except OSError:
        block("mock-scenario evidence validation is unavailable")
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_nlink != 1
        or metadata.st_mode & 0o022
    ):
        block("mock-scenario evidence validation is unavailable")

    helper_environment = {
        "CI": "1",
        "LANG": "C",
        "LC_ALL": "C",
        "GIT_TERMINAL_PROMPT": "0",
        "GCM_INTERACTIVE": "never",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_OPTIONAL_LOCKS": "0",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PATH": os.pathsep.join(
            path for path in HELPER_PATHS if Path(path).is_dir()
        ),
    }
    for name in ("HOME",):
        value = os.environ.get(name)
        if valid_field(value) and Path(value).is_absolute() and Path(value).is_dir():
            helper_environment[name] = value
    try:
        result = subprocess.run(
            [
                sys.executable,
                "-I",
                str(helper),
                "validate-envelope",
                "--workspace",
                str(current),
                "--task",
                task,
                "--work-kind",
                work_kind,
            ],
            cwd=current,
            env=helper_environment,
            input=raw,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError):
        block("mock-scenario evidence validation is unavailable")
    if result.returncode not in (0, 1) or len(result.stdout) > REVIEW_CONTEXT_LIMIT:
        block("mock-scenario evidence is invalid")
    try:
        validated = load_json(result.stdout)
    except (RecursionError, UnicodeError, ValueError):
        block("mock-scenario evidence is invalid")
    if validated != envelope:
        block("mock-scenario evidence is invalid")
    if result.returncode == 1:
        emit("failed")
        raise SystemExit(0)


try:
    input_raw = sys.stdin.buffer.read(INPUT_LIMIT + 1)
    if len(input_raw) > INPUT_LIMIT:
        block("compile verifier input is invalid")
    payload = load_json(input_raw)
except (RecursionError, UnicodeError, ValueError):
    block("compile verifier input is invalid")

if (
    not isinstance(payload, dict)
    or not {"workspace_path", "review_context"} <= set(payload)
    or set(payload) - {"workspace_path", "review_context", "_kent", "commentary", "delivery_context"}
):
    block("compile verifier input is invalid")

if "_kent" in payload and not isinstance(payload["_kent"], dict):
    block("compile verifier input is invalid")
if "commentary" in payload and payload["commentary"] != "" and not valid_field(payload["commentary"]):
    block("compile verifier input is invalid")
if "delivery_context" in payload and not valid_field(payload["delivery_context"]):
    block("compile verifier input is invalid")

# Delivery state is opaque transport, never a compile input or command argument.
payload = {key: payload[key] for key in ("workspace_path", "review_context")}
if any(not valid_field(value) for value in payload.values()):
    block("compile verifier input is invalid")

try:
    current = Path.cwd().resolve(strict=True)
    requested = Path(payload["workspace_path"])
    if not requested.is_absolute() or requested.resolve(strict=True) != current:
        block("compile verifier workspace is invalid")
    git_marker = current / ".git"
    metadata = git_marker.lstat()
except (OSError, RuntimeError, ValueError):
    block("compile verifier workspace is invalid")

validate_review_context(current, payload["review_context"])

if stat.S_ISREG(metadata.st_mode):
    relative_command = "./tools/agentw"
elif stat.S_ISDIR(metadata.st_mode):
    relative_command = "./gradlew"
else:
    block("compile verifier workspace is invalid")

tmpdir = os.environ.get("TMPDIR", "")
try:
    tmp_path = Path(tmpdir)
    tmp_metadata = tmp_path.lstat()
    canonical_tmp_path = tmp_path.resolve(strict=True)
except (OSError, RuntimeError, ValueError):
    block("compile verifier infrastructure is unavailable")

if (
    not tmp_path.is_absolute()
    or canonical_tmp_path != tmp_path
    or not stat.S_ISDIR(tmp_metadata.st_mode)
    or tmp_metadata.st_uid != os.getuid()
    or stat.S_IMODE(tmp_metadata.st_mode) != 0o700
):
    block("compile verifier infrastructure is unavailable")

command = current / relative_command[2:]
try:
    command_metadata = command.lstat()
except OSError:
    block("compile verifier infrastructure is unavailable")

if (
    not stat.S_ISREG(command_metadata.st_mode)
    or command_metadata.st_uid != os.getuid()
    or command_metadata.st_nlink != 1
    or command_metadata.st_mode & 0o022
    or not command_metadata.st_mode & stat.S_IXUSR
):
    block("compile verifier infrastructure is unavailable")

gradle_environment = dict(os.environ)

try:
    result = subprocess.run(
        [relative_command, TASK],
        cwd=current,
        env=gradle_environment,
        stdin=subprocess.DEVNULL,
        stdout=sys.stderr,
        stderr=sys.stderr,
        check=False,
    )
except OSError:
    block("compile verifier infrastructure is unavailable")

if result.returncode == 0:
    emit("passed")
elif result.returncode > 0:
    emit("failed")
else:
    block("compile verifier execution was interrupted")
'
