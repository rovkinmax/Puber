#!/usr/bin/env python3
from __future__ import annotations

import importlib.util
import json
import os
from pathlib import Path
import sys
import time
import tomllib
from typing import Any

sys.dont_write_bytecode = True

MAX_PROFILE_BYTES = 64 * 1024


def _sibling(name: str) -> Any:
    path = Path(__file__).with_name(name)
    if path.is_symlink() or not path.is_file():
        raise RuntimeError("{} support module is unsafe".format(name))
    spec = importlib.util.spec_from_file_location(
        "kent_{}".format(name.replace(".", "_")),
        path,
    )
    if spec is None or spec.loader is None:
        raise RuntimeError("{} support module is unavailable".format(name))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def runtime_contracts() -> Any:
    return _sibling("workflow_runtime_contracts.py")


def github_observation() -> Any:
    return _sibling("workflow_github_observation.py")


def _text(payload: dict[str, object], key: str) -> str:
    value = payload.get(key)
    if not isinstance(value, str) or not value.strip():
        raise ValueError("{} must be a non-empty string".format(key))
    return value.strip()


def _canonical(runtime: Any, value: object) -> str:
    return runtime.canonical_bytes(value).decode("utf-8")


def _profile_ci_enabled(workspace: Path) -> bool:
    path = workspace / ".kent" / "workflow-profile.toml"
    try:
        raw = path.read_bytes()
    except OSError as error:
        raise ValueError("workflow profile is required") from error
    if len(raw) > MAX_PROFILE_BYTES:
        raise ValueError("workflow profile is too large")
    try:
        value = tomllib.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise ValueError("workflow profile is invalid") from error
    capabilities = value.get("capabilities")
    return isinstance(capabilities, dict) and (
        capabilities.get("ci_monitoring") is True
    )


def _contract(
    runtime: Any,
    payload: dict[str, object],
    workspace: Path,
) -> tuple[dict[str, Any] | None, str | None]:
    raw = payload.get("ci_contract")
    if raw is None:
        if _profile_ci_enabled(workspace):
            raise ValueError("ci_contract is required")
        if payload.get("ci_report") not in (None, ""):
            raise ValueError("ci_report requires ci_contract")
        return None, None
    if not isinstance(raw, str) or not raw:
        raise ValueError("ci_contract is invalid")
    value = runtime.parse_canonical_json(
        raw,
        label="ci_contract",
        max_bytes=runtime.MAX_CI_REPORT_BYTES,
    )
    contract = runtime.validate_ci_contract(value)
    return contract, _canonical(runtime, contract)


def _report(
    runtime: Any,
    payload: dict[str, object],
    contract: dict[str, Any] | None,
) -> str | None:
    raw = payload.get("ci_report")
    if raw in (None, ""):
        return None
    if contract is None:
        raise ValueError("ci_report requires ci_contract")
    if not isinstance(raw, str):
        raise ValueError("ci_report must be canonical JSON")
    report = runtime.validate_dynamic_ci_report(
        runtime.parse_canonical_json(
            raw,
            label="ci_report",
            max_bytes=runtime.MAX_DYNAMIC_CI_REPORT_BYTES,
        )
    )
    if report["contract"] != contract:
        raise ValueError("ci_report contract does not match ci_contract")
    return _canonical(runtime, report)


def _cursor(runtime: Any, payload: dict[str, object]) -> tuple[object, str | None]:
    if "pr_feedback_cursor" not in payload:
        return "uninitialized", None
    raw = payload["pr_feedback_cursor"]
    if raw != "uninitialized" and not isinstance(raw, (str, dict)):
        raise ValueError("pr_feedback_cursor is invalid")
    value = runtime.validate_dynamic_pr_feedback_cursor(raw)
    return (
        value,
        value if value == "uninitialized" else _canonical(runtime, value),
    )


def _merge_report(pr: dict[str, object]) -> str:
    return json.dumps(
        {
            "state": pr.get("state"),
            "mergedAt": pr.get("mergedAt"),
            "mergeCommit": pr.get("mergeCommit"),
            "headRefName": pr.get("headRefName"),
            "headRefOid": pr.get("headRefOid"),
            "baseRefName": pr.get("baseRefName"),
            "baseRefOid": pr.get("baseRefOid"),
            "url": pr.get("url"),
        },
        ensure_ascii=False,
        sort_keys=True,
    )


def _pr_report(
    *,
    pr: dict[str, object],
    reason: str,
    checks: list[dict[str, object]] | None = None,
    observed_cursor: str | None = None,
    error: Exception | None = None,
) -> str:
    value: dict[str, object] = {
        "reason": reason,
        "state": pr.get("state"),
        "headRefOid": pr.get("headRefOid"),
        "baseRefOid": pr.get("baseRefOid"),
        "reviewDecision": pr.get("reviewDecision"),
        "mergeStateStatus": pr.get("mergeStateStatus"),
        "checks": checks or [],
        "url": pr.get("url"),
    }
    if observed_cursor is not None:
        value["observed_feedback_cursor"] = observed_cursor
    if error is not None:
        if hasattr(error, "as_dict"):
            value["safe_error"] = error.as_dict()
        else:
            value["safe_error"] = {
                "code": str(getattr(error, "code", "") or "invalid_observation"),
            }
    return json.dumps(value, ensure_ascii=False, sort_keys=True)


def _emit(
    transition: str,
    values: dict[str, object],
    *,
    cursor: str | None = None,
) -> None:
    result = dict(values)
    if cursor is not None:
        result["pr_feedback_cursor"] = cursor
    print(json.dumps(
        {"transition": transition, **result},
        ensure_ascii=False,
        sort_keys=True,
    ))


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        raise ValueError("stdin is not valid JSON: {}".format(error))
    if not isinstance(payload, dict):
        raise ValueError("stdin must be one JSON object")

    workspace = Path(_text(payload, "workspace_path")).expanduser().resolve()
    pr_url = _text(payload, "pr_url")
    branch_name = _text(payload, "branch_name")
    merge_strategy = _text(payload, "merge_strategy")
    initial_head = _text(payload, "pr_head_oid")
    initial_base = _text(payload, "pr_base_oid")
    if not workspace.is_dir():
        raise ValueError("workspace does not exist: {}".format(workspace))
    if merge_strategy not in {"merge", "squash", "rebase"}:
        raise ValueError("unsupported merge_strategy: {!r}".format(merge_strategy))

    runtime = runtime_contracts()
    observation = github_observation()
    contract, contract_text = _contract(runtime, payload, workspace)
    report_text = _report(runtime, payload, contract)
    acknowledged, acknowledged_text = _cursor(runtime, payload)
    repository, pull_number = observation.parse_pr_url(pr_url)
    if contract is not None and (
        repository != contract["repository"]
        or pull_number != contract["pull_number"]
    ):
        raise ValueError("ci_contract does not identify pr_url")
    values: dict[str, object] = {
        "workspace_path": str(workspace),
        "pr_url": pr_url,
        "branch_name": branch_name,
        "merge_strategy": merge_strategy,
    }
    if contract_text is not None:
        values["ci_contract"] = contract_text
    if report_text is not None:
        values["ci_report"] = report_text
    if "task_short_id" in payload:
        values["task_short_id"] = _text(payload, "task_short_id")

    test_mode = os.environ.get("KENT_PR_WATCH_TEST_MODE") == "1"
    interval = max(
        0 if test_mode else 30,
        int(os.environ.get("KENT_PR_WATCH_INTERVAL_SECONDS", "60")),
    )
    max_polls = max(0, int(os.environ.get("KENT_PR_WATCH_MAX_POLLS", "120")))
    max_errors = max(1, int(os.environ.get("KENT_PR_WATCH_MAX_ERRORS", "5")))
    timeout = max(
        1,
        int(os.environ.get("KENT_PR_WATCH_QUERY_TIMEOUT_SECONDS", "60")),
    )
    gh_bin = os.environ.get("KENT_GH_BIN")
    errors = 0
    polls = 0
    while True:
        polls += 1
        try:
            watcher = observation.GitHubObserver(
                workspace,
                gh_bin=gh_bin,
                timeout=timeout,
            )
            observed = watcher.observe_pr(pr_url)
            errors = 0
            pr = observed["pr"]
            state = str(pr.get("state") or "").upper()
            head_oid = str(pr["headRefOid"])
            base_oid = str(pr["baseRefOid"])
            if state == "MERGED":
                _emit(
                    "merge_watch_pr_merged",
                    {**values, "merge_report": _merge_report(pr)},
                    cursor=acknowledged_text,
                )
                return 0

            current = runtime.make_dynamic_pr_feedback_cursor(
                repository=repository,
                pull_number=pull_number,
                items=observed["feedback_items"],
                review_decision=str(pr.get("reviewDecision") or ""),
                checks=observed["checks"],
            )
            delta = runtime.diff_dynamic_pr_feedback_cursor(
                acknowledged,
                current,
            )
            initial_cursor_baseline = (
                acknowledged == "uninitialized"
                and not observed["feedback_items"]
                and current.get("review_decision") in {"", "APPROVED"}
            )
            if initial_cursor_baseline:
                delta = {
                    **delta,
                    "transition": "still_waiting",
                    "changed_items": [],
                    "needs_refresh": False,
                }
            observed_text = (
                _canonical(runtime, current)
                if delta["transition"] == "state_changed"
                else None
            )
            classification = runtime.classify_github_checks(
                observed["checks"],
                require_ci=(
                    contract["require_ci"]
                    if contract is not None
                    else False
                ),
            )
            reason = ""
            if state == "CLOSED":
                reason = "pull_request_closed_without_merge"
            elif head_oid != initial_head:
                reason = "pull_request_head_changed"
            elif base_oid != initial_base:
                reason = "pull_request_base_changed"
            elif (
                str(pr.get("mergeStateStatus") or "").upper()
                in {"DIRTY", "CONFLICTING"}
                or str(pr.get("mergeable") or "").upper() == "CONFLICTING"
            ):
                reason = "merge_conflict"
            elif (
                str(pr.get("reviewDecision") or "").upper()
                == "CHANGES_REQUESTED"
                and delta["transition"] == "state_changed"
            ):
                reason = "changes_requested"
            elif delta["transition"] == "state_changed":
                reason = (
                    "pull_request_feedback_refresh_required"
                    if delta.get("needs_refresh")
                    else "pull_request_feedback_changed"
                )
            elif classification["state"] == "failed":
                reason = "checks_failed"
            elif classification["state"] in {
                "invalid_observation",
                "observation_limit",
            }:
                reason = classification["state"]

            if reason:
                report = {
                    **values,
                    "pr_report": _pr_report(
                        pr=pr,
                        reason=reason,
                        checks=list(classification.get("checks", [])),
                        observed_cursor=observed_text,
                    ),
                    "pr_head_oid": head_oid,
                    "pr_base_oid": base_oid,
                }
                if observed_text is not None:
                    report["observed_feedback_cursor"] = observed_text
                _emit(
                    "merge_watch_state_changed",
                    report,
                    cursor=acknowledged_text,
                )
                return 0
            if max_polls and polls >= max_polls:
                _emit(
                    "merge_watch_still_waiting",
                    {
                        **values,
                        "pr_head_oid": head_oid,
                        "pr_base_oid": base_oid,
                    },
                    cursor=acknowledged_text,
                )
                return 0
            time.sleep(interval)
        except Exception as error:
            errors += 1
            if errors < max_errors:
                time.sleep(interval)
                continue
            _emit(
                "merge_watch_state_changed",
                {
                    **values,
                    "pr_report": _pr_report(
                        pr={},
                        reason="github_query_failed",
                        error=error,
                    ),
                    "pr_head_oid": initial_head,
                    "pr_base_oid": initial_base,
                },
                cursor=acknowledged_text,
            )
            return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print("workflow-wait-github-pr: {}".format(error), file=sys.stderr)
        raise SystemExit(1)
